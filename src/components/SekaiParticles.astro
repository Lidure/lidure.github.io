---
/** Canvas 樱花粒子层：优先 OffscreenCanvas + Worker，旧浏览器回退主线程 Canvas。 */
---
<canvas id="sakura-canvas" aria-hidden="true"></canvas>

<style>
#sakura-canvas {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 9999;
  overflow: hidden;
  transform: translateZ(0);
}
</style>

<script>
type SakuraWindow = Window & typeof globalThis & {
  __sakuraParticlesCleanup?: () => void;
  __sakuraParticlesPageLoadBound?: boolean;
};

type FallbackPetal = {
  x: number;
  y: number;
  size: number;
  speed: number;
  drift: number;
  wind: number;
  sway: number;
  phase: number;
  rotation: number;
  spin: number;
  tilt: number;
  alpha: number;
  tone: number;
};

const sakuraWindow = window as SakuraWindow;
const FALLBACK_MAX_PETALS = 24;

function readSakuraSettings() {
  let sakura = false;
  let reduceMotion = false;
  try {
    const saved = JSON.parse(localStorage.getItem('hero_settings') || '{}');
    sakura = saved.sakura === true;
    reduceMotion = saved.reduceMotion === true;
  } catch (_error) {}
  return { sakura, reduceMotion };
}

function initSakuraParticles() {
  const canvasElement = document.getElementById('sakura-canvas') as HTMLCanvasElement | null;
  if (!canvasElement || canvasElement.dataset.sakuraInitialized === '1') return;
  const canvas: HTMLCanvasElement = canvasElement;

  sakuraWindow.__sakuraParticlesCleanup?.();
  canvas.dataset.sakuraInitialized = '1';

  const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const initialSettings = readSakuraSettings();
  let requestedEnabled = initialSettings.sakura;
  let explicitReduceMotion = initialSettings.reduceMotion;
  let worker: Worker | null = null;
  let fallbackContext: CanvasRenderingContext2D | null = null;
  let fallbackFrame = 0;
  let fallbackLastTime = performance.now();
  let fallbackSpawnCarry = 0;
  let fallbackPetals: FallbackPetal[] = [];
  let viewportWidth = Math.max(1, window.innerWidth);
  let viewportHeight = Math.max(1, window.innerHeight);
  let dpr = Math.min(2, Math.max(1, window.devicePixelRatio || 1));

  const rootMotionObserver = new MutationObserver(() => {
    explicitReduceMotion = document.documentElement.dataset.reduceMotion === 'true';
    syncEnabled();
  });
  rootMotionObserver.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-reduce-motion'],
  });

  function isReducedMotion() {
    return explicitReduceMotion || motionQuery.matches;
  }

  function isEffectEnabled() {
    return requestedEnabled && !isReducedMotion() && document.visibilityState !== 'hidden';
  }

  function randomBetween(min: number, max: number) {
    return min + Math.random() * (max - min);
  }

  function createFallbackPetal(spawnInside = false): FallbackPetal {
    const size = randomBetween(7, 14);
    return {
      x: randomBetween(-30, viewportWidth + 20),
      y: spawnInside ? randomBetween(-viewportHeight * 0.2, viewportHeight * 0.85) : randomBetween(-70, -18),
      size,
      speed: randomBetween(28, 62),
      drift: randomBetween(8, 24),
      wind: randomBetween(8, 28),
      sway: randomBetween(0.7, 1.7),
      phase: randomBetween(0, Math.PI * 2),
      rotation: randomBetween(0, Math.PI * 2),
      spin: randomBetween(-1.1, 1.1),
      tilt: randomBetween(0.45, 1),
      alpha: randomBetween(0.52, 0.9),
      tone: randomBetween(-5, 7),
    };
  }

  function resetFallbackPetals(initial = false) {
    fallbackPetals = [];
    fallbackSpawnCarry = 0;
    if (!isEffectEnabled()) return;
    const count = initial ? Math.min(14, FALLBACK_MAX_PETALS) : 6;
    for (let i = 0; i < count; i += 1) fallbackPetals.push(createFallbackPetal(true));
  }

  function drawFallbackPetal(ctx: CanvasRenderingContext2D, petal: FallbackPetal) {
    const size = petal.size;
    ctx.save();
    ctx.translate(petal.x, petal.y);
    ctx.rotate(petal.rotation);
    ctx.scale(1, petal.tilt);
    ctx.beginPath();
    ctx.moveTo(0, size * 0.72);
    ctx.bezierCurveTo(-size * 0.7, size * 0.28, -size * 0.64, -size * 0.5, -size * 0.08, -size * 0.84);
    ctx.bezierCurveTo(-size * 0.01, -size * 0.66, size * 0.01, -size * 0.66, size * 0.08, -size * 0.84);
    ctx.bezierCurveTo(size * 0.64, -size * 0.5, size * 0.7, size * 0.28, 0, size * 0.72);
    ctx.closePath();
    ctx.fillStyle = `hsla(${340 + petal.tone}, 88%, 86%, ${petal.alpha})`;
    ctx.shadowColor = `hsla(${338 + petal.tone}, 90%, 72%, ${petal.alpha * 0.28})`;
    ctx.shadowBlur = 5;
    ctx.fill();
    ctx.restore();
  }

  function resizeFallbackCanvas() {
    if (!fallbackContext) return;
    canvas.width = Math.max(1, Math.round(viewportWidth * dpr));
    canvas.height = Math.max(1, Math.round(viewportHeight * dpr));
    fallbackContext.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function runFallback(now: number) {
    if (!fallbackContext) return;
    const dt = Math.min(0.05, Math.max(0, (now - fallbackLastTime) / 1000));
    fallbackLastTime = now;
    fallbackContext.clearRect(0, 0, viewportWidth, viewportHeight);

    if (isEffectEnabled()) {
      fallbackSpawnCarry += dt * 1.15;
      while (fallbackSpawnCarry >= 1 && fallbackPetals.length < FALLBACK_MAX_PETALS) {
        fallbackSpawnCarry -= 1;
        fallbackPetals.push(createFallbackPetal(false));
      }

      const nowSeconds = now / 1000;
      for (let i = fallbackPetals.length - 1; i >= 0; i -= 1) {
        const petal = fallbackPetals[i];
        const breeze = Math.sin(nowSeconds * petal.sway + petal.phase) * petal.wind;
        petal.x += (petal.drift + breeze) * dt;
        petal.y += petal.speed * dt;
        petal.rotation += petal.spin * dt;
        if (petal.y > viewportHeight + 90 || petal.x > viewportWidth + 100 || petal.x < -120) {
          fallbackPetals.splice(i, 1);
          continue;
        }
        drawFallbackPetal(fallbackContext, petal);
      }
    }

    fallbackFrame = requestAnimationFrame(runFallback);
  }

  function resize() {
    viewportWidth = Math.max(1, window.innerWidth);
    viewportHeight = Math.max(1, window.innerHeight);
    dpr = Math.min(2, Math.max(1, window.devicePixelRatio || 1));
    if (worker) {
      worker.postMessage({
        type: 'resize',
        width: viewportWidth,
        height: viewportHeight,
        dpr,
      });
    } else {
      resizeFallbackCanvas();
    }
  }

  function syncEnabled() {
    const active = isEffectEnabled();
    canvas.hidden = !active;
    if (worker) {
      worker.postMessage({
        type: 'enabled',
        enabled: requestedEnabled && document.visibilityState !== 'hidden',
        reducedMotion: isReducedMotion(),
      });
    } else if (active && fallbackPetals.length === 0) {
      resetFallbackPetals(true);
    } else if (!active && fallbackContext) {
      fallbackPetals = [];
      fallbackContext.clearRect(0, 0, viewportWidth, viewportHeight);
    }
  }

  const supportsOffscreen =
    typeof Worker !== 'undefined' &&
    'transferControlToOffscreen' in canvas;

  if (supportsOffscreen) {
    try {
      worker = new Worker(new URL('../workers/sakura.worker.js', import.meta.url), { type: 'module' });
      const offscreen = canvas.transferControlToOffscreen();
      worker.postMessage({
        type: 'init',
        canvas: offscreen,
        width: viewportWidth,
        height: viewportHeight,
        dpr,
        enabled: requestedEnabled,
        reducedMotion: isReducedMotion(),
      }, [offscreen]);
    } catch (_error) {
      worker?.terminate();
      worker = null;
    }
  }

  if (!worker) {
    fallbackContext = canvas.getContext('2d');
    if (fallbackContext) {
      resizeFallbackCanvas();
      resetFallbackPetals(true);
      fallbackLastTime = performance.now();
      fallbackFrame = requestAnimationFrame(runFallback);
    }
  }

  function onSakuraSetting(event: Event) {
    const customEvent = event as CustomEvent<{ enabled?: boolean }>;
    requestedEnabled = customEvent.detail?.enabled !== false;
    syncEnabled();
  }

  function onMotionPreferenceChange() {
    syncEnabled();
  }

  function onVisibilityChange() {
    worker?.postMessage({ type: 'visibility', hidden: document.visibilityState === 'hidden' });
    fallbackLastTime = performance.now();
    syncEnabled();
  }

  window.addEventListener('resize', resize, { passive: true });
  document.addEventListener('lidure:sakura-setting', onSakuraSetting);
  document.addEventListener('visibilitychange', onVisibilityChange);
  motionQuery.addEventListener('change', onMotionPreferenceChange);
  syncEnabled();

  sakuraWindow.__sakuraParticlesCleanup = () => {
    window.removeEventListener('resize', resize);
    document.removeEventListener('lidure:sakura-setting', onSakuraSetting);
    document.removeEventListener('visibilitychange', onVisibilityChange);
    motionQuery.removeEventListener('change', onMotionPreferenceChange);
    rootMotionObserver.disconnect();
    if (fallbackFrame) cancelAnimationFrame(fallbackFrame);
    worker?.terminate();
    worker = null;
    fallbackContext = null;
    fallbackPetals = [];
    sakuraWindow.__sakuraParticlesCleanup = undefined;
  };
}

if (!sakuraWindow.__sakuraParticlesPageLoadBound) {
  sakuraWindow.__sakuraParticlesPageLoadBound = true;
  document.addEventListener('astro:page-load', initSakuraParticles);
  document.addEventListener('astro:before-swap', () => sakuraWindow.__sakuraParticlesCleanup?.());
}

initSakuraParticles();
</script>