<div class="banner-waves" id="banner-waves" aria-hidden="true">
  <svg
    class="banner-waves-static"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 24 150 28"
    preserveAspectRatio="none"
    shape-rendering="geometricPrecision"
  >
    <defs>
      <path
        id="gentle-wave"
        d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v48h-352z"
      />
    </defs>
    <g>
      <use href="#gentle-wave" x="-42.000" y="0" class="wave-layer wave-layer-1" />
      <use href="#gentle-wave" x="2.641" y="3" class="wave-layer wave-layer-2" />
      <use href="#gentle-wave" x="48.944" y="5" class="wave-layer wave-layer-3" />
      <use href="#gentle-wave" x="92.468" y="7" class="wave-layer wave-layer-4" />
    </g>
  </svg>
  <canvas data-wave-canvas></canvas>
</div>

<style is:global>
  body.layout-standard {
    --blog-banner-height: 65vh;
  }

  body.layout-standard .hero-slideshow {
    height: var(--blog-banner-height, 65vh);
    min-height: 400px;
  }

  body.layout-standard .blog-banner-stage {
    position: relative;
    z-index: 2;
    width: 100%;
    height: var(--blog-banner-height, 65vh);
    min-height: 400px;
  }

  body.layout-standard .blog-banner-stage > .blog-banner {
    height: 100%;
    min-height: 0;
  }

  body.layout-standard .banner-waves {
    --banner-wave-height: clamp(50px, 15vh, 150px);
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    z-index: 15;
    width: 100%;
    height: var(--banner-wave-height);
    margin-bottom: -1px;
    color: var(--standard-page-bg);
    isolation: isolate;
    contain: layout style;
    overflow: visible;
    pointer-events: none;
    transform: translate3d(0, 0, 0);
    transform-origin: bottom;
    backface-visibility: hidden;
  }

  body.layout-standard .banner-waves-static,
  body.layout-standard .banner-waves canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  body.layout-standard .banner-waves-static {
    z-index: 1;
    transition: opacity 180ms ease;
  }

  body.layout-standard .banner-waves canvas {
    z-index: 2;
    opacity: 0;
    transition: opacity 180ms ease;
  }

  body.layout-standard .banner-waves.is-canvas-ready canvas {
    opacity: 1;
  }

  body.layout-standard .banner-waves.is-canvas-ready .banner-waves-static {
    opacity: 0;
  }

  body.layout-standard .banner-waves .wave-layer {
    fill: currentColor;
  }

  body.layout-standard .banner-waves .wave-layer-1 { opacity: 0.25; }
  body.layout-standard .banner-waves .wave-layer-2 { opacity: 0.50; }
  body.layout-standard .banner-waves .wave-layer-3 { opacity: 0.65; }
  body.layout-standard .banner-waves .wave-layer-4 { opacity: 0.75; }

  html[data-wave-strength="soft"] body.layout-standard .banner-waves {
    transform: scaleY(0.72) translateZ(0);
  }

  html[data-wave-strength="strong"] body.layout-standard .banner-waves {
    transform: scaleY(1.22) translateZ(0);
  }

  html[data-wave-enabled="false"] body.layout-standard .banner-waves,
  html.no-hero-bg body.layout-standard .banner-waves,
  html[data-wallpaper-mode="fullscreen"] body.layout-standard .banner-waves {
    display: none;
  }

  @media (max-width: 1023px) {
    body.layout-standard .banner-waves {
      --banner-wave-height: clamp(50px, 10vh, 150px);
    }

    html[data-wave-mobile="false"] body.layout-standard .banner-waves {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    body.layout-standard .banner-waves-static,
    body.layout-standard .banner-waves canvas {
      transition: none;
    }
  }

  html[data-reduce-motion="true"] body.layout-standard .banner-waves-static,
  html[data-reduce-motion="true"] body.layout-standard .banner-waves canvas {
    transition: none;
  }
</style>

<script>
  import {
    WAVE_LAYERS,
    WAVE_PATH_D,
    WAVE_VIEWBOX,
    resolveWavePreset,
    waveUseX,
  } from '../lib/banner-waves.mjs';

  type WaveSettings = {
    waveEnabled: boolean;
    waveStrength: 'soft' | 'standard' | 'strong';
    waveSpeed: 'slow' | 'normal' | 'fast';
    waveMobile: boolean;
    reduceMotion: boolean;
  };

  const waveWindow = window as typeof window & {
    __lidureVisualSettings?: { read?: () => Partial<WaveSettings> };
    __bannerWavesCleanup?: () => void;
    __bannerWavesLifecycleBound?: boolean;
  };

  function settingsFromRoot(): WaveSettings {
    const root = document.documentElement;
    return {
      waveEnabled: root.dataset.waveEnabled !== 'false',
      waveStrength: root.dataset.waveStrength === 'soft' || root.dataset.waveStrength === 'strong'
        ? root.dataset.waveStrength
        : 'standard',
      waveSpeed: root.dataset.waveSpeed === 'slow' || root.dataset.waveSpeed === 'fast'
        ? root.dataset.waveSpeed
        : 'normal',
      waveMobile: root.dataset.waveMobile !== 'false',
      reduceMotion: root.dataset.reduceMotion === 'true',
    };
  }

  function readSettings(): WaveSettings {
    const fallback = settingsFromRoot();
    const read = waveWindow.__lidureVisualSettings?.read;
    if (typeof read !== 'function') return fallback;
    try {
      return { ...fallback, ...read() } as WaveSettings;
    } catch {
      return fallback;
    }
  }

  function contentFillColor() {
    const surface = document.querySelector<HTMLElement>('.standard-page-surface');
    if (surface) {
      const background = getComputedStyle(surface).backgroundColor;
      if (background && background !== 'rgba(0, 0, 0, 0)') return background;
    }
    const bodyStyle = getComputedStyle(document.body);
    return bodyStyle.getPropertyValue('--standard-page-bg').trim() || '#15151a';
  }

  function initBannerWaves() {
    waveWindow.__bannerWavesCleanup?.();

    const root = document.getElementById('banner-waves');
    const canvas = root?.querySelector<HTMLCanvasElement>('[data-wave-canvas]');
    if (!root || !canvas) return;

    const context = canvas.getContext('2d');
    if (!context) return;

    let wavePath: Path2D;
    try {
      wavePath = new Path2D(WAVE_PATH_D);
    } catch {
      return;
    }

    const waveRoot: HTMLElement = root;
    const waveCanvas: HTMLCanvasElement = canvas;
    const waveContext: CanvasRenderingContext2D = context;
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const mobileQuery = window.matchMedia('(max-width: 1023px)');
    let raf = 0;
    let width = 0;
    let height = 0;
    let settings = readSettings();
    let firstFrameDrawn = false;
    let startTime = performance.now();

    function motionReduced() {
      return settings.reduceMotion || motionQuery.matches;
    }

    function shouldRender() {
      const pageRoot = document.documentElement;
      if (pageRoot.dataset.wallpaperMode === 'fullscreen') return false;
      if (pageRoot.classList.contains('no-hero-bg')) return false;
      return settings.waveEnabled && !(mobileQuery.matches && !settings.waveMobile);
    }

    function stopAnimation() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    }

    function resize() {
      const rect = waveRoot.getBoundingClientRect();
      const nextWidth = Math.max(1, Math.round(rect.width));
      const nextHeight = Math.max(1, Math.round(rect.height));
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      if (
        nextWidth === width
        && nextHeight === height
        && waveCanvas.width === Math.round(nextWidth * dpr)
      ) return;

      width = nextWidth;
      height = nextHeight;
      waveCanvas.width = Math.round(width * dpr);
      waveCanvas.height = Math.round(height * dpr);
      waveCanvas.style.width = `${width}px`;
      waveCanvas.style.height = `${height}px`;
    }

    function draw(now: number) {
      resize();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const preset = resolveWavePreset(settings);
      const fill = contentFillColor();
      const elapsed = (now - startTime) / 1000;
      const scaleX = width / WAVE_VIEWBOX.width;
      const scaleY = height / WAVE_VIEWBOX.height;

      waveContext.setTransform(1, 0, 0, 1, 0, 0);
      waveContext.clearRect(0, 0, waveCanvas.width, waveCanvas.height);

      WAVE_LAYERS.forEach((layer) => {
        const useX = waveUseX(layer, elapsed, preset.speed);
        waveContext.save();
        waveContext.setTransform(
          dpr * scaleX,
          0,
          0,
          dpr * scaleY,
          dpr * useX * scaleX,
          dpr * (layer.y - WAVE_VIEWBOX.y) * scaleY,
        );
        waveContext.globalAlpha = Math.min(1, layer.alpha * preset.alpha);
        waveContext.fillStyle = fill;
        waveContext.fill(wavePath);
        waveContext.restore();
      });

      if (!firstFrameDrawn) {
        firstFrameDrawn = true;
        waveRoot.classList.add('is-canvas-ready');
      }
    }

    function frame(now: number) {
      if (!shouldRender() || motionReduced() || document.hidden) {
        stopAnimation();
        waveRoot.classList.remove('is-canvas-ready');
        return;
      }
      draw(now);
      raf = requestAnimationFrame(frame);
    }

    function refresh({ restart = true } = {}) {
      settings = readSettings();
      const active = shouldRender();
      waveRoot.hidden = !active;
      stopAnimation();
      firstFrameDrawn = false;
      waveRoot.classList.remove('is-canvas-ready');
      if (!active) return;
      if (restart) startTime = performance.now();
      resize();
      if (motionReduced()) return;
      raf = requestAnimationFrame(frame);
    }

    function onVisibilityChange() {
      if (document.hidden) stopAnimation();
      else refresh({ restart: false });
    }

    const resizeObserver = typeof ResizeObserver !== 'undefined' ? new ResizeObserver(resize) : null;
    resizeObserver?.observe(waveRoot);
    const themeObserver = new MutationObserver(() => refresh({ restart: false }));
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme', 'data-wallpaper-mode', 'style', 'class'],
    });

    const onSettingsChange = () => refresh();
    const onMediaChange = () => refresh({ restart: false });
    document.addEventListener('lidure:visual-settings-change', onSettingsChange);
    document.addEventListener('visibilitychange', onVisibilityChange);
    window.addEventListener('resize', resize);
    motionQuery.addEventListener?.('change', onMediaChange);
    mobileQuery.addEventListener?.('change', onMediaChange);

    waveWindow.__bannerWavesCleanup = () => {
      stopAnimation();
      resizeObserver?.disconnect();
      themeObserver.disconnect();
      document.removeEventListener('lidure:visual-settings-change', onSettingsChange);
      document.removeEventListener('visibilitychange', onVisibilityChange);
      window.removeEventListener('resize', resize);
      motionQuery.removeEventListener?.('change', onMediaChange);
      mobileQuery.removeEventListener?.('change', onMediaChange);
      waveRoot.classList.remove('is-canvas-ready');
    };

    refresh();
  }

  if (!waveWindow.__bannerWavesLifecycleBound) {
    waveWindow.__bannerWavesLifecycleBound = true;
    document.addEventListener('astro:page-load', initBannerWaves);
    document.addEventListener('astro:before-swap', () => waveWindow.__bannerWavesCleanup?.());
  }

  initBannerWaves();
</script>
