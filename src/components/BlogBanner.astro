---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="blog-banner" aria-labelledby="blog-banner-title">
  <div class="blog-banner-copy">
    <h1 id="blog-banner-title">{title}</h1>
    {subtitle && <p>{subtitle}</p>}
  </div>
</section>

<style>
  :global(html.no-hero-bg body.layout-standard) .blog-banner {
    background: var(--standard-card-soft);
    color: var(--standard-text);
  }

  :global(html.no-hero-bg body.layout-standard) .blog-banner-copy h1,
  :global(html.no-hero-bg body.layout-standard) .blog-banner-copy p {
    text-shadow: none;
  }

  :global(html.no-hero-bg body.layout-standard) .blog-banner-copy p {
    color: var(--standard-muted);
  }
</style>

<style is:global>
  /* Firefly-style banner/content composition.
     The page surface itself overlaps the banner instead of being pushed back
     below it. Homepage navigation then sits fully inside the content field. */
  body.layout-standard {
    --banner-surface-overlap: 3.5rem;
    --home-banner-content-inset: 2.9rem;
  }

  /* Non-home banner pages retain the original stacking boundary. On the
     homepage the stage must not create one, otherwise the content surface
     cannot visually overlap the banner area. */
  html[data-wallpaper-mode="banner"] body.layout-standard:not(.is-home) .blog-banner-stage {
    z-index: 4;
  }

  html[data-wallpaper-mode="banner"] body.layout-standard.is-home .blog-banner-stage {
    z-index: auto;
  }

  html[data-wallpaper-mode="banner"] body.layout-standard .standard-page-surface {
    z-index: 3;
    margin-top: calc(-1 * var(--banner-surface-overlap));
  }

  html[data-wallpaper-mode="banner"] body.layout-standard.is-home .standard-page-surface {
    border-radius: 0;
  }

  html[data-wallpaper-mode="banner"] body.layout-standard.is-home .standard-content {
    padding-top: var(--home-banner-content-inset);
  }

  html[data-wallpaper-mode="banner"] body.layout-standard:not(.is-home) .standard-content {
    padding-top: calc(var(--banner-surface-overlap) + 14px);
  }

  body.layout-standard.is-home .blog-banner-stage,
  body.layout-standard.is-home .blog-banner,
  body.layout-standard.is-home .banner-waves {
    pointer-events: none;
  }

  body.layout-standard.is-home .blog-banner-copy {
    transform: translateY(calc(-1 * clamp(20px, 4vh, 42px)));
  }

  /* Keep the category navigation out of the composited seam itself. It is a
     complete content pill, not another overlap layer. A small top margin keeps
     its upper radius clear of the content boundary seen in Chromium. */
  body.layout-standard.is-home .home-category-bar {
    position: relative;
    z-index: 6;
    margin: 10px 0 20px;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in oklch, var(--standard-card-bg) 95%, transparent);
    box-shadow:
      0 8px 24px color-mix(in oklch, var(--standard-page-bg) 46%, transparent),
      0 0 0 1px color-mix(in oklch, var(--standard-accent) 8%, transparent);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  /* Firefly makes waves and the wallpaper gradient mutually exclusive. Keep
     the gradient only as the fallback when waves are not rendered on the
     current device. */
  @media (min-width: 1024px) {
    html[data-wave-enabled="true"] body.layout-standard .standard-page-surface::before {
      display: none;
    }
  }

  @media (max-width: 1023px) {
    html[data-wave-enabled="true"][data-wave-mobile="true"] body.layout-standard .standard-page-surface::before {
      display: none;
    }
  }

  @media (max-width: 720px) {
    body.layout-standard.is-home {
      --banner-surface-overlap: 2.25rem;
      --home-banner-content-inset: 2rem;
    }

    body.layout-standard.is-home .blog-banner-copy {
      transform: translateY(calc(-1 * clamp(12px, 2.5vh, 24px)));
    }

    body.layout-standard.is-home .home-category-bar {
      margin-top: 6px;
      margin-bottom: 16px;
      overflow-x: auto;
      overflow-y: hidden;
      border-radius: 14px;
    }
  }
</style>
