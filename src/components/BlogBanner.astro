---
import BannerHeightSettingsEnhancer from './BannerHeightSettingsEnhancer.astro';

interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<BannerHeightSettingsEnhancer />
<section class="blog-banner" aria-labelledby="blog-banner-title">
  <div class="blog-banner-copy">
    <div id="blog-banner-title" class="blog-banner-title">{title}</div>
    {subtitle && <p class="blog-banner-subtitle" data-original-subtitle={subtitle}>{subtitle}</p>}
  </div>
</section>

<style>
  :global(html.no-hero-bg body.layout-standard) .blog-banner {
    background: var(--standard-card-soft);
    color: var(--standard-text);
  }

  :global(html.no-hero-bg body.layout-standard) .blog-banner-copy .blog-banner-title,
  :global(html.no-hero-bg body.layout-standard) .blog-banner-copy p {
    text-shadow: none;
  }

  :global(html.no-hero-bg body.layout-standard) .blog-banner-copy p {
    color: var(--standard-muted);
  }
</style>

<style is:global>
  /* Firefly-style banner/content composition.
     The content panel starts 3.5rem before the banner ends. The panel itself
     stays transparent on the homepage; readable content is layered above the
     waves while the body page color provides the continuous surface below. */
  body.layout-standard {
    --banner-surface-overlap: 3.5rem;
    --home-banner-content-inset: 0.75rem;
  }

  /* Non-home banner pages retain a local stacking boundary, but the whole
     banner stage stays below the page surface so decorative waves can never
     outrank dialogs or other UI inside the content surface. On the homepage
     the stage must not create one, otherwise the content panel cannot cross
     the banner seam like Firefly's z-30 content-panel. */
  html[data-wallpaper-mode="banner"] body.layout-standard:not(.is-home) .blog-banner-stage {
    z-index: 2;
  }

  html[data-wallpaper-mode="banner"] body.layout-standard.is-home .blog-banner-stage {
    z-index: auto;
  }

  html[data-wallpaper-mode="banner"] body.layout-standard .standard-page-surface {
    z-index: 3;
    margin-top: calc(-1 * var(--banner-surface-overlap));
  }

  /* Firefly's content-panel is a positioning wrapper rather than an opaque
     sheet. Keep this wrapper out of a stacking context; the body supplies the
     page background and the inner content receives the actual z-index. */
  html[data-wallpaper-mode="banner"] body.layout-standard.is-home .standard-page-surface {
    z-index: auto;
    border-radius: 0;
    background: transparent;
  }

  html[data-wallpaper-mode="banner"] body.layout-standard.is-home .standard-content {
    position: relative;
    z-index: 30;
    padding-top: calc(var(--banner-surface-overlap) + 14px);
  }

  html[data-wallpaper-mode="banner"] body.layout-standard:not(.is-home) .standard-content {
    padding-top: calc(var(--banner-surface-overlap) + 14px);
  }

  body.layout-standard.is-home .blog-banner-stage,
  body.layout-standard.is-home .blog-banner,
  body.layout-standard.is-home .banner-waves {
    pointer-events: none;
  }

  body.layout-standard.is-home .blog-banner-copy {
    transform: translateY(calc(-1 * clamp(20px, 4vh, 42px)));
  }

  /* Keep the home grid explicitly readable above decorative layers as an
     additional local guarantee; the parent content panel now matches Firefly's
     z-30 layer while waves remain at z-15. */
  body.layout-standard.is-home .home-layout {
    position: relative;
    z-index: 20;
  }

  body.layout-standard.is-home .home-center-column {
    grid-area: main;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-self: start;
  }

  body.layout-standard.is-home .home-category-bar {
    width: 100%;
    max-width: none;
    box-sizing: border-box;
    justify-content: flex-start;
    margin: 0;
    overflow: hidden;
    border-radius: 14px;
    background: color-mix(in oklch, var(--standard-card-bg) 97%, transparent);
    box-shadow:
      0 10px 30px color-mix(in oklch, var(--standard-page-bg) 38%, transparent),
      0 0 0 1px color-mix(in oklch, var(--standard-accent) 8%, transparent);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  /* Firefly makes waves and the wallpaper gradient mutually exclusive. Keep
     the gradient only as the fallback when waves are not rendered on the
     current device. */
  @media (min-width: 1024px) {
    html[data-wave-enabled="true"] body.layout-standard .standard-page-surface::before {
      display: none;
    }
  }

  @media (max-width: 1023px) {
    html[data-wave-enabled="true"][data-wave-mobile="true"] body.layout-standard .standard-page-surface::before {
      display: none;
    }
  }

  @media (max-width: 720px) {
    body.layout-standard.is-home {
      --banner-surface-overlap: 2.25rem;
      --home-banner-content-inset: 0.5rem;
    }

    body.layout-standard.is-home .blog-banner-copy {
      transform: translateY(calc(-1 * clamp(12px, 2.5vh, 24px)));
    }

    body.layout-standard.is-home .home-center-column {
      gap: 16px;
    }

    body.layout-standard.is-home .home-category-bar {
      overflow-x: auto;
      overflow-y: hidden;
      border-radius: 14px;
    }
  }
</style>


<script>
  const phrases = [
    '把喜欢的东西，认真地收进小站里。',
    '记录游戏、音乐与日常。',
    '折腾技术，也收藏热爱。',
    '让灵感在这里慢慢生长。',
  ];

  let typingTimer: number | undefined;
  let activeSubtitle: HTMLElement | null = null;
  let phraseIndex = 0;
  let charIndex = 0;
  let deleting = false;

  function stopTypewriter() {
    if (typingTimer !== undefined) window.clearTimeout(typingTimer);
    typingTimer = undefined;
    if (activeSubtitle) {
      activeSubtitle.textContent = activeSubtitle.dataset.originalSubtitle || '';
      activeSubtitle.removeAttribute('aria-label');
      activeSubtitle = null;
    }
  }

  function startTypewriter() {
    stopTypewriter();

    const subtitle = document.querySelector<HTMLElement>('.blog-banner-subtitle');
    const root = document.documentElement;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      || root.dataset.reduceMotion === 'true';

    if (!subtitle || root.dataset.wallpaperMode !== 'banner' || reducedMotion) return;

    activeSubtitle = subtitle;
    phraseIndex = 0;
    charIndex = 0;
    deleting = false;
    subtitle.setAttribute('aria-label', phrases[0]);
    subtitle.textContent = '';

    const tick = () => {
      if (!activeSubtitle || !activeSubtitle.isConnected) {
        stopTypewriter();
        return;
      }

      const phrase = phrases[phraseIndex];
      charIndex += deleting ? -1 : 1;
      activeSubtitle.textContent = phrase.slice(0, charIndex);

      let delay = deleting ? 48 : 105;
      if (!deleting && charIndex >= phrase.length) {
        deleting = true;
        delay = 1500;
      } else if (deleting && charIndex <= 0) {
        deleting = false;
        phraseIndex = (phraseIndex + 1) % phrases.length;
        delay = 350;
      }

      typingTimer = window.setTimeout(tick, delay);
    };

    typingTimer = window.setTimeout(tick, 450);
  }

  let lifecycleBound = false;
  function bindTypewriterLifecycle() {
    if (lifecycleBound) return;
    lifecycleBound = true;
    document.addEventListener('astro:page-load', startTypewriter);
    document.addEventListener('astro:before-swap', stopTypewriter);
    const observer = new MutationObserver(() => {
      if (document.documentElement.dataset.wallpaperMode === 'banner' && !activeSubtitle) {
        startTypewriter();
      } else if (document.documentElement.dataset.wallpaperMode !== 'banner' && activeSubtitle) {
        stopTypewriter();
      } else if (document.documentElement.dataset.reduceMotion === 'true' && activeSubtitle) {
        stopTypewriter();
      }
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-wallpaper-mode', 'data-reduce-motion'] });
  }

  bindTypewriterLifecycle();
  startTypewriter();
</script>

<style is:global>
  /* Keep the main banner heading readable and immediate; give it only a subtle entrance. */
  html[data-wallpaper-mode="banner"] .blog-banner-title,
  html[data-wallpaper-mode="fullscreen"] body.layout-standard.is-home .blog-banner-title {
    animation: banner-title-reveal 650ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .blog-banner-subtitle {
    min-height: 1.8em;
  }

  html[data-wallpaper-mode="banner"] .blog-banner-subtitle::after {
    content: '';
    display: inline-block;
    width: 1px;
    height: 1em;
    margin-left: 4px;
    vertical-align: -0.12em;
    background: currentColor;
    animation: banner-typewriter-caret 0.85s steps(1, end) infinite;
  }

  @keyframes banner-title-reveal {
    from { opacity: 0; transform: translateY(7px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes banner-typewriter-caret {
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    html[data-wallpaper-mode="banner"] .blog-banner-title,
    html[data-wallpaper-mode="fullscreen"] body.layout-standard.is-home .blog-banner-title { animation: none; }
    .blog-banner-subtitle::after { animation: none; }
  }
</style>
