---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="blog-banner" aria-labelledby="blog-banner-title">
  <div class="blog-banner-copy">
    <h1 id="blog-banner-title">{title}</h1>
    {subtitle && <p>{subtitle}</p>}
  </div>
</section>

<style>
  :global(html.no-hero-bg body.layout-standard) .blog-banner {
    background: var(--standard-card-soft);
    color: var(--standard-text);
  }

  :global(html.no-hero-bg body.layout-standard) .blog-banner-copy h1,
  :global(html.no-hero-bg body.layout-standard) .blog-banner-copy p {
    text-shadow: none;
  }

  :global(html.no-hero-bg body.layout-standard) .blog-banner-copy p {
    color: var(--standard-muted);
  }
</style>

<style is:global>
  /* Firefly-style banner/content relationship. The banner stage must not be a
     stacking context: the page surface can then rise over the bottom of the
     wallpaper while the independently positioned wave layers remain above it. */
  body.layout-standard {
    --banner-surface-overlap: 3.5rem;
  }

  body.layout-standard .blog-banner-stage {
    z-index: auto;
  }

  html[data-wallpaper-mode="banner"] body.layout-standard.is-home .standard-page-surface {
    z-index: 3;
    margin-top: calc(-1 * var(--banner-surface-overlap));
    border-radius: 0;
    box-shadow: none;
  }

  /* Keep the first real controls just below the visual wave edge, while the
     surface itself already occupies the overlap behind the waves. */
  html[data-wallpaper-mode="banner"] body.layout-standard.is-home .standard-content {
    padding-top: calc(var(--banner-surface-overlap) + 10px);
  }

  html[data-wallpaper-mode="banner"] body.layout-standard.is-home .blog-banner-copy {
    transform: translateY(clamp(-30px, -3vh, -14px));
  }

  html[data-wallpaper-mode="banner"] body.layout-standard.is-home .home-category-bar {
    position: relative;
    z-index: 4;
    margin-bottom: 20px;
  }

  /* Firefly makes waves and the wallpaper gradient mutually exclusive. Keep
     the gradient only as the fallback when waves are not rendered on the
     current device. */
  @media (min-width: 1024px) {
    html[data-wave-enabled="true"] body.layout-standard .standard-page-surface::before {
      display: none;
    }
  }

  @media (max-width: 1023px) {
    body.layout-standard {
      --banner-surface-overlap: 2.75rem;
    }

    html[data-wallpaper-mode="banner"] body.layout-standard.is-home .blog-banner-copy {
      transform: translateY(clamp(-22px, -2.2vh, -10px));
    }

    html[data-wallpaper-mode="banner"] body.layout-standard.is-home .standard-content {
      padding-top: calc(var(--banner-surface-overlap) + 8px);
    }

    html[data-wave-enabled="true"][data-wave-mobile="true"] body.layout-standard .standard-page-surface::before {
      display: none;
    }
  }
</style>
