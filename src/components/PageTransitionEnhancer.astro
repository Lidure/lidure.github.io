<div id="page-transition-progress" transition:persist aria-hidden="true"></div>

<style is:global>
  #page-transition-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10050;
    width: 100%;
    height: 3px;
    pointer-events: none;
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left center;
    background: var(
      --firefly-primary,
      var(--standard-accent, hsl(var(--theme-hue, 340) 72% 60%))
    );
    box-shadow: 0 0 8px color-mix(
      in oklch,
      var(--firefly-primary, var(--standard-accent, hsl(var(--theme-hue, 340) 72% 60%))) 60%,
      transparent
    );
    will-change: transform, opacity;
  }

  html.is-page-transitioning .standard-page-surface,
  html.is-page-transitioning .immersive-content {
    will-change: transform, opacity;
  }

  html[data-reduce-motion="true"] #page-transition-progress,
  html[data-reduce-motion="true"] .standard-page-surface,
  html[data-reduce-motion="true"] .immersive-content {
    animation: none !important;
    transition: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    #page-transition-progress,
    .standard-page-surface,
    .immersive-content {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script is:inline>
(function () {
  var root = document.documentElement;
  var motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

  function motionReduced() {
    return root.dataset.reduceMotion === 'true' || motionQuery.matches;
  }

  function currentPageSurface() {
    return document.querySelector('.standard-page-surface, .immersive-content');
  }

  function cancelAnimation(element) {
    if (!element || typeof element.getAnimations !== 'function') return;
    element.getAnimations().forEach(function (animation) {
      try { animation.cancel(); } catch (error) {}
    });
  }

  function startProgressBar() {
    var bar = document.getElementById('page-transition-progress');
    if (!bar || motionReduced()) return;
    cancelAnimation(bar);
    bar.animate(
      [
        { transform: 'scaleX(0)', opacity: 1 },
        { transform: 'scaleX(0.92)', opacity: 1 },
      ],
      {
        duration: 8000,
        easing: 'cubic-bezier(0.1, 0.05, 0.1, 1)',
        fill: 'forwards',
      },
    );
  }

  function finishProgressBar() {
    var bar = document.getElementById('page-transition-progress');
    if (!bar) return;
    cancelAnimation(bar);
    if (motionReduced()) {
      bar.style.opacity = '0';
      bar.style.transform = 'scaleX(0)';
      return;
    }
    bar.animate(
      [
        { transform: 'scaleX(1)', opacity: 1 },
        { transform: 'scaleX(1)', opacity: 0 },
      ],
      {
        duration: 420,
        easing: 'ease-out',
        fill: 'forwards',
      },
    );
  }

  function animateLeavingSurface() {
    var surface = currentPageSurface();
    if (!surface || motionReduced() || typeof surface.animate !== 'function') return;
    cancelAnimation(surface);
    surface.animate(
      [
        { opacity: 1, transform: 'translateY(0)' },
        { opacity: 0, transform: 'translateY(-2rem)' },
      ],
      {
        duration: 120,
        easing: 'cubic-bezier(0.55, 0.055, 0.675, 0.19)',
        fill: 'forwards',
      },
    );
  }

  function animateEnteringSurface() {
    var surface = currentPageSurface();
    if (!surface || motionReduced() || typeof surface.animate !== 'function') return;
    cancelAnimation(surface);
    surface.animate(
      [
        { opacity: 0, transform: 'translateY(2rem)' },
        { opacity: 1, transform: 'translateY(0)' },
      ],
      {
        duration: 120,
        easing: 'cubic-bezier(0.25, 0.46, 0.45, 0.94)',
        fill: 'both',
      },
    );
  }

  if (!window.__pageTransitionEnhancerBound) {
    window.__pageTransitionEnhancerBound = true;

    document.addEventListener('astro:before-preparation', function () {
      root.classList.add('is-page-transitioning');
      startProgressBar();
      animateLeavingSurface();
    });

    document.addEventListener('astro:after-swap', function () {
      animateEnteringSurface();
      finishProgressBar();
    });

    document.addEventListener('astro:page-load', function () {
      root.classList.remove('is-page-transitioning');
    });
  }
})();
</script>