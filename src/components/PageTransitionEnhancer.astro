<div id="page-transition-progress" transition:persist aria-hidden="true"></div>

<style is:global>
  /* Astro's ClientRouter uses the browser View Transition API when available.
     Firefly does not layer a native root snapshot over its Swup content motion.
     Keep the native pseudo-elements inert as a defensive fallback; the runtime
     also calls viewTransition.skipTransition() before each swap below. */
  ::view-transition-group(root),
  ::view-transition-image-pair(root),
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none !important;
    transition: none !important;
    mix-blend-mode: normal;
  }

  ::view-transition-old(root) {
    opacity: 0 !important;
  }

  ::view-transition-new(root) {
    opacity: 1 !important;
  }

  #page-transition-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-toast);
    width: 100%;
    height: 3px;
    pointer-events: none;
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left center;
    background: var(
      --firefly-primary,
      var(--standard-accent, hsl(var(--theme-hue, 340) 72% 60%))
    );
    box-shadow: 0 0 8px color-mix(
      in oklch,
      var(--firefly-primary, var(--standard-accent, hsl(var(--theme-hue, 340) 72% 60%))) 60%,
      transparent
    );
    will-change: transform, opacity;
  }

  /* Mirror Firefly's Swup transition.css: motion belongs to the content node,
     never to the wallpaper / banner / standard-page-surface glass shell. */
  .transition-main {
    transition:
      opacity 120ms cubic-bezier(0.25, 0.46, 0.45, 0.94),
      transform 120ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .transition-leaving {
    transition:
      transform 120ms cubic-bezier(0.55, 0.055, 0.675, 0.19),
      opacity 120ms cubic-bezier(0.55, 0.055, 0.675, 0.19);
  }

  html.is-page-transitioning.is-page-leaving .transition-leaving {
    transform: translateY(-2rem);
    opacity: 0;
    will-change: transform, opacity;
  }

  html.is-page-transitioning.is-page-entering .transition-main {
    transform: translateY(2rem);
    opacity: 0;
    will-change: transform, opacity;
  }

  html[data-reduce-motion="true"] #page-transition-progress,
  html[data-reduce-motion="true"] .transition-main,
  html[data-reduce-motion="true"] .transition-leaving {
    animation: none !important;
    transition: none !important;
    transform: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    #page-transition-progress,
    .transition-main,
    .transition-leaving {
      animation: none !important;
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script is:inline>
(function () {
  var root = document.documentElement;
  var motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

  function motionReduced() {
    return root.dataset.reduceMotion === 'true' || motionQuery.matches;
  }

  function cancelAnimation(element) {
    if (!element || typeof element.getAnimations !== 'function') return;
    element.getAnimations().forEach(function (animation) {
      try { animation.cancel(); } catch (error) {}
    });
  }

  function startProgressBar() {
    var bar = document.getElementById('page-transition-progress');
    if (!bar || motionReduced()) return;
    cancelAnimation(bar);
    bar.animate(
      [
        { transform: 'scaleX(0)', opacity: 1 },
        { transform: 'scaleX(0.95)', opacity: 1 },
      ],
      {
        duration: 8000,
        easing: 'cubic-bezier(0.1, 0.05, 0.1, 1)',
        fill: 'forwards',
      },
    );
  }

  function finishProgressBar() {
    var bar = document.getElementById('page-transition-progress');
    if (!bar) return;
    cancelAnimation(bar);
    if (motionReduced()) {
      bar.style.opacity = '0';
      bar.style.transform = 'scaleX(0)';
      return;
    }
    bar.animate(
      [
        { transform: 'scaleX(1)', opacity: 1 },
        { transform: 'scaleX(1)', opacity: 0 },
      ],
      {
        duration: 500,
        easing: 'ease-out',
        fill: 'forwards',
      },
    );
  }

  function beginLeave() {
    root.classList.remove('is-page-entering');
    root.classList.add('is-page-transitioning', 'is-page-leaving');
  }

  function beginEnter() {
    root.classList.remove('is-page-leaving');
    root.classList.add('is-page-transitioning', 'is-page-entering');

    if (motionReduced()) {
      root.classList.remove('is-page-entering');
      return;
    }

    /* New content is swapped while the entering class is active, so it starts
       at Firefly's +2rem/opacity-0 state. Two frames ensure that state reaches
       the compositor before we remove it and let CSS transition to rest. */
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        root.classList.remove('is-page-entering');
      });
    });
  }

  function resetTransitionState() {
    root.classList.remove('is-page-transitioning', 'is-page-leaving', 'is-page-entering');
  }

  if (!window.__pageTransitionEnhancerBound) {
    window.__pageTransitionEnhancerBound = true;

    document.addEventListener('astro:before-preparation', function () {
      beginLeave();
      startProgressBar();
    });

    /* CSS can disable the pseudo-element animation, but Chromium has already
       captured a native page snapshot by this point. Explicitly skipping the
       ViewTransition prevents that rasterized backdrop-filter snapshot from
       ever becoming the visible transition frame. Astro still performs its
       normal SPA body swap and fires after-swap/page-load lifecycle events. */
    document.addEventListener('astro:before-swap', function (event) {
      if (event.viewTransition && typeof event.viewTransition.skipTransition === 'function') {
        event.viewTransition.skipTransition();
      }
    });

    document.addEventListener('astro:after-swap', function () {
      beginEnter();
      finishProgressBar();
    });

    document.addEventListener('astro:page-load', function () {
      window.setTimeout(resetTransitionState, 140);
    });
  }
})();
</script>