<section id="gallery-manager-overlay" class="gallery-manager-overlay" aria-labelledby="gallery-manager-title" hidden>
  <header class="gallery-manager-head">
    <div>
      <p class="gallery-eyebrow">Airi Gallery</p>
      <h2 id="gallery-manager-title">管理图库</h2>
      <p>管理功能由 Airi Gallery Cloud 提供，凭据不会进入 Blog。</p>
    </div>
    <button id="gallery-manager-close" type="button">返回图库</button>
  </header>

  <div class="gallery-manager-body">
    <div id="gallery-manager-loading" class="gallery-manager-status" role="status">正在打开管理界面…</div>
    <div id="gallery-manager-failure" class="gallery-manager-failure" hidden>
      <p>管理界面加载超时。你可以重试，或直接打开 Airi Gallery Cloud。</p>
      <div class="gallery-manager-actions">
        <button id="gallery-manager-retry" type="button">重新加载</button>
        <button id="gallery-manager-failure-close" type="button">关闭</button>
        <a
          id="gallery-manager-direct"
          href="https://airigallery.lidure22.xyz/"
          target="_blank"
          rel="noopener noreferrer"
        >直接打开 Cloud</a>
      </div>
    </div>
    <div id="gallery-manager-frame-host" class="gallery-manager-frame-host"></div>
  </div>
</section>

<script>
  import { initGalleryManager } from '../lib/gallery-manager-controller.mjs';

  const galleryWindow = window as any;

  function cleanupGalleryManager() {
    const root = document.getElementById('gallery-manager-overlay') as any;
    root?.__galleryManagerCleanup?.();
    if (root) root.__galleryManagerCleanup = null;
  }

  function mountGalleryManager() {
    const root = document.getElementById('gallery-manager-overlay') as any;
    if (!root) return;
    root.__galleryManagerCleanup?.();
    root.__galleryManagerCleanup = initGalleryManager(root);
  }

  if (!galleryWindow.__galleryManagerLifecycleBound) {
    galleryWindow.__galleryManagerLifecycleBound = true;
    document.addEventListener('astro:page-load', mountGalleryManager);
    document.addEventListener('astro:before-swap', cleanupGalleryManager);
  }

  mountGalleryManager();
</script>
