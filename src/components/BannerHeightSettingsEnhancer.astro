<script is:inline>
  (function restoreBannerHeightBeforePaint() {
    try {
      var raw = JSON.parse(localStorage.getItem('hero_settings') || '{}');
      var parsed = Number(raw.bannerHeight);
      var value = Number.isFinite(parsed) ? Math.max(45, Math.min(80, parsed)) : 65;
      document.documentElement.style.setProperty('--user-banner-height', value + 'vh');
      if (document.body) document.body.style.setProperty('--blog-banner-height', value + 'vh');
    } catch (_) {}
  })();
</script>

<script>
  type VisualBridge = {
    read?: () => { bannerHeight?: number };
    write?: (patch: { bannerHeight: number }) => { bannerHeight?: number };
  };

  const bannerHeightWindow = window as typeof window & {
    __lidureVisualSettings?: VisualBridge;
    __bannerHeightSettingsBound?: boolean;
  };

  const clampBannerHeight = (value: unknown) => {
    const parsed = Number(value);
    return Math.max(45, Math.min(80, Number.isFinite(parsed) ? parsed : 65));
  };

  function applyHeight(value: number) {
    const resolved = clampBannerHeight(value);
    document.documentElement.style.setProperty('--user-banner-height', `${resolved}vh`);
    document.body?.style.setProperty('--blog-banner-height', `${resolved}vh`);
    const input = document.getElementById('banner-height-range') as HTMLInputElement | null;
    const output = document.getElementById('banner-height-val');
    if (input) input.value = String(resolved);
    if (output) output.textContent = `${resolved}vh`;
  }

  function currentHeight() {
    const bridgeValue = bannerHeightWindow.__lidureVisualSettings?.read?.()?.bannerHeight;
    if (bridgeValue != null) return clampBannerHeight(bridgeValue);
    try {
      const raw = JSON.parse(localStorage.getItem('hero_settings') || '{}');
      return clampBannerHeight(raw.bannerHeight);
    } catch {
      return 65;
    }
  }

  function ensureControl() {
    const bannerCard = document.querySelector<HTMLElement>('.settings-card.mode-banner-only');
    if (!bannerCard) return;

    let input = document.getElementById('banner-height-range') as HTMLInputElement | null;
    if (!input) {
      const group = document.createElement('div');
      group.className = 'setting-group banner-height-setting';
      group.innerHTML = `
        <div class="setting-heading">
          <span class="setting-label">Banner 高度</span>
          <span class="range-value" id="banner-height-val">65vh</span>
        </div>
        <input type="range" id="banner-height-range" min="45" max="80" step="1" value="65" aria-label="Banner 高度" />
        <small class="banner-height-helper">仅横幅模式 · 45–80vh</small>
      `;
      const title = bannerCard.querySelector('.settings-card-title');
      if (title) title.insertAdjacentElement('afterend', group);
      else bannerCard.prepend(group);
      input = group.querySelector<HTMLInputElement>('#banner-height-range');

      input?.addEventListener('input', function () {
        const value = clampBannerHeight(this.value);
        applyHeight(value);
        bannerHeightWindow.__lidureVisualSettings?.write?.({ bannerHeight: value });
      });
    }

    const reset = document.getElementById('visual-reset-current');
    if (reset && reset.dataset.bannerHeightResetBound !== 'true') {
      reset.dataset.bannerHeightResetBound = 'true';
      reset.addEventListener('click', function () {
        const backgroundTab = document.getElementById('visual-tab-background');
        if (!backgroundTab?.classList.contains('is-active')) return;
        requestAnimationFrame(() => {
          applyHeight(65);
          bannerHeightWindow.__lidureVisualSettings?.write?.({ bannerHeight: 65 });
        });
      });
    }

    applyHeight(currentHeight());
  }

  if (!bannerHeightWindow.__bannerHeightSettingsBound) {
    bannerHeightWindow.__bannerHeightSettingsBound = true;
    document.addEventListener('lidure:visual-settings-change', (event) => {
      const detail = (event as CustomEvent<{ settings?: { bannerHeight?: number } }>).detail;
      if (detail?.settings?.bannerHeight != null) applyHeight(detail.settings.bannerHeight);
      ensureControl();
    });
    document.addEventListener('astro:page-load', ensureControl);
    document.addEventListener('DOMContentLoaded', ensureControl, { once: true });
  }

  ensureControl();
</script>

<style is:global>
  .banner-height-setting .banner-height-helper {
    display: block;
    margin-top: 6px;
    color: var(--standard-muted);
    font-size: 0.72rem;
  }
</style>
