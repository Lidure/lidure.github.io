---
import SidebarWidget from './SidebarWidget.astro';
import RecentMomentsWidget from './RecentMomentsWidget.astro';
import MusicStatusWidget from './MusicStatusWidget.astro';
import VisitorCounter from './VisitorCounter.astro';

interface TagItem {
  tag: string;
  count: number;
}

interface Props {
  topTags: TagItem[];
  postCount: number;
  tagCount: number;
}

const { topTags, postCount, tagCount } = Astro.props;
---

<aside class="home-right-sidebar" aria-label="站点动态与小组件">
  <SidebarWidget title="热门标签" icon="#" tone="cyan">
    <div class="popular-tag-list">
      {topTags.slice(0, 9).map((item, index) => (
        <a href={`/tags/${encodeURIComponent(item.tag)}`}>
          <span class="popular-tag-rank">{String(index + 1).padStart(2, '0')}</span>
          <span class="popular-tag-name">{item.tag}</span>
          <small>{item.count}</small>
        </a>
      ))}
    </div>
  </SidebarWidget>

  <SidebarWidget title="最近碎碎念" icon="✎" tone="pink">
    <RecentMomentsWidget />
  </SidebarWidget>

  <SidebarWidget title="音乐" icon="♫" tone="purple" className="music-widget-shell">
    <MusicStatusWidget />
  </SidebarWidget>

  <SidebarWidget title="站点统计" icon="◌" tone="warm">
    <div class="site-stat-summary">
      <span><strong>{postCount}</strong> 篇文章</span>
      <span><strong>{tagCount}</strong> 个标签</span>
    </div>
    <VisitorCounter />
  </SidebarWidget>

  <SidebarWidget title="小公告" icon="☀" tone="warm">
    <p class="sidebar-note">这里主要记录项目折腾、游戏、音乐和一些日常。背景和播放器都可以从右下角随时打开。</p>
  </SidebarWidget>
</aside>
