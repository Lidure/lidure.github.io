---
import '../styles/message-board.css';
import '../styles/message-board-palette.css';
import '../styles/message-board-stickers.css';
---

<section class="message-board" id="message-board-root" aria-labelledby="message-board-heading">
  <header class="message-board-toolbar">
    <div>
      <span class="message-board-kicker">COMMUNITY CORKBOARD</span>
      <h2 id="message-board-heading">大家的留言墙</h2>
      <p>每一张便签都会留在这面墙上。拖一拖、点一点，也可以贴下自己的话。</p>
    </div>
    <div class="message-board-toolbar-actions">
      <span class="message-board-count"><strong id="message-board-count">—</strong> 张便签</span>
      <button id="message-compose-open" type="button" class="message-board-primary">贴一张便签</button>
    </div>
  </header>

  <p id="message-board-status" class="message-board-status" aria-live="polite">正在看看墙上都贴了些什么…</p>

  <div class="message-board-scene">
    <div id="message-board-viewport" class="message-board-viewport">
      <div id="message-board-stage" class="message-board-stage" role="region" aria-label="公共留言板">
        <div class="message-board-loading">正在加载便签…</div>
      </div>
    </div>

    <div class="message-board-sticker-layer" aria-label="可拖动的留言墙装饰贴纸">
      <button
        type="button"
        class="message-board-sticker-button message-board-sticker message-board-sticker--dog"
        data-board-sticker="dog"
        data-default-x="0.845"
        data-default-y="0.045"
        aria-label="拖动或戳戳帕恰狗贴纸"
      >
        <img
          data-sticker-image
          src="https://www.pngmart.com/files/23/Pochacco-Download-PNG-Image.png"
          alt="帕恰狗"
          draggable="false"
          decoding="async"
          referrerpolicy="no-referrer"
        />
        <span class="message-board-sticker-caption" aria-hidden="true">可以拖我</span>
      </button>

      <button
        type="button"
        class="message-board-sticker-button message-board-sticker message-board-sticker--flower"
        data-board-sticker="flower"
        data-default-x="0.035"
        data-default-y="0.16"
        aria-label="拖动小花贴纸"
      >
        <img
          data-sticker-image
          src="https://cdn.jsdelivr.net/npm/openmoji@15.1.0/color/svg/1F33C.svg"
          alt="花朵贴纸"
          draggable="false"
          decoding="async"
        />
      </button>

      <button
        type="button"
        class="message-board-sticker-button message-board-sticker message-board-sticker--star"
        data-board-sticker="star"
        data-default-x="0.065"
        data-default-y="0.73"
        aria-label="拖动星星贴纸"
      >
        <img
          data-sticker-image
          src="https://cdn.jsdelivr.net/npm/openmoji@15.1.0/color/svg/2B50.svg"
          alt="星星贴纸"
          draggable="false"
          decoding="async"
        />
      </button>

      <button
        type="button"
        class="message-board-sticker-button message-board-sticker message-board-sticker--tape"
        data-board-sticker="tape"
        data-default-x="0.81"
        data-default-y="0.78"
        aria-label="拖动蝴蝶结贴纸"
      >
        <img
          data-sticker-image
          src="https://cdn.jsdelivr.net/npm/openmoji@15.1.0/color/svg/1F380.svg"
          alt="蝴蝶结贴纸"
          draggable="false"
          decoding="async"
        />
      </button>
    </div>
  </div>

  <div class="message-board-footer">
    <button id="message-board-load-older" type="button" class="message-board-secondary" hidden>加载更早的便签</button>
  </div>

  <div id="message-composer" class="message-composer-backdrop" hidden>
    <section class="message-composer" role="dialog" aria-modal="true" aria-labelledby="message-composer-title">
      <button type="button" class="message-surface-close" data-message-close="composer" aria-label="关闭写便签窗口">×</button>
      <span class="message-board-kicker">NEW NOTE</span>
      <h3 id="message-composer-title">贴一张便签</h3>
      <form id="message-composer-form">
        <label>你的 ID<input id="message-composer-user" name="userId" maxlength="32" required placeholder="例如：路过的旅人" /></label>
        <label>想说的话<textarea id="message-composer-text" name="text" maxlength="800" rows="6" required placeholder="写点什么…"></textarea></label>
        <fieldset class="message-color-picker">
          <legend>便签颜色</legend>
          <div id="message-color-options" class="message-color-options"></div>
        </fieldset>
        <p id="message-composer-status" class="message-inline-status" aria-live="polite"></p>
        <button id="message-composer-submit" type="submit" class="message-board-primary">贴到墙上</button>
      </form>
    </section>
  </div>

  <aside id="message-drawer" class="message-drawer" role="dialog" aria-modal="true" aria-labelledby="message-drawer-title" hidden>
    <button type="button" class="message-surface-close" data-message-close="drawer" aria-label="关闭便签详情">×</button>
    <div id="message-drawer-content">
      <h3 id="message-drawer-title">便签详情</h3>
    </div>
  </aside>

  <details id="message-admin" class="message-admin-panel">
    <summary>管理员</summary>
    <div class="message-admin-content">
      <span id="message-admin-status">未登录</span>
      <input id="message-admin-password" type="password" autocomplete="current-password" placeholder="管理员密码" />
      <button id="message-admin-login" type="button">登录</button>
      <button id="message-admin-logout" type="button" hidden>退出登录</button>
    </div>
  </details>
</section>

<script>
  import { initMessageBoard } from '../lib/message-board-controller';

  const w = window as typeof window & { __messageBoardCleanup?: () => void; __messageBoardBound?: boolean };
  const STICKER_STORAGE_KEY = 'message_board_sticker_positions_v2';
  const STICKER_DRAG_THRESHOLD = 6;

  type StoredStickerPosition = { x: number; y: number };
  type StickerPositionMap = Record<string, StoredStickerPosition>;

  function initMessageBoardStickers() {
    const root = document.getElementById('message-board-root');
    const scene = root?.querySelector<HTMLElement>('.message-board-scene');
    if (!root || !scene) return () => {};

    const controller = new AbortController();
    const { signal } = controller;
    const stickers = [...root.querySelectorAll<HTMLButtonElement>('[data-board-sticker]')];
    const dogMessages = ['汪～', '摸摸成功 ♡', '今天也要开心呀', '贴好便签再走吧'];
    const stickerMessages: Record<string, string[]> = {
      dog: dogMessages,
      flower: ['今天也要开花呀 ✿', '给你一朵小花'],
      star: ['叮——捡到一颗星星 ✦', '今天会有好运'],
      tape: ['装饰一下这里 ♡', '这里也要可可爱爱'],
    };
    let dogMessageIndex = Math.floor(Math.random() * dogMessages.length);

    function reducedMotionPreferred() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches
        || document.documentElement.dataset.reduceMotion === 'true';
    }

    function readStoredPositions(): StickerPositionMap {
      try {
        const raw = localStorage.getItem(STICKER_STORAGE_KEY);
        if (!raw) return {};
        const parsed = JSON.parse(raw) as StickerPositionMap;
        return parsed && typeof parsed === 'object' ? parsed : {};
      } catch {
        return {};
      }
    }

    function writeStoredPositions(positions: StickerPositionMap) {
      try {
        localStorage.setItem(STICKER_STORAGE_KEY, JSON.stringify(positions));
      } catch {
        // Decoration persistence is optional; dragging still works if storage is unavailable.
      }
    }

    let storedPositions = readStoredPositions();

    function clamp(value: number, min: number, max: number) {
      return Math.min(Math.max(value, min), Math.max(min, max));
    }

    function setStickerPosition(sticker: HTMLElement, normalizedX: number, normalizedY: number) {
      const rect = scene.getBoundingClientRect();
      const width = sticker.offsetWidth || 96;
      const height = sticker.offsetHeight || 96;
      const x = clamp(normalizedX * rect.width, 0, rect.width - width);
      const y = clamp(normalizedY * rect.height, 0, rect.height - height);
      sticker.style.setProperty('--sticker-x', `${x}px`);
      sticker.style.setProperty('--sticker-y', `${y}px`);
    }

    function applyStoredPositions() {
      stickers.forEach((sticker) => {
        const name = sticker.dataset.boardSticker || '';
        const saved = storedPositions[name];
        const defaultX = Number(sticker.dataset.defaultX) || 0;
        const defaultY = Number(sticker.dataset.defaultY) || 0;
        setStickerPosition(sticker, saved?.x ?? defaultX, saved?.y ?? defaultY);
      });
    }

    function persistStickerPosition(sticker: HTMLElement) {
      const name = sticker.dataset.boardSticker;
      if (!name) return;
      const sceneRect = scene.getBoundingClientRect();
      const stickerRect = sticker.getBoundingClientRect();
      storedPositions = {
        ...storedPositions,
        [name]: {
          x: clamp((stickerRect.left - sceneRect.left) / Math.max(1, sceneRect.width), 0, 1),
          y: clamp((stickerRect.top - sceneRect.top) / Math.max(1, sceneRect.height), 0, 1),
        },
      };
      writeStoredPositions(storedPositions);
    }

    function showStickerBubble(target: HTMLElement, text: string) {
      target.querySelectorAll('.message-board-sticker-bubble').forEach((node) => node.remove());
      const bubble = document.createElement('span');
      bubble.className = 'message-board-sticker-bubble';
      bubble.textContent = text;
      bubble.setAttribute('aria-hidden', 'true');
      target.appendChild(bubble);

      if (!reducedMotionPreferred()) {
        target.classList.remove('is-playing');
        void target.offsetWidth;
        target.classList.add('is-playing');
      }

      window.setTimeout(() => {
        bubble.remove();
        target.classList.remove('is-playing');
      }, reducedMotionPreferred() ? 800 : 1350);
    }

    function activateSticker(sticker: HTMLElement) {
      const name = sticker.dataset.boardSticker || '';
      const messages = stickerMessages[name] || ['贴纸被戳了一下'];
      let message = messages[Math.floor(Math.random() * messages.length)];
      if (name === 'dog') {
        message = dogMessages[dogMessageIndex % dogMessages.length];
        dogMessageIndex += 1;
      }
      showStickerBubble(sticker, message);
    }

    stickers.forEach((sticker) => {
      let pointerId = -1;
      let startClientX = 0;
      let startClientY = 0;
      let startX = 0;
      let startY = 0;
      let moved = false;

      sticker.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        const sceneRect = scene.getBoundingClientRect();
        const stickerRect = sticker.getBoundingClientRect();
        pointerId = event.pointerId;
        startClientX = event.clientX;
        startClientY = event.clientY;
        startX = stickerRect.left - sceneRect.left;
        startY = stickerRect.top - sceneRect.top;
        moved = false;
        sticker.classList.add('is-dragging');
        sticker.setPointerCapture(event.pointerId);
        event.preventDefault();
      }, { signal });

      sticker.addEventListener('pointermove', (event) => {
        if (event.pointerId !== pointerId || !sticker.hasPointerCapture(pointerId)) return;
        const sceneRect = scene.getBoundingClientRect();
        const dx = event.clientX - startClientX;
        const dy = event.clientY - startClientY;
        moved ||= Math.hypot(dx, dy) >= STICKER_DRAG_THRESHOLD;
        const x = clamp(startX + dx, 0, sceneRect.width - sticker.offsetWidth);
        const y = clamp(startY + dy, 0, sceneRect.height - sticker.offsetHeight);
        sticker.style.setProperty('--sticker-x', `${x}px`);
        sticker.style.setProperty('--sticker-y', `${y}px`);
        event.preventDefault();
      }, { signal });

      const finishDrag = (event: PointerEvent) => {
        if (event.pointerId !== pointerId) return;
        if (sticker.hasPointerCapture(pointerId)) sticker.releasePointerCapture(pointerId);
        sticker.classList.remove('is-dragging');
        persistStickerPosition(sticker);
        if (!moved) activateSticker(sticker);
        pointerId = -1;
      };

      sticker.addEventListener('pointerup', finishDrag, { signal });
      sticker.addEventListener('pointercancel', finishDrag, { signal });
      sticker.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          activateSticker(sticker);
        }
      }, { signal });
    });

    const resizeObserver = new ResizeObserver(applyStoredPositions);
    resizeObserver.observe(scene);
    requestAnimationFrame(applyStoredPositions);

    return () => {
      controller.abort();
      resizeObserver.disconnect();
    };
  }

  function mount() {
    w.__messageBoardCleanup?.();

    const boardRoot = document.getElementById('message-board-root');
    const composer = document.getElementById('message-composer');
    const drawer = document.getElementById('message-drawer');
    const cleanupController = initMessageBoard();
    const cleanupStickers = initMessageBoardStickers();

    if (composer && composer.parentElement !== document.body) document.body.appendChild(composer);
    if (drawer && drawer.parentElement !== document.body) document.body.appendChild(drawer);

    w.__messageBoardCleanup = () => {
      cleanupStickers();
      cleanupController();
      if (boardRoot?.isConnected) {
        if (composer) boardRoot.appendChild(composer);
        if (drawer) boardRoot.appendChild(drawer);
      } else {
        composer?.remove();
        drawer?.remove();
      }
    };
  }
  if (!w.__messageBoardBound) {
    w.__messageBoardBound = true;
    document.addEventListener('astro:page-load', mount);
    document.addEventListener('astro:before-swap', () => w.__messageBoardCleanup?.());
  }
  mount();
</script>
