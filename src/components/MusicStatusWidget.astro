<div class="music-status-widget" id="home-music-status" aria-label="SEKAI 播放器快捷控制">
  <div class="music-status-art">
    <button class="music-status-cover-open" id="home-music-open" type="button" aria-label="打开 SEKAI 播放器">
      <img data-music-cover src="/assets/music/default-cover.webp" alt="默认音乐封面" />
      <span class="music-status-cover-fallback" data-music-fallback aria-hidden="true">♪</span>
      <span class="music-status-cover-shade" aria-hidden="true"></span>
    </button>
    <button
      id="home-music-play-pause"
      class="music-status-play-overlay"
      type="button"
      aria-label="播放"
      title="播放"
    >▶</button>
  </div>

  <div class="music-status-track">
    <small class="music-status-state" data-music-state>音乐待机</small>
    <strong class="music-status-track-title" data-music-title>SEKAI Player</strong>
    <span class="music-status-track-artist" data-music-artist>点击封面打开播放器</span>
  </div>

  <div class="music-status-controls" aria-label="音乐快捷控制">
    <button id="home-music-prev" class="music-status-control" type="button" aria-label="上一首" title="上一首">
      <span aria-hidden="true">‹</span>
      <small>上一首</small>
    </button>
    <button id="home-music-next" class="music-status-control" type="button" aria-label="下一首" title="下一首">
      <small>下一首</small>
      <span aria-hidden="true">›</span>
    </button>
  </div>
</div>

<style is:global>
  body.layout-standard .sidebar-widget .music-status-widget {
    display: grid;
    grid-template-columns: 1fr;
    gap: 11px;
    width: 100%;
    cursor: default;
  }

  body.layout-standard .music-status-art {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    isolation: isolate;
    border-radius: 22px;
    background:
      radial-gradient(circle at 24% 18%, color-mix(in srgb, var(--standard-purple) 24%, transparent), transparent 44%),
      linear-gradient(145deg, var(--standard-purple-soft), var(--standard-accent-soft));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--standard-line) 78%, transparent);
  }

  body.layout-standard .music-status-art::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    padding: 3px;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    background: conic-gradient(
      from 12deg,
      hsl(var(--theme-hue, 340) 88% 68%),
      #78d9ff 21%,
      #a88cff 43%,
      #ff8fbd 64%,
      #ffd37a 82%,
      hsl(var(--theme-hue, 340) 88% 68%)
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    filter: saturate(1.08);
    transition: opacity 220ms ease;
  }

  body.layout-standard .music-status-widget.is-playing .music-status-art::before {
    opacity: 1;
    animation: music-cover-flow 4.8s linear infinite;
  }

  body.layout-standard .music-status-widget.is-playing .music-status-art {
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--standard-line) 56%, transparent),
      0 0 22px color-mix(in srgb, hsl(var(--theme-hue, 340) 88% 66%) 18%, transparent);
  }

  @keyframes music-cover-flow {
    from { filter: hue-rotate(0deg) saturate(1.08); }
    to { filter: hue-rotate(360deg) saturate(1.08); }
  }

  body.layout-standard .music-status-cover-open {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: inherit;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  body.layout-standard .music-status-cover-open img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 220ms ease, filter 220ms ease;
  }

  body.layout-standard .music-status-cover-open:hover img {
    transform: scale(1.018);
    filter: saturate(1.04);
  }

  body.layout-standard .music-status-cover-fallback {
    position: absolute;
    inset: 0;
    display: none;
    place-items: center;
    color: color-mix(in srgb, var(--standard-purple) 80%, var(--standard-text));
    font-size: clamp(3.6rem, 8vw, 5.4rem);
    font-weight: 800;
    opacity: 0.72;
  }

  body.layout-standard .music-status-cover-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 54%, rgba(6, 7, 14, 0.2));
  }

  body.layout-standard .music-status-play-overlay {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 4;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    padding: 0 0 0 3px;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(255, 255, 255, 0.36);
    border-radius: 50%;
    background: rgba(13, 14, 24, 0.56);
    color: #fff;
    box-shadow: 0 10px 30px rgba(5, 6, 14, 0.24);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font: 800 1rem/1 system-ui, sans-serif;
    cursor: pointer;
    transition: opacity 160ms ease, transform 160ms ease, background 160ms ease, border-color 160ms ease;
  }

  body.layout-standard .music-status-play-overlay:hover {
    transform: translate(-50%, -50%) scale(1.06);
    border-color: rgba(255, 255, 255, 0.58);
    background: color-mix(in srgb, var(--standard-purple) 58%, rgba(13, 14, 24, 0.62));
  }

  body.layout-standard .music-status-widget.is-playing .music-status-play-overlay {
    padding-left: 0;
    background: color-mix(in srgb, var(--standard-cyan) 48%, rgba(13, 14, 24, 0.62));
  }

  @media (hover: hover) and (pointer: fine) {
    body.layout-standard .music-status-play-overlay {
      opacity: 0;
      pointer-events: none;
      transform: translate(-50%, -50%) scale(0.92);
    }

    body.layout-standard .music-status-art:hover .music-status-play-overlay,
    body.layout-standard .music-status-art:focus-within .music-status-play-overlay {
      opacity: 1;
      pointer-events: auto;
      transform: translate(-50%, -50%) scale(1);
    }

    body.layout-standard .music-status-art:hover .music-status-play-overlay:hover,
    body.layout-standard .music-status-art:focus-within .music-status-play-overlay:hover {
      transform: translate(-50%, -50%) scale(1.06);
    }
  }

  body.layout-standard .music-status-track {
    min-width: 0;
    display: grid;
    gap: 3px;
    padding: 0 2px;
  }

  body.layout-standard .music-status-state {
    color: var(--standard-purple);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  body.layout-standard .music-status-track-title,
  body.layout-standard .music-status-track-artist {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  body.layout-standard .music-status-track-title {
    color: var(--standard-text);
    font-size: 0.88rem;
    line-height: 1.45;
  }

  body.layout-standard .music-status-track-artist {
    color: var(--standard-muted);
    font-size: 0.69rem;
    line-height: 1.45;
  }

  body.layout-standard .music-status-controls {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    padding-top: 9px;
    border-top: 1px solid var(--standard-line);
  }

  body.layout-standard .music-status-control {
    min-width: 0;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: 1px solid color-mix(in srgb, var(--standard-purple) 16%, var(--standard-line));
    border-radius: 9px;
    background: color-mix(in srgb, var(--standard-purple-soft) 72%, transparent);
    color: var(--standard-purple);
    font: inherit;
    line-height: 1;
    cursor: pointer;
    transition: transform 160ms ease, border-color 160ms ease, background 160ms ease, color 160ms ease;
  }

  body.layout-standard .music-status-control span {
    font-size: 1.15rem;
  }

  body.layout-standard .music-status-control small {
    font-size: 0.66rem;
    font-weight: 700;
  }

  body.layout-standard .music-status-control:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--standard-purple) 40%, var(--standard-line));
    background: color-mix(in srgb, var(--standard-purple-soft) 84%, var(--standard-card-bg));
  }

  body.layout-standard .music-status-cover-open:focus-visible,
  body.layout-standard .music-status-play-overlay:focus-visible,
  body.layout-standard .music-status-control:focus-visible {
    outline: 2px solid var(--standard-purple);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    body.layout-standard .music-status-cover-open img,
    body.layout-standard .music-status-play-overlay,
    body.layout-standard .music-status-control { transition: none; }
    body.layout-standard .music-status-cover-open:hover img { transform: none; }
    body.layout-standard .music-status-play-overlay:hover { transform: translate(-50%, -50%); }
    body.layout-standard .music-status-control:hover { transform: none; }
    body.layout-standard .music-status-widget.is-playing .music-status-art::before { animation: none; }
  }

  html[data-reduce-motion="true"] body.layout-standard .music-status-cover-open img,
  html[data-reduce-motion="true"] body.layout-standard .music-status-play-overlay,
  html[data-reduce-motion="true"] body.layout-standard .music-status-control { transition: none; }
  html[data-reduce-motion="true"] body.layout-standard .music-status-cover-open:hover img { transform: none; }
  html[data-reduce-motion="true"] body.layout-standard .music-status-play-overlay:hover { transform: translate(-50%, -50%); }
  html[data-reduce-motion="true"] body.layout-standard .music-status-control:hover { transform: none; }
  html[data-reduce-motion="true"] body.layout-standard .music-status-widget.is-playing .music-status-art::before { animation: none; }

  @media (max-width: 760px) {
    body.layout-standard .music-status-art {
      max-height: min(72vw, 360px);
    }

    body.layout-standard .music-status-play-overlay {
      width: 54px;
      height: 54px;
    }
  }
</style>

<script is:inline>
(function () {
  var DEFAULT_MUSIC_COVER = '/assets/music/default-cover.webp';

  function cleanupMusicStatus() {
    if (window.__homeMusicStatusObserver) {
      window.__homeMusicStatusObserver.disconnect();
      window.__homeMusicStatusObserver = null;
    }
    var audio = window.__homeMusicStatusAudio;
    var handler = window.__homeMusicStatusAudioHandler;
    if (audio && handler) {
      ['play', 'pause', 'loadedmetadata', 'emptied'].forEach(function (eventName) {
        audio.removeEventListener(eventName, handler);
      });
    }
    window.__homeMusicStatusAudio = null;
    window.__homeMusicStatusAudioHandler = null;
  }

  function initMusicStatus() {
    var root = document.getElementById('home-music-status');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    cleanupMusicStatus();

    var open = document.getElementById('home-music-open');
    var prev = document.getElementById('home-music-prev');
    var playPause = document.getElementById('home-music-play-pause');
    var next = document.getElementById('home-music-next');
    var state = root.querySelector('[data-music-state]');
    var title = root.querySelector('[data-music-title]');
    var artist = root.querySelector('[data-music-artist]');
    var cover = root.querySelector('[data-music-cover]');
    var fallback = root.querySelector('[data-music-fallback]');
    var audio = document.getElementById('sekaiAudio');

    function showCover(src) {
      if (!cover) return;
      var nextSrc = src || DEFAULT_MUSIC_COVER;
      if (cover.getAttribute('src') !== nextSrc) cover.setAttribute('src', nextSrc);
      cover.style.display = 'block';
      if (fallback) fallback.style.display = 'none';
    }

    function sync() {
      var sourceTitle = document.getElementById('sekaiTrackTitle');
      var sourceArtist = document.getElementById('sekaiTrackArtist');
      var sourceCover = document.getElementById('sekaiDockCover') || document.getElementById('sekaiCover');
      var currentTitle = sourceTitle && sourceTitle.textContent ? sourceTitle.textContent.trim() : '';
      var currentArtist = sourceArtist && sourceArtist.textContent ? sourceArtist.textContent.trim() : '';
      var hasTrack = currentTitle && currentTitle !== '选择一首歌曲';

      if (title) title.textContent = hasTrack ? currentTitle : 'SEKAI Player';
      if (artist) artist.textContent = hasTrack ? (currentArtist || '未知艺术家') : '点击封面打开播放器';
      if (state) state.textContent = audio && audio.src && !audio.paused ? '正在播放' : (hasTrack ? '已暂停' : '音乐待机');
      root.classList.toggle('is-playing', !!(audio && audio.src && !audio.paused));
      if (playPause) {
        playPause.textContent = audio && audio.src ? (audio.paused ? '▶' : '❚❚') : '▶';
        playPause.title = audio && audio.src && !audio.paused ? '暂停' : '播放';
        playPause.setAttribute('aria-label', playPause.title);
      }

      var coverSrc = sourceCover && (sourceCover.currentSrc || sourceCover.src) ? (sourceCover.currentSrc || sourceCover.src) : '';
      showCover(coverSrc || DEFAULT_MUSIC_COVER);
    }

    if (cover) {
      cover.addEventListener('error', function () {
        var currentSrc = cover.getAttribute('src') || '';
        if (currentSrc !== DEFAULT_MUSIC_COVER) showCover(DEFAULT_MUSIC_COVER);
      });
    }

    open?.addEventListener('click', function () {
      window.__sekaiOpenPlayer?.();
    });

    prev?.addEventListener('click', function () {
      var target = document.getElementById('sekaiPrevBtn');
      if (target) target.click();
    });

    playPause?.addEventListener('click', function () {
      var target = document.getElementById('sekaiPlayPauseBtn');
      if (target) target.click();
    });

    next?.addEventListener('click', function () {
      var target = document.getElementById('sekaiNextBtn');
      if (target) target.click();
    });

    var observer = new MutationObserver(sync);
    ['sekaiTrackTitle', 'sekaiTrackArtist', 'sekaiDockCover', 'sekaiCover'].forEach(function (id) {
      var element = document.getElementById(id);
      if (element) observer.observe(element, { subtree: true, childList: true, characterData: true, attributes: true, attributeFilter: ['src'] });
    });
    window.__homeMusicStatusObserver = observer;

    if (audio) {
      ['play', 'pause', 'loadedmetadata', 'emptied'].forEach(function (eventName) {
        audio.addEventListener(eventName, sync);
      });
      window.__homeMusicStatusAudio = audio;
      window.__homeMusicStatusAudioHandler = sync;
    }

    sync();
  }

  if (!window.__homeMusicStatusPageLoadBound) {
    window.__homeMusicStatusPageLoadBound = true;
    document.addEventListener('astro:page-load', initMusicStatus);
    document.addEventListener('astro:before-swap', cleanupMusicStatus);
  }
  initMusicStatus();
})();
</script>