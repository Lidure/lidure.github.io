---
/**
 * HeroSlideshow — Homepage background slideshow with settings panel
 *
 * HOW TO ADD DEFAULT IMAGES (always available):
 *   Add paths or URLs to the defaultImages array below.
 *
 * Examples:
 *   '/hero1.jpg'                        → public/hero1.jpg
 *   '/images/bg.png'                    → public/images/bg.png
 *   'https://example.com/wallpaper.jpg' → online URL
 *   '/hero.mp4'                         → public/hero.mp4 (video)
 */
const defaultImages: string[] = [
  // 填入 R2 图床 URL，例如：
  'https://pub-6108779417b647c592c51538e44c8bd0.r2.dev/%E8%83%8C%E6%99%AF%E5%9B%BE/953c5e02532e4eeb9ec758e7fd7e8ad3.jpg',
  'https://pub-6108779417b647c592c51538e44c8bd0.r2.dev/%E8%83%8C%E6%99%AF%E5%9B%BE/miku_star.mp4',
  'https://pub-6108779417b647c592c51538e44c8bd0.r2.dev/%E8%83%8C%E6%99%AF%E5%9B%BE/1b87e2c5880511ebb6edd017c2d2eca2.png',
  'https://pub-6108779417b647c592c51538e44c8bd0.r2.dev/%E8%83%8C%E6%99%AF%E5%9B%BE/wallhaven-1p9z61.jpg',
  'https://pub-6108779417b647c592c51538e44c8bd0.r2.dev/%E8%83%8C%E6%99%AF%E5%9B%BE/25_1(1).png',
  'https://pub-6108779417b647c592c51538e44c8bd0.r2.dev/%E8%83%8C%E6%99%AF%E5%9B%BE/25_2.jpg',
  'https://pub-6108779417b647c592c51538e44c8bd0.r2.dev/%E8%83%8C%E6%99%AF%E5%9B%BE/shizuku.jpg',
  'https://pub-6108779417b647c592c51538e44c8bd0.r2.dev/%E8%83%8C%E6%99%AF%E5%9B%BE/B292469EBE40CB0DE50A866C73C61F81.jpg',
  'https://pub-6108779417b647c592c51538e44c8bd0.r2.dev/%E8%83%8C%E6%99%AF%E5%9B%BE/miku_ying1.mp4',
  'https://pub-6108779417b647c592c51538e44c8bd0.r2.dev/%E8%83%8C%E6%99%AF%E5%9B%BE/3dmiku1.mp4',
  'https://pub-6108779417b647c592c51538e44c8bd0.r2.dev/%E8%83%8C%E6%99%AF%E5%9B%BE/snow.mp4',
  'https://pub-6108779417b647c592c51538e44c8bd0.r2.dev/%E8%83%8C%E6%99%AF%E5%9B%BE/output.mp4'
];

const DEFAULT_INTERVAL = 15000;
const DEFAULT_OPACITY = 0.45;
---

<div
  class="hero-slideshow"
  id="hero-slideshow"
  transition:persist
  data-defaults={JSON.stringify(defaultImages)}
  data-default-interval={String(DEFAULT_INTERVAL)}
  data-default-opacity={String(DEFAULT_OPACITY)}
>
  <div class="slideshow-layer" aria-hidden="true"></div>
  <canvas class="slideshow-canvas" aria-hidden="true"></canvas>
  <video class="slideshow-video" id="slideshowVideo" data-persistent-media muted loop playsinline webkit-playsinline preload="metadata" aria-hidden="true" tabindex="-1" disablepictureinpicture disableRemotePlayback></video>
  <div class="slideshow-overlay" aria-hidden="true"></div>
</div>

<div class="media-panel" id="media-panel" transition:persist>
  <div class="media-panel-inner">
    <div class="media-panel-header">
      <button class="media-panel-back" id="media-panel-back" type="button" aria-label="返回">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <span class="media-panel-title">背景库</span>
      <button class="media-panel-add" id="media-panel-add" type="button" aria-label="添加">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      </button>
    </div>
    <div class="media-panel-body" id="media-panel-body">
      <div class="media-panel-empty">暂无媒体，点击右上角 + 添加</div>
    </div>
  </div>
</div>

<div class="media-preview" id="media-preview" transition:persist aria-hidden="true">
  <button class="media-preview-close" id="media-preview-close" type="button" aria-label="关闭">&times;</button>
  <div class="media-preview-stage" id="media-preview-stage">
    <img class="media-preview-img" id="media-preview-img" src="" alt="" />
    <video class="media-preview-video" id="media-preview-video" data-page-media src="" muted loop playsinline webkit-playsinline controls controlslist="nodownload noplaybackrate noremoteplayback" disablepictureinpicture disableRemotePlayback></video>
  </div>
</div>

<style>
  /* ===== Slideshow Container ===== */
  .hero-slideshow {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .slideshow-layer {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity 1.5s ease-in-out;
  }

  .slideshow-layer.visible {
    opacity: 1;
  }

  .slideshow-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.5s ease-in-out;
    z-index: 1;
    pointer-events: none;
  }

  .slideshow-canvas.visible {
    opacity: 1;
  }

  .poster-needed-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 24px;
    color: rgba(255, 255, 255, 0.86);
    text-align: center;
    background:
      radial-gradient(circle at 30% 30%, rgba(117, 135, 255, 0.28), transparent 34%),
      linear-gradient(135deg, rgba(20, 24, 42, 0.82), rgba(5, 8, 18, 0.92));
    opacity: 0;
    transition: opacity 1.5s ease-in-out;
    pointer-events: none;
    z-index: 1;
  }

  .poster-needed-placeholder.visible {
    opacity: 1;
  }

  .slideshow-video {
    position: absolute;
    width: 1px;
    height: 1px;
    left: -9999px;
    top: -9999px;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none;
    z-index: -1;
  }

  .slideshow-video.visible {
    opacity: 0 !important;
    visibility: hidden !important;
  }

  .slideshow-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, var(--slideshow-overlay, 0.45)) 0%,
      rgba(0, 0, 0, calc(var(--slideshow-overlay, 0.45) + 0.12)) 50%,
      rgba(0, 0, 0, calc(var(--slideshow-overlay, 0.45) + 0.22)) 100%
    );
    pointer-events: none;
    z-index: 2;
  }

  /* --- Media Panel (centered dialog) --- */
  .media-panel {
    position: fixed;
    inset: 0;
    z-index: 10001;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    animation: media-panel-in 0.25s ease;
  }

  .media-panel.open {
    display: flex;
  }

  .media-panel-inner {
    width: 90vw;
    max-width: 800px;
    height: 75vh;
    max-height: 600px;
    background: rgba(14, 12, 26, 0.45);
    backdrop-filter: blur(30px) saturate(1.4);
    -webkit-backdrop-filter: blur(30px) saturate(1.4);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5);
  }

  [data-theme="light"] .media-panel-inner {
    background: rgba(255, 240, 248, 0.45);
    border-color: rgba(200, 80, 150, 0.2);
  }

  .media-panel.open {
    display: flex;
  }

  @keyframes media-panel-in {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .media-panel-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
    flex-shrink: 0;
  }

  [data-theme="light"] .media-panel-header {
    border-bottom-color: rgba(200, 80, 150, 0.12);
    background: rgba(255, 255, 255, 0.15);
  }

  .media-panel-back {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.1);
    color: var(--text);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 200ms, border-color 200ms;
    flex-shrink: 0;
  }

  [data-theme="light"] .media-panel-back {
    border-color: rgba(200, 80, 150, 0.25);
    background: rgba(255, 255, 255, 0.35);
  }

  .media-panel-back:hover {
    border-color: var(--accent);
    background: rgba(var(--accent-rgb), 0.08);
  }

  .media-panel-back svg {
    width: 18px;
    height: 18px;
  }

  .media-panel-title {
    flex: 1;
    font-weight: 700;
    font-size: 1rem;
    color: var(--text);
  }

  .media-panel-add {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: linear-gradient(135deg, var(--accent), var(--accent-3));
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 200ms, box-shadow 200ms;
    flex-shrink: 0;
  }

  .media-panel-add:hover {
    transform: scale(1.08);
    box-shadow: 0 4px 16px rgba(var(--accent-rgb), 0.35);
  }

  .media-panel-add:active {
    transform: scale(0.95);
  }

  .media-panel-add svg {
    width: 18px;
    height: 18px;
  }

  .media-panel-body {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 24px;
  }

  .media-panel-empty {
    color: var(--muted);
    font-size: 0.9rem;
    text-align: center;
    padding: 60px 20px;
  }

  :global(.media-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
    width: 100%;
    overflow: visible;
  }

  :global(.media-card) {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.15);
    cursor: pointer;
    min-width: 0;
    min-height: 0;
    transition: border-color 200ms, transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 200ms;
  }

  [data-theme="light"] :global(.media-card) {
    border-color: rgba(200, 80, 150, 0.15);
  }

  :global(.media-card:hover) {
    border-color: transparent;
    transform: scale(1.2);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    z-index: 10;
  }

  :global(.media-card.active) {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.3);
  }

  :global(.media-card img),
  :global(.media-card video),
  :global(.media-card canvas) {
    width: 100%;
    aspect-ratio: 16 / 9;
    display: block;
    object-fit: cover;
    background: rgba(0, 0, 0, 0.35);
  }

  :global(.media-card .poster-needed-placeholder) {
    position: absolute;
    font-size: 0.72rem;
    line-height: 1.4;
  }

  :global(.media-card-poster:not([src])),
  :global(.media-card-poster.is-loading) {
    min-height: 112px;
  }

  :global(.media-card video.media-card-poster) {
    pointer-events: none;
  }

  :global(.media-card-video-mark) {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 38px;
    height: 38px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.48);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    backdrop-filter: blur(4px);
  }

  :global(.media-card-video-mark svg) {
    width: 18px;
    height: 18px;
    margin-left: 2px;
  }

  :global(.media-card-default) {
    position: absolute;
    top: 6px;
    left: 6px;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 700;
    backdrop-filter: blur(4px);
  }

  :global(.media-card-del) {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: none;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    opacity: 0;
    transition: opacity 200ms, background 200ms;
    backdrop-filter: blur(4px);
  }

  :global(.media-card:hover .media-card-del) {
    opacity: 1;
  }

  @media (hover: none) {
    :global(.media-card-del),
    :global(.media-card-preview) {
      opacity: 0.8;
      min-width: 32px;
      min-height: 32px;
      width: 32px;
      height: 32px;
    }
  }

  :global(.media-card:hover .media-card-preview) {
    opacity: 1;
  }

  :global(.media-card-del:hover) {
    background: rgba(255, 68, 102, 0.8);
  }

  :global(.media-card-preview) {
    position: absolute;
    bottom: 6px;
    right: 6px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: none;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 200ms, background 200ms;
    backdrop-filter: blur(4px);
  }

  :global(.media-card-preview:hover) {
    background: rgba(var(--accent-rgb), 0.7);
  }

  :global(.media-card-preview svg) {
    width: 14px;
    height: 14px;
  }

  /* --- Media Preview Lightbox --- */
  .media-preview {
    position: fixed;
    inset: 0;
    z-index: 10002;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.82);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    animation: preview-in 0.25s ease;
  }

  .media-preview.open {
    display: flex;
  }

  @keyframes preview-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .media-preview-close {
    position: absolute;
    top: 20px;
    right: 24px;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    font-size: 1.6rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 200ms, transform 200ms;
  }

  .media-preview-close:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: scale(1.08);
  }

  .media-preview-stage {
    max-width: 90vw;
    max-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .media-preview-img {
    max-width: 90vw;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  .media-preview-video {
    max-width: 90vw;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  /* ===== Responsive ===== */
  @media (max-width: 720px) {
    .hero-settings-btn {
      left: 16px;
      top: 80px;
      width: 38px;
      height: 38px;
    }

    .hero-settings-btn svg {
      width: 16px;
      height: 16px;
    }

    .hero-settings-panel {
      left: 12px;
      right: 12px;
      top: 126px;
      width: auto;
      max-height: calc(100vh - 150px);
    }
  }

  @media (max-width: 480px) {
    .hero-settings-btn {
      left: 12px;
      top: 76px;
      width: 34px;
      height: 34px;
    }

    .hero-settings-btn svg {
      width: 14px;
      height: 14px;
    }

    .hero-settings-panel {
      left: 8px;
      right: 8px;
      top: 118px;
      width: auto;
      max-height: calc(100vh - 130px);
      border-radius: var(--radius-md);
    }

    .settings-close {
      width: 40px;
      height: 40px;
    }

    .settings-close svg {
      width: 18px;
      height: 18px;
    }

    :global(.media-grid) {
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 8px;
    }

    .url-add-btn {
      padding: 10px 16px;
      min-height: 40px;
    }

    .media-panel-body {
      padding: 10px;
    }
  }

  /* ===== Reduced motion ===== */
  @media (prefers-reduced-motion: reduce) {
    .slideshow-layer {
      transition: none !important;
    }

    .slideshow-video {
      transition: none !important;
    }

    .hero-settings-panel {
      animation: none !important;
    }
  }
</style>

<script>
// @ts-nocheck
(function () {
  // ===== Module-level cleanup state =====
  var _timer = null;
  var _destroyed = false;
  var _pageHandler = null;
  var _heroLifecycleController = null;

  function cleanup() {
    if (_timer) { clearTimeout(_timer); _timer = null; }
    if (_pageHandler) {
      document.removeEventListener('astro:page-load', _pageHandler);
      _pageHandler = null;
    }
    // Pause the slideshow video (it's persisted, so don't remove it)
    var sv = document.getElementById('slideshowVideo');
    if (sv) { sv.pause(); sv.src = ''; sv.classList.remove('visible'); }
    _destroyed = true;
  }

  function initHeroSlideshow() {
    // ===== Query persistent DOM elements =====
    var container = document.getElementById('hero-slideshow');
    var settingsBtn = document.getElementById('hero-settings-btn');
    var settingsPanel = document.getElementById('hero-settings-panel');
    var closeBtn = document.getElementById('settings-close');
    var toggleEnabled = document.getElementById('toggle-enabled');
    var toggleAutoplay = document.getElementById('toggle-autoplay');
    var toggleSakura = document.getElementById('toggle-sakura');
    var intervalRange = document.getElementById('interval-range');
    var intervalVal = document.getElementById('interval-val');
    var opacityRange = document.getElementById('opacity-range');
    var opacityVal = document.getElementById('opacity-val');
    var qualitySelect = document.getElementById('quality-select');
    var uploadZone = document.getElementById('upload-zone');
    var fileInput = document.getElementById('file-input');
    var urlInput = document.getElementById('url-input');
    var urlAddBtn = document.getElementById('url-add-btn');
    var mediaManageBtn = document.getElementById('media-manage-btn');
    var mediaCount = document.getElementById('media-count');
    var mediaPanel = document.getElementById('media-panel');
    var mediaPanelBack = document.getElementById('media-panel-back');
    var mediaPanelAdd = document.getElementById('media-panel-add');
    var mediaPanelBody = document.getElementById('media-panel-body');
    var mediaPreview = document.getElementById('media-preview');
    var mediaPreviewClose = document.getElementById('media-preview-close');
    var mediaPreviewImg = document.getElementById('media-preview-img');
    var mediaPreviewVideo = document.getElementById('media-preview-video');
    hardenPreviewVideo(mediaPreviewVideo);

    if (!container || !settingsBtn) return;

    function hardenBackgroundVideo(el) {
      if (!el) return;
      el.muted = true;
      el.defaultMuted = true;
      el.loop = true;
      el.autoplay = false;
      el.controls = false;
      el.playsInline = true;
      el.preload = 'metadata';
      // Do not force CORS on the playback element. The video can still play
      // when the storage response lacks ACAO; only canvas poster capture needs it.
      el.tabIndex = -1;
      el.setAttribute('muted', '');
      el.setAttribute('playsinline', '');
      el.setAttribute('webkit-playsinline', '');
      el.setAttribute('aria-hidden', 'true');
      el.setAttribute('data-persistent-media', '');
      el.setAttribute('disablepictureinpicture', '');
      el.setAttribute('disableremoteplayback', '');
      try { el.disablePictureInPicture = true; } catch (err) {}
      try { el.disableRemotePlayback = true; } catch (err) {}
    }

    function hardenPreviewVideo(el) {
      if (!el) return;
      el.muted = true;
      el.loop = true;
      el.playsInline = true;
      el.preload = 'metadata';
      // Preview playback also works without canvas-readable CORS headers.
      el.setAttribute('playsinline', '');
      el.setAttribute('webkit-playsinline', '');
      el.setAttribute('data-page-media', '');
      el.setAttribute('controlslist', 'nodownload noplaybackrate noremoteplayback');
      el.setAttribute('disablepictureinpicture', '');
      el.setAttribute('disableremoteplayback', '');
      try { el.disablePictureInPicture = true; } catch (err) {}
      try { el.disableRemotePlayback = true; } catch (err) {}
    }

    function isMobileVideoHostile() {
      var coarsePointer = window.matchMedia && window.matchMedia('(hover: none), (pointer: coarse), (max-width: 760px)').matches;
      var mobileUA = /Android|iPhone|iPad|iPod|Mobile|MicroMessenger|MQQBrowser|UCBrowser|Quark|HuaweiBrowser|MiuiBrowser/i.test(navigator.userAgent || '');
      return Boolean(coarsePointer || mobileUA);
    }
    // ===== Element-level guard (same pattern as theme toggle fix) =====
    // Prevents double-initialization when astro:page-load fires on first load
    if (container.dataset.heroSlideshowInitialized === '1') {
      // Lightweight reinit: just restart slideshow on page navigation return
      _destroyed = false;
      var savedState = null;
      try {
        var s = localStorage.getItem('hero_settings');
        if (s) savedState = JSON.parse(s);
      } catch (e) {}
      if (savedState && savedState.enabled !== false) {
        var overlayVal = savedState.opacity != null ? savedState.opacity : 0.45;
        document.documentElement.style.setProperty('--slideshow-overlay', String(overlayVal));
      }
      return;
    }
    container.dataset.heroSlideshowInitialized = '1';

    // ===== Full initialization =====
    cleanup();
    _destroyed = false;

    var defaults = JSON.parse(container.dataset.defaults || '[]');
