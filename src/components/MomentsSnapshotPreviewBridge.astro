<script>
  const snapshotWindow = window as typeof window & {
    __momentsSnapshotPreviewBound?: boolean;
  };

  function openSnapshotFromSideRail(event: MouseEvent) {
    const target = event.target as Element | null;
    const button = target?.closest<HTMLButtonElement>('.moments-side-photo');
    if (!button) return;

    const gallery = button.closest<HTMLElement>('.moments-side-gallery');
    if (!gallery) return;

    const thumbnails = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.moments-side-photo'));
    const index = thumbnails.indexOf(button);
    if (index < 0) return;

    // The Moments renderer marks image groups as both `.card-images` and
    // `.moment-media`; using :is() keeps this bridge compatible with either
    // representation without URL-string matching.
    const sourceImages = Array.from(document.querySelectorAll<HTMLImageElement>(
      '.moments-list :is(.card-images img, .moment-media img)',
    )).slice(0, thumbnails.length);
    const sourceImage = sourceImages[index];
    if (!sourceImage) return;

    event.preventDefault();
    event.stopImmediatePropagation();

    // Prefer the page's own entry point so navigation, focus return and image
    // fallback handling stay identical to clicking the notebook image itself.
    sourceImage.click();

    // If that image was rendered before its lightbox click binding existed,
    // still guarantee that a SNAPSHOTS click opens a preview immediately.
    const lightbox = document.getElementById('moment-lightbox') as HTMLElement | null;
    if (lightbox?.hidden !== false) {
      const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement | null;
      if (!lightbox || !lightboxImage) return;
      lightboxImage.src = sourceImage.dataset.lightboxSrc || sourceImage.currentSrc || sourceImage.src;
      lightboxImage.alt = sourceImage.alt || '';
      lightbox.hidden = false;
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.classList.add('lightbox-open');
      const counter = document.getElementById('lightbox-counter');
      if (counter) counter.textContent = '';
      const prev = document.getElementById('lightbox-prev') as HTMLButtonElement | null;
      const next = document.getElementById('lightbox-next') as HTMLButtonElement | null;
      if (prev) prev.hidden = true;
      if (next) next.hidden = true;
      (document.getElementById('lightbox-close') as HTMLButtonElement | null)?.focus({ preventScroll: true });
    }
  }

  if (!snapshotWindow.__momentsSnapshotPreviewBound) {
    snapshotWindow.__momentsSnapshotPreviewBound = true;
    document.addEventListener('click', openSnapshotFromSideRail, { capture: true });
  }
</script>
