---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const primaryLinks = [
  { href: '/', label: '首页' },
  { href: '/posts', label: '文章' },
  { href: '/moments', label: '碎碎念' },
  { href: '/messages', label: '留言' },
];

const utilityLinks = [
  { href: '/tags', label: '标签' },
  { href: '/search', label: '搜索' },
  { href: '/player', label: '沉浸' },
  { href: '/sekai-quest', label: '闯关' },
];

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header" id="site-header">
  <div class="site-header-inner">
    <a class="site-brand" href="/" aria-label="返回首页">Lidure</a>

    <button
      class="site-nav-toggle"
      type="button"
      aria-label="打开导航"
      aria-controls="site-nav-panel"
      aria-expanded="false"
    >
      <span></span><span></span><span></span>
    </button>

    <div class="site-nav-panel" id="site-nav-panel" data-open="false">
      <nav class="site-nav-primary" aria-label="主要导航">
        {primaryLinks.map((link) => (
          <a href={link.href} class:list={{ active: isActive(link.href) }} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))}
      </nav>

      <div class="site-nav-utilities">
        {utilityLinks.map((link) => (
          <a href={link.href} class:list={{ active: isActive(link.href) }}>
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<script is:inline>
(function () {
  function initSiteHeader() {
    var header = document.getElementById('site-header');
    var toggle = header && header.querySelector('.site-nav-toggle');
    var panel = document.getElementById('site-nav-panel');
    if (!header || !toggle || !panel || header.dataset.initialized === 'true') return;
    header.dataset.initialized = 'true';

    function setScrolled() {
      header.classList.toggle('is-scrolled', window.scrollY > 24);
    }

    function closePanel() {
      panel.dataset.open = 'false';
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', '打开导航');
    }

    toggle.addEventListener('click', function () {
      var nextOpen = panel.dataset.open !== 'true';
      panel.dataset.open = nextOpen ? 'true' : 'false';
      toggle.setAttribute('aria-expanded', String(nextOpen));
      toggle.setAttribute('aria-label', nextOpen ? '关闭导航' : '打开导航');
    });

    panel.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', closePanel);
    });

    if (window.__siteHeaderScrollHandler) {
      window.removeEventListener('scroll', window.__siteHeaderScrollHandler);
    }
    window.__siteHeaderScrollHandler = setScrolled;
    window.addEventListener('scroll', window.__siteHeaderScrollHandler, { passive: true });
    setScrolled();
  }

  if (!window.__siteHeaderPageLoadBound) {
    window.__siteHeaderPageLoadBound = true;
    document.addEventListener('astro:page-load', initSiteHeader);
  }
  initSiteHeader();
})();
</script>
