<div class="moments-pin-status" id="moments-pin-status" role="status" aria-live="polite" aria-atomic="true"></div>

<style is:global>
  .moments-pin-status {
    position: fixed;
    left: 50%;
    bottom: max(24px, env(safe-area-inset-bottom));
    z-index: 10020;
    max-width: min(420px, calc(100vw - 32px));
    padding: 9px 14px;
    border: 1px solid color-mix(in srgb, var(--standard-line, rgba(255, 255, 255, 0.1)) 82%, transparent);
    border-radius: 999px;
    color: var(--standard-text, var(--text));
    background: color-mix(in srgb, var(--standard-card-bg, var(--panel)) 94%, transparent);
    box-shadow: 0 12px 34px rgba(0, 0, 0, 0.16);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    font-size: 0.82rem;
    line-height: 1.45;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 8px);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .moments-pin-status.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .moment-pin-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 24px;
    padding: 3px 8px;
    border: 1px solid color-mix(in srgb, var(--standard-accent, var(--accent)) 24%, transparent);
    border-radius: 999px;
    color: var(--standard-accent, var(--accent));
    background: color-mix(in srgb, var(--standard-accent-soft, var(--tag-bg)) 78%, transparent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .moment-pin-badge svg {
    width: 11px;
    height: 11px;
    fill: currentColor;
  }

  .pin-moment-btn {
    padding: 3px 9px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.76rem;
    cursor: pointer;
    transition: color 160ms ease, background 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .pin-moment-btn:hover,
  .pin-moment-btn[aria-pressed="true"] {
    color: var(--standard-accent, var(--accent));
    border-color: color-mix(in srgb, var(--standard-accent, var(--accent)) 28%, transparent);
    background: color-mix(in srgb, var(--standard-accent-soft, var(--tag-bg)) 74%, transparent);
  }

  .pin-moment-btn:hover {
    transform: translateY(-1px);
  }

  .pin-moment-btn:disabled {
    cursor: wait;
    opacity: 0.58;
    transform: none;
  }

  .pin-moment-btn:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--standard-accent, var(--accent)) 70%, white);
    outline-offset: 2px;
  }

  @media (max-width: 620px) {
    .moment-pin-badge {
      min-height: 22px;
      padding-inline: 7px;
    }

    .pin-moment-btn {
      min-height: 32px;
      padding-inline: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .moments-pin-status,
    .pin-moment-btn {
      transition: none;
    }
  }
</style>

<script>
  import { installMomentsJournalEnhancer } from '../lib/moments-journal-enhancer.mjs';
  import '../styles/moments-journal.css';
  import {
    fetchMoments,
    MomentApiError,
    setMomentPinned as setMomentPinnedViaApi,
    type MomentApiItem,
  } from '../lib/moments-api';

  const pinWindow = window as typeof window & {
    __momentsPinCleanup?: () => void;
    __momentsPinLifecycleBound?: boolean;
  };

  let statusTimer = 0;

  function showPinStatus(message: string) {
    const status = document.getElementById('moments-pin-status');
    if (!status) return;
    status.textContent = message;
    status.classList.add('is-visible');
    window.clearTimeout(statusTimer);
    statusTimer = window.setTimeout(() => status.classList.remove('is-visible'), 2200);
  }

  function initMomentsPinControls() {
    pinWindow.__momentsPinCleanup?.();

    const list = document.getElementById('moments-list');
    if (!list) return;
    const listRoot = list;

    const controller = new AbortController();
    const { signal } = controller;
    installMomentsJournalEnhancer(listRoot, signal);
    let items: MomentApiItem[] = [];
    let decorateQueued = false;

    const cards = () => Array.from(listRoot.querySelectorAll<HTMLElement>('.moment-card'));
    const adminControlsVisible = () => Boolean(listRoot.querySelector('.delete-moment-btn'));

    function itemForCard(card: HTMLElement, index: number) {
      const id = card.dataset.id;
      if (id) {
        const exact = items.find((item) => item.id === id);
        if (exact) return exact;
      }
      return items[index] ?? null;
    }

    function createPinBadge() {
      const badge = document.createElement('span');
      badge.className = 'moment-pin-badge';
      badge.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.6 3.2c.7-.7 1.8-.7 2.5 0l3.7 3.7c.7.7.7 1.8 0 2.5l-2 2 1.2 3.5c.2.6.1 1.3-.4 1.8l-.7.7-5.3-5.3-4.3 4.3.4 3.4-1.4 1.4-2.2-4.3-4.3-2.2 1.4-1.4 3.4.4 4.3-4.3-5.3-5.3.7-.7c.5-.5 1.2-.6 1.8-.4l3.5 1.2 2-2Z"/></svg><span>置顶</span>';
      return badge;
    }

    function syncCardDecoration(card: HTMLElement, item: MomentApiItem | null) {
      const leftMeta = card.querySelector<HTMLElement>('.card-meta-left');
      const actions = card.querySelector<HTMLElement>('.card-actions');
      let badge = leftMeta?.querySelector<HTMLElement>('.moment-pin-badge') ?? null;

      if (item?.pinned === true) {
        if (!badge && leftMeta) {
          badge = createPinBadge();
          leftMeta.appendChild(badge);
        }
      } else {
        badge?.remove();
      }

      let button = actions?.querySelector<HTMLButtonElement>('.pin-moment-btn') ?? null;
      const canManage = adminControlsVisible() && Boolean(item?.id) && Boolean(card.dataset.id);
      if (!canManage) {
        button?.remove();
        return;
      }

      if (!button && actions) {
        button = document.createElement('button');
        button.type = 'button';
        button.className = 'pin-moment-btn';
        actions.insertBefore(button, actions.querySelector('.delete-moment-btn'));
      }

      if (!button || !item) return;
      button.dataset.momentId = item.id;
      button.dataset.pinned = String(item.pinned === true);
      button.setAttribute('aria-pressed', String(item.pinned === true));
      button.setAttribute('aria-label', item.pinned === true ? '取消置顶这条动态' : '置顶这条动态');
      button.title = item.pinned === true ? '取消置顶' : '置顶这条动态';
      button.textContent = item.pinned === true ? '取消置顶' : '置顶';
    }

    function decorate() {
      decorateQueued = false;
      cards().forEach((card, index) => syncCardDecoration(card, itemForCard(card, index)));
    }

    function queueDecorate() {
      if (decorateQueued) return;
      decorateQueued = true;
      requestAnimationFrame(decorate);
    }

    function reorderManagedCards() {
      const current = cards();
      const byId = new Map(
        current
          .map((card) => [card.dataset.id, card] as const)
          .filter(([id]) => Boolean(id)),
      );
      if (byId.size === 0) return;

      const ordered = items
        .map((item) => byId.get(item.id))
        .filter((card): card is HTMLElement => Boolean(card));
      if (ordered.length === 0) return;

      ordered.forEach((card, index) => {
        card.style.setProperty('--delay', `${index * 40}ms`);
        listRoot.appendChild(card);
      });
    }

    async function refreshItems({ reorder = false } = {}) {
      const response = await fetchMoments({ limit: 200, signal });
      items = response.items;
      if (reorder) reorderManagedCards();
      decorate();
    }

    async function togglePin(button: HTMLButtonElement) {
      const momentId = button.dataset.momentId;
      if (!momentId || button.disabled) return;
      const nextPinned = button.dataset.pinned !== 'true';
      const oldText = button.textContent || (nextPinned ? '置顶' : '取消置顶');
      button.disabled = true;
      button.textContent = nextPinned ? '置顶中…' : '取消中…';

      try {
        await setMomentPinnedViaApi(momentId, nextPinned, { signal });
        await refreshItems({ reorder: true });
        showPinStatus(nextPinned ? '📌 已置顶这条碎碎念' : '已取消置顶');
      } catch (error) {
        button.disabled = false;
        button.textContent = oldText;
        if (error instanceof MomentApiError && error.code === 'AUTH_REQUIRED') {
          showPinStatus('登录已失效，请重新登录后再操作');
          return;
        }
        showPinStatus(`置顶操作失败：${error instanceof Error ? error.message : String(error)}`);
      }
    }

    listRoot.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      const button = target?.closest<HTMLButtonElement>('.pin-moment-btn');
      if (!button) return;
      event.preventDefault();
      event.stopPropagation();
      void togglePin(button);
    }, { signal });

    const observer = new MutationObserver(() => queueDecorate());
    observer.observe(listRoot, { childList: true, subtree: true });

    void refreshItems().catch(() => {
      // The moments page already owns its primary loading/error UI. Pin controls
      // should fail quietly rather than masking the main timeline.
    });

    pinWindow.__momentsPinCleanup = () => {
      controller.abort();
      observer.disconnect();
      window.clearTimeout(statusTimer);
    };
  }

  if (!pinWindow.__momentsPinLifecycleBound) {
    pinWindow.__momentsPinLifecycleBound = true;
    document.addEventListener('astro:page-load', initMomentsPinControls);
    document.addEventListener('astro:before-swap', () => pinWindow.__momentsPinCleanup?.());
  }

  initMomentsPinControls();
</script>
