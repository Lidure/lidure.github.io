<div class="moments-pin-status" id="moments-pin-status" role="status" aria-live="polite" aria-atomic="true"></div>

<style is:global>
  .moments-pin-status {
    position: fixed;
    left: 50%;
    bottom: max(24px, env(safe-area-inset-bottom));
    z-index: 10020;
    max-width: min(420px, calc(100vw - 32px));
    padding: 9px 13px;
    border: 1px solid color-mix(in srgb, var(--standard-line, rgba(255, 255, 255, 0.1)) 82%, transparent);
    border-radius: 10px;
    color: var(--standard-text, var(--text));
    background: color-mix(in srgb, var(--standard-card-bg, var(--panel)) 90%, transparent);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    font-size: 0.78rem;
    line-height: 1.45;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 8px);
    transition: opacity 160ms ease, transform 160ms ease;
  }
  .moments-pin-status.is-visible { opacity: 1; transform: translate(-50%, 0); }
  .moment-pin-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 20px;
    padding: 0;
    border: 0;
    color: var(--standard-accent, var(--accent));
    background: transparent;
    font-size: 0.66rem;
    font-weight: 650;
    white-space: nowrap;
  }
  .moment-pin-badge svg { width: 10px; height: 10px; fill: currentColor; }
  .pin-moment-btn {
    padding: 3px 7px;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.68rem;
    cursor: pointer;
    opacity: 0.62;
    transition: color 150ms ease, background 150ms ease, opacity 150ms ease;
  }
  .pin-moment-btn:hover,
  .pin-moment-btn[aria-pressed="true"] {
    color: var(--standard-accent, var(--accent));
    background: color-mix(in srgb, var(--standard-accent-soft, var(--tag-bg)) 55%, transparent);
    opacity: 1;
  }
  .pin-moment-btn:disabled { cursor: wait; opacity: 0.45; }
  .pin-moment-btn:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--standard-accent, var(--accent)) 58%, transparent);
    outline-offset: 2px;
  }
  @media (max-width: 620px) { .pin-moment-btn { min-height: 32px; opacity: 0.9; } }
  @media (prefers-reduced-motion: reduce) {
    .moments-pin-status,
    .pin-moment-btn { transition: none; }
  }
</style>

<script>
  import {
    fetchMoments,
    MomentApiError,
    setMomentPinned as setMomentPinnedViaApi,
    type MomentApiItem,
  } from '../lib/moments-api';
  import { getMomentDaypart } from '../lib/moments-life-wall.mjs';

  const pinWindow = window as typeof window & {
    __momentsPinCleanup?: () => void;
    __momentsPinLifecycleBound?: boolean;
  };

  const noteShifts = [0, 8, -5, 11, -8, 4];
  const sideCategories = ['all', '游戏', '音乐', '生活', '吐槽'];
  let statusTimer = 0;

  function showPinStatus(message: string) {
    const status = document.getElementById('moments-pin-status');
    if (!status) return;
    status.textContent = message;
    status.classList.add('is-visible');
    window.clearTimeout(statusTimer);
    statusTimer = window.setTimeout(() => status.classList.remove('is-visible'), 2200);
  }

  function ensureMomentsCompanionShell(listRoot: HTMLElement) {
    const shell = listRoot.closest<HTMLElement>('.moments-shell');
    if (!shell) return null;
    const existing = shell.querySelector<HTMLElement>('.moments-page-grid');
    if (existing) return existing;

    const grid = document.createElement('div');
    grid.className = 'moments-page-grid';

    const left = document.createElement('aside');
    left.className = 'moments-side moments-side--left';
    left.setAttribute('aria-label', '碎碎念概览');
    left.innerHTML = `
      <div class="moments-side-stack">
        <section class="moments-side-note moments-side-overview">
          <span class="moments-side-kicker">NOTEBOOK</span>
          <strong id="moments-side-total">--</strong>
          <span>条生活记录</span>
        </section>
        <section class="moments-side-note">
          <span class="moments-side-kicker">RECENT</span>
          <p id="moments-side-month">最近的日子</p>
        </section>
        <section class="moments-side-note">
          <span class="moments-side-kicker">INDEX</span>
          <div class="moments-side-categories" id="moments-side-categories"></div>
        </section>
      </div>`;

    const main = document.createElement('div');
    main.className = 'moments-main-column';

    const right = document.createElement('aside');
    right.className = 'moments-side moments-side--right';
    right.setAttribute('aria-label', '生活边角');
    right.innerHTML = `
      <div class="moments-side-stack">
        <section class="moments-side-note moments-side-quote">
          <span class="moments-side-kicker">TODAY</span>
          <p>普通的一天，也值得被记下来。</p>
        </section>
        <section class="moments-side-note">
          <span class="moments-side-kicker">SNAPSHOTS</span>
          <div class="moments-side-gallery" id="moments-side-gallery" aria-label="最近图片"></div>
        </section>
      </div>`;

    const categoryRoot = left.querySelector<HTMLElement>('#moments-side-categories');
    sideCategories.forEach((category) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'moments-side-category';
      button.dataset.sideCategory = category;
      button.setAttribute('data-side-category', category);
      button.innerHTML = `<span>${category === 'all' ? '全部' : category}</span><small>0</small>`;
      categoryRoot?.appendChild(button);
    });

    const filter = shell.querySelector<HTMLElement>('.moments-wall-filter');
    const composer = shell.querySelector<HTMLElement>('#publish-box');
    const retry = shell.querySelector<HTMLElement>('#moments-retry');
    const insertionPoint = filter || listRoot;
    shell.insertBefore(grid, insertionPoint);
    grid.append(left, main, right);
    if (filter) main.appendChild(filter);
    if (composer) main.appendChild(composer);
    main.appendChild(listRoot);
    if (retry) main.appendChild(retry);
    return grid;
  }

  function initMomentsPinControls() {
    pinWindow.__momentsPinCleanup?.();

    const list = document.getElementById('moments-list');
    if (!list) return;
    const listRoot = list;
    ensureMomentsCompanionShell(listRoot);

    const controller = new AbortController();
    const { signal } = controller;
    let items: MomentApiItem[] = [];
    let decorateQueued = false;

    const cards = () => Array.from(listRoot.querySelectorAll<HTMLElement>('.moment-card'));
    const adminControlsVisible = () => Boolean(listRoot.querySelector('.delete-moment-btn'));

    function itemForCard(card: HTMLElement, index: number) {
      const id = card.dataset.id;
      if (id) {
        const exact = items.find((item) => item.id === id);
        if (exact) return exact;
      }
      return items[index] ?? null;
    }

    function syncSunlitDecoration(card: HTMLElement, index: number) {
      card.style.setProperty('--note-shift', `${noteShifts[index % noteShifts.length]}px`);
      const actions = card.querySelector<HTMLElement>('.card-actions');
      const time = actions?.querySelector<HTMLTimeElement>('.card-date');
      if (!actions || !time) return;
      const daypart = getMomentDaypart(time.dateTime || time.textContent || '');
      let label = actions.querySelector<HTMLElement>('.moment-daypart');
      if (!label) {
        label = document.createElement('span');
        label.className = 'moment-daypart';
        actions.insertBefore(label, time);
      }
      label.dataset.daypart = daypart.key;
      label.textContent = `${daypart.mark} ${daypart.label}`;
    }

    function createPinBadge() {
      const badge = document.createElement('span');
      badge.className = 'moment-pin-badge';
      badge.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.6 3.2c.7-.7 1.8-.7 2.5 0l3.7 3.7c.7.7.7 1.8 0 2.5l-2 2 1.2 3.5c.2.6.1 1.3-.4 1.8l-.7.7-5.3-5.3-4.3 4.3.4 3.4-1.4 1.4-2.2-4.3-4.3-2.2 1.4-1.4 3.4.4 4.3-4.3-5.3-5.3.7-.7c.5-.5 1.2-.6 1.8-.4l3.5 1.2 2-2Z"/></svg><span>置顶</span>';
      return badge;
    }

    function syncCardDecoration(card: HTMLElement, item: MomentApiItem | null) {
      const leftMeta = card.querySelector<HTMLElement>('.card-meta-left');
      const actions = card.querySelector<HTMLElement>('.card-actions');
      let badge = leftMeta?.querySelector<HTMLElement>('.moment-pin-badge') ?? null;
      if (item?.pinned === true) {
        if (!badge && leftMeta) {
          badge = createPinBadge();
          leftMeta.appendChild(badge);
        }
      } else {
        badge?.remove();
      }

      let button = actions?.querySelector<HTMLButtonElement>('.pin-moment-btn') ?? null;
      const canManage = adminControlsVisible() && Boolean(item?.id) && Boolean(card.dataset.id);
      if (!canManage) {
        button?.remove();
        return;
      }
      if (!button && actions) {
        button = document.createElement('button');
        button.type = 'button';
        button.className = 'pin-moment-btn';
        actions.insertBefore(button, actions.querySelector('.delete-moment-btn'));
      }
      if (!button || !item) return;
      button.dataset.momentId = item.id;
      button.dataset.pinned = String(item.pinned === true);
      button.setAttribute('aria-pressed', String(item.pinned === true));
      button.setAttribute('aria-label', item.pinned === true ? '取消置顶这条动态' : '置顶这条动态');
      button.title = item.pinned === true ? '取消置顶' : '置顶这条动态';
      button.textContent = item.pinned === true ? '取消置顶' : '置顶';
    }

    function openSnapshotPreview(sourceImage: HTMLImageElement) {
      sourceImage.click();

      const lightbox = document.getElementById('moment-lightbox') as HTMLElement | null;
      if (lightbox?.hidden === false) return;
      const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement | null;
      if (!lightbox || !lightboxImage) return;

      lightboxImage.src = sourceImage.dataset.lightboxSrc || sourceImage.currentSrc || sourceImage.src;
      lightboxImage.alt = sourceImage.alt || '';
      lightbox.hidden = false;
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.classList.add('lightbox-open');

      const counter = document.getElementById('lightbox-counter');
      if (counter) counter.textContent = '';
      const prev = document.getElementById('lightbox-prev') as HTMLButtonElement | null;
      const next = document.getElementById('lightbox-next') as HTMLButtonElement | null;
      if (prev) prev.hidden = true;
      if (next) next.hidden = true;
      (document.getElementById('lightbox-close') as HTMLButtonElement | null)?.focus({ preventScroll: true });
    }

    function syncMomentsCompanions() {
      const total = document.getElementById('moments-side-total');
      if (total) total.textContent = String(items.length || cards().length);

      const newest = items[0] as (MomentApiItem & { date?: string; createdAt?: number }) | undefined;
      const dateValue = newest?.date ? new Date(newest.date) : newest?.createdAt ? new Date(newest.createdAt) : new Date();
      const month = document.getElementById('moments-side-month');
      if (month && !Number.isNaN(dateValue.getTime())) {
        month.textContent = dateValue.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long' });
      }

      const counts = new Map<string, number>();
      items.forEach((item) => {
        const category = String((item as MomentApiItem & { category?: string }).category || '生活');
        counts.set(category, (counts.get(category) || 0) + 1);
      });
      const activeCategory = document.querySelector<HTMLElement>('.pill[data-category].active')?.dataset.category || 'all';
      const sideCategoryButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-side-category]'));
      sideCategoryButtons.forEach((button) => {
        const category = button.dataset.sideCategory || 'all';
        const small = button.querySelector('small');
        if (small) small.textContent = String(category === 'all' ? items.length : (counts.get(category) || 0));
        button.classList.toggle('is-active', category === activeCategory);
        button.setAttribute('aria-pressed', String(category === activeCategory));
      });

      const gallery = document.getElementById('moments-side-gallery');
      if (gallery) {
        const sourceImages = Array.from(listRoot.querySelectorAll<HTMLImageElement>('.card-images img')).slice(0, 4);
        gallery.replaceChildren(...sourceImages.map((sourceImage, index) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'moments-side-photo';
          button.dataset.snapshotIndex = String(index);
          button.setAttribute('aria-label', '打开最近图片');
          const img = document.createElement('img');
          img.src = sourceImage.currentSrc || sourceImage.src;
          img.alt = sourceImage.alt || '最近的碎碎念图片';
          img.loading = 'lazy';
          button.appendChild(img);
          button.addEventListener('click', () => openSnapshotPreview(sourceImage), { signal });
          return button;
        }));
        gallery.classList.toggle('is-empty', sourceImages.length === 0);
      }
    }

    function decorate() {
      decorateQueued = false;
      cards().forEach((card, index) => {
        syncSunlitDecoration(card, index);
        syncCardDecoration(card, itemForCard(card, index));
      });
      syncMomentsCompanions();
    }

    function queueDecorate() {
      if (decorateQueued) return;
      decorateQueued = true;
      requestAnimationFrame(decorate);
    }

    function announceOrderChange() {
      listRoot.dispatchEvent(new CustomEvent('moments:pin-order-changed', {
        detail: { orderedIds: items.map((item) => item.id).filter(Boolean) },
      }));
    }

    async function refreshItems({ reorder = false } = {}) {
      const response = await fetchMoments({ limit: 200, signal });
      items = response.items;
      if (reorder) announceOrderChange();
      decorate();
    }

    async function togglePin(button: HTMLButtonElement) {
      const momentId = button.dataset.momentId;
      if (!momentId || button.disabled) return;
      const nextPinned = button.dataset.pinned !== 'true';
      const oldText = button.textContent || (nextPinned ? '置顶' : '取消置顶');
      button.disabled = true;
      button.textContent = nextPinned ? '置顶中…' : '取消中…';
      try {
        await setMomentPinnedViaApi(momentId, nextPinned, { signal });
        await refreshItems({ reorder: true });
        showPinStatus(nextPinned ? '已置顶这条碎碎念' : '已取消置顶');
      } catch (error) {
        button.disabled = false;
        button.textContent = oldText;
        if (error instanceof MomentApiError && error.code === 'AUTH_REQUIRED') {
          showPinStatus('登录已失效，请重新登录后再操作');
          return;
        }
        showPinStatus(`置顶操作失败：${error instanceof Error ? error.message : String(error)}`);
      }
    }

    listRoot.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      const button = target?.closest<HTMLButtonElement>('.pin-moment-btn');
      if (!button) return;
      event.preventDefault();
      event.stopPropagation();
      void togglePin(button);
    }, { signal });

    const sideCategoryButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-side-category]'));
    sideCategoryButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const category = button.dataset.sideCategory || 'all';
        const targetTab = document.querySelector<HTMLButtonElement>(`.pill[data-category="${CSS.escape(category)}"]`);
        targetTab?.click();
        sideCategoryButtons.forEach((candidate) => candidate.classList.toggle('is-active', candidate === button));
      }, { signal });
    });

    const observer = new MutationObserver(() => queueDecorate());
    observer.observe(listRoot, { childList: true, subtree: true });

    void refreshItems().catch(() => {
      // The moments page owns loading/error UI. Companion/pin enhancements fail quietly.
      queueDecorate();
    });

    pinWindow.__momentsPinCleanup = () => {
      controller.abort();
      observer.disconnect();
      window.clearTimeout(statusTimer);
    };
  }

  if (!pinWindow.__momentsPinLifecycleBound) {
    pinWindow.__momentsPinLifecycleBound = true;
    document.addEventListener('astro:page-load', initMomentsPinControls);
    document.addEventListener('astro:before-swap', () => pinWindow.__momentsPinCleanup?.());
  }

  initMomentsPinControls();
</script>
