<section
  id="gallery-manage-dialog"
  class="gallery-manage-dialog-layer"
  role="dialog"
  aria-modal="true"
  aria-labelledby="gallery-manage-dialog-title"
  hidden
>
  <button class="gallery-manage-dialog-backdrop" type="button" data-dialog-dismiss aria-label="关闭对话框"></button>
  <div class="gallery-manage-dialog-card" tabindex="-1">
    <header class="gallery-manage-dialog-head">
      <div>
        <p id="gallery-manage-dialog-kicker" class="gallery-manage-kicker">Gallery</p>
        <h2 id="gallery-manage-dialog-title">图库管理</h2>
      </div>
      <button id="gallery-manage-dialog-close" class="gallery-manage-dialog-close" type="button" aria-label="关闭">×</button>
    </header>
    <div id="gallery-manage-dialog-body" class="gallery-manage-dialog-body"></div>
    <footer id="gallery-manage-dialog-actions" class="gallery-manage-dialog-actions"></footer>
  </div>
</section>
