<button
  class="hero-settings-btn"
  id="hero-settings-btn"
  transition:persist
  type="button"
  aria-label="背景与外观设置"
  title="背景与外观设置"
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="3"/>
    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
  </svg>
</button>

<div class="hero-settings-panel" id="hero-settings-panel" transition:persist>
  <div class="settings-header">
    <div>
      <span class="settings-kicker">DISPLAY</span>
      <span class="settings-title">背景与外观</span>
    </div>
    <button class="settings-close" id="settings-close" type="button" aria-label="关闭">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <div class="visual-tabs" role="tablist" aria-label="背景与外观设置分类">
    <button id="visual-tab-appearance" class="visual-tab is-active" type="button" role="tab" aria-selected="true" aria-controls="visual-panel-appearance" tabindex="0">外观</button>
    <button id="visual-tab-background" class="visual-tab" type="button" role="tab" aria-selected="false" aria-controls="visual-panel-background" tabindex="-1">背景</button>
    <button id="visual-tab-effects" class="visual-tab" type="button" role="tab" aria-selected="false" aria-controls="visual-panel-effects" tabindex="-1">特效</button>
  </div>

  <div class="settings-body">
    <section id="visual-panel-appearance" class="visual-tab-panel is-active" role="tabpanel" aria-labelledby="visual-tab-appearance">
      <div class="setting-group">
        <div class="setting-heading"><span class="setting-label">主题色相</span><span class="range-value" id="theme-hue-val">340°</span></div>
        <div class="range-row"><input type="range" id="theme-hue-range" min="0" max="360" step="1" value="340" aria-label="主题色相" /></div>
      </div>
      <div class="setting-group">
        <div class="setting-heading"><span class="setting-label">卡片透明度</span><span class="range-value" id="card-opacity-val">92%</span></div>
        <div class="range-row"><input type="range" id="card-opacity-range" min="20" max="100" step="1" value="92" aria-label="卡片透明度" /></div>
      </div>
      <div class="setting-row">
        <span class="setting-label">显示卡片边框</span>
        <label class="toggle-switch"><input type="checkbox" id="toggle-card-border" checked /><span class="toggle-track"></span></label>
      </div>
      <div class="setting-row">
        <span class="setting-label">卡片跟随主题色</span>
        <label class="toggle-switch"><input type="checkbox" id="toggle-card-follow-theme" /><span class="toggle-track"></span></label>
      </div>
    </section>

    <section id="visual-panel-background" class="visual-tab-panel" role="tabpanel" aria-labelledby="visual-tab-background" hidden>
      <div class="setting-group">
        <span class="setting-label">壁纸显示模式</span>
        <div class="wallpaper-mode-switch" role="group" aria-label="壁纸显示模式">
          <button id="wallpaper-mode-banner" class="wallpaper-mode-option is-active" type="button" aria-pressed="true">横幅壁纸</button>
          <button id="wallpaper-mode-fullscreen" class="wallpaper-mode-option" type="button" aria-pressed="false">全屏壁纸</button>
        </div>
      </div>
      <div class="setting-row"><span class="setting-label">启用背景</span><label class="toggle-switch"><input type="checkbox" id="toggle-enabled" checked /><span class="toggle-track"></span></label></div>
      <div class="setting-row"><span class="setting-label">自动轮播</span><label class="toggle-switch"><input type="checkbox" id="toggle-autoplay" checked /><span class="toggle-track"></span></label></div>
      <div class="setting-group">
        <div class="setting-heading"><span class="setting-label">切换间隔</span><span class="range-value" id="interval-val">15s</span></div>
        <div class="range-row"><input type="range" id="interval-range" min="2" max="20" step="1" value="15" aria-label="切换间隔" /></div>
      </div>
      <div class="setting-group">
        <div class="setting-heading"><span class="setting-label">遮罩强度</span><span class="range-value" id="opacity-val">45%</span></div>
        <div class="range-row"><input type="range" id="opacity-range" min="0" max="80" step="5" value="45" aria-label="遮罩强度" /></div>
      </div>
      <div class="setting-group mode-fullscreen-only">
        <div class="setting-heading"><span class="setting-label">背景模糊</span><span class="range-value" id="background-blur-val">6px</span></div>
        <div class="range-row"><input type="range" id="background-blur-range" min="0" max="20" step="1" value="6" aria-label="全屏背景模糊" /></div>
      </div>
      <div class="setting-group mode-fullscreen-only">
        <div class="setting-heading"><span class="setting-label">卡片透明度</span><span class="range-value" id="fullscreen-card-opacity-val">92%</span></div>
        <div class="range-row"><input type="range" id="fullscreen-card-opacity-range" min="20" max="100" step="1" value="92" aria-label="全屏壁纸卡片透明度" /></div>
      </div>
      <div class="setting-row mode-banner-only"><span class="setting-label">Banner 渐变过渡</span><label class="toggle-switch"><input type="checkbox" id="toggle-banner-gradient" checked /><span class="toggle-track"></span></label></div>
      <div class="setting-row mode-banner-only"><span class="setting-label">Banner 标题</span><label class="toggle-switch"><input type="checkbox" id="toggle-banner-title" checked /><span class="toggle-track"></span></label></div>
      <div class="setting-group">
        <span class="setting-label">上传画质</span>
        <select class="quality-select" id="quality-select">
          <option value="high">高质量 (JPEG 95%)</option>
          <option value="medium">中等 (JPEG 75%)</option>
          <option value="original">原始画质 (不压缩)</option>
        </select>
      </div>
      <div class="setting-group">
        <span class="setting-label">添加图片 / 视频</span>
        <label class="upload-zone" id="upload-zone">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          <span>点击上传或拖入图片</span>
          <input type="file" accept="image/*" multiple id="file-input" hidden />
        </label>
        <div class="url-row"><input type="url" id="url-input" placeholder="粘贴图片 / 视频 URL" aria-label="背景媒体 URL" /><button class="url-add-btn" id="url-add-btn" type="button">添加</button></div>
      </div>
      <div class="setting-group">
        <button class="media-manage-btn" id="media-manage-btn" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          <span>背景库</span><span class="media-count" id="media-count">0</span><span aria-hidden="true">›</span>
        </button>
      </div>
    </section>

    <section id="visual-panel-effects" class="visual-tab-panel" role="tabpanel" aria-labelledby="visual-tab-effects" hidden>
      <div class="setting-row"><span class="setting-label">樱花飘落</span><label class="toggle-switch"><input type="checkbox" id="toggle-sakura" /><span class="toggle-track"></span></label></div>
      <div class="setting-group">
        <div class="setting-heading"><span class="setting-label">樱花密度</span><span class="range-value" id="sakura-density-val">65%</span></div>
        <div class="range-row"><input type="range" id="sakura-density-range" min="0" max="100" step="5" value="65" aria-label="樱花密度" /></div>
      </div>
      <div class="setting-group">
        <div class="setting-heading"><span class="setting-label">飘落速度</span><span class="range-value" id="sakura-speed-val">1.00×</span></div>
        <div class="range-row"><input type="range" id="sakura-speed-range" min="25" max="200" step="5" value="100" aria-label="樱花飘落速度" /></div>
      </div>
      <div class="setting-row"><span class="setting-label">减少动态效果</span><label class="toggle-switch"><input type="checkbox" id="toggle-reduce-motion" /><span class="toggle-track"></span></label></div>
    </section>
  </div>

  <div class="settings-footer">
    <button id="visual-reset-current" class="settings-reset" type="button">恢复当前页默认</button>
  </div>
</div>

<style>
  .hero-settings-btn { position:fixed; left:28px; top:90px; z-index:9999; width:42px; height:42px; border:1px solid rgba(255,255,255,.22); border-radius:50%; display:grid; place-items:center; color:var(--text-soft); background:color-mix(in srgb,var(--panel-bg) 72%,transparent); backdrop-filter:blur(18px) saturate(1.25); -webkit-backdrop-filter:blur(18px) saturate(1.25); box-shadow:0 8px 24px rgba(5,6,14,.12); cursor:pointer; transition:transform 180ms ease,border-color 180ms ease,color 180ms ease; }
  .hero-settings-btn:hover { transform:rotate(20deg) scale(1.06); color:var(--accent); border-color:color-mix(in srgb,var(--accent) 48%,transparent); }
  .hero-settings-btn svg { width:18px; height:18px; }
  .hero-settings-panel { position:fixed; left:28px; top:142px; z-index:9998; width:min(460px,calc(100vw - 40px)); max-height:calc(100vh - 164px); display:none; flex-direction:column; overflow:hidden; border:1px solid color-mix(in srgb,var(--border) 72%,transparent); border-radius:20px; color:var(--text); background:color-mix(in srgb,var(--panel-bg) 88%,transparent); backdrop-filter:blur(26px) saturate(1.18); -webkit-backdrop-filter:blur(26px) saturate(1.18); box-shadow:0 20px 60px rgba(4,6,16,.2); }
  .hero-settings-panel.open { display:flex; animation:visual-panel-in .2s ease-out; }
  @keyframes visual-panel-in { from{opacity:0;transform:translateY(-8px) scale(.985)} to{opacity:1;transform:none} }
  .settings-header { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:16px 18px 12px; }
  .settings-header > div { display:grid; gap:2px; }
  .settings-kicker { color:var(--accent); font-size:.62rem; font-weight:800; letter-spacing:.18em; }
  .settings-title { font-size:1rem; font-weight:800; }
  .settings-close { width:34px; height:34px; border:0; border-radius:50%; display:grid; place-items:center; color:var(--muted); background:transparent; cursor:pointer; }
  .settings-close:hover { color:var(--accent); background:var(--tag-bg); }
  .settings-close svg { width:16px; height:16px; }
  .visual-tabs { display:grid; grid-template-columns:repeat(3,1fr); gap:5px; margin:0 14px 12px; padding:4px; border-radius:12px; background:color-mix(in srgb,var(--card-bg) 68%,transparent); }
  .visual-tab { min-height:34px; border:0; border-radius:9px; color:var(--muted); background:transparent; font:inherit; font-size:.8rem; font-weight:700; cursor:pointer; }
  .visual-tab.is-active { color:var(--accent); background:color-mix(in srgb,var(--accent) 13%,var(--panel-bg)); box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--accent) 20%,transparent); }
  .visual-tab:focus-visible,.wallpaper-mode-option:focus-visible,.settings-reset:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }
  .settings-body { overflow-y:auto; padding:2px 18px 16px; }
  .visual-tab-panel { display:grid; gap:14px; }
  .visual-tab-panel[hidden] { display:none; }
  .setting-row,.setting-heading { display:flex; align-items:center; justify-content:space-between; gap:14px; }
  .setting-group { display:grid; gap:8px; }
  .setting-label { color:var(--text-soft); font-size:.84rem; font-weight:650; }
  .range-row { display:flex; align-items:center; gap:10px; }
  .range-row input[type="range"] { width:100%; height:4px; appearance:none; -webkit-appearance:none; border-radius:999px; background:color-mix(in srgb,var(--accent) 22%,var(--border)); }
  .range-row input[type="range"]::-webkit-slider-thumb { appearance:none; -webkit-appearance:none; width:16px; height:16px; border:3px solid var(--panel-bg); border-radius:50%; background:var(--accent); box-shadow:0 0 0 1px color-mix(in srgb,var(--accent) 28%,transparent); cursor:pointer; }
  .range-value { min-width:48px; color:var(--accent); font-size:.76rem; font-weight:800; text-align:right; }
  .toggle-switch { position:relative; display:inline-flex; cursor:pointer; }
  .toggle-switch input { position:absolute; opacity:0; pointer-events:none; }
  .toggle-track { position:relative; display:block; width:40px; height:22px; border:1px solid var(--border); border-radius:999px; background:var(--card-bg); transition:background 160ms ease,border-color 160ms ease; }
  .toggle-track::after { content:''; position:absolute; left:3px; top:3px; width:14px; height:14px; border-radius:50%; background:var(--muted); transition:transform 160ms ease,background 160ms ease; }
  .toggle-switch input:checked + .toggle-track { background:color-mix(in srgb,var(--accent) 28%,var(--card-bg)); border-color:color-mix(in srgb,var(--accent) 42%,var(--border)); }
  .toggle-switch input:checked + .toggle-track::after { transform:translateX(18px); background:var(--accent); }
  .wallpaper-mode-switch { display:grid; grid-template-columns:1fr 1fr; gap:6px; padding:4px; border-radius:12px; background:color-mix(in srgb,var(--card-bg) 76%,transparent); }
  .wallpaper-mode-option { min-height:38px; border:0; border-radius:9px; color:var(--muted); background:transparent; font:inherit; font-size:.82rem; font-weight:700; cursor:pointer; }
  .wallpaper-mode-option.is-active { color:var(--accent); background:var(--panel-bg); box-shadow:0 3px 12px rgba(0,0,0,.08); }
  :global(html[data-wallpaper-mode="banner"]) .mode-fullscreen-only { display:none; }
  :global(html[data-wallpaper-mode="fullscreen"]) .mode-banner-only { display:none; }
  .quality-select,.url-row input { width:100%; min-height:40px; box-sizing:border-box; border:1px solid var(--border); border-radius:10px; padding:8px 11px; color:var(--text); background:var(--card-bg); font:inherit; font-size:.8rem; outline:none; }
  .quality-select:focus,.url-row input:focus { border-color:color-mix(in srgb,var(--accent) 58%,var(--border)); }
  .upload-zone { min-height:58px; display:flex; align-items:center; justify-content:center; gap:8px; padding:10px; border:1px dashed color-mix(in srgb,var(--accent) 30%,var(--border)); border-radius:12px; color:var(--muted); background:color-mix(in srgb,var(--card-bg) 74%,transparent); cursor:pointer; font-size:.8rem; }
  .upload-zone:hover,.upload-zone.dragover { color:var(--accent); border-color:var(--accent); }
  .upload-zone svg { width:18px; height:18px; }
  .url-row { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:7px; }
  .url-add-btn { min-width:58px; border:1px solid color-mix(in srgb,var(--accent) 26%,var(--border)); border-radius:10px; color:var(--accent); background:color-mix(in srgb,var(--accent) 10%,var(--card-bg)); font:inherit; font-size:.8rem; font-weight:750; cursor:pointer; }
  .media-manage-btn { width:100%; min-height:44px; display:flex; align-items:center; gap:9px; padding:9px 11px; border:1px solid var(--border); border-radius:11px; color:var(--text-soft); background:var(--card-bg); font:inherit; font-size:.84rem; font-weight:700; cursor:pointer; }
  .media-manage-btn:hover { color:var(--accent); border-color:color-mix(in srgb,var(--accent) 40%,var(--border)); }
  .media-manage-btn svg { width:18px; height:18px; color:var(--accent); }
  .media-count { margin-left:auto; min-width:22px; padding:2px 7px; border-radius:999px; color:var(--accent); background:color-mix(in srgb,var(--accent) 12%,transparent); text-align:center; font-size:.7rem; }
  .settings-footer { padding:11px 18px 16px; border-top:1px solid var(--border); }
  .settings-reset { width:100%; min-height:38px; border:1px solid var(--border); border-radius:10px; color:var(--muted); background:transparent; font:inherit; font-size:.78rem; font-weight:700; cursor:pointer; }
  .settings-reset:hover { color:var(--accent); border-color:color-mix(in srgb,var(--accent) 36%,var(--border)); background:color-mix(in srgb,var(--accent) 7%,transparent); }
  @media (max-width:720px) { .hero-settings-btn{left:16px;top:80px;width:38px;height:38px}.hero-settings-panel{left:12px;right:12px;top:126px;width:auto;max-height:calc(100vh - 146px);border-radius:18px}.settings-body{padding-left:14px;padding-right:14px} }
  @media (max-width:480px) { .hero-settings-btn{left:12px;top:76px;width:36px;height:36px}.hero-settings-panel{left:8px;right:8px;top:118px;max-height:calc(100vh - 128px)}.settings-header{padding:13px 14px 10px}.visual-tabs{margin-left:10px;margin-right:10px}.settings-close{width:40px;height:40px} }
  @media (prefers-reduced-motion:reduce) { .hero-settings-panel.open{animation:none}.hero-settings-btn,.toggle-track,.toggle-track::after{transition:none} }
</style>

<script>
// @ts-nocheck
(function () {
  function initVisualSettingsPanel() {
    var panel = document.getElementById('hero-settings-panel');
    if (!panel) return;

    var visualWindow = window;
    if (visualWindow.__visualSettingsPanelController) visualWindow.__visualSettingsPanelController.abort();
    var controller = typeof AbortController === 'function' ? new AbortController() : null;
    visualWindow.__visualSettingsPanelController = controller;
    var options = controller ? { signal: controller.signal } : undefined;

    var tabs = Array.from(panel.querySelectorAll('[role="tab"]'));
    var activeTab = 'appearance';
    var tabMap = {
      appearance: document.getElementById('visual-tab-appearance'),
      background: document.getElementById('visual-tab-background'),
      effects: document.getElementById('visual-tab-effects')
    };
    var panelMap = {
      appearance: document.getElementById('visual-panel-appearance'),
      background: document.getElementById('visual-panel-background'),
      effects: document.getElementById('visual-panel-effects')
    };

    function bridge() { return visualWindow.__lidureVisualSettings; }
    function readSettings() { return bridge() ? bridge().read() : {}; }
    function writeSettings(patch) { return bridge() ? bridge().write(patch) : null; }
    function setText(id, value) { var el = document.getElementById(id); if (el) el.textContent = value; }
    function setChecked(id, value) { var el = document.getElementById(id); if (el) el.checked = !!value; }
    function setValue(id, value) { var el = document.getElementById(id); if (el) el.value = String(value); }

    function activateTab(name, focus) {
      activeTab = name;
      Object.keys(tabMap).forEach(function (key) {
        var tab = tabMap[key];
        var content = panelMap[key];
        var active = key === name;
        if (tab) {
          tab.classList.toggle('is-active', active);
          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;
        }
        if (content) {
          content.classList.toggle('is-active', active);
          content.hidden = !active;
        }
      });
      if (focus && tabMap[name]) tabMap[name].focus();
    }

    function sync(settings) {
      settings = settings || readSettings();
      var mode = settings.wallpaperMode === 'fullscreen' ? 'fullscreen' : 'banner';
      var bannerButton = document.getElementById('wallpaper-mode-banner');
      var fullscreenButton = document.getElementById('wallpaper-mode-fullscreen');
      if (bannerButton) { bannerButton.classList.toggle('is-active', mode === 'banner'); bannerButton.setAttribute('aria-pressed', String(mode === 'banner')); }
      if (fullscreenButton) { fullscreenButton.classList.toggle('is-active', mode === 'fullscreen'); fullscreenButton.setAttribute('aria-pressed', String(mode === 'fullscreen')); }

      setValue('theme-hue-range', settings.themeHue ?? 340); setText('theme-hue-val', Math.round(settings.themeHue ?? 340) + '°');
      var opacityPercent = Math.round((settings.cardOpacity ?? 0.92) * 100);
      setValue('card-opacity-range', opacityPercent); setValue('fullscreen-card-opacity-range', opacityPercent);
      setText('card-opacity-val', opacityPercent + '%'); setText('fullscreen-card-opacity-val', opacityPercent + '%');
      setChecked('toggle-card-border', settings.cardBorder !== false); setChecked('toggle-card-follow-theme', settings.cardFollowTheme === true);
      setValue('background-blur-range', settings.backgroundBlur ?? 6); setText('background-blur-val', Math.round(settings.backgroundBlur ?? 6) + 'px');
      setChecked('toggle-banner-gradient', settings.bannerGradient !== false); setChecked('toggle-banner-title', settings.bannerTitle !== false);
      setValue('sakura-density-range', Math.round((settings.sakuraDensity ?? 0.65) * 100)); setText('sakura-density-val', Math.round((settings.sakuraDensity ?? 0.65) * 100) + '%');
      setValue('sakura-speed-range', Math.round((settings.sakuraSpeed ?? 1) * 100)); setText('sakura-speed-val', Number(settings.sakuraSpeed ?? 1).toFixed(2) + '×');
      setChecked('toggle-reduce-motion', settings.reduceMotion === true);
    }

    Object.keys(tabMap).forEach(function (name) {
      var tab = tabMap[name];
      if (!tab) return;
      tab.addEventListener('click', function () { activateTab(name, false); }, options);
    });

    panel.querySelector('.visual-tabs')?.addEventListener('keydown', function (event) {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      var current = Math.max(0, tabs.indexOf(document.activeElement));
      var next = event.key === 'ArrowRight' ? (current + 1) % tabs.length : (current - 1 + tabs.length) % tabs.length;
      var nextId = tabs[next].id.replace('visual-tab-', '');
      activateTab(nextId, true);
    }, options);

    document.getElementById('wallpaper-mode-banner')?.addEventListener('click', function () { sync(writeSettings({ wallpaperMode: 'banner' })); }, options);
    document.getElementById('wallpaper-mode-fullscreen')?.addEventListener('click', function () { sync(writeSettings({ wallpaperMode: 'fullscreen' })); }, options);

    var hueRange = document.getElementById('theme-hue-range');
    hueRange?.addEventListener('input', function () { var value = Number(this.value); setText('theme-hue-val', value + '°'); writeSettings({ themeHue: value }); }, options);

    function updateCardOpacity(value) {
      var percent = Math.max(20, Math.min(100, Number(value)));
      setValue('card-opacity-range', percent); setValue('fullscreen-card-opacity-range', percent);
      setText('card-opacity-val', percent + '%'); setText('fullscreen-card-opacity-val', percent + '%');
      writeSettings({ cardOpacity: percent / 100 });
    }
    document.getElementById('card-opacity-range')?.addEventListener('input', function () { updateCardOpacity(this.value); }, options);
    document.getElementById('fullscreen-card-opacity-range')?.addEventListener('input', function () { updateCardOpacity(this.value); }, options);

    document.getElementById('background-blur-range')?.addEventListener('input', function () { var value = Number(this.value); setText('background-blur-val', value + 'px'); writeSettings({ backgroundBlur: value }); }, options);
    document.getElementById('toggle-card-border')?.addEventListener('change', function () { writeSettings({ cardBorder: this.checked }); }, options);
    document.getElementById('toggle-card-follow-theme')?.addEventListener('change', function () { writeSettings({ cardFollowTheme: this.checked }); }, options);
    document.getElementById('toggle-banner-gradient')?.addEventListener('change', function () { writeSettings({ bannerGradient: this.checked }); }, options);
    document.getElementById('toggle-banner-title')?.addEventListener('change', function () { writeSettings({ bannerTitle: this.checked }); }, options);
    document.getElementById('sakura-density-range')?.addEventListener('input', function () { var value = Number(this.value) / 100; setText('sakura-density-val', Math.round(value * 100) + '%'); writeSettings({ sakuraDensity: value }); }, options);
    document.getElementById('sakura-speed-range')?.addEventListener('input', function () { var value = Number(this.value) / 100; setText('sakura-speed-val', value.toFixed(2) + '×'); writeSettings({ sakuraSpeed: value }); }, options);
    document.getElementById('toggle-reduce-motion')?.addEventListener('change', function () { writeSettings({ reduceMotion: this.checked }); }, options);

    document.getElementById('visual-reset-current')?.addEventListener('click', function () {
      if (activeTab === 'appearance') {
        sync(writeSettings({ themeHue: 340, cardOpacity: 0.92, cardBorder: true, cardFollowTheme: false }));
        return;
      }
      if (activeTab === 'effects') {
        var sakuraToggle = document.getElementById('toggle-sakura');
        if (sakuraToggle) { sakuraToggle.checked = true; sakuraToggle.dispatchEvent(new Event('change', { bubbles: true })); }
        sync(writeSettings({ sakura: true, sakuraDensity: 0.65, sakuraSpeed: 1, reduceMotion: false }));
        return;
      }
      var enabled = document.getElementById('toggle-enabled'); if (enabled) { enabled.checked = true; enabled.dispatchEvent(new Event('change', { bubbles: true })); }
      var autoplay = document.getElementById('toggle-autoplay'); if (autoplay) { autoplay.checked = true; autoplay.dispatchEvent(new Event('change', { bubbles: true })); }
      var interval = document.getElementById('interval-range'); if (interval) { interval.value = '15'; interval.dispatchEvent(new Event('input', { bubbles: true })); }
      var opacity = document.getElementById('opacity-range'); if (opacity) { opacity.value = '45'; opacity.dispatchEvent(new Event('input', { bubbles: true })); }
      var quality = document.getElementById('quality-select'); if (quality) { quality.value = 'high'; quality.dispatchEvent(new Event('change', { bubbles: true })); }
      sync(writeSettings({ wallpaperMode: 'banner', backgroundBlur: 6, cardOpacity: 0.92, bannerGradient: true, bannerTitle: true }));
    }, options);

    document.addEventListener('lidure:visual-settings-change', function (event) { sync(event.detail && event.detail.settings); }, options);
    activateTab(activeTab, false);
    sync();
  }

  if (!window.__visualSettingsPanelLifecycleBound) {
    window.__visualSettingsPanelLifecycleBound = true;
    document.addEventListener('astro:page-load', initVisualSettingsPanel);
  }
  initVisualSettingsPanel();
})();
</script>
