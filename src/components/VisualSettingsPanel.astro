<button
  class="hero-settings-btn"
  id="hero-settings-btn"
  transition:persist
  type="button"
  aria-label="背景与外观设置"
  aria-controls="hero-settings-panel"
  aria-expanded="false"
  title="背景与外观设置"
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="3"/>
    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-2.82-.33A1.65 1.65 0 0 0 13 20.83V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 7.92 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 3.6 15.08 1.65 1.65 0 0 0 2.09 14H2a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 3.6 8.92a1.65 1.65 0 0 0-.33-1.82l-.06-.06A2 2 0 0 1 6.04 4.2l.06.06a1.65 1.65 0 0 0 1.82.33A1.65 1.65 0 0 0 9 3.09V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1.08 1.5 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82A1.65 1.65 0 0 0 19.91 10H20a2 2 0 0 1 0 4h-.09A1.65 1.65 0 0 0 19.4 15Z"/>
  </svg>
</button>

<div class="hero-settings-panel" id="hero-settings-panel" transition:persist role="dialog" aria-labelledby="visual-settings-title">
  <header class="settings-header">
    <div class="settings-heading-copy">
      <span class="settings-title" id="visual-settings-title">背景与外观</span>
      <span class="settings-helper">Customize your space</span>
    </div>
    <button class="settings-close" id="settings-close" type="button" aria-label="关闭">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17"/></svg>
    </button>
  </header>

  <div class="visual-tabs" role="tablist" aria-label="背景与外观设置分类">
    <button id="visual-tab-appearance" class="visual-tab is-active" type="button" role="tab" aria-selected="true" aria-controls="visual-panel-appearance" tabindex="0">外观</button>
    <button id="visual-tab-background" class="visual-tab" type="button" role="tab" aria-selected="false" aria-controls="visual-panel-background" tabindex="-1">背景</button>
    <button id="visual-tab-effects" class="visual-tab" type="button" role="tab" aria-selected="false" aria-controls="visual-panel-effects" tabindex="-1">特效</button>
  </div>

  <div class="settings-body">
    <section id="visual-panel-appearance" class="visual-tab-panel is-active" role="tabpanel" aria-labelledby="visual-tab-appearance">
      <div class="settings-card">
        <div class="settings-card-title"><span>页面外观</span><small>Surface</small></div>
        <div class="setting-group">
          <div class="setting-heading"><span class="setting-label">主题色相</span><span class="range-value" id="theme-hue-val">340°</span></div>
          <input type="range" id="theme-hue-range" min="0" max="360" step="1" value="340" aria-label="主题色相" />
        </div>
        <div class="setting-group">
          <div class="setting-heading"><span class="setting-label">卡片透明度</span><span class="range-value" id="card-opacity-val">92%</span></div>
          <input type="range" id="card-opacity-range" min="20" max="100" step="1" value="92" aria-label="卡片透明度" />
        </div>
        <div class="setting-row"><div><span class="setting-label">显示卡片边框</span><small>保留轻量轮廓</small></div><label class="toggle-switch"><input type="checkbox" id="toggle-card-border" checked /><span class="toggle-track"></span></label></div>
        <div class="setting-row"><div><span class="setting-label">卡片跟随主题色</span><small>仅用于轻微强调</small></div><label class="toggle-switch"><input type="checkbox" id="toggle-card-follow-theme" /><span class="toggle-track"></span></label></div>
      </div>
    </section>

    <section id="visual-panel-background" class="visual-tab-panel" role="tabpanel" aria-labelledby="visual-tab-background" hidden>
      <div class="settings-card">
        <div class="settings-card-title"><span>壁纸显示</span><small>Wallpaper</small></div>
        <div class="setting-group">
          <div class="segmented-control three wallpaper-mode-switch" role="group" aria-label="壁纸显示模式">
            <button id="wallpaper-mode-banner" class="segment-option wallpaper-mode-option is-active" type="button" aria-pressed="true">横幅</button>
            <button id="wallpaper-mode-fullscreen" class="segment-option wallpaper-mode-option" type="button" aria-pressed="false">全屏</button>
            <button id="wallpaper-mode-overlay" class="segment-option wallpaper-mode-option" type="button" aria-pressed="false">覆盖透明</button>
          </div>
        </div>
        <div class="setting-row"><div><span class="setting-label">启用背景</span><small>显示当前背景媒体</small></div><label class="toggle-switch"><input type="checkbox" id="toggle-enabled" checked /><span class="toggle-track"></span></label></div>
        <div class="setting-row"><div><span class="setting-label">自动轮播</span><small>按间隔切换背景</small></div><label class="toggle-switch"><input type="checkbox" id="toggle-autoplay" checked /><span class="toggle-track"></span></label></div>
        <div class="setting-group">
          <div class="setting-heading"><span class="setting-label">切换间隔</span><span class="range-value" id="interval-val">15s</span></div>
          <input type="range" id="interval-range" min="2" max="20" step="1" value="15" aria-label="切换间隔" />
        </div>
        <div class="setting-group">
          <div class="setting-heading"><span class="setting-label">遮罩强度</span><span class="range-value" id="opacity-val">45%</span></div>
          <input type="range" id="opacity-range" min="0" max="80" step="5" value="45" aria-label="遮罩强度" />
        </div>
        <div class="setting-group mode-fullscreen-only">
          <div class="setting-heading"><span class="setting-label">背景模糊</span><span class="range-value" id="background-blur-val">6px</span></div>
          <input type="range" id="background-blur-range" min="0" max="20" step="1" value="6" aria-label="透明壁纸背景模糊" />
        </div>
        <div class="setting-group mode-fullscreen-only">
          <div class="setting-heading"><span class="setting-label">卡片透明度</span><span class="range-value" id="fullscreen-card-opacity-val">92%</span></div>
          <input type="range" id="fullscreen-card-opacity-range" min="20" max="100" step="1" value="92" aria-label="透明壁纸卡片透明度" />
        </div>
      </div>

      <div class="settings-card mode-banner-only">
        <div class="settings-card-title"><span>横幅过渡</span><small>Banner</small></div>
        <div class="setting-row"><div><span class="setting-label">水波纹</span><small>四层柔和动态边界</small></div><label class="toggle-switch"><input type="checkbox" id="toggle-wave-enabled" checked /><span class="toggle-track"></span></label></div>
        <div class="setting-group">
          <span class="setting-label">波浪强度</span>
          <div class="segmented-control three" role="group" aria-label="波浪强度">
            <button id="wave-strength-soft" class="segment-option" type="button" aria-pressed="false">柔和</button>
            <button id="wave-strength-standard" class="segment-option is-active" type="button" aria-pressed="true">标准</button>
            <button id="wave-strength-strong" class="segment-option" type="button" aria-pressed="false">明显</button>
          </div>
        </div>
        <div class="setting-group">
          <span class="setting-label">动画速度</span>
          <div class="segmented-control three" role="group" aria-label="波浪速度">
            <button id="wave-speed-slow" class="segment-option" type="button" aria-pressed="false">慢</button>
            <button id="wave-speed-normal" class="segment-option is-active" type="button" aria-pressed="true">标准</button>
            <button id="wave-speed-fast" class="segment-option" type="button" aria-pressed="false">快</button>
          </div>
        </div>
        <div class="setting-row"><div><span class="setting-label">移动端水波纹</span><small>小屏幕仍显示过渡</small></div><label class="toggle-switch"><input type="checkbox" id="toggle-wave-mobile" checked /><span class="toggle-track"></span></label></div>
        <div class="setting-row"><div><span class="setting-label">Banner 渐变</span><small>保留底部柔化</small></div><label class="toggle-switch"><input type="checkbox" id="toggle-banner-gradient" checked /><span class="toggle-track"></span></label></div>
        <div class="setting-row"><div><span class="setting-label">Banner 标题</span><small>显示页面标题与说明</small></div><label class="toggle-switch"><input type="checkbox" id="toggle-banner-title" checked /><span class="toggle-track"></span></label></div>
      </div>

      <div class="settings-card media-settings-card">
        <div class="settings-card-title"><span>背景媒体</span><small>Library</small></div>
        <div class="setting-group compact">
          <span class="setting-label">上传画质</span>
          <select class="quality-select" id="quality-select">
            <option value="high">高质量 · JPEG 95%</option>
            <option value="medium">中等 · JPEG 75%</option>
            <option value="original">原始画质</option>
          </select>
        </div>
        <label class="upload-zone" id="upload-zone">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M5 14v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4"/></svg>
          <span><strong>添加图片 / 视频</strong><small>点击选择或拖入图片</small></span>
          <input type="file" accept="image/*" multiple id="file-input" hidden />
        </label>
        <div class="url-row"><input type="url" id="url-input" placeholder="粘贴图片 / 视频 URL" aria-label="背景媒体 URL" /><button class="url-add-btn" id="url-add-btn" type="button">添加</button></div>
        <button class="media-manage-btn" id="media-manage-btn" type="button">
          <span class="media-library-icon" aria-hidden="true">▦</span>
          <span class="media-library-copy"><strong>管理背景库</strong><small><span class="media-count" id="media-count">0</span> 个背景媒体</small></span>
          <span class="media-library-arrow" aria-hidden="true">›</span>
        </button>
      </div>
    </section>

    <section id="visual-panel-effects" class="visual-tab-panel" role="tabpanel" aria-labelledby="visual-tab-effects" hidden>
      <div class="settings-card">
        <div class="settings-card-title"><span>页面特效</span><small>Effects</small></div>
        <div class="setting-row"><div><span class="setting-label">樱花飘落</span><small>Canvas 花瓣效果</small></div><label class="toggle-switch"><input type="checkbox" id="toggle-sakura" /><span class="toggle-track"></span></label></div>
        <div class="setting-group">
          <div class="setting-heading"><span class="setting-label">樱花密度</span><span class="range-value" id="sakura-density-val">65%</span></div>
          <input type="range" id="sakura-density-range" min="0" max="100" step="5" value="65" aria-label="樱花密度" />
        </div>
        <div class="setting-group">
          <div class="setting-heading"><span class="setting-label">飘落速度</span><span class="range-value" id="sakura-speed-val">1.00×</span></div>
          <input type="range" id="sakura-speed-range" min="25" max="200" step="5" value="100" aria-label="樱花飘落速度" />
        </div>
        <div class="setting-row"><div><span class="setting-label">减少动态效果</span><small>停止持续装饰动画</small></div><label class="toggle-switch"><input type="checkbox" id="toggle-reduce-motion" /><span class="toggle-track"></span></label></div>
      </div>
    </section>
  </div>

  <footer class="settings-footer"><button id="visual-reset-current" class="settings-reset" type="button">恢复当前页默认</button></footer>
</div>

<style>
  .hero-settings-btn {
    position: fixed; left: 28px; top: 90px; z-index: var(--z-floating);
    width: 42px; height: 42px; display: grid; place-items: center;
    border: 1px solid color-mix(in srgb, var(--border, rgba(255,255,255,.14)) 80%, transparent);
    border-radius: 13px; color: var(--text-soft, #d8d8df);
    background: color-mix(in srgb, var(--panel-bg, #1d1d24) 88%, transparent);
    box-shadow: 0 10px 28px rgba(5, 6, 14, .14);
    backdrop-filter: blur(18px) saturate(1.08); -webkit-backdrop-filter: blur(18px) saturate(1.08);
    cursor: pointer; transition: transform 180ms ease, border-color 180ms ease, color 180ms ease, background 180ms ease;
  }
  .hero-settings-btn:hover { transform: translateY(-1px); color: hsl(var(--theme-hue, 340) 72% 66%); border-color: hsl(var(--theme-hue, 340) 60% 58% / .35); }
  .hero-settings-btn svg { width: 18px; height: 18px; }

  .hero-settings-panel {
    position: fixed; left: 28px; top: 142px; z-index: var(--z-overlay);
    width: min(445px, calc(100vw - 40px)); max-height: calc(100dvh - 164px);
    display: none; flex-direction: column; overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--border, rgba(255,255,255,.12)) 76%, transparent);
    border-radius: 22px; color: var(--text, #eeeeF2);
    background: color-mix(in srgb, var(--panel-bg, #19191f) 93%, transparent);
    box-shadow: 0 22px 64px rgba(4, 6, 16, .22);
    backdrop-filter: blur(24px) saturate(1.08); -webkit-backdrop-filter: blur(24px) saturate(1.08);
  }
  .hero-settings-panel.open { display: flex; animation: visual-panel-in 190ms ease-out; }
  @keyframes visual-panel-in { from { opacity: 0; transform: translateY(-6px) scale(.99); } to { opacity: 1; transform: none; } }

  .settings-header { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 18px 19px 12px; }
  .settings-heading-copy { display: grid; gap: 3px; }
  .settings-title { font-size: 1.02rem; font-weight: 750; letter-spacing: .01em; }
  .settings-helper { color: var(--muted, #92929d); font-size: .67rem; letter-spacing: .045em; }
  .settings-close { width: 34px; height: 34px; display: grid; place-items: center; border: 0; border-radius: 10px; color: var(--muted, #92929d); background: transparent; cursor: pointer; }
  .settings-close:hover { color: var(--text, #eee); background: color-mix(in srgb, var(--text, #fff) 7%, transparent); }
  .settings-close svg { width: 17px; height: 17px; }

  .visual-tabs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; margin: 0 14px 12px; padding: 4px; border-radius: 13px; background: color-mix(in srgb, var(--text, #fff) 5%, transparent); }
  .visual-tab { min-height: 34px; border: 0; border-radius: 9px; color: var(--muted, #9696a0); background: transparent; font: inherit; font-size: .79rem; font-weight: 650; cursor: pointer; transition: background 170ms ease, color 170ms ease, box-shadow 170ms ease; }
  .visual-tab.is-active { color: hsl(var(--theme-hue, 340) 70% 68%); background: color-mix(in srgb, hsl(var(--theme-hue, 340) 70% 62%) 13%, var(--panel-bg, #222)); box-shadow: inset 0 0 0 1px hsl(var(--theme-hue, 340) 65% 62% / .14); }

  .settings-body { min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 0 14px 14px; scrollbar-width: thin; }
  .visual-tab-panel { display: grid; gap: 10px; }
  .visual-tab-panel[hidden] { display: none; }
  .settings-card { display: grid; gap: 12px; padding: 14px; border: 1px solid color-mix(in srgb, var(--border, rgba(255,255,255,.10)) 72%, transparent); border-radius: 15px; background: color-mix(in srgb, var(--text, #fff) 3.5%, transparent); }
  .settings-card-title { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding-bottom: 2px; }
  .settings-card-title > span { font-size: .83rem; font-weight: 720; }
  .settings-card-title > small { color: var(--muted, #9696a0); font-size: .61rem; letter-spacing: .08em; text-transform: uppercase; }

  .setting-group { display: grid; gap: 8px; }
  .setting-group.compact { grid-template-columns: minmax(0, 1fr) minmax(150px, 48%); align-items: center; }
  .setting-heading, .setting-row { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
  .setting-row > div { min-width: 0; display: grid; gap: 2px; }
  .setting-row small, .upload-zone small, .media-library-copy small { color: var(--muted, #92929d); font-size: .65rem; line-height: 1.4; }
  .setting-label { color: var(--text, #eee); font-size: .77rem; font-weight: 620; }
  .range-value { color: hsl(var(--theme-hue, 340) 66% 68%); font-size: .68rem; font-variant-numeric: tabular-nums; }

  input[type="range"] { width: 100%; height: 4px; accent-color: hsl(var(--theme-hue, 340) 68% 62%); cursor: pointer; }
  .quality-select, .url-row input { min-width: 0; border: 1px solid color-mix(in srgb, var(--border, rgba(255,255,255,.12)) 80%, transparent); border-radius: 10px; color: var(--text, #eee); background: color-mix(in srgb, var(--panel-bg, #18181e) 92%, transparent); font: inherit; font-size: .72rem; outline: none; }
  .quality-select { width: 100%; padding: 8px 30px 8px 10px; }
  .quality-select:focus, .url-row input:focus { border-color: hsl(var(--theme-hue, 340) 64% 62% / .5); box-shadow: 0 0 0 3px hsl(var(--theme-hue, 340) 64% 62% / .09); }

  .toggle-switch { position: relative; flex: 0 0 auto; width: 38px; height: 22px; cursor: pointer; }
  .toggle-switch input { position: absolute; opacity: 0; pointer-events: none; }
  .toggle-track { position: absolute; inset: 0; border: 1px solid color-mix(in srgb, var(--border, rgba(255,255,255,.15)) 80%, transparent); border-radius: 999px; background: color-mix(in srgb, var(--text, #fff) 7%, transparent); transition: background 170ms ease, border-color 170ms ease; }
  .toggle-track::after { content: ''; position: absolute; left: 3px; top: 3px; width: 14px; height: 14px; border-radius: 50%; background: color-mix(in srgb, var(--text, #fff) 72%, #fff); box-shadow: 0 1px 4px rgba(0,0,0,.2); transition: transform 170ms ease, background 170ms ease; }
  .toggle-switch input:checked + .toggle-track { border-color: hsl(var(--theme-hue, 340) 68% 58% / .5); background: hsl(var(--theme-hue, 340) 68% 58% / .48); }
  .toggle-switch input:checked + .toggle-track::after { transform: translateX(16px); background: #fff; }
  .toggle-switch input:focus-visible + .toggle-track { outline: 2px solid hsl(var(--theme-hue, 340) 68% 64%); outline-offset: 3px; }

  .segmented-control { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3px; padding: 3px; border: 1px solid color-mix(in srgb, var(--border, rgba(255,255,255,.1)) 62%, transparent); border-radius: 11px; background: color-mix(in srgb, var(--text, #fff) 3%, transparent); }
  .segmented-control.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .segment-option { min-height: 31px; padding: 4px 8px; border: 0; border-radius: 8px; color: var(--muted, #92929d); background: transparent; font: inherit; font-size: .69rem; font-weight: 650; cursor: pointer; }
  .segment-option.is-active { color: hsl(var(--theme-hue, 340) 68% 70%); background: color-mix(in srgb, hsl(var(--theme-hue, 340) 68% 60%) 13%, var(--panel-bg, #222)); }

  .upload-zone { display: flex; align-items: center; gap: 11px; min-height: 58px; padding: 11px 12px; border: 1px dashed color-mix(in srgb, var(--border, rgba(255,255,255,.13)) 90%, transparent); border-radius: 12px; color: var(--muted, #92929d); background: color-mix(in srgb, var(--text, #fff) 2%, transparent); cursor: pointer; transition: border-color 170ms ease, background 170ms ease, color 170ms ease; }
  .upload-zone:hover { color: hsl(var(--theme-hue, 340) 68% 68%); border-color: hsl(var(--theme-hue, 340) 60% 62% / .4); background: hsl(var(--theme-hue, 340) 55% 55% / .055); }
  .upload-zone svg { width: 22px; height: 22px; flex: 0 0 auto; }
  .upload-zone > span { display: grid; gap: 2px; }
  .upload-zone strong { color: inherit; font-size: .74rem; }
  .url-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 7px; }
  .url-row input { width: 100%; padding: 9px 10px; }
  .url-add-btn, .settings-reset { border: 1px solid color-mix(in srgb, var(--border, rgba(255,255,255,.12)) 80%, transparent); border-radius: 9px; color: var(--text, #eee); background: color-mix(in srgb, var(--text, #fff) 4%, transparent); font: inherit; font-size: .69rem; font-weight: 650; cursor: pointer; }
  .url-add-btn { padding: 0 13px; }
  .url-add-btn:hover, .settings-reset:hover { color: hsl(var(--theme-hue, 340) 68% 68%); border-color: hsl(var(--theme-hue, 340) 58% 62% / .34); }

  .media-manage-btn { width: 100%; display: grid; grid-template-columns: 32px minmax(0, 1fr) auto; align-items: center; gap: 10px; padding: 10px; border: 1px solid color-mix(in srgb, var(--border, rgba(255,255,255,.12)) 70%, transparent); border-radius: 12px; color: var(--text, #eee); background: color-mix(in srgb, var(--text, #fff) 2.5%, transparent); text-align: left; cursor: pointer; }
  .media-library-icon { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 9px; color: hsl(var(--theme-hue, 340) 68% 68%); background: hsl(var(--theme-hue, 340) 60% 60% / .09); }
  .media-library-copy { display: grid; gap: 1px; }
  .media-library-copy strong { font-size: .73rem; }
  .media-library-arrow { color: var(--muted, #92929d); font-size: 1.25rem; }

  .mode-fullscreen-only { display: none; }
  :global(html[data-wallpaper-mode="fullscreen"]) .mode-fullscreen-only,
  :global(html[data-wallpaper-mode="overlay"]) .mode-fullscreen-only { display: grid; }
  :global(html[data-wallpaper-mode="fullscreen"]) .mode-banner-only,
  :global(html[data-wallpaper-mode="overlay"]) .mode-banner-only { display: none; }

  .settings-footer { padding: 10px 14px 14px; border-top: 1px solid color-mix(in srgb, var(--border, rgba(255,255,255,.1)) 60%, transparent); }
  .settings-reset { width: 100%; min-height: 34px; }

  .visual-tab:focus-visible, .settings-close:focus-visible, .segment-option:focus-visible, .url-add-btn:focus-visible, .media-manage-btn:focus-visible, .settings-reset:focus-visible, .hero-settings-btn:focus-visible { outline: 2px solid hsl(var(--theme-hue, 340) 68% 64%); outline-offset: 2px; }

  @media (max-width: 720px) {
    .hero-settings-btn { left: 16px; top: 80px; width: 38px; height: 38px; border-radius: 12px; }
    .hero-settings-panel { left: 0; right: 0; top: auto; bottom: 0; width: 100%; max-height: 86dvh; border-radius: 24px 24px 0 0; padding-bottom: env(safe-area-inset-bottom); }
    .hero-settings-panel::before { content: ''; width: 36px; height: 4px; margin: 7px auto 0; border-radius: 999px; background: color-mix(in srgb, var(--text, #fff) 18%, transparent); }
    .settings-header { padding-top: 10px; }
    .settings-body { overflow-x: hidden; }
  }

  @media (max-width: 420px) {
    .settings-card { padding: 12px; }
    .setting-group.compact { grid-template-columns: 1fr; }
    .settings-header { padding-inline: 15px; }
    .visual-tabs { margin-inline: 11px; }
    .settings-body { padding-inline: 11px; }
    .settings-footer { padding-inline: 11px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-settings-panel.open { animation: none; }
    .hero-settings-btn, .toggle-track, .toggle-track::after, .visual-tab { transition: none; }
  }
</style>

<script>
// @ts-nocheck
(function () {
  function initVisualSettingsPanel() {
    var panel = document.getElementById('hero-settings-panel');
    if (!panel) return;
    var settingsButton = document.getElementById('hero-settings-btn');
    var closeButton = document.getElementById('settings-close');
    var visualWindow = window;

    if (visualWindow.__visualSettingsPanelController) visualWindow.__visualSettingsPanelController.abort();
    var controller = typeof AbortController === 'function' ? new AbortController() : null;
    visualWindow.__visualSettingsPanelController = controller;
    var options = controller ? { signal: controller.signal } : undefined;

    if (visualWindow.__visualSettingsPanelExpandedObserver) visualWindow.__visualSettingsPanelExpandedObserver.disconnect();
    function syncExpandedState() {
      if (settingsButton) settingsButton.setAttribute('aria-expanded', String(panel.classList.contains('open')));
    }
    var expandedObserver = new MutationObserver(syncExpandedState);
    expandedObserver.observe(panel, { attributes: true, attributeFilter: ['class'] });
    visualWindow.__visualSettingsPanelExpandedObserver = expandedObserver;
    syncExpandedState();

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && panel.classList.contains('open')) {
        event.preventDefault();
        if (closeButton) closeButton.click();
        else panel.classList.remove('open');
        syncExpandedState();
        if (settingsButton) settingsButton.focus();
      }
    }, options);

    var tabs = Array.from(panel.querySelectorAll('[role="tab"]'));
    var activeTab = 'appearance';
    var tabMap = {
      appearance: document.getElementById('visual-tab-appearance'),
      background: document.getElementById('visual-tab-background'),
      effects: document.getElementById('visual-tab-effects')
    };
    var panelMap = {
      appearance: document.getElementById('visual-panel-appearance'),
      background: document.getElementById('visual-panel-background'),
      effects: document.getElementById('visual-panel-effects')
    };

    function bridge() { return visualWindow.__lidureVisualSettings; }
    function readSettings() { return bridge() ? bridge().read() : {}; }
    function writeSettings(patch) { return bridge() ? bridge().write(patch) : null; }
    function setText(id, value) { var el = document.getElementById(id); if (el) el.textContent = value; }
    function setChecked(id, value) { var el = document.getElementById(id); if (el) el.checked = !!value; }
    function setValue(id, value) { var el = document.getElementById(id); if (el) el.value = String(value); }
    function setSegment(prefix, value, values) {
      values.forEach(function (entry) {
        var button = document.getElementById(prefix + entry);
        if (!button) return;
        var active = entry === value;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
    }

    function activateTab(name, focus) {
      activeTab = name;
      Object.keys(tabMap).forEach(function (key) {
        var tab = tabMap[key];
        var content = panelMap[key];
        var active = key === name;
        if (tab) {
          tab.classList.toggle('is-active', active);
          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;
        }
        if (content) {
          content.classList.toggle('is-active', active);
          content.hidden = !active;
        }
      });
      if (focus && tabMap[name]) tabMap[name].focus();
    }

    function sync(settings) {
      settings = settings || readSettings();
      var mode = settings.wallpaperMode === 'fullscreen' || settings.wallpaperMode === 'overlay' ? settings.wallpaperMode : 'banner';
      var bannerButton = document.getElementById('wallpaper-mode-banner');
      var fullscreenButton = document.getElementById('wallpaper-mode-fullscreen');
      var overlayButton = document.getElementById('wallpaper-mode-overlay');
      if (bannerButton) { bannerButton.classList.toggle('is-active', mode === 'banner'); bannerButton.setAttribute('aria-pressed', String(mode === 'banner')); }
      if (fullscreenButton) { fullscreenButton.classList.toggle('is-active', mode === 'fullscreen'); fullscreenButton.setAttribute('aria-pressed', String(mode === 'fullscreen')); }
      if (overlayButton) { overlayButton.classList.toggle('is-active', mode === 'overlay'); overlayButton.setAttribute('aria-pressed', String(mode === 'overlay')); }

      setValue('theme-hue-range', settings.themeHue ?? 340); setText('theme-hue-val', Math.round(settings.themeHue ?? 340) + '°');
      var cardOpacity = Math.round((settings.cardOpacity ?? 0.92) * 100);
      setValue('card-opacity-range', cardOpacity); setValue('fullscreen-card-opacity-range', cardOpacity);
      setText('card-opacity-val', cardOpacity + '%'); setText('fullscreen-card-opacity-val', cardOpacity + '%');
      setChecked('toggle-card-border', settings.cardBorder !== false);
      setChecked('toggle-card-follow-theme', settings.cardFollowTheme === true);
      setValue('background-blur-range', settings.backgroundBlur ?? 6); setText('background-blur-val', Math.round(settings.backgroundBlur ?? 6) + 'px');
      setChecked('toggle-banner-gradient', settings.bannerGradient !== false);
      setChecked('toggle-banner-title', settings.bannerTitle !== false);
      setChecked('toggle-wave-enabled', settings.waveEnabled !== false);
      setChecked('toggle-wave-mobile', settings.waveMobile !== false);
      setSegment('wave-strength-', settings.waveStrength || 'standard', ['soft', 'standard', 'strong']);
      setSegment('wave-speed-', settings.waveSpeed || 'normal', ['slow', 'normal', 'fast']);
      setValue('sakura-density-range', Math.round((settings.sakuraDensity ?? 0.65) * 100)); setText('sakura-density-val', Math.round((settings.sakuraDensity ?? 0.65) * 100) + '%');
      setValue('sakura-speed-range', Math.round((settings.sakuraSpeed ?? 1) * 100)); setText('sakura-speed-val', Number(settings.sakuraSpeed ?? 1).toFixed(2) + '×');
      setChecked('toggle-reduce-motion', settings.reduceMotion === true);
    }

    Object.keys(tabMap).forEach(function (name) {
      var tab = tabMap[name];
      if (tab) tab.addEventListener('click', function () { activateTab(name, false); }, options);
    });

    panel.querySelector('.visual-tabs')?.addEventListener('keydown', function (event) {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      var current = Math.max(0, tabs.indexOf(document.activeElement));
      var next = event.key === 'ArrowRight' ? (current + 1) % tabs.length : (current - 1 + tabs.length) % tabs.length;
      activateTab(tabs[next].id.replace('visual-tab-', ''), true);
    }, options);

    document.getElementById('wallpaper-mode-banner')?.addEventListener('click', function () { sync(writeSettings({ wallpaperMode: 'banner' })); }, options);
    document.getElementById('wallpaper-mode-fullscreen')?.addEventListener('click', function () { sync(writeSettings({ wallpaperMode: 'fullscreen' })); }, options);
    document.getElementById('wallpaper-mode-overlay')?.addEventListener('click', function () { sync(writeSettings({ wallpaperMode: 'overlay' })); }, options);
    document.getElementById('theme-hue-range')?.addEventListener('input', function () { var value = Number(this.value); setText('theme-hue-val', value + '°'); writeSettings({ themeHue: value }); }, options);

    function updateCardOpacity(value) {
      var percent = Math.max(20, Math.min(100, Number(value)));
      setValue('card-opacity-range', percent); setValue('fullscreen-card-opacity-range', percent);
      setText('card-opacity-val', percent + '%'); setText('fullscreen-card-opacity-val', percent + '%');
      writeSettings({ cardOpacity: percent / 100 });
    }
    document.getElementById('card-opacity-range')?.addEventListener('input', function () { updateCardOpacity(this.value); }, options);
    document.getElementById('fullscreen-card-opacity-range')?.addEventListener('input', function () { updateCardOpacity(this.value); }, options);
    document.getElementById('background-blur-range')?.addEventListener('input', function () { var value = Number(this.value); setText('background-blur-val', value + 'px'); writeSettings({ backgroundBlur: value }); }, options);
    document.getElementById('toggle-card-border')?.addEventListener('change', function () { writeSettings({ cardBorder: this.checked }); }, options);
    document.getElementById('toggle-card-follow-theme')?.addEventListener('change', function () { writeSettings({ cardFollowTheme: this.checked }); }, options);
    document.getElementById('toggle-banner-gradient')?.addEventListener('change', function () { writeSettings({ bannerGradient: this.checked }); }, options);
    document.getElementById('toggle-banner-title')?.addEventListener('change', function () { writeSettings({ bannerTitle: this.checked }); }, options);
    document.getElementById('toggle-wave-enabled')?.addEventListener('change', function () { sync(writeSettings({ waveEnabled: this.checked })); }, options);
    document.getElementById('toggle-wave-mobile')?.addEventListener('change', function () { sync(writeSettings({ waveMobile: this.checked })); }, options);

    ['soft', 'standard', 'strong'].forEach(function (value) {
      document.getElementById('wave-strength-' + value)?.addEventListener('click', function () { sync(writeSettings({ waveStrength: value })); }, options);
    });
    ['slow', 'normal', 'fast'].forEach(function (value) {
      document.getElementById('wave-speed-' + value)?.addEventListener('click', function () { sync(writeSettings({ waveSpeed: value })); }, options);
    });

    document.getElementById('sakura-density-range')?.addEventListener('input', function () { var value = Number(this.value) / 100; setText('sakura-density-val', Math.round(value * 100) + '%'); writeSettings({ sakuraDensity: value }); }, options);
    document.getElementById('sakura-speed-range')?.addEventListener('input', function () { var value = Number(this.value) / 100; setText('sakura-speed-val', value.toFixed(2) + '×'); writeSettings({ sakuraSpeed: value }); }, options);
    document.getElementById('toggle-reduce-motion')?.addEventListener('change', function () { writeSettings({ reduceMotion: this.checked }); }, options);

    document.getElementById('visual-reset-current')?.addEventListener('click', function () {
      if (activeTab === 'appearance') {
        sync(writeSettings({ themeHue: 340, cardOpacity: 0.92, cardBorder: true, cardFollowTheme: false }));
        return;
      }
      if (activeTab === 'effects') {
        var sakuraToggle = document.getElementById('toggle-sakura');
        if (sakuraToggle) { sakuraToggle.checked = true; sakuraToggle.dispatchEvent(new Event('change', { bubbles: true })); }
        sync(writeSettings({ sakura: true, sakuraDensity: 0.65, sakuraSpeed: 1, reduceMotion: false }));
        return;
      }
      var enabled = document.getElementById('toggle-enabled'); if (enabled) { enabled.checked = true; enabled.dispatchEvent(new Event('change', { bubbles: true })); }
      var autoplay = document.getElementById('toggle-autoplay'); if (autoplay) { autoplay.checked = true; autoplay.dispatchEvent(new Event('change', { bubbles: true })); }
      var interval = document.getElementById('interval-range'); if (interval) { interval.value = '15'; interval.dispatchEvent(new Event('input', { bubbles: true })); }
      var opacity = document.getElementById('opacity-range'); if (opacity) { opacity.value = '45'; opacity.dispatchEvent(new Event('input', { bubbles: true })); }
      var quality = document.getElementById('quality-select'); if (quality) { quality.value = 'high'; quality.dispatchEvent(new Event('change', { bubbles: true })); }
      sync(writeSettings({
        wallpaperMode: 'banner', backgroundBlur: 6, cardOpacity: 0.92,
        bannerGradient: true, bannerTitle: true,
        waveEnabled: true, waveStrength: 'standard', waveSpeed: 'normal', waveMobile: true
      }));
    }, options);

    document.addEventListener('lidure:visual-settings-change', function (event) { sync(event.detail && event.detail.settings); }, options);
    activateTab(activeTab, false);
    sync();
  }

  if (!window.__visualSettingsPanelLifecycleBound) {
    window.__visualSettingsPanelLifecycleBound = true;
    document.addEventListener('astro:page-load', initVisualSettingsPanel);
  }
  initVisualSettingsPanel();
})();
</script>
