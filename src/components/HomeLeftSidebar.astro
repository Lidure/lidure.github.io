---

<aside class="home-left-sidebar" aria-label="站点资料与导航">
  <SidebarWidget title="关于我" icon="♡" tone="pink" className="profile-widget">
    <div class="sidebar-profile">
      <div class="profile-avatar-frame">
        <img src="/p0-256.webp" alt="搁浅 的头像" width="256" height="256" />
      </div>
      <div class="sidebar-profile-copy">
        <strong>搁浅</strong>
        <span class="profile-name-accent" aria-hidden="true"></span>
        <p>研究生 · PJSK / 游戏 / Vibe coding，偶尔记录项目和日常。</p>
      </div>
      <nav class="profile-social-links" aria-label="联系方式">
        {socialLinks.map((item) => (
          <a
            class="profile-social-link"
            href={item.href}
            target="_blank"
            rel="noreferrer"
            aria-label={item.label}
            title={item.label}
          >
            <svg class="profile-social-icon" viewBox={item.viewBox} aria-hidden="true" focusable="false">
              <path d={item.path} />
            </svg>
          </a>
        ))}
      </nav>
    </div>
    <dl class="sidebar-stats-grid">
      <div><dt>文章</dt><dd>{postCount}</dd></div>
      <div><dt>标签</dt><dd>{tagCount}</dd></div>
    </dl>
  </SidebarWidget>

  <SidebarWidget title="快速入口" icon="⌁" tone="purple">
    <nav class="sidebar-link-list" aria-label="首页快速入口">
      <a href={featuredHref}><span>精选文章</span><span>→</span></a>
      <a href="/posts"><span>文章归档</span><span>→</span></a>
      <a href="/moments"><span>碎碎念</span><span>→</span></a>
      <a href="/messages"><span>留言板</span><span>→</span></a>
    </nav>
  </SidebarWidget>

  <SidebarWidget title="常用标签" icon="#" tone="cyan">
    <div class="sidebar-tag-cloud">
      {topTags.slice(0, 7).map((item) => (
        <a href={`/tags/${encodeURIComponent(item.tag)}`}>
          <span>#{item.tag}</span><small>{item.count}</small>
        </a>
      ))}
    </div>
    <a class="sidebar-widget-more" href="/tags">查看全部标签 →</a>
  </SidebarWidget>
</aside>

<style is:global>
  body.layout-standard .profile-avatar-frame {
    width: 100%;
    aspect-ratio: 1 / 1;
    margin-bottom: 12px;
    overflow: hidden;
    border-radius: 12px;
    background: var(--firefly-btn-bg, var(--standard-card-soft));
    box-shadow: 0 0 0 1px color-mix(in oklch, var(--firefly-primary, var(--standard-accent)) 12%, transparent);
  }

  body.layout-standard .profile-avatar-frame img {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    border: 0;
    border-radius: inherit;
    object-fit: cover;
    box-shadow: none;
  }

  body.layout-standard .sidebar-profile-copy {
    width: 100%;
  }

  body.layout-standard .sidebar-profile-copy strong {
    font-size: 1.18rem;
  }

  body.layout-standard .profile-name-accent {
    display: block;
    width: 20px;
    height: 4px;
    margin: 6px auto 8px;
    border-radius: 999px;
    background: var(--firefly-primary, var(--standard-accent));
  }

  body.layout-standard .sidebar-profile-copy p {
    margin-top: 0;
  }

  body.layout-standard .profile-social-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 12px;
  }

  body.layout-standard .profile-social-link {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 10px;
    background: var(--firefly-btn-bg, var(--standard-card-soft));
    color: var(--firefly-btn-content, var(--standard-accent));
    text-decoration: none;
    box-shadow: inset 0 0 0 1px color-mix(in oklch, currentColor 7%, transparent);
    transition: transform 160ms ease, color 160ms ease, background 160ms ease;
  }

  body.layout-standard .profile-social-icon {
    width: 24px;
    height: 24px;
    fill: currentColor;
  }

  body.layout-standard .profile-social-link:hover {
    transform: translateY(-2px);
    color: var(--firefly-deep-text, var(--standard-text));
    background: var(--firefly-btn-bg-hover, var(--standard-accent-soft));
  }

  body.layout-standard .profile-social-link:active {
    transform: scale(0.92);
    background: var(--firefly-btn-bg-active, var(--standard-accent-soft));
  }

  body.layout-standard .profile-social-link:focus-visible {
    outline: 2px solid var(--firefly-primary, var(--standard-accent));
    outline-offset: 3px;
  }

  @media (max-width: 849px) {
    body.layout-standard .profile-avatar-frame {
      max-width: 240px;
      margin-inline: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    body.layout-standard .profile-social-link { transition: none; }
    body.layout-standard .profile-social-link:hover,
    body.layout-standard .profile-social-link:active { transform: none; }
  }

  html[data-reduce-motion="true"] body.layout-standard .profile-social-link {
    transition: none;
  }

  html[data-reduce-motion="true"] body.layout-standard .profile-social-link:hover,
  html[data-reduce-motion="true"] body.layout-standard .profile-social-link:active {
    transform: none;
  }
</style>
