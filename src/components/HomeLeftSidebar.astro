---
import SidebarWidget from './SidebarWidget.astro';

interface TagItem {
  tag: string;
  count: number;
}

interface Props {
  postCount: number;
  tagCount: number;
  featuredHref: string;
  topTags: TagItem[];
}

const { postCount, tagCount, featuredHref, topTags } = Astro.props;
const socialLinks = [
  { href: 'https://github.com/Lidure', label: 'GitHub', glyph: 'GH' },
  { href: 'https://qm.qq.com/q/ujOhar9jQQ', label: 'QQ', glyph: 'QQ' },
];
---

<aside class="home-left-sidebar" aria-label="站点资料与导航">
  <SidebarWidget title="关于我" icon="♡" tone="pink" className="profile-widget">
    <div class="sidebar-profile">
      <img src="/p0-256.webp" alt="搁浅 的头像" width="88" height="88" />
      <div class="sidebar-profile-copy">
        <strong>搁浅</strong>
        <p>研究生 · PJSK / 游戏 / Vibe coding，偶尔记录项目和日常。</p>
      </div>
      <nav class="profile-social-links" aria-label="联系方式">
        {socialLinks.map((item) => (
          <a
            href={item.href}
            target="_blank"
            rel="noreferrer"
            aria-label={item.label}
            title={item.label}
          >
            <span aria-hidden="true">{item.glyph}</span>
          </a>
        ))}
      </nav>
    </div>
    <dl class="sidebar-stats-grid">
      <div><dt>文章</dt><dd>{postCount}</dd></div>
      <div><dt>标签</dt><dd>{tagCount}</dd></div>
    </dl>
  </SidebarWidget>

  <SidebarWidget title="快速入口" icon="⌁" tone="purple">
    <nav class="sidebar-link-list" aria-label="首页快速入口">
      <a href={featuredHref}><span>精选文章</span><span>→</span></a>
      <a href="/posts"><span>文章归档</span><span>→</span></a>
      <a href="/moments"><span>碎碎念</span><span>→</span></a>
      <a href="/messages"><span>留言板</span><span>→</span></a>
    </nav>
  </SidebarWidget>

  <SidebarWidget title="常用标签" icon="#" tone="cyan">
    <div class="sidebar-tag-cloud">
      {topTags.slice(0, 7).map((item) => (
        <a href={`/tags/${encodeURIComponent(item.tag)}`}>
          <span>#{item.tag}</span><small>{item.count}</small>
        </a>
      ))}
    </div>
    <a class="sidebar-widget-more" href="/tags">查看全部标签 →</a>
  </SidebarWidget>
</aside>

<style is:global>
  body.layout-standard .profile-social-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 12px;
  }

  body.layout-standard .profile-social-links a {
    position: relative;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid color-mix(in srgb, var(--standard-line) 88%, transparent);
    border-radius: 10px;
    background: color-mix(in srgb, var(--standard-card-soft) 78%, transparent);
    color: var(--standard-muted);
    text-decoration: none;
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.025);
    transition: transform 160ms ease, color 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  body.layout-standard .profile-social-links a span {
    font-size: 0.62rem;
    font-weight: 850;
    letter-spacing: -0.02em;
  }

  body.layout-standard .profile-social-links a:hover {
    transform: translateY(-2px);
    color: var(--standard-purple);
    border-color: color-mix(in srgb, var(--standard-purple) 30%, var(--standard-line));
    background: color-mix(in srgb, var(--standard-purple-soft) 78%, var(--standard-card-bg));
  }

  body.layout-standard .profile-social-links a:nth-child(2):hover {
    color: var(--standard-cyan);
    border-color: color-mix(in srgb, var(--standard-cyan) 30%, var(--standard-line));
    background: color-mix(in srgb, var(--standard-cyan-soft) 78%, var(--standard-card-bg));
  }

  body.layout-standard .profile-social-links a:focus-visible {
    outline: 2px solid var(--standard-purple);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    body.layout-standard .profile-social-links a { transition: none; }
    body.layout-standard .profile-social-links a:hover { transform: none; }
  }

  html[data-reduce-motion="true"] body.layout-standard .profile-social-links a {
    transition: none;
  }

  html[data-reduce-motion="true"] body.layout-standard .profile-social-links a:hover {
    transform: none;
  }
</style>
