---
import SidebarWidget from './SidebarWidget.astro';

interface TagItem {
  tag: string;
  count: number;
}

interface Props {
  postCount: number;
  tagCount: number;
  featuredHref: string;
  topTags: TagItem[];
}

const { postCount, tagCount, featuredHref, topTags } = Astro.props;
const socialLinks = [
  {
