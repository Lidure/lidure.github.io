---
interface Props {
  title?: string;
  description?: string;
  showTime?: boolean;
  showBanner?: boolean;
  layoutMode?: 'standard' | 'immersive';
  bannerTitle?: string;
  bannerSubtitle?: string;
}

const normalizedPath = Astro.url.pathname.replace(/\/+$/, '');
const defaultLayoutMode: 'standard' | 'immersive' =
  normalizedPath === '/player' ? 'immersive' : 'standard';

const {
  title = '搁浅 的小窝',
  description = '一个使用 Astro 和 GitHub Pages 搭建的个人博客。',
  showTime = false,
  showBanner = true,
  layoutMode = defaultLayoutMode,
  bannerTitle,
  bannerSubtitle,
} = Astro.props;

const isStandard = layoutMode === 'standard';
const isHome = normalizedPath === '';
const resolvedBannerTitle = bannerTitle ?? title.split('|')[0].trim();
const resolvedBannerSubtitle = bannerSubtitle ?? description;

import '../styles/global.css';
import '../styles/firefly-refresh.css';
import '../styles/firefly-v2.css';
import '../styles/firefly-v2-pages.css';
import '../styles/firefly-v4.css';
import '../styles/firefly-v5-polish.css';
import '../styles/firefly-v6-theme.css';
import '../styles/firefly-wallpaper-modes.css';
import '../styles/bannerless-pages.css';
import '../styles/immersive-nav.css';
import '../styles/tokens.css';
import '../styles/site-shell.css';
import '../styles/moments.css';
import ClockDisplay from '../components/ClockDisplay.astro';
import BlogBanner from '../components/BlogBanner.astro';
import BannerWaves from '../components/BannerWaves.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FloatingControls from '../components/FloatingControls.astro';
import ImmersiveUiController from '../components/ImmersiveUiController.astro';
import { ClientRouter } from 'astro:transitions';
import SekaiPlayer from '../components/SekaiPlayer.astro';
import VisualSettingsPanel from '../components/VisualSettingsPanel.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import SekaiParticles from '../components/SekaiParticles.astro';
import MomentsPinControls from '../components/MomentsPinControls.astro';
import PageTransitionEnhancer from '../components/PageTransitionEnhancer.astro';
import FullscreenWallpaperController from '../components/FullscreenWallpaperController.astro';

const siteBase = Astro.site ?? new URL('https://lidure22.xyz');
const canonicalUrl = new URL(Astro.url.pathname, siteBase);
const socialImageUrl = new URL('/site-icon-512.png', siteBase);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="referrer" content="same-origin" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <title>{title}</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=Zen+Maru+Gothic:wght@400;500;600;700&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=Zen+Maru+Gothic:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=Zen+Maru+Gothic:wght@400;500;600;700&display=swap" rel="stylesheet" /></noscript>
    <ClientRouter />
    <script is:inline>
    (function() {
      var theme = 'dark';
      try { theme = localStorage.getItem('theme') || 'dark'; } catch(e) {}
      document.documentElement.setAttribute('data-theme', theme);
    })();
    (function() {
      try {
        var raw = JSON.parse(localStorage.getItem('hero_settings') || '{}');
        var root = document.documentElement;
        var mode = raw.wallpaperMode === 'fullscreen' || raw.wallpaperMode === 'overlay' ? raw.wallpaperMode : 'banner';
        var opacity = Number.isFinite(Number(raw.opacity)) ? Math.max(0, Math.min(1, Number(raw.opacity))) : 0.45;
        var blur = Number.isFinite(Number(raw.backgroundBlur)) ? Math.max(0, Math.min(20, Number(raw.backgroundBlur))) : 5;
        var cardOpacity = Number.isFinite(Number(raw.cardOpacity)) ? Math.max(0.2, Math.min(1, Number(raw.cardOpacity))) : 0.92;
        var hue = Number.isFinite(Number(raw.themeHue)) ? Math.max(0, Math.min(360, Number(raw.themeHue))) : 255;

        root.dataset.wallpaperMode = mode;
        root.dataset.bannerGradient = String(raw.bannerGradient !== false);
        root.dataset.bannerTitle = String(raw.bannerTitle !== false);
        root.dataset.cardBorder = String(raw.cardBorder !== false);
        root.dataset.cardFollowTheme = String(raw.cardFollowTheme === true);
        root.dataset.reduceMotion = String(raw.reduceMotion === true);
        root.dataset.waveEnabled = String(raw.waveEnabled !== false);
        root.dataset.waveStrength = ['soft', 'standard', 'strong'].includes(raw.waveStrength) ? raw.waveStrength : 'standard';
        root.dataset.waveSpeed = ['slow', 'normal', 'fast'].includes(raw.waveSpeed) ? raw.waveSpeed : 'normal';
        root.dataset.waveMobile = String(raw.waveMobile !== false);
        root.classList.toggle('no-hero-bg', raw.enabled === false);
        root.style.setProperty('--wallpaper-overlay', String(opacity));
        root.style.setProperty('--wallpaper-blur', blur + 'px');
        root.style.setProperty('--card-opacity', String(cardOpacity));
        root.style.setProperty('--card-opacity-percent', Math.round(cardOpacity * 100) + '%');
        root.style.setProperty('--theme-hue', String(hue));
      } catch(e) {}
    })();
    (function() {
      if (window.__pageMediaSwapCleanupBound) return;
      window.__pageMediaSwapCleanupBound = true;

      var pageMediaSelector = 'video[data-page-media], audio[data-page-media]';

      document.addEventListener('astro:before-swap', function() {
        document.querySelectorAll(pageMediaSelector).forEach(function(media) {
          if (media.matches(':not([data-persistent-media])') === false) return;
          try { media.pause(); } catch(e) {}
          media.removeAttribute('src');
          media.querySelectorAll('source').forEach(function(source) {
            source.removeAttribute('src');
          });
          try { media.load(); } catch(e) {}
        });
      });
    })();
    (function() {
      if (window.__busuanziLifecycleBound) return;
      window.__busuanziLifecycleBound = true;
      var busuanziRequestUrl = 'https://busuanzi.ibruce.info/busuanzi?jsonpCallback=BusuanziCallback';

      function applyBusuanzi(data) {
        var values = data || {};
        var pv = document.getElementById('busuanzi_value_site_pv');
        var uv = document.getElementById('busuanzi_value_site_uv');
        if (pv && values.site_pv != null) pv.textContent = String(values.site_pv);
        if (uv && values.site_uv != null) uv.textContent = String(values.site_uv);
      }

      function refreshBusuanzi() {
        if (!document.getElementById('busuanzi_value_site_pv')) return;
        if (window.bszCaller && typeof window.bszCaller.fetch === 'function') {
          window.bszCaller.fetch(busuanziRequestUrl, applyBusuanzi);
          return;
        }
        var script = document.getElementById('busuanzi-counter-script');
        if (!script) {
          script = document.createElement('script');
          script.id = 'busuanzi-counter-script';
          script.async = true;
          script.src = 'https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js';
          document.head.appendChild(script);
        }
        script.addEventListener('load', refreshBusuanzi, { once: true });
      }
      document.addEventListener('astro:page-load', refreshBusuanzi);
      refreshBusuanzi();
    })();
    </script>
    <script>
      import { installHeroVideoLoopGuard } from '../lib/hero-video-loop-guard.mjs';
      installHeroVideoLoopGuard();
    </script>
    <script>
      import {
        applyVisualSettingsToDocument,
        readVisualSettings,
        writeVisualSettings,
      } from '../lib/visual-settings.mjs';

      const visualWindow = window as any;

      function installVisualSettingsBridge() {
        visualWindow.__lidureVisualSettings = {
          read() {
            return readVisualSettings(window.localStorage);
          },
          write(patch: Record<string, unknown>) {
            return writeVisualSettings(patch, {
              storage: window.localStorage,
              doc: document,
              target: document,
            });
          },
        };
        applyVisualSettingsToDocument(visualWindow.__lidureVisualSettings.read(), document);
      }

      function installVisualResetDefaultSync() {
        if (visualWindow.__lidureVisualResetDefaultsBound) return;
        visualWindow.__lidureVisualResetDefaultsBound = true;

        document.addEventListener('click', (event) => {
          const target = event.target as Element | null;
          if (!target?.closest?.('#visual-reset-current')) return;

          queueMicrotask(() => {
            const bridge = visualWindow.__lidureVisualSettings;
            if (!bridge) return;

            if (document.getElementById('visual-panel-appearance')?.classList.contains('is-active')) {
              bridge.write({ themeHue: 255 });
              return;
            }

            if (document.getElementById('visual-panel-background')?.classList.contains('is-active')) {
              bridge.write({ backgroundBlur: 5 });
            }
          });
        });
      }

      if (!visualWindow.__lidureVisualSettingsLifecycleBound) {
        visualWindow.__lidureVisualSettingsLifecycleBound = true;
        document.addEventListener('astro:page-load', installVisualSettingsBridge);
      }
      installVisualSettingsBridge();
      installVisualResetDefaultSync();
    </script>
  </head>
  <body id="top" class:list={[`layout-${layoutMode}`, { 'is-home': isHome, 'is-bannerless': isStandard && !showBanner }]}>
    <VisualSettingsPanel />
    <HeroSlideshow />
    <SekaiParticles />
    <SekaiPlayer />
    <PageTransitionEnhancer />
    <FullscreenWallpaperController />
    <MomentsPinControls />
    <SiteHeader currentPath={Astro.url.pathname} />
    <FloatingControls />
    {!isStandard && <ImmersiveUiController />}

    {isStandard ? (
      <>
        {showBanner && (
          <div class="blog-banner-stage">
            <BlogBanner title={resolvedBannerTitle} subtitle={resolvedBannerSubtitle} />
            <BannerWaves />
            <button id="fullscreen-scroll-indicator" class="fullscreen-scroll-indicator" type="button" aria-label="向下浏览">
              <svg class="fullscreen-scroll-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="m6.5 9.5 5.5 5.5 5.5-5.5" />
              </svg>
            </button>
          </div>
        )}
        <div class="standard-page-surface" id="standard-page-surface">
          <main class="content-area standard-content">
            {showTime && <div class="clock-row"><ClockDisplay /></div>}
            <slot />
          </main>
          <footer class="footer">
            <div class="footer-inner">
              <div class="footer-note">
                <strong>搁浅的小窝 · 2026</strong>
                <p>在自己的角落里慢慢记录。</p>
              </div>
              <nav class="footer-links" aria-label="页脚链接">
                <a href="/rss.xml">RSS</a>
                <a href="https://github.com/Lidure" target="_blank" rel="noreferrer">GitHub</a>
                <a href="/messages">留言</a>
                <a href="#top">返回顶部</a>
              </nav>
              <small>Built with Astro · Hosted on GitHub Pages</small>
            </div>
          </footer>
        </div>
      </>
    ) : (
      <main class="immersive-content"><slot /></main>
    )}
  </body>
</html>