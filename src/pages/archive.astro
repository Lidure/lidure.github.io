---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const postsByYear = posts.reduce((groups, post) => {
  const year = String(post.data.pubDate.getFullYear());
  (groups[year] ??= []).push(post);
  return groups;
}, {} as Record<string, typeof posts>);

const years = Object.entries(postsByYear)
  .sort(([a], [b]) => Number(b) - Number(a));
---
<BaseLayout
  title="归档 | 搁浅 的小窝"
  description="按年份回看写下来的文章。"
  showBanner={false}
>
  <section class="archive-shell">
    <header class="page-heading">
      <h1>归档</h1>
      <p>共 {posts.length} 篇，按年份回到当时写下来的那一页。</p>
    </header>

    <nav class="archive-year-nav" aria-label="归档年份">
      {years.map(([year, yearPosts]) => (
        <a href={`#archive-${year}`}>
          <span>{year}</span><sup>{yearPosts.length}</sup>
        </a>
      ))}
    </nav>

    <div class="archive-years">
      {years.map(([year, yearPosts]) => (
        <section class="archive-year" id={`archive-${year}`} aria-labelledby={`archive-title-${year}`}>
          <h2 id={`archive-title-${year}`}>{year}</h2>
          <div class="archive-index">
            {yearPosts.map((post) => (
              <article class="archive-entry">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' })}
                </time>
                <a href={`/posts/${post.id.replace(/\.md$/, '')}`}>{post.data.title}</a>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
