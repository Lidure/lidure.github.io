---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages.css';
import '../styles/search.css';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const jsonData = JSON.stringify(
  allPosts.map((p) => ({
    title: p.data.title,
    description: p.data.description,
    slug: p.id.replace(/\.md$/, ''),
    tags: p.data.tags,
    pubDate: p.data.pubDate.valueOf(),
  })),
).replace(/</g, '\\u003c');
---
<BaseLayout
  title="搜索 | 搁浅 的小窝"
  description="在全站文章中搜索关键字。"
  showBanner={false}
>
  <section class="search-shell">
    <header class="page-heading">
      <h1>搜索</h1>
      <p>从写下来的文章里，找一个记得的词。</p>
    </header>

    <div class="search-bar" role="search">
      <input type="search" id="search-input" placeholder="输入关键字搜索文章…" aria-label="搜索文章" autofocus />
      <span id="search-count" class="search-count" aria-live="polite"></span>
    </div>

    <div id="search-results" class="search-results"></div>

    <noscript>
      <p class="search-empty">需要启用 JavaScript 才能使用搜索功能。</p>
    </noscript>
  </section>
</BaseLayout>

<script id="__SEARCH_DATA" type="application/json" set:html={jsonData}></script>

<script>
import Fuse from 'fuse.js';

interface PostDoc {
  title: string;
  description: string;
  slug: string;
  tags: string[];
  pubDate: number;
}

const input = document.getElementById('search-input') as HTMLInputElement | null;
const results = document.getElementById('search-results');
const count = document.getElementById('search-count');

let posts: PostDoc[] = [];
let searchReady = true;

try {
  const script = document.getElementById('__SEARCH_DATA');
  if (!script?.textContent) throw new Error('Search data is missing');
  posts = JSON.parse(script.textContent) as PostDoc[];
} catch (error) {
  searchReady = false;
  console.error('Failed to initialize search:', error);
  if (results) {
    results.innerHTML = '<p class="search-empty">搜索数据加载失败，请刷新页面重试。</p>';
  }
}

const fuse = new Fuse(posts, {
  keys: ['title', 'description', 'tags'],
  threshold: 0.4,
  includeScore: true,
});

function render(items: PostDoc[]): void {
  if (!results || !count) return;
  if (items.length === 0) {
    results.innerHTML = '<p class="search-empty">没有找到匹配的文章。</p>';
    count.textContent = '';
    return;
  }

  count.textContent = `${items.length} 篇匹配`;

  results.innerHTML = items
    .map((p: PostDoc) => {
      const date = new Date(p.pubDate);
      const dateLabel = date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).replaceAll('/', '.');
      return `
    <article class="search-result-entry">
      <time datetime="${date.toISOString()}">${dateLabel}</time>
      <div class="search-result-copy">
        <h2><a href="/posts/${p.slug}">${p.title}</a></h2>
        <p>${p.description}</p>
        <p class="search-result-tags">${p.tags.map((t: string) => `<span>#${t}</span>`).join('')}</p>
      </div>
    </article>`;
    })
    .join('');
}

if (searchReady) input?.addEventListener('input', () => {
  if (!results || !count) return;
  const query = input.value.trim();
  if (!query) {
    results.innerHTML = '';
    count.textContent = '';
    return;
  }
  render(fuse.search(query).map((r) => r.item));
});
</script>