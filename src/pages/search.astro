---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const jsonData = JSON.stringify(
  allPosts.map((p) => ({
    title: p.data.title,
    description: p.data.description,
    slug: p.id.replace(/\.md$/, ''),
    tags: p.data.tags,
    pubDate: p.data.pubDate.valueOf(),
  })),
).replace(/</g, '\\u003c');
---
<BaseLayout title="搜索 | 搁浅 的小窝" description="在全站文章中搜索关键字。">
  <section class="archive-shell">
    <span class="kicker">Search</span>
    <h1>搜索</h1>

    <div class="search-bar">
      <input type="search" id="search-input" placeholder="输入关键字搜索文章…" autofocus />
      <span id="search-count" class="search-count"></span>
    </div>

    <div id="search-results" class="archive-list"></div>

    <noscript>
      <p>需要启用 JavaScript 才能使用搜索功能。</p>
    </noscript>
  </section>
</BaseLayout>

<script id="__SEARCH_DATA" type="application/json" set:html={jsonData}></script>

<script>
import Fuse from 'fuse.js';

interface PostDoc {
  title: string;
  description: string;
  slug: string;
  tags: string[];
  pubDate: number;
}

const input = document.getElementById('search-input') as HTMLInputElement | null;
const results = document.getElementById('search-results');
const count = document.getElementById('search-count');

let posts: PostDoc[] = [];
let searchReady = true;

try {
  const script = document.getElementById('__SEARCH_DATA');
  if (!script?.textContent) throw new Error('Search data is missing');
  posts = JSON.parse(script.textContent) as PostDoc[];
} catch (error) {
  searchReady = false;
  console.error('Failed to initialize search:', error);
  if (results) {
    results.innerHTML = '<p class="search-empty">搜索数据加载失败，请刷新页面重试。</p>';
  }
}

const fuse = new Fuse(posts, {
  keys: ['title', 'description', 'tags'],
  threshold: 0.4,
  includeScore: true,
});

function render(items: PostDoc[]): void {
  if (!results || !count) return;
  if (items.length === 0) {
    results.innerHTML = '<p class="search-empty">没有找到匹配的文章。</p>';
    count.textContent = '';
    return;
  }

  count.textContent = `${items.length} 篇匹配`;

  results.innerHTML = items
    .map(
      (p: PostDoc) => `
    <article class="card">
      <div class="meta">
        <span>${new Date(p.pubDate).toLocaleDateString('zh-CN')}</span>
      </div>
      <h3><a href="/posts/${p.slug}">${p.title}</a></h3>
      <p>${p.description}</p>
      <div class="tag-list">
        ${p.tags.map((t: string) => `<span class="tag">#${t}</span>`).join('')}
      </div>
    </article>`,
    )
    .join('');
}

if (searchReady) input?.addEventListener('input', () => {
  if (!results || !count) return;
  const query = input.value.trim();
  if (!query) {
    results.innerHTML = '';
    count.textContent = '';
    return;
  }
  render(fuse.search(query).map((r) => r.item));
});
</script>
