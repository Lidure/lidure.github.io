---
const target = '/sekai-quest/';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>Redirecting to SEKAI Quest</title>
    <link rel="canonical" href={target} />
    <script is:inline>
      window.location.replace('/sekai-quest/');
    </script>
  </head>
  <body>
    <a href={target}>Open SEKAI Quest</a>
  </body>
</html>
