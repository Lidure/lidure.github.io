---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="SEKAI Beat | 搁浅 的小窝" description="一个原创的类 PJSK 氛围节奏小游戏，支持键盘和触控。">
  <section class="rhythm-shell" data-rhythm-game>
    <div class="rhythm-top">
      <div class="rhythm-title">
        <span class="rhythm-kicker">Fan-made rhythm toy</span>
        <h1>SEKAI Beat</h1>
      </div>
      <div class="rhythm-actions">
        <select id="rhythmDifficulty" class="rhythm-select" aria-label="难度">
          <option value="easy">Easy</option>
          <option value="hard" selected>Hard</option>
          <option value="expert">Expert</option>
        </select>
        <button type="button" id="rhythmStart" class="rhythm-button primary">Start</button>
        <button type="button" id="rhythmRestart" class="rhythm-button">Restart</button>
      </div>
    </div>

    <div class="rhythm-hud" aria-live="polite">
      <div><span>Score</span><strong id="rhythmScore">0</strong></div>
      <div><span>Combo</span><strong id="rhythmCombo">0</strong></div>
      <div><span>Acc</span><strong id="rhythmAcc">100%</strong></div>
      <div><span>Best</span><strong id="rhythmBest">0</strong></div>
    </div>

    <div class="rhythm-stage">
      <canvas id="rhythmCanvas" class="rhythm-canvas" width="960" height="640" aria-label="SEKAI Beat game stage"></canvas>
      <div id="rhythmOverlay" class="rhythm-overlay">
        <strong>SEKAI Beat</strong>
        <span>Tap Start</span>
      </div>
      <div class="rhythm-touch" aria-label="触控轨道">
        <button type="button" data-lane="0"><span>D</span></button>
        <button type="button" data-lane="1"><span>F</span></button>
        <button type="button" data-lane="2"><span>J</span></button>
        <button type="button" data-lane="3"><span>K</span></button>
      </div>
    </div>

    <div class="rhythm-judges" aria-hidden="true">
      <span id="judgePerfect">Perfect 0</span>
      <span id="judgeGreat">Great 0</span>
      <span id="judgeGood">Good 0</span>
      <span id="judgeMiss">Miss 0</span>
    </div>
  </section>

  <style>
    .rhythm-shell {
      min-height: calc(100vh - 190px);
      display: grid;
      gap: 14px;
      color: var(--text);
    }

    .rhythm-top {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 14px;
      padding: 18px 18px 0;
    }

    .rhythm-title {
      display: grid;
      gap: 2px;
    }

    .rhythm-kicker {
      color: var(--accent-2);
      font-size: 0.78rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .rhythm-title h1 {
      margin: 0;
      font-size: clamp(2rem, 7vw, 4.2rem);
      line-height: 0.95;
      letter-spacing: 0;
      font-family: 'ZCOOL KuaiLe', 'Noto Sans SC', sans-serif;
      color: #fff;
      text-shadow: 0 0 22px rgba(var(--accent-rgb), 0.55), 0 0 44px rgba(82, 219, 255, 0.28);
    }

    .rhythm-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .rhythm-select,
    .rhythm-button {
      height: 38px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 999px;
      background: rgba(13, 16, 31, 0.72);
      color: var(--text);
      font: inherit;
      font-weight: 800;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.22);
    }

    .rhythm-select {
      padding: 0 34px 0 14px;
      color-scheme: dark;
    }

    .rhythm-button {
      min-width: 88px;
      padding: 0 16px;
      cursor: pointer;
      transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
    }

    .rhythm-button:hover {
      transform: translateY(-1px);
      border-color: rgba(255, 255, 255, 0.32);
    }

    .rhythm-button.primary {
      border: none;
      color: #140d20;
      background: linear-gradient(135deg, #ff6ba7, #52dbff 54%, #ffd66e);
    }

    .rhythm-hud,
    .rhythm-judges {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 8px;
      padding: 0 18px;
    }

    .rhythm-hud > div,
    .rhythm-judges > span {
      min-width: 0;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(13, 16, 31, 0.58);
      border-radius: 8px;
      padding: 8px 10px;
      backdrop-filter: blur(18px) saturate(1.15);
    }

    .rhythm-hud span {
      display: block;
      color: var(--muted);
      font-size: 0.72rem;
      line-height: 1.1;
    }

    .rhythm-hud strong {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      font-size: clamp(1rem, 3.4vw, 1.55rem);
      line-height: 1.15;
      color: #fff;
    }

    .rhythm-stage {
      position: relative;
      height: min(68vh, 690px);
      min-height: 500px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 18px;
      overflow: hidden;
      background:
        linear-gradient(180deg, rgba(12, 14, 31, 0.34), rgba(5, 8, 20, 0.92)),
        radial-gradient(circle at 18% 18%, rgba(255, 107, 157, 0.28), transparent 28%),
        radial-gradient(circle at 78% 16%, rgba(82, 219, 255, 0.24), transparent 30%),
        radial-gradient(circle at 50% 96%, rgba(255, 214, 110, 0.18), transparent 34%),
        #070913;
      box-shadow: 0 22px 70px rgba(0, 0, 0, 0.36);
      isolation: isolate;
    }

    .rhythm-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
      touch-action: none;
      z-index: 1;
    }

    .rhythm-overlay {
      position: absolute;
      inset: 0;
      z-index: 3;
      display: grid;
      place-content: center;
      gap: 8px;
      text-align: center;
      pointer-events: none;
      color: #fff;
      background: radial-gradient(circle at center, rgba(5, 8, 20, 0.24), rgba(5, 8, 20, 0.74));
      transition: opacity 180ms ease;
    }

    .rhythm-overlay.hidden {
      opacity: 0;
    }

    .rhythm-overlay strong {
      font-size: clamp(2rem, 8vw, 5rem);
      line-height: 1;
      font-family: 'ZCOOL KuaiLe', 'Noto Sans SC', sans-serif;
      text-shadow: 0 0 28px rgba(var(--accent-rgb), 0.72);
    }

    .rhythm-overlay span {
      color: var(--text-soft);
      font-weight: 800;
      letter-spacing: 0.04em;
    }

    .rhythm-touch {
      position: absolute;
      left: 50%;
      bottom: 14px;
      z-index: 4;
      width: min(560px, calc(100% - 24px));
      transform: translateX(-50%);
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 8px;
      pointer-events: auto;
    }

    .rhythm-touch button {
      height: clamp(54px, 12vw, 76px);
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.08);
      color: #fff;
      font: inherit;
      cursor: pointer;
      touch-action: manipulation;
      backdrop-filter: blur(18px);
      transition: transform 80ms ease, background 80ms ease, border-color 80ms ease;
    }

    .rhythm-touch button span {
      display: inline-grid;
      place-items: center;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.12);
      font-weight: 900;
    }

    .rhythm-touch button.active {
      transform: translateY(2px) scale(0.98);
      border-color: rgba(255, 255, 255, 0.46);
      background: rgba(var(--accent-rgb), 0.32);
    }

    .rhythm-judges {
      padding-bottom: 8px;
    }

    .rhythm-judges > span {
      color: var(--text-soft);
      font-size: 0.8rem;
      font-weight: 800;
      text-align: center;
      white-space: nowrap;
    }

    @media (max-width: 720px) {
      .rhythm-shell {
        min-height: calc(100svh - 150px);
        gap: 10px;
      }

      .rhythm-top {
        align-items: stretch;
        flex-direction: column;
        padding: 6px 2px 0;
      }

      .rhythm-actions {
        justify-content: stretch;
      }

      .rhythm-actions > * {
        flex: 1 1 auto;
      }

      .rhythm-hud,
      .rhythm-judges {
        padding: 0;
        gap: 6px;
      }

      .rhythm-hud > div,
      .rhythm-judges > span {
        padding: 7px 6px;
      }

      .rhythm-stage {
        height: min(68svh, 620px);
        min-height: 420px;
        border-radius: 14px;
      }
    }

    @media (max-width: 460px) {
      .rhythm-hud strong {
        font-size: 0.95rem;
      }

      .rhythm-judges > span {
        font-size: 0.68rem;
      }
    }
  </style>

  <script>
    (() => {
      const STORAGE_KEY = 'sekai_beat_best_v1';
      const LANES = ['D', 'F', 'J', 'K'];
      const LANE_KEYS: Record<string, number> = { d: 0, f: 1, j: 2, k: 3 };
      const DIFFICULTY = {
        easy: { bpm: 124, interval: 1, length: 42, extra: false },
        hard: { bpm: 148, interval: 0.5, length: 50, extra: true },
        expert: { bpm: 168, interval: 0.375, length: 54, extra: true },
      } as const;

      type DifficultyName = keyof typeof DIFFICULTY;
      type Note = {
        lane: number;
        time: number;
        hit: boolean;
        missed: boolean;
        glow: number;
      };

      type JudgeName = 'Perfect' | 'Great' | 'Good' | 'Miss';

      function initRhythmGame() {
        const rootCandidate = document.querySelector<HTMLElement>('[data-rhythm-game]');
        if (!rootCandidate || rootCandidate.dataset.ready === 'true') return;
        const root = rootCandidate;
        root.dataset.ready = 'true';

        const canvasCandidate = root.querySelector<HTMLCanvasElement>('#rhythmCanvas');
        const startButtonCandidate = root.querySelector<HTMLButtonElement>('#rhythmStart');
        const restartButtonCandidate = root.querySelector<HTMLButtonElement>('#rhythmRestart');
        const difficultySelectCandidate = root.querySelector<HTMLSelectElement>('#rhythmDifficulty');
        const overlayCandidate = root.querySelector<HTMLElement>('#rhythmOverlay');
        const scoreElCandidate = root.querySelector<HTMLElement>('#rhythmScore');
        const comboElCandidate = root.querySelector<HTMLElement>('#rhythmCombo');
        const accElCandidate = root.querySelector<HTMLElement>('#rhythmAcc');
        const bestElCandidate = root.querySelector<HTMLElement>('#rhythmBest');
        if (!canvasCandidate || !startButtonCandidate || !restartButtonCandidate || !difficultySelectCandidate || !overlayCandidate || !scoreElCandidate || !comboElCandidate || !accElCandidate || !bestElCandidate) return;

        const canvas = canvasCandidate;
        const startButton = startButtonCandidate;
        const restartButton = restartButtonCandidate;
        const difficultySelect = difficultySelectCandidate;
        const overlay = overlayCandidate;
        const scoreEl = scoreElCandidate;
        const comboEl = comboElCandidate;
        const accEl = accElCandidate;
        const bestEl = bestElCandidate;
        const judgeEls: Record<JudgeName, HTMLElement | null> = {
          Perfect: root.querySelector<HTMLElement>('#judgePerfect'),
          Great: root.querySelector<HTMLElement>('#judgeGreat'),
          Good: root.querySelector<HTMLElement>('#judgeGood'),
          Miss: root.querySelector<HTMLElement>('#judgeMiss'),
        };
        const laneButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('.rhythm-touch button[data-lane]'));

        const ctxCandidate = canvas.getContext('2d');
        if (!ctxCandidate) return;
        const ctx = ctxCandidate;

        let audio: AudioContext | null = null;
        let notes: Note[] = [];
        let raf = 0;
        let running = false;
        let finished = false;
        let startedAt = 0;
        let travelTime = 1.62;
        let nextBeat = 0;
        let score = 0;
        let combo = 0;
        let maxCombo = 0;
        let totalWeight = 0;
        let judged = 0;
        let lastJudge = '';
        let lastJudgeAt = 0;
        let best = Number(localStorage.getItem(STORAGE_KEY) || 0);
        let laneFlash = [0, 0, 0, 0];
        let judgeCounts: Record<JudgeName, number> = { Perfect: 0, Great: 0, Good: 0, Miss: 0 };

        bestEl.textContent = String(best);

        function currentDifficulty() {
          return difficultySelect.value as DifficultyName;
        }

        function audioTime() {
          return audio ? audio.currentTime - startedAt : 0;
        }

        function resizeCanvas() {
          const rect = canvas.getBoundingClientRect();
          const ratio = Math.max(1, Math.min(2, window.devicePixelRatio || 1));
          canvas.width = Math.max(1, Math.round(rect.width * ratio));
          canvas.height = Math.max(1, Math.round(rect.height * ratio));
          ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
        }

        function buildChart(name: DifficultyName) {
          const config = DIFFICULTY[name];
          const beat = 60 / config.bpm;
          const chart: Note[] = [];
          const base = [
            [0, 1, 2, 3],
            [3, 2, 1, 0],
            [0, 2, 1, 3],
            [1, 3, 0, 2],
            [0, 1, 3, 2],
            [2, 0, 3, 1],
            [3, 1, 2, 0],
            [1, 0, 2, 3],
          ];
          let step = 0;
          for (let time = 1.7; time < config.length; time += beat * config.interval) {
            const phrase = base[Math.floor(step / 8) % base.length];
            const lane = phrase[step % phrase.length];
            chart.push({ lane, time, hit: false, missed: false, glow: 0 });
            if (config.extra && step % 16 === 10) {
              chart.push({ lane: (lane + 2) % 4, time: time + beat * 0.5, hit: false, missed: false, glow: 0 });
            }
            if (name === 'expert' && step % 12 === 7) {
              chart.push({ lane: (lane + 1) % 4, time: time + beat * 0.25, hit: false, missed: false, glow: 0 });
            }
            step += 1;
          }
          return chart.sort((a, b) => a.time - b.time);
        }

        function ensureAudio() {
          audio ||= new AudioContext();
          if (audio.state === 'suspended') {
            void audio.resume();
          }
        }

        function playTone(lane: number, judge: JudgeName | 'beat') {
          if (!audio) return;
          const now = audio.currentTime;
          const osc = audio.createOscillator();
          const gain = audio.createGain();
          const filter = audio.createBiquadFilter();
          const baseFreq = [523.25, 659.25, 783.99, 987.77][lane] || 523.25;
          osc.type = judge === 'beat' ? 'triangle' : 'sine';
          osc.frequency.setValueAtTime(judge === 'beat' ? 196 : baseFreq, now);
          filter.type = 'lowpass';
          filter.frequency.setValueAtTime(judge === 'beat' ? 700 : 2600, now);
          gain.gain.setValueAtTime(0.0001, now);
          gain.gain.exponentialRampToValueAtTime(judge === 'Miss' ? 0.025 : judge === 'beat' ? 0.03 : 0.1, now + 0.012);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + (judge === 'beat' ? 0.08 : 0.18));
          osc.connect(filter);
          filter.connect(gain);
          gain.connect(audio.destination);
          osc.start(now);
          osc.stop(now + 0.22);
        }

        function updateHud() {
          scoreEl.textContent = String(score);
          comboEl.textContent = String(combo);
          const acc = judged ? Math.round((totalWeight / judged) * 1000) / 10 : 100;
          accEl.textContent = `${acc}%`;
          bestEl.textContent = String(best);
          judgeEls.Perfect && (judgeEls.Perfect.textContent = `Perfect ${judgeCounts.Perfect}`);
          judgeEls.Great && (judgeEls.Great.textContent = `Great ${judgeCounts.Great}`);
          judgeEls.Good && (judgeEls.Good.textContent = `Good ${judgeCounts.Good}`);
          judgeEls.Miss && (judgeEls.Miss.textContent = `Miss ${judgeCounts.Miss}`);
        }

        function setOverlay(title: string, sub: string, visible: boolean) {
          overlay.innerHTML = `<strong>${title}</strong><span>${sub}</span>`;
          overlay.classList.toggle('hidden', !visible);
        }

        function judgeNote(note: Note, judge: JudgeName) {
          note.hit = judge !== 'Miss';
          note.missed = judge === 'Miss';
          note.glow = 1;
          judged += 1;
          judgeCounts[judge] += 1;
          lastJudge = judge;
          lastJudgeAt = performance.now();
          if (judge === 'Perfect') {
            combo += 1;
            score += 1000 + combo * 4;
            totalWeight += 1;
          } else if (judge === 'Great') {
            combo += 1;
            score += 760 + combo * 3;
            totalWeight += 0.78;
          } else if (judge === 'Good') {
            combo += 1;
            score += 420;
            totalWeight += 0.45;
          } else {
            combo = 0;
          }
          maxCombo = Math.max(maxCombo, combo);
          best = Math.max(best, score);
          localStorage.setItem(STORAGE_KEY, String(best));
          updateHud();
        }

        function hitLane(lane: number) {
          if (!running || finished) return;
          const now = audioTime();
          laneFlash[lane] = 1;
          const candidates = notes
            .filter((note) => note.lane === lane && !note.hit && !note.missed)
            .map((note) => ({ note, delta: Math.abs(note.time - now) }))
            .filter((item) => item.delta <= 0.18)
            .sort((a, b) => a.delta - b.delta);
          if (!candidates.length) {
            playTone(lane, 'Miss');
            return;
          }
          const { note, delta } = candidates[0];
          const judge: JudgeName = delta <= 0.055 ? 'Perfect' : delta <= 0.105 ? 'Great' : 'Good';
          judgeNote(note, judge);
          playTone(lane, judge);
        }

        function startGame(reset = true) {
          ensureAudio();
          if (!audio) return;
          if (reset) {
            notes = buildChart(currentDifficulty());
            score = 0;
            combo = 0;
            maxCombo = 0;
            totalWeight = 0;
            judged = 0;
            lastJudge = '';
            judgeCounts = { Perfect: 0, Great: 0, Good: 0, Miss: 0 };
            laneFlash = [0, 0, 0, 0];
            updateHud();
          }
          finished = false;
          running = true;
          travelTime = currentDifficulty() === 'expert' ? 1.48 : currentDifficulty() === 'easy' ? 1.78 : 1.62;
          nextBeat = 0;
          startedAt = audio.currentTime + 0.18;
          setOverlay('', '', false);
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(draw);
        }

        function finishGame() {
          running = false;
          finished = true;
          const acc = judged ? Math.round((totalWeight / judged) * 1000) / 10 : 0;
          setOverlay(`${score}`, `Max ${maxCombo} / Acc ${acc}%`, true);
        }

        function laneGeometry(width: number, height: number) {
          const stageWidth = Math.min(width * 0.82, 620);
          const laneWidth = stageWidth / 4;
          const left = (width - stageWidth) / 2;
          const hitY = height - Math.max(92, height * 0.17);
          const topY = Math.max(52, height * 0.08);
          return { left, stageWidth, laneWidth, hitY, topY };
        }

        function drawBackground(width: number, height: number, now: number) {
          ctx.clearRect(0, 0, width, height);
          const pulse = 0.5 + Math.sin(now * 3.2) * 0.5;
          const sky = ctx.createLinearGradient(0, 0, 0, height);
          sky.addColorStop(0, '#090b22');
          sky.addColorStop(0.45, '#10122d');
          sky.addColorStop(1, '#050711');
          ctx.fillStyle = sky;
          ctx.fillRect(0, 0, width, height);

          for (let i = 0; i < 42; i += 1) {
            const x = (i * 97 + now * 18) % (width + 80) - 40;
            const y = (i * 53) % Math.max(1, height * 0.72);
            const r = 1 + ((i * 7) % 4);
            ctx.globalAlpha = 0.18 + pulse * 0.22;
            ctx.fillStyle = i % 3 === 0 ? '#ff6ba7' : i % 3 === 1 ? '#52dbff' : '#ffd66e';
            ctx.beginPath();
            ctx.arc(x, y, r, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.globalAlpha = 1;

          const floor = ctx.createRadialGradient(width / 2, height * 0.96, 20, width / 2, height * 0.96, width * 0.65);
          floor.addColorStop(0, `rgba(82,219,255,${0.3 + pulse * 0.08})`);
          floor.addColorStop(0.35, 'rgba(255,107,167,0.16)');
          floor.addColorStop(1, 'rgba(0,0,0,0)');
          ctx.fillStyle = floor;
          ctx.fillRect(0, height * 0.5, width, height * 0.5);
        }

        function drawStage(width: number, height: number) {
          const geo = laneGeometry(width, height);
          const vanishX = width / 2;
          const vanishY = geo.topY;
          ctx.save();
          ctx.lineWidth = 1;
          for (let i = 0; i <= 4; i += 1) {
            const x = geo.left + i * geo.laneWidth;
            const grad = ctx.createLinearGradient(x, vanishY, x, geo.hitY + 55);
            grad.addColorStop(0, 'rgba(255,255,255,0.04)');
            grad.addColorStop(1, i % 2 ? 'rgba(82,219,255,0.44)' : 'rgba(255,107,167,0.42)');
            ctx.strokeStyle = grad;
            ctx.beginPath();
            ctx.moveTo(vanishX + (x - width / 2) * 0.24, vanishY);
            ctx.lineTo(x, geo.hitY + 56);
            ctx.stroke();
          }

          for (let i = 0; i < 4; i += 1) {
            const x = geo.left + i * geo.laneWidth;
            ctx.fillStyle = i % 2 ? 'rgba(82,219,255,0.055)' : 'rgba(255,107,167,0.055)';
            ctx.beginPath();
            ctx.moveTo(vanishX + (x - width / 2) * 0.24, vanishY);
            ctx.lineTo(vanishX + (x + geo.laneWidth - width / 2) * 0.24, vanishY);
            ctx.lineTo(x + geo.laneWidth, geo.hitY + 56);
            ctx.lineTo(x, geo.hitY + 56);
            ctx.closePath();
            ctx.fill();
          }

          ctx.shadowBlur = 28;
          ctx.shadowColor = '#52dbff';
          ctx.strokeStyle = 'rgba(255,255,255,0.82)';
          ctx.lineWidth = 4;
          ctx.beginPath();
          ctx.moveTo(geo.left, geo.hitY);
          ctx.lineTo(geo.left + geo.stageWidth, geo.hitY);
          ctx.stroke();
          ctx.shadowBlur = 0;

          for (let i = 0; i < 4; i += 1) {
            const center = geo.left + geo.laneWidth * (i + 0.5);
            const flash = laneFlash[i];
            const radius = 28 + flash * 18;
            ctx.fillStyle = `rgba(${i % 2 ? '82,219,255' : '255,107,167'},${0.14 + flash * 0.24})`;
            ctx.strokeStyle = `rgba(255,255,255,${0.34 + flash * 0.5})`;
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.roundRect(center - radius, geo.hitY - 24, radius * 2, 48, 24);
            ctx.fill();
            ctx.stroke();
            ctx.fillStyle = 'rgba(255,255,255,0.82)';
            ctx.font = '800 16px Noto Sans SC, sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(LANES[i], center, geo.hitY);
          }

          if (lastJudge && performance.now() - lastJudgeAt < 520) {
            const alpha = 1 - (performance.now() - lastJudgeAt) / 520;
            ctx.globalAlpha = alpha;
            ctx.fillStyle = lastJudge === 'Perfect' ? '#ffd66e' : lastJudge === 'Great' ? '#52dbff' : lastJudge === 'Good' ? '#ff6ba7' : '#b8b8c7';
            ctx.font = '900 30px ZCOOL KuaiLe, Noto Sans SC, sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(lastJudge, width / 2, geo.hitY - 86);
            ctx.globalAlpha = 1;
          }
          ctx.restore();
        }

        function drawNotes(width: number, height: number, now: number) {
          const geo = laneGeometry(width, height);
          for (const note of notes) {
            if (note.hit || note.missed) continue;
            const until = note.time - now;
            const progress = 1 - until / travelTime;
            if (progress < -0.08 || progress > 1.18) continue;
            const y = geo.topY + (geo.hitY - geo.topY) * progress;
            const scale = 0.48 + progress * 0.72;
            const center = geo.left + geo.laneWidth * (note.lane + 0.5);
            const widthNote = geo.laneWidth * (0.44 + progress * 0.18);
            const heightNote = 16 + scale * 12;
            const hue = note.lane % 2 ? '82,219,255' : '255,107,167';
            ctx.save();
            ctx.shadowBlur = 18 + progress * 16;
            ctx.shadowColor = note.lane % 2 ? '#52dbff' : '#ff6ba7';
            const grad = ctx.createLinearGradient(center - widthNote, y, center + widthNote, y);
            grad.addColorStop(0, `rgba(${hue},0.2)`);
            grad.addColorStop(0.5, 'rgba(255,255,255,0.96)');
            grad.addColorStop(1, `rgba(${hue},0.82)`);
            ctx.fillStyle = grad;
            ctx.beginPath();
            ctx.roundRect(center - widthNote / 2, y - heightNote / 2, widthNote, heightNote, heightNote / 2);
            ctx.fill();
            ctx.restore();
          }
        }

        function missOldNotes(now: number) {
          for (const note of notes) {
            if (!note.hit && !note.missed && note.time < now - 0.2) {
              judgeNote(note, 'Miss');
            }
          }
        }

        function draw() {
          resizeCanvas();
          const rect = canvas.getBoundingClientRect();
          const width = rect.width;
          const height = rect.height;
          const now = running ? audioTime() : 0;
          for (let i = 0; i < 4; i += 1) {
            laneFlash[i] *= 0.82;
            laneButtons[i]?.classList.toggle('active', laneFlash[i] > 0.14);
          }
          drawBackground(width, height, now);
          drawStage(width, height);
          if (running) {
            if (now >= nextBeat) {
              playTone(nextBeat % 2 ? 2 : 1, 'beat');
              nextBeat += 60 / DIFFICULTY[currentDifficulty()].bpm;
            }
            missOldNotes(now);
            drawNotes(width, height, now);
            const lastNote = notes[notes.length - 1];
            if (lastNote && now > lastNote.time + 1.6) {
              finishGame();
            }
          }
          if (!finished) {
            raf = requestAnimationFrame(draw);
          }
        }

        function handleKeydown(event: KeyboardEvent) {
          const lane = LANE_KEYS[event.key.toLowerCase()];
          if (lane === undefined) return;
          event.preventDefault();
          hitLane(lane);
        }

        function cleanup() {
          cancelAnimationFrame(raf);
          window.removeEventListener('resize', resizeCanvas);
          window.removeEventListener('keydown', handleKeydown);
          root.dataset.ready = 'false';
        }

        startButton.addEventListener('click', () => startGame(true));
        restartButton.addEventListener('click', () => startGame(true));
        difficultySelect.addEventListener('change', () => {
          if (running) startGame(true);
        });
        laneButtons.forEach((button) => {
          const lane = Number(button.dataset.lane || 0);
          button.addEventListener('pointerdown', (event) => {
            event.preventDefault();
            hitLane(lane);
          });
        });
        canvas.addEventListener('pointerdown', (event) => {
          const rect = canvas.getBoundingClientRect();
          const geo = laneGeometry(rect.width, rect.height);
          const x = event.clientX - rect.left;
          const lane = Math.max(0, Math.min(3, Math.floor((x - geo.left) / geo.laneWidth)));
          hitLane(lane);
        });
        window.addEventListener('keydown', handleKeydown);
        window.addEventListener('resize', resizeCanvas);
        document.addEventListener('astro:before-swap', cleanup, { once: true });
        resizeCanvas();
        notes = buildChart(currentDifficulty());
        updateHud();
        drawBackground(canvas.getBoundingClientRect().width, canvas.getBoundingClientRect().height, 0);
        drawStage(canvas.getBoundingClientRect().width, canvas.getBoundingClientRect().height);
      }

      document.addEventListener('astro:page-load', initRhythmGame);
      initRhythmGame();
    })();
  </script>
</BaseLayout>
