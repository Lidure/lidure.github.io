---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="留言板 | 搁浅 的小窝"
  description="给博客留下想说的话。"
  bannerTitle="留言板"
  bannerSubtitle="路过也可以留下一句话。"
>
  <section class="messages-shell">
    <div class="messages-layout">
      <aside class="messages-composer-column">
        <section class="messages-composer-card">
          <div class="messages-composer-heading">
            <span class="messages-composer-kicker">GUESTBOOK</span>
            <h2>留下一句话</h2>
            <p class="messages-intro">自设一个 ID 就能留言和评论，不需要密钥。随便聊聊项目、游戏、音乐或路过时的心情都可以。</p>
          </div>

          <form class="message-form" id="message-form">
            <label>
              <span>你的 ID</span>
              <input type="text" name="userId" id="message-user-id" maxlength="32" placeholder="例如：路过的旅人" required />
            </label>
            <label>
              <span>留言</span>
              <textarea name="text" id="message-text" maxlength="800" rows="6" placeholder="写点什么..." required></textarea>
            </label>
            <div class="form-actions">
              <p id="message-status" aria-live="polite"></p>
              <button type="submit" id="message-submit">发送留言</button>
            </div>
          </form>

          <section class="message-admin" id="message-admin">
            <div class="message-admin-label">管理状态</div>
            <div class="message-admin-row">
              <span id="message-session-status">检查登录状态中...</span>
              <button type="button" id="message-logout" hidden>退出登录</button>
            </div>
            <div id="message-login" hidden>
              <input type="password" id="message-login-password" placeholder="管理员密码" autocomplete="current-password" />
              <button type="button" id="message-login-submit">登录</button>
            </div>
          </section>
        </section>
      </aside>

      <section class="messages-stream-column" aria-labelledby="messages-stream-title">
        <header class="messages-stream-header">
          <div>
            <span class="messages-stream-kicker">RECENT MESSAGES</span>
            <h2 id="messages-stream-title">最近留言</h2>
          </div>
          <div class="messages-stream-summary">
            <strong id="message-count">—</strong>
            <span>条留言</span>
          </div>
        </header>

        <div class="messages-list" id="messages-list">
          <div class="message-loading">留言加载中...</div>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .messages-shell {
    width: min(100%, 1220px);
    margin: 0 auto;
  }

  .messages-layout {
    display: grid;
    grid-template-columns: minmax(340px, 370px) minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }

  .messages-composer-column {
    position: sticky;
    top: 84px;
  }

  .messages-composer-card,
  .message-card {
    border: 1px solid var(--standard-line, var(--panel-border));
    background: var(--standard-card-bg, var(--panel-gradient));
    box-shadow: 0 10px 28px rgba(4, 6, 16, 0.07);
  }

  .messages-composer-card {
    overflow: hidden;
    border-radius: 16px;
  }

  .messages-composer-heading {
    padding: 20px 20px 15px;
    border-bottom: 1px solid var(--standard-line, var(--panel-border));
    background: linear-gradient(120deg, var(--standard-accent-soft, rgba(var(--accent-rgb), .1)), transparent 58%);
  }

  .messages-composer-kicker,
  .messages-stream-kicker {
    display: block;
    margin-bottom: 4px;
    color: var(--standard-accent, var(--accent));
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .messages-composer-heading h2,
  .messages-stream-header h2 {
    margin: 0;
    color: var(--standard-text, var(--text));
    font-family: var(--font-body);
    font-size: 1.18rem;
  }

  .messages-intro {
    margin: 9px 0 0;
    color: var(--standard-muted, var(--muted));
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .message-form {
    display: grid;
    gap: 14px;
    padding: 18px 20px;
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
  }

  .message-form label {
    display: grid;
    gap: 7px;
  }

  .message-form label > span,
  .message-admin-label {
    color: var(--standard-muted, var(--muted));
    font-size: 0.76rem;
    font-weight: 700;
  }

  .message-form input,
  .message-form textarea,
  #message-login input {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid var(--standard-line, var(--panel-border));
    border-radius: 10px;
    background: var(--standard-page-bg, var(--bg));
    color: var(--standard-text, var(--text));
    font: inherit;
    padding: 11px 13px;
    transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease;
  }

  .message-form textarea {
    resize: vertical;
    min-height: 148px;
    line-height: 1.65;
  }

  .message-form input:focus,
  .message-form textarea:focus,
  #message-login input:focus {
    outline: none;
    border-color: var(--standard-accent, var(--accent));
    box-shadow: 0 0 0 3px var(--standard-accent-soft, rgba(var(--accent-rgb), .1));
  }

  .form-actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
  }

  #message-status {
    min-height: 20px;
    margin: 0;
    color: var(--standard-muted, var(--muted));
    font-size: 0.78rem;
  }

  #message-status.error { color: #df6070; }

  #message-submit {
    border: 0;
    border-radius: 9px;
    background: var(--standard-accent, var(--accent));
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-size: 0.86rem;
    font-weight: 700;
    padding: 10px 17px;
  }

  #message-submit:disabled,
  .message-delete:disabled { opacity: 0.6; cursor: wait; }

  .message-admin {
    margin: 0;
    padding: 13px 20px 16px;
    border: 0 !important;
    border-top: 1px solid var(--standard-line, var(--panel-border)) !important;
    border-radius: 0 !important;
    background: color-mix(in srgb, var(--standard-purple-soft, transparent) 62%, transparent) !important;
    box-shadow: none !important;
  }

  .message-admin-label { margin-bottom: 7px; color: var(--standard-purple, var(--muted)); }

  .message-admin-row,
  #message-login {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .message-admin-row { color: var(--standard-muted, var(--muted)); font-size: 0.76rem; }
  #message-login { margin-top: 0.7rem; }
  #message-login input { flex: 1; min-width: 0; }

  #message-logout,
  #message-login-submit,
  .message-delete {
    border: 0;
    border-radius: 8px;
    padding: 0.38rem 0.72rem;
    color: var(--standard-text, inherit);
    background: var(--standard-card-soft, rgba(255,255,255,.1));
    cursor: pointer;
    font: inherit;
    font-size: 0.72rem;
  }

  .messages-stream-column { min-width: 0; }

  .messages-stream-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 13px;
    padding: 2px 2px 0;
  }

  .messages-stream-summary {
    display: flex;
    align-items: baseline;
    gap: 5px;
    color: var(--standard-muted, var(--muted));
    font-size: 0.74rem;
  }

  .messages-stream-summary strong {
    color: var(--standard-cyan, var(--accent));
    font-size: 1.2rem;
  }

  .messages-list {
    display: grid;
    gap: 12px;
  }

  .message-card {
    position: relative;
    overflow: hidden;
    border-radius: 15px;
    padding: 17px 19px 15px;
  }

  .message-card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: linear-gradient(to bottom, var(--standard-accent, var(--accent)), var(--standard-purple, var(--accent)));
    opacity: 0.82;
  }

  .message-card:nth-child(3n + 2)::before {
    background: linear-gradient(to bottom, var(--standard-cyan, var(--accent)), var(--standard-purple, var(--accent)));
  }

  .message-card:nth-child(3n + 3)::before {
    background: linear-gradient(to bottom, var(--standard-warm, var(--accent)), var(--standard-accent, var(--accent)));
  }

  .message-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .message-meta strong {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 9px;
    border-radius: 8px;
    background: var(--standard-accent-soft, rgba(var(--accent-rgb), .1));
    color: var(--standard-accent, var(--text));
    font-size: 0.8rem;
  }

  .message-meta time {
    margin-left: auto;
    color: var(--standard-muted, var(--muted));
    font-size: 0.74rem;
    white-space: nowrap;
  }

  .message-delete {
    margin-left: 0;
    color: #e88794;
    background: rgba(216, 80, 100, 0.1);
  }

  .message-text {
    margin: 0 0 12px;
    color: var(--standard-text, var(--text));
    font-size: 0.92rem;
    line-height: 1.78;
    white-space: pre-wrap;
  }

  .message-loading,
  .message-empty {
    margin: 0;
    padding: 48px 18px;
    border: 1px dashed var(--standard-line, var(--panel-border));
    border-radius: 15px;
    background: var(--standard-card-bg, transparent);
    text-align: center;
    color: var(--standard-muted, var(--muted));
  }

  @media (max-width: 900px) {
    .messages-layout { grid-template-columns: 1fr; }
    .messages-composer-column { position: static; }
  }

  @media (max-width: 640px) {
    .messages-composer-heading,
    .message-form,
    .message-admin { padding-left: 15px; padding-right: 15px; }

    .form-actions,
    .message-meta {
      align-items: stretch;
      grid-template-columns: 1fr;
    }

    .form-actions { display: grid; }
    #message-submit { width: 100%; }
    .message-meta { display: flex; flex-wrap: wrap; }
    .message-meta time { margin-left: 0; }
    .message-delete { margin-left: auto; }
  }
</style>

<script>
  import {
    createCommentsWidget,
    createGuestMessage,
    deleteGuestMessage,
    fetchGuestMessages,
    formatPublicTime,
    getStoredUserId,
    normalizeUserId,
    setStoredUserId,
    type GuestMessage,
  } from '../lib/public-interactions';
  import { getSession, login, logout } from '../lib/moments-api';

  const form = document.getElementById('message-form') as HTMLFormElement | null;
  const userInput = document.getElementById('message-user-id') as HTMLInputElement | null;
  const textInput = document.getElementById('message-text') as HTMLTextAreaElement | null;
  const submit = document.getElementById('message-submit') as HTMLButtonElement | null;
  const status = document.getElementById('message-status');
  const list = document.getElementById('messages-list');
  const count = document.getElementById('message-count');
  const sessionStatus = document.getElementById('message-session-status');
  const loginBox = document.getElementById('message-login');
  const loginPassword = document.getElementById('message-login-password') as HTMLInputElement | null;
  const loginSubmit = document.getElementById('message-login-submit') as HTMLButtonElement | null;
  const logoutButton = document.getElementById('message-logout') as HTMLButtonElement | null;
  let adminMode = false;
  let currentMessages: GuestMessage[] = [];

  if (userInput) userInput.value = getStoredUserId();

  function setStatus(text: string, error = false) {
    if (!status) return;
    status.textContent = text;
    status.className = error ? 'error' : '';
  }

  function updateSessionUi(authenticated: boolean, message = '') {
    adminMode = authenticated;
    if (sessionStatus) sessionStatus.textContent = message || (authenticated ? '已登录，可以删除留言。' : '管理员登录后可删除留言。');
    if (loginBox) loginBox.hidden = authenticated;
    if (logoutButton) logoutButton.hidden = !authenticated;
    if (currentMessages.length > 0) renderMessages(currentMessages);
  }

  function renderMessages(messages: GuestMessage[]) {
    if (!list) return;
    currentMessages = messages;
    list.innerHTML = '';
    if (count) count.textContent = String(messages.length);

    if (!messages.length) {
      const empty = document.createElement('p');
      empty.className = 'message-empty';
      empty.textContent = '还没有留言，来写第一条吧。';
      list.appendChild(empty);
      return;
    }

    messages.forEach((message) => {
      const card = document.createElement('article');
      card.className = 'message-card';
      const meta = document.createElement('div');
      meta.className = 'message-meta';
      const user = document.createElement('strong');
      user.textContent = message.userId;
      const time = document.createElement('time');
      time.dateTime = new Date(message.createdAt).toISOString();
      time.textContent = formatPublicTime(message.createdAt);
      meta.append(user, time);
      if (adminMode) {
        const deleteButton = document.createElement('button');
        deleteButton.type = 'button';
        deleteButton.className = 'message-delete';
        deleteButton.textContent = '删除';
        deleteButton.title = '删除这条留言';
        deleteButton.addEventListener('click', async () => {
          if (!window.confirm('确定删除这条留言吗？删除后不可恢复。')) return;
          deleteButton.disabled = true;
          try {
            await deleteGuestMessage(message.id);
            currentMessages = currentMessages.filter((item) => item.id !== message.id);
            renderMessages(currentMessages);
          } catch (err) {
            deleteButton.disabled = false;
            setStatus(err instanceof Error ? err.message : '删除失败', true);
          }
        });
        meta.appendChild(deleteButton);
      }

      const text = document.createElement('p');
      text.className = 'message-text';
      text.textContent = message.text;
      card.append(meta, text, createCommentsWidget('message', message.id, message.commentCount));
      list.appendChild(card);
    });
  }

  async function refreshSession() {
    try {
      const state = await getSession();
      updateSessionUi(state.authenticated);
    } catch (err) {
      updateSessionUi(false, err instanceof Error ? err.message : '登录状态检查失败');
    }
  }

  loginSubmit?.addEventListener('click', async () => {
    const password = loginPassword?.value.trim() || '';
    if (!password) return updateSessionUi(false, '请输入管理员密码');
    loginSubmit.disabled = true;
    try {
      const state = await login(password);
      if (loginPassword) loginPassword.value = '';
      updateSessionUi(state.authenticated);
    } catch (err) {
      updateSessionUi(false, err instanceof Error ? err.message : '登录失败，请重试');
    } finally {
      loginSubmit.disabled = false;
    }
  });

  loginPassword?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') loginSubmit?.click();
  });

  logoutButton?.addEventListener('click', async () => {
    logoutButton.disabled = true;
    try {
      await logout();
      updateSessionUi(false, '已退出登录');
    } finally {
      logoutButton.disabled = false;
    }
  });

  async function refreshMessages() {
    if (!list) return;
    try {
      renderMessages(await fetchGuestMessages());
    } catch (err) {
      if (count) count.textContent = '—';
      list.innerHTML = '<p class="message-empty">留言加载失败，请稍后再试。</p>';
    }
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!userInput || !textInput || !submit) return;

    const userId = normalizeUserId(userInput.value);
    const text = textInput.value.trim();
    if (!userId || !text) {
      setStatus('请填写 ID 和留言内容', true);
      return;
    }

    setStoredUserId(userId);
    submit.disabled = true;
    setStatus('');

    try {
      const item = await createGuestMessage(userId, text);
      textInput.value = '';
      const fresh = await fetchGuestMessages().catch(() => null);
      renderMessages(fresh || [item]);
      setStatus('已发送');
    } catch (err) {
      setStatus(err instanceof Error ? err.message : '发送失败', true);
    } finally {
      submit.disabled = false;
    }
  });

  refreshMessages();
  refreshSession();
</script>
