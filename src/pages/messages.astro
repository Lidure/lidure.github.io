---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="留言板 | 搁浅 的小窝" description="给博客留下想说的话。">
  <section class="messages-shell">
    <header class="messages-hero">
      <span class="kicker">Guestbook</span>
      <h1>留言板</h1>
      <p>路过也可以留下一句话。自设一个 ID 就能留言和评论，不需要密钥。</p>
    </header>

    <section class="message-admin" id="message-admin">
      <div class="message-admin-row">
        <span id="message-session-status">检查登录状态中...</span>
        <button type="button" id="message-logout" hidden>退出登录</button>
      </div>
      <div id="message-login" hidden>
        <input type="password" id="message-login-password" placeholder="管理员密码" autocomplete="current-password" />
        <button type="button" id="message-login-submit">登录</button>
      </div>
    </section>

    <form class="message-form" id="message-form">
      <label>
        <span>你的 ID</span>
        <input type="text" name="userId" id="message-user-id" maxlength="32" placeholder="例如：路过的旅人" required />
      </label>
      <label>
        <span>留言</span>
        <textarea name="text" id="message-text" maxlength="800" rows="4" placeholder="写点什么..." required></textarea>
      </label>
      <div class="form-actions">
        <p id="message-status" aria-live="polite"></p>
        <button type="submit" id="message-submit">发送留言</button>
      </div>
    </form>

    <div class="messages-list" id="messages-list">
      <div class="message-loading">留言加载中...</div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .messages-shell {
    max-width: 760px;
    margin: 0 auto;
  }

  .messages-hero {
    padding: 34px 34px 30px;
    margin-bottom: 22px;
    border-radius: var(--radius-xl);
    border: 1px solid var(--panel-border);
    background: var(--panel-gradient);
    box-shadow: var(--shadow);
    text-align: center;
  }

  .messages-hero .kicker {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.78rem;
  }

  .messages-hero h1 {
    margin: 8px 0 10px;
    font-family: 'Ma Shan Zheng', cursive;
    font-size: 3.6rem;
    letter-spacing: 0;
  }

  .messages-hero p {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .message-form,
  .message-card {
    border: 1px solid var(--panel-border);
    background: var(--panel-gradient);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(14px);
  }

  .message-form {
    display: grid;
    gap: 14px;
    padding: 20px 22px;
    margin-bottom: 20px;
    border-radius: var(--radius-lg);
  }

  .message-form label {
    display: grid;
    gap: 7px;
  }

  .message-form span {
    color: var(--muted);
    font-size: 0.84rem;
    font-weight: 700;
  }

  .message-form input,
  .message-form textarea {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid var(--panel-border);
    border-radius: 12px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    padding: 11px 13px;
  }

  .message-form textarea {
    resize: vertical;
    min-height: 106px;
  }

  .message-form input:focus,
  .message-form textarea:focus {
    outline: none;
    border-color: var(--accent);
  }

  .form-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  #message-status {
    min-height: 20px;
    margin: 0;
    color: var(--muted);
    font-size: 0.86rem;
  }

  #message-status.error {
    color: #d94040;
  }

  #message-submit {
    border: none;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--accent), var(--accent-3));
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-weight: 700;
    padding: 11px 18px;
    box-shadow: 0 4px 16px rgba(var(--accent-rgb), 0.28);
  }

  #message-submit:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .message-admin {
    margin: 1rem 0;
    padding: 0.75rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 14px;
    background: rgba(10, 14, 30, 0.35);
  }

  .message-admin-row,
  #message-login {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  #message-login {
    margin-top: 0.6rem;
  }

  #message-login input {
    flex: 1;
    min-width: 0;
  }

  #message-logout,
  #message-login-submit,
  .message-delete {
    border: 0;
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    color: inherit;
    background: rgba(255, 255, 255, 0.12);
    cursor: pointer;
  }

  .message-delete {
    margin-left: auto;
    color: #ffc1cb;
    background: rgba(255, 92, 122, 0.14);
  }

  .message-delete:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .messages-list {
    display: grid;
    gap: 14px;
  }

  .message-card {
    border-radius: var(--radius-lg);
    padding: 18px 20px;
  }

  .message-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .message-meta strong {
    color: var(--text);
  }

  .message-meta time {
    color: var(--muted);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .message-text {
    margin: 0;
    color: var(--text);
    line-height: 1.75;
    white-space: pre-wrap;
  }

  .message-loading,
  .message-empty {
    padding: 34px 18px;
    text-align: center;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .messages-hero {
      padding: 28px 18px 24px;
    }

    .messages-hero h1 {
      font-size: 2.7rem;
    }

    .form-actions,
    .message-meta {
      align-items: flex-start;
      flex-direction: column;
    }

    #message-submit {
      width: 100%;
    }
  }
</style>

<script>
  import {
    createCommentsWidget,
    createGuestMessage,
    deleteGuestMessage,
    fetchGuestMessages,
    formatPublicTime,
    getStoredUserId,
    normalizeUserId,
    setStoredUserId,
    type GuestMessage,
  } from '../lib/public-interactions';
  import { getSession, login, logout } from '../lib/moments-api';

  const form = document.getElementById('message-form') as HTMLFormElement | null;
  const userInput = document.getElementById('message-user-id') as HTMLInputElement | null;
  const textInput = document.getElementById('message-text') as HTMLTextAreaElement | null;
  const submit = document.getElementById('message-submit') as HTMLButtonElement | null;
  const status = document.getElementById('message-status');
  const list = document.getElementById('messages-list');
  const sessionStatus = document.getElementById('message-session-status');
  const loginBox = document.getElementById('message-login');
  const loginPassword = document.getElementById('message-login-password') as HTMLInputElement | null;
  const loginSubmit = document.getElementById('message-login-submit') as HTMLButtonElement | null;
  const logoutButton = document.getElementById('message-logout') as HTMLButtonElement | null;
  let adminMode = false;
  let currentMessages: GuestMessage[] = [];

  if (userInput) userInput.value = getStoredUserId();

  function setStatus(text: string, error = false) {
    if (!status) return;
    status.textContent = text;
    status.className = error ? 'error' : '';
  }

  function updateSessionUi(authenticated: boolean, message = '') {
    adminMode = authenticated;
    if (sessionStatus) sessionStatus.textContent = message || (authenticated ? '已登录，可以删除留言。' : '管理员登录后可删除留言。');
    if (loginBox) loginBox.hidden = authenticated;
    if (logoutButton) logoutButton.hidden = !authenticated;
    if (currentMessages.length > 0) renderMessages(currentMessages);
  }

  function renderMessages(messages: GuestMessage[]) {
    if (!list) return;
    currentMessages = messages;
    list.innerHTML = '';

    if (!messages.length) {
      const empty = document.createElement('p');
      empty.className = 'message-empty';
      empty.textContent = '还没有留言，来写第一条吧。';
      list.appendChild(empty);
      return;
    }

    messages.forEach((message) => {
      const card = document.createElement('article');
      card.className = 'message-card';
      const meta = document.createElement('div');
      meta.className = 'message-meta';
      const user = document.createElement('strong');
      user.textContent = message.userId;
      const time = document.createElement('time');
      time.dateTime = new Date(message.createdAt).toISOString();
      time.textContent = formatPublicTime(message.createdAt);
      meta.append(user, time);
      if (adminMode) {
        const deleteButton = document.createElement('button');
        deleteButton.type = 'button';
        deleteButton.className = 'message-delete';
        deleteButton.textContent = '删除';
        deleteButton.title = '删除这条留言';
        deleteButton.addEventListener('click', async () => {
          if (!window.confirm('确定删除这条留言吗？删除后不可恢复。')) return;
          deleteButton.disabled = true;
          try {
            await deleteGuestMessage(message.id);
            currentMessages = currentMessages.filter((item) => item.id !== message.id);
            renderMessages(currentMessages);
          } catch (err) {
            deleteButton.disabled = false;
            setStatus(err instanceof Error ? err.message : '删除失败', true);
          }
        });
        meta.appendChild(deleteButton);
      }

      const text = document.createElement('p');
      text.className = 'message-text';
      text.textContent = message.text;
      card.append(meta, text, createCommentsWidget('message', message.id, message.commentCount));
      list.appendChild(card);
    });
  }

  async function refreshSession() {
    try {
      const state = await getSession();
      updateSessionUi(state.authenticated);
    } catch (err) {
      updateSessionUi(false, err instanceof Error ? err.message : '登录状态检查失败');
    }
  }

  loginSubmit?.addEventListener('click', async () => {
    const password = loginPassword?.value.trim() || '';
    if (!password) return updateSessionUi(false, '请输入管理员密码');
    loginSubmit.disabled = true;
    try {
      const state = await login(password);
      if (loginPassword) loginPassword.value = '';
      updateSessionUi(state.authenticated);
    } catch (err) {
      updateSessionUi(false, err instanceof Error ? err.message : '登录失败，请重试');
    } finally {
      loginSubmit.disabled = false;
    }
  });

  loginPassword?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') loginSubmit?.click();
  });

  logoutButton?.addEventListener('click', async () => {
    logoutButton.disabled = true;
    try {
      await logout();
      updateSessionUi(false, '已退出登录');
    } finally {
      logoutButton.disabled = false;
    }
  });

  async function refreshMessages() {
    if (!list) return;
    try {
      renderMessages(await fetchGuestMessages());
    } catch (err) {
      list.innerHTML = '<p class="message-empty">留言加载失败，请稍后再试。</p>';
    }
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!userInput || !textInput || !submit) return;

    const userId = normalizeUserId(userInput.value);
    const text = textInput.value.trim();
    if (!userId || !text) {
      setStatus('请填写 ID 和留言内容', true);
      return;
    }

    setStoredUserId(userId);
    submit.disabled = true;
    setStatus('');

    try {
      const item = await createGuestMessage(userId, text);
      textInput.value = '';
      const fresh = await fetchGuestMessages().catch(() => null);
      renderMessages(fresh || [item]);
      setStatus('已发送');
    } catch (err) {
      setStatus(err instanceof Error ? err.message : '发送失败', true);
    } finally {
      submit.disabled = false;
    }
  });

  refreshMessages();
  refreshSession();
</script>
