---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getGitHubProjects } from '../../lib/github-projects';
import '../../styles/article-archive.css';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const projects = await getGitHubProjects();
---
<BaseLayout
  title="文章 | 搁浅 的小窝"
  description="按时间浏览博客文章，也顺手放着近期维护的 GitHub 项目。"
  bannerTitle="文章"
  bannerSubtitle="按时间浏览博客文章，也顺手放着近期维护的 GitHub 项目。"
>
  <section class="article-archive">
    <header class="article-archive-head">
      <h1>文章</h1>
      <p>写下来以后，很多当时觉得理所当然的事才不会悄悄消失。</p>
    </header>

    <div class="article-archive-list">
      {posts.map((post) => {
        const href = `/posts/${post.id.replace(/\.md$/, '')}`;
        const published = post.data.pubDate.toLocaleDateString('zh-CN', {
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
        }).replaceAll('/', '.');
        const updated = post.data.updatedDate?.toLocaleDateString('zh-CN', {
          month: '2-digit',
          day: '2-digit',
        }).replaceAll('/', '.');

        return (
          <article class="article-entry">
            <a class="article-entry-link" href={href}>
              <time class="article-entry-date" datetime={post.data.pubDate.toISOString()}>
                {published}
                {updated && <span>更新 {updated}</span>}
              </time>
              <div class="article-entry-body">
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
                {post.data.tags.length > 0 && (
                  <div class="article-entry-tags" aria-label="文章标签">
                    {post.data.tags.map((tag) => <span>#{tag}</span>)}
                  </div>
                )}
              </div>
            </a>
          </article>
        );
      })}
    </div>

    <section class="article-projects-secondary" aria-labelledby="article-projects-title">
      <header class="article-projects-head">
        <h2 id="article-projects-title">GitHub 项目</h2>
        <p>文章之外，最近还在折腾这些。</p>
      </header>

      {projects.length > 0 ? (
        <div class="article-project-list">
          {projects.map((project) => (
            <article class="article-project-card">
              <div class="article-project-topline">
                <span class="article-project-language">{project.language}</span>
                <span>★ {project.stars}</span>
              </div>
              <h3><a href={project.htmlUrl} target="_blank" rel="noreferrer">{project.name}</a></h3>
              <p>{project.description}</p>
              <div class="article-project-footer">
                <span>更新于 {new Date(project.pushedAt).toLocaleDateString('zh-CN')}</span>
                {project.homepage && <a href={project.homepage} target="_blank" rel="noreferrer">官网</a>}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="article-project-empty">暂时没拉到公开项目，过会儿再来看看。</p>
      )}
    </section>
  </section>
</BaseLayout>
