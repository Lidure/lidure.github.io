---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import { estimateReadingMinutes } from '../../utils/article-reading';
import '../../styles/article-reading.css';
import 'katex/dist/katex.min.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const updatedDate = post.data.updatedDate ?? post.data.pubDate;
const readingMinutes = estimateReadingMinutes(post.body ?? '');
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const publishedMachine = post.data.pubDate.toISOString();
const updatedMachine = updatedDate.toISOString();
const publishedLabel = post.data.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).replaceAll('/', '.');
const updatedLabel = updatedDate.toLocaleDateString('zh-CN', {
  month: '2-digit',
  day: '2-digit',
}).replaceAll('/', '.');
---
<BaseLayout
  title={`${post.data.title} | Lidure Blog`}
  description={post.data.description}
  showBanner={false}
>
  <article class="article-publication">
    {tocHeadings.length > 0 && (
      <details class="article-toc-mobile">
        <summary>目录 <span>{tocHeadings.length} 节</span></summary>
        <nav aria-label="文章目录">
          {tocHeadings.map((heading) => (
            <a
              class="article-toc-link"
              data-depth={heading.depth}
              data-article-toc={heading.slug}
              href={`#${heading.slug}`}
            >{heading.text}</a>
          ))}
        </nav>
      </details>
    )}

    <div class="sayori-reading-grid">
      <aside class="sayori-toc-sidebar" aria-label="文章目录">
        {tocHeadings.length > 0 && (
          <div class="sayori-sidebar-sticky">
            <div class="article-toc-heading">
              <span>目录</span>
              <span>{tocHeadings.length} 节</span>
            </div>
            <nav class="sayori-toc-list">
              {tocHeadings.map((heading) => (
                <a
                  class="article-toc-link"
                  data-depth={heading.depth}
                  data-article-toc={heading.slug}
                  href={`#${heading.slug}`}
                >{heading.text}</a>
              ))}
            </nav>
            <div class="article-toc-progress" aria-hidden="true"><span></span></div>
          </div>
        )}
      </aside>

      <main class="sayori-main-column">
        <div class="sayori-post-card">
          <div class="post-reading-stats" aria-label="阅读信息">
            <span>{tocHeadings.length} 个章节</span>
            <span>{readingMinutes} 分钟阅读</span>
          </div>

          <header class="post-header">
            <h1 class="post-title">{post.data.title}</h1>
            <div class="post-meta" aria-label="文章信息">
              <time datetime={publishedMachine}>{publishedLabel}</time>
              <span aria-hidden="true">·</span>
              <span>更新 <time datetime={updatedMachine}>{updatedLabel}</time></span>
            </div>
            {post.data.description && <p class="post-description">{post.data.description}</p>}
            {post.data.tags.length > 0 && (
              <div class="post-tags" aria-label="文章标签">
                {post.data.tags.map((tag) => <span>#{tag}</span>)}
              </div>
            )}
            <div class="post-divider" aria-hidden="true"></div>
          </header>

          <div class="prose article-prose">
            <div class="markdown-content">
              <Content />
            </div>
          </div>
          <div class="article-end" aria-hidden="true"></div>
        </div>

        <section class="article-comments" aria-label="评论"><Comments /></section>
      </main>

      <aside class="sayori-right-sidebar" aria-label="阅读辅助">
        <div class="sayori-sidebar-sticky">
          <section class="right-sidebar-card reading-progress-card">
            <span class="sidebar-kicker">READING</span>
            <strong data-article-progress-label>0%</strong>
            <span>阅读进度</span>
          </section>
          <section class="right-sidebar-card">
            <span class="sidebar-kicker">ARTICLE</span>
            <dl class="right-sidebar-meta">
              <div><dt>发布</dt><dd>{publishedLabel}</dd></div>
              <div><dt>更新</dt><dd>{updatedLabel}</dd></div>
              <div><dt>预计</dt><dd>{readingMinutes} 分钟</dd></div>
            </dl>
          </section>
          {post.data.tags.length > 0 && (
            <section class="right-sidebar-card">
              <span class="sidebar-kicker">TAGS</span>
              <div class="right-sidebar-tags">
                {post.data.tags.slice(0, 6).map((tag) => <span>#{tag}</span>)}
              </div>
            </section>
          )}
          <button type="button" class="article-backtop" data-article-backtop>回到顶部 <span aria-hidden="true">↑</span></button>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<script>
  const articleWindow = window as typeof window & {
    __articlePublicationCleanup?: () => void;
    __articlePublicationLifecycleBound?: boolean;
  };

  function initArticlePublication() {
    articleWindow.__articlePublicationCleanup?.();

    const article = document.querySelector<HTMLElement>('.article-publication');
    const prose = article?.querySelector<HTMLElement>('.article-prose');
    if (!article || !prose) return;

    const controller = new AbortController();
    const { signal } = controller;
    const tocLinks = Array.from(article.querySelectorAll<HTMLAnchorElement>('[data-article-toc]'));
    const headingIds = Array.from(new Set(tocLinks.map((link) => link.dataset.articleToc).filter(Boolean))) as string[];
    const progressLabel = article.querySelector<HTMLElement>('[data-article-progress-label]');
    const backtop = article.querySelector<HTMLButtonElement>('[data-article-backtop]');
    let ticking = false;

    const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches
      || document.documentElement.dataset.reduceMotion === 'true';

    const sync = () => {
      ticking = false;
      const rect = prose.getBoundingClientRect();
      const start = window.scrollY + rect.top;
      const end = start + prose.offsetHeight - window.innerHeight;
      const span = Math.max(1, end - start);
      const progress = Math.min(1, Math.max(0, (window.scrollY - start) / span));
      article.style.setProperty('--article-reading-progress', String(progress));
      if (progressLabel) progressLabel.textContent = `${Math.round(progress * 100)}%`;

      let currentId = headingIds[0] ?? '';
      for (const id of headingIds) {
        const heading = document.getElementById(id);
        if (heading && heading.getBoundingClientRect().top <= Math.min(180, window.innerHeight * 0.28)) {
          currentId = id;
        }
      }

      tocLinks.forEach((link) => {
        link.classList.toggle('is-current', Boolean(currentId) && link.dataset.articleToc === currentId);
      });
    };

    const requestSync = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(sync);
    };

    tocLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        const id = link.dataset.articleToc;
        if (!id) return;
        const heading = document.getElementById(id);
        if (!heading) return;
        event.preventDefault();
        heading.scrollIntoView({ behavior: reducedMotion() ? 'auto' : 'smooth', block: 'start' });
        history.replaceState(null, '', `#${encodeURIComponent(id)}`);
        link.closest<HTMLDetailsElement>('.article-toc-mobile')?.removeAttribute('open');
      }, { signal });
    });

    backtop?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: reducedMotion() ? 'auto' : 'smooth' });
    }, { signal });

    window.addEventListener('scroll', requestSync, { passive: true, signal });
    window.addEventListener('resize', requestSync, { passive: true, signal });

    articleWindow.__articlePublicationCleanup = () => controller.abort();
    sync();
  }

  if (!articleWindow.__articlePublicationLifecycleBound) {
    articleWindow.__articlePublicationLifecycleBound = true;
    document.addEventListener('astro:page-load', initArticlePublication);
    document.addEventListener('astro:before-swap', () => articleWindow.__articlePublicationCleanup?.());
  }

  initArticlePublication();
</script>
