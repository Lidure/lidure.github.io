---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import ArticleTOC from '../../components/ArticleTOC.astro';
import { estimateReadingMinutes } from '../../utils/article-reading';
import '../../styles/article-reading.css';
import '../../styles/article-toc-sayori.css';
import '../../styles/article-sayori-layout.css';
import 'katex/dist/katex.min.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const updatedDate = post.data.updatedDate ?? post.data.pubDate;
const readingMinutes = estimateReadingMinutes(post.body ?? '');
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const publishedMachine = post.data.pubDate.toISOString();
const updatedMachine = updatedDate.toISOString();
const publishedLabel = post.data.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).replaceAll('/', '.');
const updatedLabel = updatedDate.toLocaleDateString('zh-CN', {
  month: '2-digit',
  day: '2-digit',
}).replaceAll('/', '.');
---
<BaseLayout
  title={`${post.data.title} | Lidure Blog`}
  description={post.data.description}
  showBanner={false}
>
  <article class="article-publication">
    {tocHeadings.length > 0 && (
      <details class="article-toc-mobile">
        <summary>目录 <span>{tocHeadings.length} 节</span></summary>
        <nav aria-label="文章目录">
          {tocHeadings.map((heading) => (
            <a
              class="article-toc-link"
              data-depth={heading.depth}
              data-article-toc={heading.slug}
              href={`#${heading.slug}`}
            >{heading.text}</a>
          ))}
        </nav>
      </details>
    )}

    <div class="sayori-reading-grid">
      <aside class="sayori-toc-sidebar" aria-label="文章目录">
        {tocHeadings.length > 0 && (
          <div class="sayori-sidebar-sticky">
            <ArticleTOC headings={tocHeadings} />
          </div>
        )}
      </aside>

      <main class="sayori-main-column">
        <div class="sayori-post-card">
          <div class="post-reading-stats" aria-label="阅读信息">
            <span>{tocHeadings.length} 个章节</span>
            <span>{readingMinutes} 分钟阅读</span>
          </div>

          <header class="post-header">
            <h1 class="post-title">{post.data.title}</h1>
            <div class="post-meta" aria-label="文章信息">
              <time datetime={publishedMachine}>{publishedLabel}</time>
              <span aria-hidden="true">·</span>
              <span>更新 <time datetime={updatedMachine}>{updatedLabel}</time></span>
            </div>
            {post.data.description && <p class="post-description">{post.data.description}</p>}
            {post.data.tags.length > 0 && (
              <div class="post-tags" aria-label="文章标签">
                {post.data.tags.map((tag) => <span>#{tag}</span>)}
              </div>
            )}
            <div class="post-divider" aria-hidden="true"></div>
          </header>

          <div class="prose article-prose">
            <div class="markdown-content">
              <Content />
            </div>
          </div>
          <div class="article-end" aria-hidden="true"></div>
        </div>

        <section class="article-comments" aria-label="评论"><Comments /></section>
      </main>

      <aside class="sayori-right-sidebar" aria-label="阅读辅助">
        <div class="sayori-sidebar-sticky">
          <section class="right-sidebar-card reading-progress-card">
            <span class="sidebar-kicker">READING</span>
            <strong data-article-progress-label>0%</strong>
            <span>阅读进度</span>
          </section>
          <section class="right-sidebar-card">
            <span class="sidebar-kicker">ARTICLE</span>
            <dl class="right-sidebar-meta">
              <div><dt>发布</dt><dd>{publishedLabel}</dd></div>
              <div><dt>更新</dt><dd>{updatedLabel}</dd></div>
              <div><dt>预计</dt><dd>{readingMinutes} 分钟</dd></div>
            </dl>
          </section>
          {post.data.tags.length > 0 && (
            <section class="right-sidebar-card">
              <span class="sidebar-kicker">TAGS</span>
              <div class="right-sidebar-tags">
                {post.data.tags.slice(0, 6).map((tag) => <span>#{tag}</span>)}
              </div>
            </section>
          )}
          <button type="button" class="article-backtop" data-article-backtop>回到顶部 <span aria-hidden="true">↑</span></button>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<script>
  const articleWindow = window as typeof window & {
    __articlePublicationCleanup?: () => void;
    __articlePublicationLifecycleBound?: boolean;
  };

  function initArticlePublication() {
    articleWindow.__articlePublicationCleanup?.();

    const article = document.querySelector<HTMLElement>('.article-publication');
    const prose = article?.querySelector<HTMLElement>('.article-prose');
    if (!article || !prose) return;
    const proseElement: HTMLElement = prose;

    const controller = new AbortController();
    const { signal } = controller;
    const tocLinks = Array.from(article.querySelectorAll<HTMLAnchorElement>('[data-article-toc]'));
    const desktopTocLinks = Array.from(article.querySelectorAll<HTMLAnchorElement>('[data-article-card-toc] [data-article-toc]'));
    const headingIds = Array.from(new Set(tocLinks.map((link) => link.dataset.articleToc).filter(Boolean))) as string[];
    const headingElements = headingIds
      .map((id) => document.getElementById(id))
      .filter((heading): heading is HTMLElement => heading instanceof HTMLElement);
    const tocScrollContainer = article.querySelector<HTMLElement>('[data-article-toc-scroll]');
    const tocContent = article.querySelector<HTMLElement>('.toc-content');
    const indicator = article.querySelector<HTMLElement>('[data-article-toc-indicator]');
    const progressLabel = article.querySelector<HTMLElement>('[data-article-progress-label]');
    const backtop = article.querySelector<HTMLButtonElement>('[data-article-backtop]');
    const activeHeadingIds = new Set<string>();

    let progressStart = 0;
    let progressSpan = 1;
    let progressTicking = false;
    let lastProgressPercent = -1;

    const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches
      || document.documentElement.dataset.reduceMotion === 'true';

    const collectVisibleHeadingIds = () => {
      const visible = headingElements
        .filter((heading) => {
          const rect = heading.getBoundingClientRect();
          return rect.top < window.innerHeight && rect.bottom > 0;
        })
        .map((heading) => heading.id);

      if (visible.length > 0 || headingElements.length === 0) return visible;

      let closest = headingElements[0];
      let closestDistance = Number.POSITIVE_INFINITY;
      headingElements.forEach((heading) => {
        const distance = Math.abs(heading.getBoundingClientRect().top - 80);
        if (distance < closestDistance) {
          closest = heading;
          closestDistance = distance;
        }
      });
      return closest ? [closest.id] : [];
    };

    const syncTocActiveRange = () => {
      const visibleIds = activeHeadingIds.size > 0
        ? Array.from(activeHeadingIds)
        : collectVisibleHeadingIds();

      desktopTocLinks.forEach((link) => {
        link.classList.toggle('visible', Boolean(link.dataset.articleToc) && visibleIds.includes(link.dataset.articleToc!));
      });

      const activeEntries = desktopTocLinks.filter((link) => link.classList.contains('visible'));
      if (!indicator || !tocContent || activeEntries.length === 0) {
        if (indicator) indicator.style.opacity = '0';
        return;
      }

      const firstActive = activeEntries[0];
      const lastActive = activeEntries[activeEntries.length - 1];
      const top = firstActive.offsetTop;
      const height = lastActive.offsetTop + lastActive.offsetHeight - firstActive.offsetTop;

      indicator.style.top = `${top}px`;
      indicator.style.height = `${height}px`;
      indicator.style.opacity = '1';

      if (!tocScrollContainer) return;
      const itemTop = firstActive.offsetTop;
      const itemBottom = itemTop + firstActive.offsetHeight;
      const viewportTop = tocScrollContainer.scrollTop;
      const viewportBottom = viewportTop + tocScrollContainer.clientHeight;
      const isInside = itemTop >= viewportTop && itemBottom <= viewportBottom;

      if (!isInside) {
        const targetTop = itemTop - tocScrollContainer.clientHeight / 2 + firstActive.clientHeight / 2;
        tocScrollContainer.scrollTo({
          top: Math.max(0, targetTop),
          behavior: reducedMotion() ? 'auto' : 'smooth',
        });
      }
    };

    const tocObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const heading = entry.target as HTMLElement;
        if (entry.isIntersecting) activeHeadingIds.add(heading.id);
        else activeHeadingIds.delete(heading.id);
      });
      syncTocActiveRange();
    }, { threshold: 0 });

    headingElements.forEach((heading) => tocObserver.observe(heading));

    function measureReadingProgress() {
      const rect = proseElement.getBoundingClientRect();
      progressStart = window.scrollY + rect.top;
      const progressEnd = progressStart + proseElement.offsetHeight - window.innerHeight;
      progressSpan = Math.max(1, progressEnd - progressStart);
    }

    function syncReadingProgress() {
      progressTicking = false;
      const progress = Math.min(1, Math.max(0, (window.scrollY - progressStart) / progressSpan));
      const progressPercent = Math.round(progress * 100);
      if (progressLabel && progressPercent !== lastProgressPercent) {
        progressLabel.textContent = `${Math.round(progress * 100)}%`;
        lastProgressPercent = progressPercent;
      }
    }

    const requestProgressSync = () => {
      if (progressTicking) return;
      progressTicking = true;
      requestAnimationFrame(syncReadingProgress);
    };

    tocLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        const id = link.dataset.articleToc;
        if (!id) return;
        const heading = document.getElementById(id);
        if (!heading) return;
        event.preventDefault();
        const targetTop = heading.getBoundingClientRect().top + window.scrollY - 80;
        window.scrollTo({ top: targetTop, behavior: reducedMotion() ? 'auto' : 'smooth' });
        history.replaceState(null, '', `#${encodeURIComponent(id)}`);
        link.closest<HTMLDetailsElement>('.article-toc-mobile')?.removeAttribute('open');
      }, { signal });
    });

    backtop?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: reducedMotion() ? 'auto' : 'smooth' });
    }, { signal });

    const handleResize = () => {
      measureReadingProgress();
      syncReadingProgress();
      syncTocActiveRange();
    };

    window.addEventListener('scroll', requestProgressSync, { passive: true, signal });
    window.addEventListener('resize', handleResize, { passive: true, signal });

    articleWindow.__articlePublicationCleanup = () => {
      tocObserver.disconnect();
      controller.abort();
    };

    measureReadingProgress();
    syncReadingProgress();
    syncTocActiveRange();
  }

  if (!articleWindow.__articlePublicationLifecycleBound) {
    articleWindow.__articlePublicationLifecycleBound = true;
    document.addEventListener('astro:page-load', initArticlePublication);
    document.addEventListener('astro:before-swap', () => articleWindow.__articlePublicationCleanup?.());
  }

  initArticlePublication();
</script>
