---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { homePresence } from '../data/home-presence';
import '../styles/home.css';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const leadPost = posts[0];
const supportingPosts = posts.slice(1, 5);
const postHref = (id: string) => `/posts/${id.replace(/\.md$/, '')}`;
const dateLabel = (date: Date) => date.toLocaleDateString('zh-CN', {
  month: '2-digit',
  day: '2-digit',
}).replaceAll('/', '.');
---

<BaseLayout
  title="搁浅 的小窝"
  description="一个充满二次元氛围的个人博客，记录游戏、音乐、项目与日常。"
  showBanner={false}
>
  <div class="home-page">
    <section class="home-presence" aria-labelledby="home-name">
      <div class="home-presence-copy">
        <p class="home-eyebrow">你好，这里是</p>
        <h1 id="home-name">搁浅</h1>
        <p class="home-intro">{homePresence.intro}</p>

        <dl class="home-now" aria-label="最近在做的事">
          {homePresence.now.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.href ? <a href={item.href}>{item.value}</a> : item.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="home-presence-visual-wrap" aria-hidden="true">
        <img
          class="home-presence-visual"
          src={homePresence.visual.src}
          alt={homePresence.visual.alt}
          width="512"
          height="512"
        />
      </div>
    </section>

    <section class="home-writing" aria-labelledby="home-writing-title">
      <header class="home-section-header">
        <h2 id="home-writing-title">最近写下的东西</h2>
        <a href="/posts">更多文章</a>
      </header>

      {leadPost && (
        <a class="home-lead-story" href={postHref(leadPost.id)}>
          <div>
            <time class="home-story-date" datetime={leadPost.data.pubDate.toISOString()}>
              {dateLabel(leadPost.data.pubDate)}
            </time>
            <h3 class="home-story-title">{leadPost.data.title}</h3>
          </div>
          <p>{leadPost.data.description}</p>
        </a>
      )}

      {supportingPosts.length > 0 && (
        <div class="home-story-list">
          {supportingPosts.map((post) => (
            <a class="home-story-row" href={postHref(post.id)}>
              <time class="home-story-date" datetime={post.data.pubDate.toISOString()}>
                {dateLabel(post.data.pubDate)}
              </time>
              <span class="home-story-row-title">{post.data.title}</span>
              {post.data.tags[0] && <span class="home-story-tag">#{post.data.tags[0]}</span>}
            </a>
          ))}
        </div>
      )}
    </section>

    <section class="home-moments" aria-labelledby="home-moments-title">
      <header class="home-section-header">
        <h2 id="home-moments-title">最近的日常</h2>
        <a href="/moments">去碎碎念</a>
      </header>
      <div class="home-moments-slot" data-home-moments-slot></div>
    </section>

    <nav class="home-more" aria-label="更多内容">
      <a href="/archive">归档</a>
      <a href="/messages">留言</a>
      <a href="/about">关于</a>
    </nav>
  </div>
</BaseLayout>
