---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePostCard from '../components/HomePostCard.astro';
import HomeProfileSidebar from '../components/HomeProfileSidebar.astro';
import VisitorCounter from '../components/VisitorCounter.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const latestPosts = posts.slice(0, 5);
const tagCount = new Set(posts.flatMap((post) => post.data.tags)).size;
const featuredHref = featuredPost
  ? `/posts/${featuredPost.id.replace(/\.md$/, '')}`
  : '/posts';
---

<BaseLayout
  title="搁浅 的小窝"
  description="一个充满二次元氛围的个人博客，记录游戏、音乐、项目与日常。"
  bannerTitle="搁浅的小窝"
  bannerSubtitle="把喜欢的东西，认真地收进小站里。"
  showTime={true}
>
  <div class="home-layout">
    <section class="home-main-column" aria-labelledby="latest-posts-title">
      <header class="home-section-header">
        <h2 id="latest-posts-title">最新文章</h2>
        <a href="/posts">全部文章 →</a>
      </header>
      <div class="home-post-list">
        {latestPosts.map((post) => <HomePostCard post={post} />)}
      </div>
    </section>

    <HomeProfileSidebar
      postCount={posts.length}
      tagCount={tagCount}
      featuredHref={featuredHref}
    />
  </div>

  <div class="home-footer-stats">
    <span class="sekai-note">🎶 NO SONG CAN SET ME FREE · project SEKAI</span>
    <VisitorCounter />
  </div>
</BaseLayout>
