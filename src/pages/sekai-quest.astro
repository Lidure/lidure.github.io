---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="SEKAI DASH | 搁浅 的小窝" description="PJSK 像素风动作闯关 — 选择角色，穿越 SEKAI！">
  <section class="dash-shell" id="dashShell">

    <!-- Title Screen -->
    <div class="title-screen" id="titleScreen">
      <div class="title-logo">
        <span class="title-sub">同人像素冒险</span>
        <h1 class="title-main">SEKAI DASH</h1>
      </div>

      <div class="stage-select" id="stageSelect">
        <h2 class="sel-label">关卡</h2>
        <div class="stage-pills" id="stagePills">
          <button class="stage-pill active" data-stage="0"><span class="pill-dot" style="background:#45d"></span>第一幕</button>
          <button class="stage-pill" data-stage="1"><span class="pill-dot" style="background:#e16"></span>第二幕</button>
          <button class="stage-pill" data-stage="2"><span class="pill-dot" style="background:#849"></span>最终Boss</button>
        </div>
      </div>

      <div class="char-select">
        <h2 class="sel-label">角色</h2>
        <div class="char-row" id="charRow">
          <button class="char-btn" data-char="0">
            <img src="/knd.png" alt="Kanade" /><span>Kanade</span><small>均衡</small>
          </button>
          <button class="char-btn active" data-char="1">
            <img src="/mfy/mfy1.png" alt="Mafuyu" /><span>Mafuyu</span><small>力量</small>
          </button>
          <button class="char-btn" data-char="2">
            <img src="/mzk.png" alt="Mizuki" /><span>Mizuki</span><small>速度</small>
          </button>
          <button class="char-btn" data-char="3">
            <img src="/ena.png" alt="Ena" /><span>Ena</span><small>灵活</small>
          </button>
          <button class="char-btn" data-char="4">
            <img src="/25miku.png" alt="Miku" /><span>Miku</span><small>远程</small>
          </button>
        </div>
      </div>

      <button class="go-btn" id="goBtn">
        <span class="go-text">开始</span>
        <span class="go-keys">← → ↑ J</span>
      </button>
    </div>

    <!-- Game Screen -->
    <div class="game-screen hidden" id="gameScreen">
      <canvas class="game-canvas" id="gameCanvas" width="960" height="540"></canvas>
      <div class="game-hud-top">
        <div class="hud-hp" id="hudHp"></div>
        <div class="hud-lvl"><span>等级</span><strong id="hudLevel">1</strong><em id="hudXp">0/100</em></div>
        <div class="hud-notes"><span>音符</span><strong id="hudNotes">0</strong></div>
        <div class="hud-score"><strong id="hudScore">0</strong></div>
      </div>
      <div class="game-msg" id="gameMsg"></div>
      <div class="secret-toast hidden" id="secretToast">超能力已解锁</div>
      <div class="boss-finisher hidden" id="bossFinisher">
        <div class="boss-finisher-flash"></div>
        <img id="bossFinisherImg" src="/25miku/25miku_%E6%88%98%E8%B4%A51.png" alt="25 Miku boss defeated" />
        <div class="boss-finisher-title">25 初音核心 崩坏</div>
      </div>
    </div>

    <!-- Results -->
    <div class="results-screen hidden" id="resultsScreen">
      <div class="results-card">
        <div class="res-title" id="resTitle">通关！</div>
        <div class="res-stats">
          <div class="res-row"><span>音符</span><strong id="resNotes">0</strong></div>
          <div class="res-row"><span>敌人</span><strong id="resEnemies">0</strong></div>
          <div class="res-row"><span>等级</span><strong id="resLevel">1</strong></div>
          <div class="res-row"><span>得分</span><strong id="resScore">0</strong></div>
        </div>
        <div class="res-actions">
          <button class="retry-btn" id="retryBtn">重试</button>
          <button class="back-btn" id="backBtn">返回</button>
        </div>
      </div>
    </div>

    <!-- Touch Controls -->
    <div class="touch-controls hidden" id="touchControls">
      <div class="touch-left">
        <button class="t-btn" data-dir="left">◀</button>
        <button class="t-btn" data-dir="right">▶</button>
      </div>
      <div class="touch-right">
        <button class="t-btn t-jump" data-dir="jump">↑</button>
        <button class="t-btn t-atk" data-dir="attack">♪</button>
      </div>
    </div>
  </section>

  <style>
    :root { --dash-accent: #45d; --dash-accent-rgb: 68,85,221; }

    .dash-shell { min-height: calc(100vh - 190px); color: var(--text); user-select: none; -webkit-user-select: none; }

    .hidden { display: none !important; }

    /* ===== Title ===== */
    .title-screen { display: grid; gap: 24px; padding: 20px 18px; max-width: 820px; margin: 0 auto; }
    .title-logo { text-align: center; }
    .title-sub { display: block; font-size: .76rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--dash-accent); margin-bottom: 4px; }
    .title-main { margin: 0; font-family: 'Courier New', monospace; font-size: clamp(2.6rem, 8vw, 5rem); font-weight: 900; line-height: .95; background: linear-gradient(135deg, #fff 30%, var(--dash-accent)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; filter: drop-shadow(0 0 28px rgba(var(--dash-accent-rgb), .3)); }

    .sel-label { margin: 0 0 8px; font-size: .72rem; font-weight: 800; letter-spacing: .1em; color: var(--muted); }

    .stage-pills { display: flex; flex-wrap: wrap; gap: 8px; }
    .stage-pill { display: flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 12px; border: 1.5px solid var(--panel-border); background: var(--panel); color: var(--text-soft); font-family: inherit; font-size: .88rem; font-weight: 700; cursor: pointer; transition: all 160ms ease; }
    .stage-pill:hover { border-color: rgba(var(--dash-accent-rgb), .4); }
    .stage-pill.active { border-color: var(--dash-accent); background: rgba(var(--dash-accent-rgb), .08); color: var(--dash-accent); box-shadow: 0 0 18px rgba(var(--dash-accent-rgb), .12); }
    .pill-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }

    .char-row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
    .char-btn { display: grid; gap: 4px; justify-items: center; padding: 12px 6px; border-radius: 14px; border: 1.5px solid var(--panel-border); background: var(--panel); color: var(--text-soft); font-family: inherit; cursor: pointer; transition: all 160ms ease; }
    .char-btn:hover { border-color: rgba(var(--dash-accent-rgb), .4); }
    .char-btn.active { border-color: var(--dash-accent); background: rgba(var(--dash-accent-rgb), .07); color: var(--dash-accent); }
    .char-btn img { width: 48px; height: 48px; image-rendering: pixelated; image-rendering: crisp-edges; object-fit: contain; }
    .char-btn span { font-size: .78rem; font-weight: 800; }
    .char-btn small { font-size: .62rem; color: var(--muted); }

    .go-btn { display: flex; flex-direction: column; align-items: center; gap: 3px; padding: 16px 44px; margin: 0 auto; border: none; border-radius: 16px; background: linear-gradient(135deg, var(--dash-accent), rgba(var(--dash-accent-rgb), .7)); color: #0a0e18; font-family: 'Courier New', monospace; font-size: 1.4rem; font-weight: 900; cursor: pointer; letter-spacing: .06em; box-shadow: 0 8px 28px rgba(var(--dash-accent-rgb), .3); transition: transform 140ms ease, box-shadow 140ms ease; }
    .go-btn:hover { transform: translateY(-3px); box-shadow: 0 12px 36px rgba(var(--dash-accent-rgb), .4); }
    .go-keys { font-size: .68rem; font-weight: 700; letter-spacing: .14em; opacity: .55; }

    /* ===== Game ===== */
    .game-screen { position: relative; height: calc(100vh - 140px); min-height: 460px; }
    .game-canvas { display: block; width: 100%; height: 100%; image-rendering: pixelated; image-rendering: crisp-edges; }
    .game-hud-top { position: absolute; top: 10px; left: 14px; right: 14px; display: flex; justify-content: space-between; pointer-events: none; z-index: 2; gap: 8px; }
    .game-hud-top > div { min-height: 34px; padding: 7px 12px; border-radius: 10px; background: rgba(6,8,18,.8); border: 1px solid rgba(255,255,255,.08); backdrop-filter: blur(6px); font-family: 'Courier New', monospace; box-shadow: 0 6px 20px rgba(0,0,0,.16); }
    .hud-hp { display: flex; align-items: center; gap: 5px; font-size: .92rem; letter-spacing: 0; color: #fff; }
    .hp-label { margin-right: 3px; color: #ff8aa8; font-size: .82rem; font-weight: 900; }
    .hp-dot { width: 12px; height: 12px; display: inline-block; background: rgba(255,102,136,.18); border: 1px solid rgba(255,102,136,.45); clip-path: polygon(50% 100%, 6% 48%, 6% 22%, 24% 6%, 42% 18%, 50% 30%, 58% 18%, 76% 6%, 94% 22%, 94% 48%); }
    .hp-dot.filled { background: #ff6688; border-color: rgba(255,255,255,.52); box-shadow: 0 0 8px rgba(255,102,136,.42); }
    .hud-notes, .hud-lvl { display: flex; align-items: center; gap: 7px; }
    .hud-notes span { color: #ffd66e; font-size: .82rem; font-weight: 900; }
    .hud-lvl span { color: var(--dash-accent); font-size: .82rem; font-weight: 900; }
    .hud-lvl em { color: var(--muted); font-size: .72rem; font-style: normal; }
    .hud-notes strong, .hud-lvl strong, .hud-score strong { color: #fff; font-size: 1.1rem; font-weight: 900; }
    .game-msg { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-family: 'Courier New', monospace; font-size: 2rem; font-weight: 900; color: #fff; text-shadow: 0 0 20px rgba(0,0,0,.6); pointer-events: none; z-index: 3; opacity: 0; transition: opacity .3s ease; }
    .game-msg.show { opacity: 1; }
    .secret-toast { position: absolute; left: 50%; top: 18%; z-index: 8; transform: translate(-50%, -14px) scale(.96); padding: 13px 22px; border-radius: 14px; background: rgba(10,12,26,.92); border: 1.5px solid rgba(255,214,110,.72); color: #ffd66e; font-family: 'Courier New', monospace; font-size: .95rem; font-weight: 900; letter-spacing: .04em; box-shadow: 0 0 28px rgba(255,214,110,.25); opacity: 0; pointer-events: none; transition: opacity 180ms ease, transform 180ms ease; }
    .secret-toast.show { opacity: 1; transform: translate(-50%, 0) scale(1); }
    .boss-finisher { position: absolute; inset: 0; z-index: 7; display: grid; place-items: center; overflow: hidden; background: radial-gradient(circle at 50% 48%, rgba(153,102,204,.28), rgba(5,5,14,.9) 64%); pointer-events: none; animation: finisherFade 2.45s ease both; }
    .boss-finisher-flash { position: absolute; inset: 0; background: rgba(255,255,255,.65); animation: finisherFlash 2.45s ease both; }
    .boss-finisher img { position: relative; width: min(46vw, 380px); max-height: 70vh; object-fit: contain; image-rendering: pixelated; filter: drop-shadow(0 0 30px rgba(255,102,221,.55)); animation: finisherSprite 2.45s ease both; }
    .boss-finisher-title { position: absolute; bottom: 16%; left: 50%; transform: translateX(-50%); font-family: 'Courier New', monospace; font-size: clamp(1.2rem, 4vw, 2.4rem); font-weight: 900; color: #fff; text-shadow: 0 0 18px rgba(255,102,221,.9); white-space: nowrap; }
    @keyframes finisherFlash { 0% { opacity: 1; } 16%, 78% { opacity: 0; } 100% { opacity: .2; } }
    @keyframes finisherFade { 0% { opacity: 0; } 10%, 82% { opacity: 1; } 100% { opacity: 0; } }
    @keyframes finisherSprite { 0% { transform: scale(.75) translateY(26px); opacity: 0; } 18%, 68% { transform: scale(1) translateY(0); opacity: 1; } 100% { transform: scale(1.22) translateY(-18px); opacity: 0; } }

    /* ===== Results ===== */
    .results-screen { position: fixed; inset: 0; z-index: 90; display: grid; place-content: center; background: rgba(5,8,18,.9); backdrop-filter: blur(14px); padding: 20px; }
    .results-card { display: grid; gap: 18px; max-width: 380px; width: 100%; padding: 32px 28px; border-radius: 22px; background: var(--panel-gradient); border: 1.5px solid var(--panel-border); }
    .res-title { text-align: center; font-family: 'Courier New', monospace; font-size: 2rem; font-weight: 900; color: var(--dash-accent); }
    .res-stats { display: grid; gap: 8px; }
    .res-row { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid rgba(255,255,255,.05); }
    .res-row span { color: var(--muted); } .res-row strong { color: #fff; font-family: 'Courier New', monospace; }
    .res-actions { display: flex; gap: 10px; }
    .retry-btn, .back-btn { flex: 1; padding: 12px; border-radius: 12px; font-family: 'Courier New', monospace; font-size: .95rem; font-weight: 800; cursor: pointer; transition: all 140ms ease; }
    .retry-btn { border: none; background: var(--dash-accent); color: #0a0e18; }
    .retry-btn:hover { transform: translateY(-2px); }
    .back-btn { border: 1.5px solid var(--panel-border); background: var(--panel); color: var(--text-soft); }

    /* ===== Touch ===== */
    .touch-controls { position: fixed; bottom: 10px; left: 0; right: 0; z-index: 50; display: flex; justify-content: space-between; padding: 0 14px; pointer-events: none; }
    .touch-left, .touch-right { display: flex; gap: 8px; pointer-events: auto; }
    .t-btn { width: 60px; height: 60px; border-radius: 50%; border: 2px solid rgba(var(--dash-accent-rgb), .3); background: rgba(8,12,24,.8); color: rgba(var(--dash-accent-rgb), .8); font-size: 1.4rem; font-weight: 900; cursor: pointer; touch-action: manipulation; transition: all 80ms ease; }
    .t-btn:active { background: rgba(var(--dash-accent-rgb), .15); border-color: var(--dash-accent); transform: scale(.92); }
    .t-jump { width: 68px; height: 68px; }
    .t-atk { width: 68px; height: 68px; color: #ffd66e; }

    @media (max-width: 720px) {
      .char-row { grid-template-columns: repeat(5, 1fr); gap: 6px; }
      .char-btn { padding: 8px 3px; } .char-btn img { width: 36px; height: 36px; } .char-btn small { display: none; }
      .stage-pills { gap: 6px; } .stage-pill { padding: 8px 12px; font-size: .8rem; }
    }

    @media (max-width: 460px) {
      .char-row { gap: 4px; }
      .char-btn img { width: 28px; height: 28px; }
      .char-btn span { font-size: .65rem; }
    }
  </style>

  <script>
    // ===== SEKAI DASH — Action Platformer =====
    const VW = 960, VH = 540, GRAVITY = 1800;

    const CHARS = [
      { name: 'Kanade', img: '/knd.png', speed: 280, jumpPow: 620, atkCd: 350, projSpd: 520, hp: 5, color: '#33ccbb', desc: '均衡' },
      { name: 'Mafuyu', img: '/mfy/mfy1.png', speed: 250, jumpPow: 580, atkCd: 280, projSpd: 480, hp: 4, color: '#9966cc', desc: '力量' },
      { name: 'Mizuki', img: '/mzk.png', speed: 360, jumpPow: 660, atkCd: 320, projSpd: 560, hp: 4, color: '#ff99aa', desc: '速度' },
      { name: 'Ena', img: '/ena.png', speed: 300, jumpPow: 700, atkCd: 340, projSpd: 500, hp: 5, color: '#88cc44', desc: '灵活' },
      { name: 'Miku', img: '/25miku.png', speed: 270, jumpPow: 600, atkCd: 260, projSpd: 640, hp: 4, color: '#ccddff', desc: '远程' },
    ];

    const STAGES = [
      { name: '第一幕 - 街头排练', bg1: '#0a1628', bg2: '#162040', platColor: '#1e3460', platTop: '#4488cc', accent: '#4455dd', starColor: '#77aaff', enemies: 10, worldW: 3300, boss: false,
        buildPlatforms: (P: Rect[]) => {
          P.push({x:0,y:476,w:620,h:64});P.push({x:720,y:438,w:220,h:24});P.push({x:1040,y:392,w:190,h:24});
          P.push({x:1330,y:440,w:340,h:24});P.push({x:1760,y:396,w:260,h:24});P.push({x:2110,y:348,w:210,h:24});
          P.push({x:2410,y:420,w:300,h:24});P.push({x:2810,y:476,w:490,h:64});
          P.push({x:520,y:338,w:120,h:20});P.push({x:1530,y:300,w:110,h:20});P.push({x:2660,y:308,w:130,h:20});
        }},
      { name: '第二幕 - 破碎的 SEKAI', bg1: '#1a0a14', bg2: '#2a1020', platColor: '#4a1830', platTop: '#cc3366', accent: '#ee1166', starColor: '#ff6699', enemies: 15, worldW: 3900, boss: false,
        buildPlatforms: (P: Rect[]) => {
          P.push({x:0,y:476,w:430,h:64});P.push({x:540,y:420,w:190,h:24});P.push({x:830,y:370,w:170,h:24});
          P.push({x:1100,y:422,w:210,h:24});P.push({x:1410,y:350,w:190,h:24});P.push({x:1700,y:404,w:210,h:24});
          P.push({x:2010,y:340,w:170,h:24});P.push({x:2280,y:410,w:250,h:24});P.push({x:2630,y:358,w:190,h:24});
          P.push({x:2920,y:420,w:210,h:24});P.push({x:3220,y:360,w:190,h:24});P.push({x:3510,y:476,w:390,h:64});
          P.push({x:460,y:312,w:110,h:20});P.push({x:1220,y:270,w:120,h:20});P.push({x:2060,y:260,w:110,h:20});P.push({x:2760,y:282,w:130,h:20});
        }},
      { name: '第三幕 - 空虚的舞台核心', bg1: '#120a1a', bg2: '#1a1030', platColor: '#2a1848', platTop: '#884499', accent: '#9966cc', starColor: '#bb88dd', enemies: 8, worldW: 3200, boss: true,
        buildPlatforms: (P: Rect[]) => {
          P.push({x:0,y:476,w:520,h:64});P.push({x:620,y:430,w:190,h:24});P.push({x:900,y:378,w:170,h:24});
          P.push({x:1180,y:430,w:220,h:24});P.push({x:1500,y:370,w:190,h:24});P.push({x:1790,y:420,w:210,h:24});
          P.push({x:2100,y:476,w:1100,h:64});
          P.push({x:2260,y:360,w:180,h:22});P.push({x:2550,y:316,w:170,h:22});P.push({x:2840,y:360,w:180,h:22});
        }},
    ];
    interface Rect { x: number; y: number; w: number; h: number; }
    interface Player extends Rect { vx: number; vy: number; grounded: boolean; facing: number; hp: number; maxHp: number; invuln: number; jumps: number; maxJumps: number; atkTimer: number; }
    interface Enemy extends Rect { vx: number; hp: number; maxHp: number; left: number; right: number; type: 'slime' | 'bat' | 'ghost'; alive: boolean; atkTimer: number; xp: number; }
    interface Note { x: number; y: number; taken: boolean; }
    interface Pickup { x: number; y: number; type: 'health' | 'amp'; taken: boolean; }
    interface Projectile extends Rect { vx: number; vy: number; life: number; damage: number; kind: 'player' | 'enemy' | 'boss'; color: string; }
    interface Particle { x: number; y: number; vx: number; vy: number; life: number; color: string; size: number; }
    interface Boss extends Rect { hp: number; maxHp: number; active: boolean; alive: boolean; phase: number; pattern: 'idle' | 'volley' | 'rain' | 'wave' | 'beam'; timer: number; attackTimer: number; burstCount: number; beamWarn: number; beamY: number; }

    // --- State ---
    let selStage = 0, selChar = 1;
    let player: Player;
    let enemies: Enemy[] = [];
    let collectNotes: Note[] = [];
    let pickups: Pickup[] = [];
    let projectiles: Projectile[] = [];
    let particles: Particle[] = [];
    let platforms: Rect[] = [];
    let boss: Boss | null = null;
    let cameraX = 0, score = 0, notesCollected = 0, enemiesKilled = 0;
    let heroLevel = 1, heroXp = 0, heroXpNext = 100;
    let upgradeHp = 0, upgradePower = 0, upgradeHaste = 0, upgradeJump = 0;
    let pendingNextStage = false;
    let running = false, finished = false;
    let shakeX = 0, shakeY = 0, shakeT = 0;
    let msgTimer = 0;
    let secretBuffer = '';
    let superMode = false;
    let secretToastTimer = 0;
    let bossDefeatCutscene = 0;
    let worldW = 3200;
    let raf = 0, lastTime = 0;
    let animState: 'idle' | 'run' | 'jump' | 'fall' | 'attack' = 'idle';
    let animFrame = 0;
    let animTimer = 0;
    let runDustTimer = 0;
    const keys: Record<string, boolean> = {};
    const charImages: HTMLImageElement[] = [];
    const MFY_SPRITES = {
      idle: '/mfy/mfy1.png',
      jump: '/mfy/mfy_run_jump.png',
      fall: '/mfy/mfy_run_jump.png',
      attack: '/mfy/mfy_att1.png',
    } as const;
    const MFY_RUN_FRAMES = [
      '/mfy/mfy_run1.png',
      '/mfy/mfy_run2.png',
      '/mfy/mfy_run3.png',
      '/mfy/mfy_run4.png',
      '/mfy/mfy_run5.png',
      '/mfy/mfy_run6.png',
      '/mfy/mfy_run7.png',
      '/mfy/mfy_run8.png',
      '/mfy/mfy_run9.png',
      '/mfy/mfy_run10.png',
      '/mfy/mfy_run11.png',
    ] as const;
    const MFY_RUN_CYCLE_SECONDS = 1.1;
    const mfyImages: Record<keyof typeof MFY_SPRITES, HTMLImageElement> = {} as Record<keyof typeof MFY_SPRITES, HTMLImageElement>;
    const mfyRunImages: HTMLImageElement[] = [];
    const BOSS_SPRITES = {
      idle: '/25miku.png',
      volley: '/25miku/25miku_att1.png',
      rain: '/25miku/25miku_att2.png',
      wave: '/25miku/25miku2_att1.png',
      defeat1: '/25miku/25miku_%E6%88%98%E8%B4%A51.png',
      defeat2: '/25miku/25miku_%E6%88%98%E8%B4%A52.png',
      fade1: '/25miku/25miku_%E6%88%98%E8%B4%A5%E6%B6%88%E6%95%A31.png',
      fade2: '/25miku/25miku_%E6%88%98%E8%B4%A5%E6%B6%88%E6%95%A32.png',
      fade3: '/25miku/25miku_%E6%88%98%E8%B4%A5%E6%B6%88%E6%95%A33.png',
    } as const;
    const bossImages: Record<keyof typeof BOSS_SPRITES, HTMLImageElement> = {} as Record<keyof typeof BOSS_SPRITES, HTMLImageElement>;

    // --- DOM ---
    const canvas = document.getElementById('gameCanvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const titleScreen = document.getElementById('titleScreen')!;
    const gameScreen = document.getElementById('gameScreen')!;
    const resultsScreen = document.getElementById('resultsScreen')!;
    const touchControls = document.getElementById('touchControls')!;
    const gameMsg = document.getElementById('gameMsg')!;
    const secretToast = document.getElementById('secretToast')!;
    const bossFinisher = document.getElementById('bossFinisher')!;
    const bossFinisherImg = document.getElementById('bossFinisherImg') as HTMLImageElement;
    const hudHp = document.getElementById('hudHp')!;
    const hudNotes = document.getElementById('hudNotes')!;
    const hudLevel = document.getElementById('hudLevel')!;
    const hudXp = document.getElementById('hudXp')!;
    const hudScore = document.getElementById('hudScore')!;

    // Preload character images
    CHARS.forEach((c, i) => {
      const img = new Image();
      img.src = c.img;
      charImages[i] = img;
    });
    Object.entries(MFY_SPRITES).forEach(([state, src]) => {
      const img = new Image();
      img.src = src;
      mfyImages[state as keyof typeof MFY_SPRITES] = img;
    });
    MFY_RUN_FRAMES.forEach((src, index) => {
      const img = new Image();
      img.src = src;
      mfyRunImages[index] = img;
    });
    Object.entries(BOSS_SPRITES).forEach(([state, src]) => {
      const img = new Image();
      img.src = src;
      bossImages[state as keyof typeof BOSS_SPRITES] = img;
    });

    // --- Audio ---
    let audioCtx: AudioContext | null = null;
    function initAudio() { if (!audioCtx) audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)(); }
    function playSfx(freq: number, dur: number, type: OscillatorType = 'sine', vol = 0.12) {
      if (!audioCtx) return;
      const t = audioCtx.currentTime, g = audioCtx.createGain(), o = audioCtx.createOscillator();
      o.type = type; o.frequency.setValueAtTime(freq, t); o.frequency.exponentialRampToValueAtTime(freq * 0.5, t + dur);
      g.gain.setValueAtTime(vol, t); g.gain.exponentialRampToValueAtTime(0.001, t + dur);
      o.connect(g); g.connect(audioCtx.destination); o.start(t); o.stop(t + dur);
    }
    function sfxJump() { playSfx(440, 0.08, 'sine', 0.08); }
    function sfxHit() { playSfx(880, 0.1, 'square', 0.1); }
    function sfxNote() { playSfx(660, 0.12, 'sine', 0.1); playSfx(990, 0.12, 'sine', 0.06); }
    function sfxHurt() { playSfx(180, 0.2, 'sawtooth', 0.12); }
    function sfxKill() { playSfx(520, 0.15, 'square', 0.1); playSfx(780, 0.1, 'sine', 0.08); }
    function sfxClear() { playSfx(523, 0.15, 'sine', 0.12); setTimeout(() => playSfx(659, 0.15, 'sine', 0.12), 120); setTimeout(() => playSfx(784, 0.25, 'sine', 0.14), 240); }

    // --- Helpers ---
    function overlaps(a: Rect, b: Rect) { return a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y; }
    function hexRgba(hex: string, a: number) { const r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16); return `rgba(${r},${g},${b},${a})`; }
    function setAccent(color: string) { const r = parseInt(color.slice(1,3),16), g = parseInt(color.slice(3,5),16), b = parseInt(color.slice(5,7),16); document.documentElement.style.setProperty('--dash-accent', color); document.documentElement.style.setProperty('--dash-accent-rgb', `${r},${g},${b}`); }
    function burst(x: number, y: number, color: string, n: number) { for (let i = 0; i < n; i++) { const a = Math.PI * 2 * i / n; particles.push({ x, y, vx: Math.cos(a) * (100 + Math.random() * 120), vy: Math.sin(a) * (100 + Math.random() * 120) - 80, life: 0.4 + Math.random() * 0.2, color, size: 3 + Math.random() * 3 }); } }
    function shake(amount: number) { shakeT = 0.2; shakeX = (Math.random() - 0.5) * amount; shakeY = (Math.random() - 0.5) * amount; }

    function showMsg(text: string, dur = 1.5) { msgTimer = dur; gameMsg.textContent = text; gameMsg.classList.add('show'); }

    function showSecretToast(text: string) {
      secretToast.textContent = text;
      secretToastTimer = 2.4;
      secretToast.classList.add('show');
      secretToast.classList.remove('hidden');
    }

    function unlockSuperMode() {
      if (superMode) { showSecretToast('超能力已经处于激活状态'); return; }
      superMode = true;
      if (player) {
        player.maxJumps = Math.max(player.maxJumps, 3);
        player.hp = Math.min(player.maxHp, player.hp + 1);
      }
      burst(player ? player.x + player.w / 2 : 80, player ? player.y + player.h / 2 : 360, '#ffd66e', 28);
      sfxClear();
      showSecretToast('解锁超能力：超远射程 / 高伤害 / 三段跳');
      showMsg('超能力已解锁', 1.4);
      if (player) updateHud();
    }

    function handleSecretInput(key: string) {
      if (!/^[wasdjk]$/.test(key)) return;
      const code = 'wwssaaddjkjk';
      secretBuffer = (secretBuffer + key).slice(-code.length);
      if (secretBuffer === code) {
        secretBuffer = '';
        unlockSuperMode();
      }
    }

    function drawTinyNote(x: number, y: number, scale = 1) {
      ctx.save();
      ctx.translate(x, y);
      ctx.scale(scale, scale);
      ctx.fillStyle = '#ffd66e';
      ctx.fillRect(-2, -12, 4, 17);
      ctx.fillRect(2, -12, 9, 4);
      ctx.fillRect(7, -8, 4, 4);
      ctx.beginPath();
      ctx.ellipse(-5, 6, 7, 5, -0.35, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    function drawHeartIcon(x: number, y: number, filled: boolean, scale = 1) {
      ctx.save();
      ctx.translate(x, y);
      ctx.scale(scale, scale);
      ctx.fillStyle = filled ? '#ff6688' : 'rgba(255,102,136,.22)';
      ctx.fillRect(-5, -6, 4, 4);
      ctx.fillRect(1, -6, 4, 4);
      ctx.fillRect(-7, -2, 14, 5);
      ctx.fillRect(-5, 3, 10, 4);
      ctx.fillRect(-2, 7, 4, 3);
      ctx.restore();
    }

    function drawXpShard(x: number, y: number, scale = 1) {
      ctx.save();
      ctx.translate(x, y);
      ctx.scale(scale, scale);
      ctx.fillStyle = '#88ddff';
      ctx.shadowColor = '#88ddff';
      ctx.shadowBlur = 8;
      ctx.beginPath();
      ctx.moveTo(0, -12);
      ctx.lineTo(11, 0);
      ctx.lineTo(0, 12);
      ctx.lineTo(-11, 0);
      ctx.closePath();
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(-2, -5, 4, 10);
      ctx.restore();
    }

    function resetCampaign() {
      heroLevel = 1; heroXp = 0; heroXpNext = 100;
      upgradeHp = 0; upgradePower = 0; upgradeHaste = 0; upgradeJump = 0;
      score = 0; notesCollected = 0; enemiesKilled = 0; pendingNextStage = false;
      bossDefeatCutscene = 0;
    }
    function maxHpForChar() { return CHARS[selChar].hp + upgradeHp; }
    function attackDamage() { return superMode ? 8 + upgradePower : 1 + upgradePower; }
    function attackCooldown() { return Math.max(120, CHARS[selChar].atkCd * (1 - upgradeHaste * 0.08)); }
    function jumpPower() { return CHARS[selChar].jumpPow + upgradeJump * 35; }
    function projectileLife() { return superMode ? 2.4 : 0.7; }
    function projectileSpeed() { return CHARS[selChar].projSpd * (superMode ? 1.35 : 1); }
    function activateStageButton() {
      document.querySelectorAll('.stage-pill').forEach(b => b.classList.remove('active'));
      const btn = document.querySelector<HTMLElement>(`.stage-pill[data-stage="${selStage}"]`);
      if (btn) btn.classList.add('active');
    }
    function gainXp(amount: number) {
      heroXp += amount;
      let leveled = false;
      while (heroXp >= heroXpNext) {
        heroXp -= heroXpNext; heroLevel++; heroXpNext += 45; leveled = true;
        const mod = heroLevel % 4;
        if (mod === 2) { upgradePower++; showMsg(`等级 ${heroLevel}: 攻击提升`, 1.2); }
        else if (mod === 3) { upgradeHaste++; showMsg(`等级 ${heroLevel}: 射速提升`, 1.2); }
        else if (mod === 0) { upgradeHp++; player.maxHp = maxHpForChar(); player.hp = Math.min(player.maxHp, player.hp + 1); showMsg(`等级 ${heroLevel}: 生命提升`, 1.2); }
        else { upgradeJump++; player.maxJumps = Math.max(player.maxJumps, superMode ? 3 : 2); showMsg(`等级 ${heroLevel}: 机动提升`, 1.2); }
      }
      if (leveled) { sfxClear(); burst(player.x + player.w / 2, player.y + player.h / 2, CHARS[selChar].color, 16); }
      updateHud();
    }
    // --- Stage Building ---
    function buildStage(stageIdx: number) {
      const stage = STAGES[stageIdx];
      platforms = []; enemies = []; collectNotes = []; pickups = []; projectiles = []; particles = []; boss = null;
      worldW = stage.worldW;
      stage.buildPlatforms(platforms);

      const groundPlats = platforms.filter(p => p.h <= 28 && p.w >= 140);
      for (let i = 0; i < stage.enemies && i < groundPlats.length; i++) {
        const p = groundPlats[i];
        const type: Enemy['type'] = Math.random() < 0.3 ? 'bat' : Math.random() < 0.5 ? 'ghost' : 'slime';
        const hp = type === 'ghost' ? 3 : type === 'bat' ? 2 : 1;
        const xp = type === 'ghost' ? 35 : type === 'bat' ? 28 : 20;
        enemies.push({ x: p.x + p.w / 2 - 16, y: p.y - (type === 'bat' ? 60 : 32), w: 32, h: 32, vx: (60 + Math.random() * 40) * (Math.random() < 0.5 ? 1 : -1), hp, maxHp: hp, left: p.x, right: p.x + p.w, type, alive: true, atkTimer: 0.8 + Math.random() * 1.6, xp });
      }

      for (let i = 0; i < 12; i++) {
        const p = platforms[Math.floor(Math.random() * platforms.length)];
        collectNotes.push({ x: p.x + 20 + Math.random() * Math.max(0, p.w - 40), y: p.y - 50 - Math.random() * 30, taken: false });
      }
      for (let i = 0; i < 3; i++) {
        const p = platforms[2 + Math.floor(Math.random() * Math.max(1, platforms.length - 2))];
        pickups.push({ x: p.x + p.w / 2, y: p.y - 40, type: 'health', taken: false });
      }
      for (let i = 0; i < 4; i++) {
        const p = platforms[1 + Math.floor(Math.random() * Math.max(1, platforms.length - 2))];
        pickups.push({ x: p.x + 30 + Math.random() * Math.max(0, p.w - 60), y: p.y - 72, type: 'amp', taken: false });
      }
      if (stage.boss) {
        boss = { x: worldW - 430, y: 300, w: 96, h: 144, hp: 90, maxHp: 90, active: false, alive: true, phase: 1, pattern: 'idle', timer: 0, attackTimer: 1.4, burstCount: 0, beamWarn: 0, beamY: 0 };
      }
    }
    // --- Init Game ---
    function initGame(resetRun = true) {
      initAudio();
      if (resetRun) resetCampaign();
      const stage = STAGES[selStage];
      const prevHp = player ? player.hp : 0;
      setAccent(stage.accent);
      buildStage(selStage);

      const maxHp = maxHpForChar();
      const startHp = resetRun ? maxHp : Math.min(maxHp, Math.max(1, prevHp) + 1);
      player = { x: 60, y: 400, w: 36, h: 48, vx: 0, vy: 0, grounded: false, facing: 1, hp: startHp, maxHp, invuln: 0, jumps: 0, maxJumps: superMode ? 3 : (selChar === 2 || selChar === 3 || upgradeJump > 0) ? 2 : 1, atkTimer: 0 };
      cameraX = 0; running = true; finished = false; pendingNextStage = false;

      titleScreen.classList.add('hidden');
      gameScreen.classList.remove('hidden');
      resultsScreen.classList.add('hidden');
      touchControls.classList.remove('hidden');
      updateHud();
      showMsg(stage.name, 1.8);
    }

    function updateHud() {
      const maxHp = player.maxHp;
      hudHp.innerHTML = '<span class="hp-label">生命</span>' + Array.from({ length: maxHp }, (_, i) => `<span class="hp-dot${i < player.hp ? ' filled' : ''}"></span>`).join('');
      hudNotes.textContent = String(notesCollected);
      hudLevel.textContent = String(heroLevel);
      hudXp.textContent = `${heroXp}/${heroXpNext}`;
      hudScore.textContent = String(score);
    }
    // --- Input ---
    document.addEventListener('keydown', e => {
      const k = e.key.toLowerCase();
      keys[k] = true;
      handleSecretInput(k);
      if (k === 'arrowup' || k === 'w' || k === ' ') { e.preventDefault(); doJump(); }
      if (k === 'j' || k === 'k') doAttack();
      if (k === 'enter' && !running && !titleScreen.classList.contains('hidden')) initGame(true);
    });
    document.addEventListener('keyup', e => { keys[e.key.toLowerCase()] = false; });

    // Touch
    const touchBtns = touchControls.querySelectorAll<HTMLButtonElement>('.t-btn');
    touchBtns.forEach(btn => {
      const dir = btn.dataset.dir || '';
      const down = (e: PointerEvent) => { e.preventDefault(); btn.setPointerCapture(e.pointerId); btn.classList.add('active'); keys['t_' + dir] = true; if (dir === 'jump') doJump(); if (dir === 'attack') doAttack(); };
      const up = () => { btn.classList.remove('active'); keys['t_' + dir] = false; };
      btn.addEventListener('pointerdown', down);
      btn.addEventListener('pointerup', up);
      btn.addEventListener('pointercancel', up);
      btn.addEventListener('lostpointercapture', up);
    });

    function doJump() {
      if (!running || finished) return;
      if (player.grounded || player.jumps < player.maxJumps) {
        player.vy = -jumpPower();
        player.grounded = false;
        player.jumps++;
        sfxJump();
      }
    }

    function doAttack() {
      if (!running || finished || player.atkTimer > 0) return;
      const c = CHARS[selChar];
      player.atkTimer = attackCooldown();
      projectiles.push({ x: player.x + (player.facing > 0 ? player.w : -22), y: player.y + 16, w: superMode ? 26 : 16, h: superMode ? 15 : 12, vx: projectileSpeed() * player.facing, vy: 0, life: projectileLife(), damage: attackDamage(), kind: 'player', color: superMode ? '#ffd66e' : c.color });
      sfxHit();
      burst(player.x + player.w / 2 + player.facing * 20, player.y + 20, c.color, 4);
    }

    function killEnemy(enemy: Enemy, bonusScore: number) {
      if (!enemy.alive) return;
      enemy.alive = false; enemiesKilled++; score += bonusScore; gainXp(enemy.xp);
      burst(enemy.x + enemy.w / 2, enemy.y + enemy.h / 2, STAGES[selStage].accent, 12);
      sfxKill(); shake(8); updateHud();
    }
    function spawnAimedProjectile(x: number, y: number, speed: number, kind: 'enemy' | 'boss', color: string, size = 14) {
      const tx = player.x + player.w / 2 - x, ty = player.y + player.h / 2 - y;
      const len = Math.max(1, Math.hypot(tx, ty));
      projectiles.push({ x, y, w: size, h: size, vx: tx / len * speed, vy: ty / len * speed, life: 3, damage: 1, kind, color });
    }
    function damageBoss(amount: number) {
      if (!boss || !boss.alive) return;
      boss.hp = Math.max(0, boss.hp - amount);
      burst(boss.x + boss.w / 2, boss.y + boss.h / 2, '#ffffff', 5); shake(6);
      if (boss.hp <= 0) {
        boss.alive = false; boss.active = false; score += 2500; gainXp(220);
        burst(boss.x + boss.w / 2, boss.y + boss.h / 2, STAGES[selStage].accent, 36);
        finished = true; running = false; pendingNextStage = false; sfxClear();
        startBossDefeatCutscene();
      } else if (boss.phase === 1 && boss.hp <= boss.maxHp * 0.66) { boss.phase = 2; boss.attackTimer = 0.5; showMsg('BOSS 第二阶段', 1.1); shake(12); }
      else if (boss.phase === 2 && boss.hp <= boss.maxHp * 0.34) { boss.phase = 3; boss.attackTimer = 0.4; showMsg('BOSS 第三阶段', 1.1); shake(14); }
      updateHud();
    }

    function startBossDefeatCutscene() {
      bossDefeatCutscene = 2.65;
     
      bossFinisher.classList.remove('hidden');
      bossFinisherImg.src = BOSS_SPRITES.defeat1;
      setTimeout(() => { bossFinisherImg.src = BOSS_SPRITES.defeat2; }, 520);
      setTimeout(() => { bossFinisherImg.src = BOSS_SPRITES.fade1; }, 1040);
      setTimeout(() => { bossFinisherImg.src = BOSS_SPRITES.fade2; }, 1500);
      setTimeout(() => { bossFinisherImg.src = BOSS_SPRITES.fade3; }, 1960);
      setTimeout(() => {
        bossFinisher.classList.add('hidden');
        showResults();
      }, 2650);
    }
    function chooseBossPattern() {
      if (!boss) return;
      const order: Boss['pattern'][] = boss.phase === 1 ? ['volley', 'wave', 'rain'] : boss.phase === 2 ? ['rain', 'volley', 'beam', 'wave'] : ['beam', 'rain', 'volley', 'wave'];
      boss.pattern = order[Math.floor(Math.random() * order.length)]; boss.timer = 0; boss.burstCount = 0;
      if (boss.pattern === 'beam') { boss.beamWarn = 0.75; boss.beamY = Math.max(90, Math.min(430, player.y + player.h / 2)); boss.pattern = 'idle'; boss.attackTimer = 1.6; }
    }
    function updateBoss(dt: number) {
      if (!boss || !boss.alive) return;
      boss.y = 300 + Math.sin(performance.now() * 0.002) * 10;
      if (!boss.active) { if (player.x > boss.x - 650) { boss.active = true; showMsg('BOSS: 25 初音核心', 1.4); shake(12); } return; }
      if (boss.beamWarn > 0) { boss.beamWarn -= dt; if (boss.beamWarn <= 0) { projectiles.push({ x: Math.max(0, player.x - 320), y: boss.beamY - 9, w: 640, h: 18, vx: 0, vy: 0, life: 0.42, damage: 1, kind: 'boss', color: '#ff66dd' }); sfxHurt(); shake(16); } }
      boss.attackTimer -= dt;
      if (boss.pattern === 'idle' && boss.attackTimer <= 0 && boss.beamWarn <= 0) chooseBossPattern();
      boss.timer += dt;
      if (boss.pattern === 'volley' && boss.timer > 0.26) { boss.timer = 0; boss.burstCount++; spawnAimedProjectile(boss.x + 18, boss.y + 56, 230 + boss.phase * 45, 'boss', '#cc88ff', 16); if (boss.burstCount >= 3 + boss.phase * 2) { boss.pattern = 'idle'; boss.attackTimer = 1.1; } }
      else if (boss.pattern === 'rain' && boss.timer > 0.16) { boss.timer = 0; boss.burstCount++; const rx = player.x + player.w / 2 - 180 + Math.random() * 360; projectiles.push({ x: rx, y: -30, w: 14, h: 24, vx: (Math.random() - 0.5) * 50, vy: 300 + boss.phase * 45, life: 2.2, damage: 1, kind: 'boss', color: '#aa66ff' }); if (boss.burstCount >= 7 + boss.phase * 3) { boss.pattern = 'idle'; boss.attackTimer = 1.0; } }
      else if (boss.pattern === 'wave' && boss.timer > 0.42) { boss.timer = 0; boss.burstCount++; projectiles.push({ x: boss.x - 24, y: 452, w: 42, h: 20, vx: -(230 + boss.phase * 55), vy: 0, life: 4, damage: 1, kind: 'boss', color: '#ff99cc' }); if (boss.burstCount >= 2 + boss.phase) { boss.pattern = 'idle'; boss.attackTimer = 1.2; } }
      if (overlaps(player, boss)) takeDamage();
    }
    // --- Update ---
    function update(dt: number) {
      if (!running || finished) return;
      const c = CHARS[selChar];
      const stage = STAGES[selStage];

      // Player movement
      const moveL = keys['arrowleft'] || keys['a'] || keys['t_left'];
      const moveR = keys['arrowright'] || keys['d'] || keys['t_right'];
      if (moveL) { player.vx = -c.speed; player.facing = -1; }
      else if (moveR) { player.vx = c.speed; player.facing = 1; }
      else { player.vx *= Math.pow(0.01, dt); }

      player.vy += GRAVITY * dt;
      player.invuln = Math.max(0, player.invuln - dt);
      player.atkTimer = Math.max(0, player.atkTimer - dt * 1000);

      // Horizontal collision
      player.x += player.vx * dt;
      for (const p of platforms) {
        if (overlaps(player, p)) {
          if (player.vx > 0) player.x = p.x - player.w;
          else if (player.vx < 0) player.x = p.x + p.w;
          player.vx = 0;
        }
      }

      // Vertical collision
      player.y += player.vy * dt;
      player.grounded = false;
      for (const p of platforms) {
        if (overlaps(player, p)) {
          if (player.vy > 0) { player.y = p.y - player.h; player.vy = 0; player.grounded = true; player.jumps = 0; }
          else if (player.vy < 0) { player.y = p.y + p.h; player.vy = 0; }
        }
      }

      // Fall off world
      if (player.y > VH + 100) {
        player.x = Math.max(60, cameraX + 80);
        player.y = 60;
        player.vy = 0;
        takeDamage();
      }

      player.x = Math.max(0, Math.min(worldW - player.w, player.x));

      // Projectiles
      for (const proj of projectiles) {
        proj.x += proj.vx * dt; proj.y += proj.vy * dt; proj.life -= dt;
        if (proj.kind === 'player') {
          for (const enemy of enemies) {
            if (!enemy.alive || proj.life <= 0) continue;
            if (overlaps(proj, enemy)) { enemy.hp -= proj.damage; proj.life = 0; if (enemy.hp <= 0) killEnemy(enemy, enemy.type === 'ghost' ? 260 : 200); else burst(enemy.x + enemy.w / 2, enemy.y + enemy.h / 2, '#fff', 4); }
          }
          if (boss && boss.alive && boss.active && proj.life > 0 && overlaps(proj, boss)) { proj.life = 0; damageBoss(proj.damage); }
        } else if (overlaps(player, proj)) { proj.life = 0; takeDamage(); }
      }
      projectiles = projectiles.filter(p => p.life > 0 && p.x > cameraX - 180 && p.x < cameraX + VW + 260 && p.y > -120 && p.y < VH + 140);
      // Enemies
      for (const enemy of enemies) {
        if (!enemy.alive) continue;
        enemy.x += enemy.vx * dt;
        if (enemy.x <= enemy.left || enemy.x + enemy.w >= enemy.right) enemy.vx *= -1;
        if (enemy.type === 'bat') enemy.y += Math.sin(performance.now() * 0.005 + enemy.x) * 0.8;
        if (enemy.type === 'ghost') {
          enemy.atkTimer -= dt;
          const dist = Math.abs((player.x + player.w / 2) - (enemy.x + enemy.w / 2));
          if (enemy.atkTimer <= 0 && dist < 560) { spawnAimedProjectile(enemy.x + enemy.w / 2, enemy.y + 14, 210, 'enemy', '#88ddff', 12); enemy.atkTimer = 1.6 + Math.random() * 0.8; }
        }
        if (overlaps(player, enemy)) {
          if (player.vy > 100 && player.y + player.h - enemy.y < 20) { enemy.hp -= 1; player.vy = -450; if (enemy.hp <= 0) killEnemy(enemy, 250); else { burst(enemy.x + enemy.w / 2, enemy.y + enemy.h / 2, '#fff', 4); updateHud(); } }
          else takeDamage();
        }
      }
      // Collectibles
      for (const note of collectNotes) {
        if (note.taken) continue;
        if (overlaps(player, { x: note.x - 14, y: note.y - 14, w: 28, h: 28 })) {
          note.taken = true; notesCollected++; score += 100; gainXp(10);
          burst(note.x, note.y, '#ffd66e', 8); sfxNote(); updateHud();
        }
      }
      for (const pk of pickups) {
        if (pk.taken) continue;
        if (overlaps(player, { x: pk.x - 12, y: pk.y - 12, w: 24, h: 24 })) {
          pk.taken = true;
          if (pk.type === 'health' && player.hp < player.maxHp) { player.hp++; showMsg('+1 生命', 0.8); }
          else if (pk.type === 'amp') { score += 80; gainXp(35); showMsg('+经验', 0.7); }
          else score += 50;
          burst(pk.x, pk.y, pk.type === 'amp' ? '#88ddff' : '#ff6688', 6); updateHud();
        }
      }
      updateBoss(dt);
      // Particles
      for (const p of particles) { p.x += p.vx * dt; p.y += p.vy * dt; p.vy += 400 * dt; p.life -= dt; }
      particles = particles.filter(p => p.life > 0);

      // Shake
      if (shakeT > 0) { shakeT -= dt; shakeX *= 0.8; shakeY *= 0.8; } else { shakeX = 0; shakeY = 0; }

      // Message
      if (msgTimer > 0) { msgTimer -= dt; if (msgTimer <= 0) gameMsg.classList.remove('show'); }
      if (secretToastTimer > 0) {
        secretToastTimer -= dt;
        if (secretToastTimer <= 0) {
          secretToast.classList.remove('show');
          setTimeout(() => secretToast.classList.add('hidden'), 180);
        }
      }

      // Check win
      if (!stage.boss && player.x > worldW - 80) {
        finished = true; running = false; pendingNextStage = selStage < STAGES.length - 1;
        score += Math.max(0, player.hp * 500);
        sfxClear(); updateHud(); setTimeout(showResults, 800);
      }
      // Animation state
      animTimer += dt;
      if (player.atkTimer > 0) {
        if (animState !== 'attack') { animState = 'attack'; animFrame = 0; animTimer = 0; }
      } else if (!player.grounded) {
        animState = player.vy < 0 ? 'jump' : 'fall';
      } else if (Math.abs(player.vx) > 30) {
        if (animState !== 'run') { animState = 'run'; animFrame = 0; animTimer = 0; }
        const runFrameCount = selChar === 1 ? MFY_RUN_FRAMES.length : 6;
        const runFrameDelay = selChar === 1 ? MFY_RUN_CYCLE_SECONDS / MFY_RUN_FRAMES.length : 0.08;
        while (animTimer > runFrameDelay) { animFrame = (animFrame + 1) % runFrameCount; animTimer -= runFrameDelay; }
        runDustTimer += dt;
        if (runDustTimer > 0.12) { runDustTimer = 0; particles.push({ x: player.x + player.w / 2, y: player.y + player.h, vx: -player.facing * (20 + Math.random() * 30), vy: -(10 + Math.random() * 20), life: 0.3, color: 'rgba(200,200,200,0.5)', size: 2 + Math.random() * 2 }); }
      } else {
        if (animState !== 'idle') { animState = 'idle'; animFrame = 0; animTimer = 0; }
      }

      // Camera
      const targetCam = Math.max(0, Math.min(worldW - VW, player.x - VW * 0.4));
      cameraX += (targetCam - cameraX) * Math.min(1, dt * 6);
    }

    function takeDamage() {
      if (player.invuln > 0 || finished) return;
      player.hp--;
      player.invuln = 1.2;
      player.vx = -player.facing * 280;
      player.vy = -400;
      sfxHurt();
      shake(10);
      burst(player.x + player.w / 2, player.y + player.h / 2, '#e44', 8);
      updateHud();
      if (player.hp <= 0) {
        finished = true; running = false;
        showMsg('游戏结束', 2);
        setTimeout(showResults, 1500);
      }
    }

    function showResults() {
      const clear = player.hp > 0;
      document.getElementById('resTitle')!.textContent = clear ? (pendingNextStage ? '本幕通关！' : 'SEKAI 已拯救！') : '游戏结束';
      document.getElementById('resNotes')!.textContent = String(notesCollected);
      document.getElementById('resEnemies')!.textContent = String(enemiesKilled);
      document.getElementById('resLevel')!.textContent = String(heroLevel);
      document.getElementById('resScore')!.textContent = String(score);
      const retry = document.getElementById('retryBtn')!;
      retry.textContent = clear && pendingNextStage ? '下一幕' : '重试';
      gameScreen.classList.add('hidden'); resultsScreen.classList.remove('hidden'); touchControls.classList.add('hidden');
    }
    // --- Render ---
    function render(time: number) {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = Math.round(rect.width * dpr);
      canvas.height = Math.round(rect.height * dpr);
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      if (!player) return;

      const sx = (rect.width * dpr) / VW;
      const sy = (rect.height * dpr) / VH;
      const s = Math.min(sx, sy);
      const ox = (canvas.width - VW * s) / 2;
      const oy = (canvas.height - VH * s) / 2;
      ctx.setTransform(s, 0, 0, s, ox + shakeX, oy + shakeY);

      const stage = STAGES[selStage];
      const t = time / 1000;

      // Background
      ctx.fillStyle = stage.bg1;
      ctx.fillRect(0, 0, VW, VH);
      ctx.fillStyle = stage.bg2;
      ctx.fillRect(0, VH * 0.4, VW, VH * 0.6);

      // Stars (parallax)
      for (let i = 0; i < 50; i++) {
        const x = ((i * 137 + 23 - cameraX * (0.05 + (i % 3) * 0.015)) % (VW + 80)) - 40;
        const y = 20 + (i * 59) % (VH * 0.5);
        const sz = 2 + (i % 3);
        ctx.fillStyle = i % 4 === 0 ? stage.starColor : 'rgba(255,255,255,0.3)';
        ctx.fillRect(Math.floor(x), Math.floor(y), sz, sz);
      }

      // Background buildings (parallax)
      for (let i = 0; i < 12; i++) {
        const x = Math.floor((i * 280 - cameraX * 0.12) % (VW + 300) - 150);
        const h = 60 + (i % 4) * 30;
        ctx.fillStyle = i % 2 === 0 ? hexRgba(stage.platColor, 0.4) : hexRgba(stage.bg2, 0.6);
        ctx.fillRect(x, VH - 50 - h, 80, h);
        for (let j = 0; j < 3; j++) {
          ctx.fillStyle = hexRgba(stage.accent, 0.12);
          ctx.fillRect(x + 14 + j * 20, VH - 40 - h, 8, h - 20);
        }
      }

      // Platforms
      for (const p of platforms) {
        const px = Math.round(p.x - cameraX);
        if (px + p.w < -40 || px > VW + 40) continue;
        ctx.fillStyle = stage.platColor;
        ctx.fillRect(px, p.y, p.w, p.h);
        ctx.fillStyle = stage.platTop;
        ctx.fillRect(px, p.y, p.w, Math.min(6, p.h));
        // Tile pattern
        for (let tx = 0; tx < p.w; tx += 24) {
          ctx.fillStyle = hexRgba(stage.platTop, 0.08);
          ctx.fillRect(px + tx + 16, p.y + 10, 4, 4);
        }
        ctx.fillStyle = hexRgba('#000000', 0.2);
        ctx.fillRect(px, p.y + p.h - 3, p.w, 3);
      }

      // Goal gate
      if (!stage.boss) {
        const gateX = worldW - 60 - cameraX;
        ctx.save();
        ctx.fillStyle = hexRgba(stage.accent, 0.15);
        ctx.fillRect(gateX - 24, 380, 48, 96);
        ctx.strokeStyle = stage.accent;
        ctx.lineWidth = 2;
        ctx.strokeRect(gateX - 24, 380, 48, 96);
        ctx.fillStyle = '#fff';
        ctx.font = '900 14px Courier New, monospace';
        ctx.textAlign = 'center';
        ctx.fillText('终点', gateX, 430 + Math.sin(t * 3) * 3);
        ctx.restore();
      }
      // Collectibles
      for (const note of collectNotes) {
        if (note.taken) continue;
        const nx = Math.round(note.x - cameraX);
        const ny = Math.round(note.y + Math.sin(t * 3 + note.x * 0.01) * 4);
        if (nx < -30 || nx > VW + 30) continue;
        ctx.save();
        ctx.shadowColor = '#ffd66e'; ctx.shadowBlur = 8;
        drawTinyNote(nx, ny, 1.15);
        ctx.restore();
      }
      // Pickups
      for (const pk of pickups) {
        if (pk.taken) continue;
        const px = Math.round(pk.x - cameraX);
        const py = Math.round(pk.y + Math.sin(t * 2.5 + pk.x) * 3);
        if (px < -30 || px > VW + 30) continue;
        const isAmp = pk.type === 'amp';
        ctx.save();
        if (isAmp) {
          drawXpShard(px, py, 1.05);
        } else {
          drawHeartIcon(px, py, true, 1.35);
        }
        ctx.restore();
      }
      // Enemies
      for (const enemy of enemies) {
        if (!enemy.alive) continue;
        const ex = Math.round(enemy.x - cameraX);
        const ey = Math.round(enemy.y);
        if (ex + enemy.w < -20 || ex > VW + 20) continue;

        if (enemy.type === 'slime') {
          ctx.fillStyle = '#4a2060';
          ctx.fillRect(ex + 4, ey + 12, 24, 20);
          ctx.fillStyle = '#6a3088';
          ctx.fillRect(ex + 2, ey + 6, 28, 14);
          ctx.fillStyle = '#ff4488';
          ctx.fillRect(ex + 8, ey + 12, 5, 5);
          ctx.fillRect(ex + 19, ey + 12, 5, 5);
        } else if (enemy.type === 'bat') {
          const wingY = Math.sin(t * 12 + enemy.x) * 4;
          ctx.fillStyle = '#3a1848';
          ctx.fillRect(ex + 10, ey + 8, 12, 16);
          ctx.fillStyle = '#5a2868';
          ctx.fillRect(ex - 2, ey + 6 + wingY, 14, 8);
          ctx.fillRect(ex + 20, ey + 6 - wingY, 14, 8);
          ctx.fillStyle = '#ff3366';
          ctx.fillRect(ex + 12, ey + 12, 3, 3);
          ctx.fillRect(ex + 18, ey + 12, 3, 3);
        } else {
          ctx.fillStyle = '#2a1838';
          ctx.fillRect(ex + 4, ey + 4, 24, 28);
          ctx.fillStyle = '#4a2858';
          ctx.fillRect(ex + 6, ey, 20, 12);
          ctx.fillStyle = '#88ddff';
          ctx.fillRect(ex + 10, ey + 8, 4, 4);
          ctx.fillRect(ex + 18, ey + 8, 4, 4);
          if (enemy.hp < enemy.maxHp) {
            ctx.fillStyle = 'rgba(255,255,255,0.3)';
            ctx.fillRect(ex, ey - 6, enemy.w * (enemy.hp / enemy.maxHp), 3);
          }
        }
      }

      drawBoss(t);

      // Projectiles
      for (const proj of projectiles) {
        const px = Math.round(proj.x - cameraX);
        ctx.save();
        ctx.fillStyle = proj.color; ctx.shadowColor = proj.color; ctx.shadowBlur = 6;
        ctx.fillRect(px, proj.y, proj.w, proj.h);
        ctx.fillStyle = '#fff';
        if (proj.w <= 48) ctx.fillRect(px + 4, proj.y + 3, Math.max(3, proj.w * 0.35), Math.max(3, proj.h * 0.3));
        ctx.restore();
      }
      // Player
      drawPlayer(t);

      // Particles
      ctx.save();
      for (const p of particles) {
        ctx.globalAlpha = Math.max(0, p.life * 3);
        ctx.fillStyle = p.color;
        const sz = p.size * Math.max(0.3, p.life * 2);
        ctx.fillRect(Math.round(p.x - cameraX), Math.round(p.y), sz, sz);
      }
      ctx.restore();
    }

    function drawBoss(t: number) {
      if (!boss) return;
      if (!boss.alive && bossDefeatCutscene > 0) return;
      const bx = Math.round(boss.x - cameraX), by = Math.round(boss.y);
      if (bx + boss.w < -120 || bx > VW + 140) return;
      if (boss.beamWarn > 0) {
        ctx.save();
        const alpha = 0.18 + Math.sin(t * 36) * 0.08;
        ctx.fillStyle = `rgba(255,102,221,${alpha})`;
        ctx.fillRect(0, boss.beamY - 11, VW, 22);
        ctx.fillStyle = 'rgba(255,255,255,0.45)'; ctx.fillRect(0, boss.beamY - 1, VW, 2);
        ctx.restore();
      }
      ctx.save();
      ctx.fillStyle = 'rgba(0,0,0,0.22)'; ctx.beginPath(); ctx.ellipse(bx + boss.w / 2, by + boss.h + 6, boss.w * 0.48, 8, 0, 0, Math.PI * 2); ctx.fill();
      let img = bossImages.idle;
      if (!boss.alive) { const defeatOrder = [bossImages.defeat1, bossImages.defeat2, bossImages.fade1, bossImages.fade2, bossImages.fade3]; img = defeatOrder[Math.min(defeatOrder.length - 1, Math.floor(t * 8) % defeatOrder.length)]; }
      else if (boss.pattern === 'volley') img = bossImages.volley;
      else if (boss.pattern === 'rain' || boss.beamWarn > 0) img = bossImages.rain;
      else if (boss.pattern === 'wave') img = bossImages.wave;
      const drawW = boss.alive ? 154 : 170, drawH = 190, bob = boss.alive ? Math.sin(t * 3) * 4 : 0;
      ctx.imageSmoothingEnabled = false;
      if (img && img.complete && img.naturalWidth > 0) ctx.drawImage(img, bx + boss.w / 2 - drawW / 2, by + boss.h - drawH + bob, drawW, drawH);
      else { ctx.fillStyle = '#b78cff'; ctx.fillRect(bx, by, boss.w, boss.h); ctx.fillStyle = '#fff'; ctx.fillRect(bx + 26, by + 34, 12, 12); ctx.fillRect(bx + 58, by + 34, 12, 12); }
      ctx.restore();
      if (boss.alive) {
        ctx.save(); const barW = 360, barX = VW / 2 - barW / 2;
        ctx.fillStyle = 'rgba(5,8,18,0.78)'; ctx.fillRect(barX, 48, barW, 18);
        ctx.fillStyle = '#ff66dd'; ctx.fillRect(barX + 3, 51, (barW - 6) * (boss.hp / boss.maxHp), 12);
        ctx.strokeStyle = 'rgba(255,255,255,0.35)'; ctx.strokeRect(barX, 48, barW, 18);
        ctx.fillStyle = '#fff'; ctx.font = '900 12px Courier New, monospace'; ctx.textAlign = 'center'; ctx.fillText(`25 初音核心  第${boss.phase}阶段`, VW / 2, 43);
        ctx.restore();
      }
    }
    function drawPlayer(t: number) {
      const c = CHARS[selChar];
      const px = Math.round(player.x - cameraX);
      const py = Math.round(player.y);

      if (player.invuln > 0 && Math.floor(t * 16) % 2 === 0) return;

      const dir = player.facing;
      const isMafuyu = selChar === 1;
      let img = charImages[selChar];
      if (isMafuyu) {
        if (animState === 'attack') img = mfyImages.attack;
        else if (animState === 'run') img = mfyRunImages[animFrame % mfyRunImages.length] || mfyImages.idle;
        else if (animState === 'jump') img = mfyImages.jump;
        else if (animState === 'fall') img = mfyImages.fall;
        else img = mfyImages.idle;
      }
      const color = c.color;
      const W = player.w, H = player.h;

      // Sprite draw dimensions. Mafuyu uses full action-frame PNGs from /public/mfy.
      const spW = isMafuyu ? (animState === 'attack' ? 92 : animState === 'run' ? 82 : 76) : 50;
      const spH = isMafuyu ? (animState === 'attack' ? 92 : animState === 'run' ? 82 : 76) : 58;
      const spLift = isMafuyu ? 8 : 2;
      const legH_px = 12; // height of the leg region at bottom of PNG to overlay

      // --- Transforms ---
      let sx = 1, sy = 1, tilt = 0, bob = 0;

      switch (animState) {
        case 'idle':
          bob = Math.sin(t * 3) * 2;
          break;
        case 'run': {
          const phase = animFrame * Math.PI / 3;
          bob = Math.abs(Math.sin(phase)) * -3;
          tilt = Math.sin(phase) * 0.06 * dir;
          sx = 1 + Math.sin(phase) * 0.04;
          sy = 1 - Math.sin(phase) * 0.04;
          break;
        }
        case 'jump':
          sy = Math.min(1.12, 1 + Math.abs(player.vy) / 3000);
          sx = 1 / sy;
          tilt = -0.08 * dir;
          break;
        case 'fall':
          sx = Math.min(1.1, 1 + player.vy / 3000);
          sy = 1 / sx;
          tilt = 0.05 * dir;
          break;
        case 'attack':
          tilt = 0.1 * dir;
          bob = -2;
          sx = 1.06;
          sy = 0.94;
          break;
      }

      // --- Shadow ---
      ctx.fillStyle = 'rgba(0,0,0,0.18)';
      ctx.beginPath();
      ctx.ellipse(px + W / 2, py + H + 2, W * 0.55, 4, 0, 0, Math.PI * 2);
      ctx.fill();

      // --- Main character draw (PNG + animated legs) ---
      ctx.save();
      ctx.translate(px + W / 2, py + H + bob);
      if (dir < 0) ctx.scale(-sx, sy);
      else ctx.scale(sx, sy);
      if (tilt) ctx.rotate(tilt);

      ctx.imageSmoothingEnabled = false;

      // Draw the original PNG sprite
      if (img && img.complete && img.naturalWidth > 0) {
        ctx.drawImage(img, -spW / 2, -spH + spLift, spW, spH);
      } else {
        ctx.fillStyle = color;
        ctx.fillRect(-spW / 2, -spH + 2, spW, spH);
      }

      // --- Animated legs overlay ---
      // Cover the bottom leg region of the PNG with moving legs
      if (!isMafuyu) {
        const legDark = hexRgba(color, 0.55);
        const legLight = hexRgba(color, 0.75);
        const shoeColor = hexRgba('#000000', 0.35);
        const legW = 9, footY = 0; // footY=0 means at the transform origin (feet)

        switch (animState) {
          case 'idle': {
            const ib = Math.sin(t * 2.5) * 1.5;
            ctx.fillStyle = legDark;
            ctx.fillRect(-10, footY - legH_px + ib, legW, legH_px);
            ctx.fillRect(1, footY - legH_px + ib, legW, legH_px);
            ctx.fillStyle = shoeColor;
            ctx.fillRect(-11, footY - 3 + ib, legW + 2, 3);
            ctx.fillRect(0, footY - 3 + ib, legW + 2, 3);
            break;
          }
          case 'run': {
            const phase = animFrame * Math.PI / 3;
            const l1 = Math.sin(phase) * 10, l2 = Math.sin(phase + Math.PI) * 10;
            const b1 = Math.abs(Math.sin(phase)) * -4, b2 = Math.abs(Math.sin(phase + Math.PI)) * -4;
            ctx.fillStyle = legDark;
            ctx.fillRect(-10, footY - legH_px + b1, legW, legH_px + l1);
            ctx.fillRect(1, footY - legH_px + b2, legW, legH_px + l2);
            ctx.fillStyle = legLight;
            ctx.fillRect(-9, footY - legH_px + 2 + b1, legW - 2, 3);
            ctx.fillRect(2, footY - legH_px + 2 + b2, legW - 2, 3);
            ctx.fillStyle = shoeColor;
            ctx.fillRect(-11, footY - 3 + b1 + l1, legW + 3, 3);
            ctx.fillRect(0, footY - 3 + b2 + l2, legW + 3, 3);
            break;
          }
          case 'jump': {
            ctx.fillStyle = legDark;
            ctx.fillRect(-11, footY - legH_px + 4, legW, legH_px - 6);
            ctx.fillRect(2, footY - legH_px + 4, legW, legH_px - 6);
            ctx.fillStyle = shoeColor;
            ctx.fillRect(-12, footY - legH_px + legH_px - 4, legW + 2, 3);
            ctx.fillRect(1, footY - legH_px + legH_px - 4, legW + 2, 3);
            break;
          }
          case 'fall': {
            ctx.fillStyle = legDark;
            ctx.fillRect(-13, footY - legH_px - 2, legW, legH_px + 4);
            ctx.fillRect(4, footY - legH_px - 2, legW, legH_px + 4);
            ctx.fillStyle = shoeColor;
            ctx.fillRect(-14, footY + 1, legW + 2, 3);
            ctx.fillRect(3, footY + 1, legW + 2, 3);
            break;
          }
          case 'attack': {
            ctx.fillStyle = legDark;
            ctx.fillRect(-11, footY - legH_px + 3, legW, legH_px - 2);
            ctx.fillRect(3, footY - legH_px - 2, legW, legH_px + 5);
            ctx.fillStyle = shoeColor;
            ctx.fillRect(-12, footY - 1, legW + 2, 3);
            ctx.fillRect(2, footY + 1, legW + 3, 3);
            break;
          }
        }
      }

      ctx.restore();

      // === EFFECTS (world-space, outside character transform) ===

      // --- Idle: subtle glow pulse ---
      if (animState === 'idle') {
        const pulse = (Math.sin(t * 2) + 1) * 0.5;
        ctx.fillStyle = hexRgba(color, 0.06 * pulse);
        ctx.beginPath();
        ctx.ellipse(px + W / 2, py + H / 2 + bob, 24, 28, 0, 0, Math.PI * 2);
        ctx.fill();
      }

      // --- Run: dust particles ---
      if (animState === 'run') {
        if (Math.random() < 0.4) {
          particles.push({
            x: player.x + W / 2 - dir * 12,
            y: player.y + H - 2,
            vx: -dir * (20 + Math.random() * 30),
            vy: -(10 + Math.random() * 20),
            life: 0.3 + Math.random() * 0.1,
            color: 'rgba(200,200,200,0.4)',
            size: 2 + Math.random() * 2,
          });
        }
        // Speed lines
        if (Math.random() < 0.25) {
          ctx.fillStyle = hexRgba(color, 0.12);
          const lx = px + W / 2 - dir * (18 + Math.random() * 14);
          ctx.fillRect(lx, py + 6 + Math.random() * 28, 2, 8 + Math.random() * 6);
        }
      }

      // --- Jump: launch particles ---
      if (animState === 'jump' && player.vy < -400) {
        for (let i = 0; i < 2; i++) {
          particles.push({
            x: player.x + W / 2 + (Math.random() - 0.5) * 20,
            y: player.y + H,
            vx: (Math.random() - 0.5) * 60,
            vy: 30 + Math.random() * 40,
            life: 0.3,
            color: '#fff',
            size: 2 + Math.random() * 2,
          });
        }
      }

      // --- Fall: wind streaks ---
      if (animState === 'fall' && player.vy > 250) {
        ctx.save();
        for (let i = 0; i < 3; i++) {
          ctx.fillStyle = hexRgba('#ffffff', 0.08 + i * 0.02);
          ctx.fillRect(px + 4 + i * 10, py - 4 - i * 8, 2, 10 + i * 4);
        }
        ctx.restore();
      }

      // --- Attack: weapon glow + slash arc + afterimage ---
      if (animState === 'attack') {
        const atkProg = player.atkTimer / c.atkCd;

        // Weapon orb
        const orbX = px + W / 2 + dir * (22 + (1 - atkProg) * 10);
        const orbY = py + H / 2 - 4;
        ctx.save();
        ctx.fillStyle = hexRgba(color, 0.45 * atkProg);
        ctx.shadowColor = color;
        ctx.shadowBlur = 10;
        ctx.fillRect(orbX - 9, orbY - 9, 18, 18);
        ctx.fillStyle = '#fff';
        ctx.fillRect(orbX - 3, orbY - 3, 6, 6);
        ctx.restore();

        // Slash arc
        if (atkProg > 0.5) {
          ctx.save();
          ctx.globalAlpha = (atkProg - 0.5) * 2;
          ctx.strokeStyle = '#fff';
          ctx.lineWidth = 2;
          ctx.beginPath();
          const arcCX = px + W / 2 + dir * 26;
          ctx.arc(arcCX, py + H / 2, 16, dir > 0 ? -0.8 : Math.PI - 0.8, dir > 0 ? 0.8 : Math.PI + 0.8);
          ctx.stroke();
          ctx.restore();
        }

        // Afterimage
        ctx.save();
        ctx.globalAlpha = 0.12;
        ctx.imageSmoothingEnabled = false;
        if (img && img.complete && img.naturalWidth > 0) {
          ctx.drawImage(img, px + W / 2 - spW / 2 - dir * 10, py + H - spH + spLift + bob, spW, spH);
        }
        ctx.restore();
      }

      // --- Landing impact ---
      if (player.grounded && animState !== 'run' && animState !== 'attack' && player.vy === 0) {
        // Small dust puffs at feet on landing
      }
    }

    // --- Game Loop ---
    function loop(time: number) {
      const dt = Math.min(0.032, (time - lastTime) / 1000 || 0);
      lastTime = time;
      update(dt);
      render(time);
      raf = requestAnimationFrame(loop);
    }

    // --- UI Events ---
    document.querySelectorAll<HTMLButtonElement>('.stage-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.stage-pill').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        selStage = parseInt(btn.dataset.stage || '0');
        setAccent(STAGES[selStage].accent);
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.char-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.char-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        selChar = parseInt(btn.dataset.char || '0');
      });
    });

    document.getElementById('goBtn')!.addEventListener('click', () => initGame(true));
    document.getElementById('retryBtn')!.addEventListener('click', () => { if (pendingNextStage) { selStage++; activateStageButton(); setAccent(STAGES[selStage].accent); initGame(false); } else initGame(true); });
    document.getElementById('backBtn')!.addEventListener('click', () => {
      cancelAnimationFrame(raf);
      gameScreen.classList.add('hidden');
      resultsScreen.classList.add('hidden');
      touchControls.classList.add('hidden');
      titleScreen.classList.remove('hidden');
    });

    document.addEventListener('astro:before-swap', () => cancelAnimationFrame(raf), { once: true });

    // Start render loop
    setAccent(STAGES[0].accent);
    raf = requestAnimationFrame(loop);
  </script>
</BaseLayout>
