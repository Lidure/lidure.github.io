    // --- Audio ---
    let audioCtx: AudioContext | null = null;
    let masterGain: GainNode | null = null;
    let bgmGain: GainNode | null = null;
    let bgmPlaying = false;
    let sfxVol = 0.35, musicVol = 0.15;

    function initAudio() {
      if (!audioCtx) audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      if (!masterGain && audioCtx) { masterGain = audioCtx.createGain(); masterGain.gain.value = 1; masterGain.connect(audioCtx.destination); }
    }

    // Layered SFX with ADSR envelope, random pitch variation, noise layer support
    function playSfx(freq: number, dur: number, type: OscillatorType = 'sine', vol = 0.12, opts?: { noise?: number; slide?: number; vibrato?: number; delay?: number }) {
      if (!audioCtx || !masterGain) return;
      const t = audioCtx.currentTime + (opts?.delay || 0);
      const rv = 1 + (Math.random() - 0.5) * 0.12; // ±6% pitch variation
      const g = audioCtx.createGain();
      g.gain.setValueAtTime(0, t);
      g.gain.linearRampToValueAtTime(vol * sfxVol, t + 0.006);
      g.gain.exponentialRampToValueAtTime(vol * sfxVol * 0.5, t + dur * 0.3);
      g.gain.exponentialRampToValueAtTime(0.001, t + dur);
      const o = audioCtx.createOscillator();
      o.type = type;
      o.frequency.setValueAtTime(freq * rv, t);
      if (opts?.slide) o.frequency.linearRampToValueAtTime(freq * rv * opts.slide, t + dur);
      if (opts?.vibrato) {
        const vibr = audioCtx.createOscillator(); vibr.frequency.value = opts.vibrato; vibr.type = 'sine';
        const vGain = audioCtx.createGain(); vGain.gain.value = freq * 0.04;
        vibr.connect(vGain); vGain.connect(o.frequency); vibr.start(t); vibr.stop(t + dur);
      }
      o.connect(g); g.connect(masterGain); o.start(t); o.stop(t + dur);
      // Noise layer
      if (opts?.noise) {
        const buf = audioCtx.createBuffer(1, audioCtx.sampleRate * dur, audioCtx.sampleRate);
        const data = buf.getChannelData(0);
        for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / data.length, 2);
        const ns = audioCtx.createBufferSource(); ns.buffer = buf;
        const ng = audioCtx.createGain();
        ng.gain.setValueAtTime(opts.noise * sfxVol, t);
        ng.gain.exponentialRampToValueAtTime(0.001, t + dur * 0.8);
        ns.connect(ng); ng.connect(masterGain); ns.start(t); ns.stop(t + dur);
      }
    }

    // Short noise burst for impacts (no sustained tone)
    function playNoise(dur: number, vol = 0.1, opts?: { highpass?: number; delay?: number }) {
      if (!audioCtx || !masterGain) return;
      const t = audioCtx.currentTime + (opts?.delay || 0);
      const buf = audioCtx.createBuffer(1, audioCtx.sampleRate * dur, audioCtx.sampleRate);
      const data = buf.getChannelData(0);
      for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / data.length, 0.5);
      const ns = audioCtx.createBufferSource(); ns.buffer = buf;
      const ng = audioCtx.createGain();
      ng.gain.setValueAtTime(vol * sfxVol, t);
      ng.gain.exponentialRampToValueAtTime(0.001, t + dur);
      if (opts?.highpass) { const hp = audioCtx.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = opts.highpass; ns.connect(hp); hp.connect(ng); }
      else ns.connect(ng);
      ng.connect(masterGain); ns.start(t); ns.stop(t + dur);
    }

