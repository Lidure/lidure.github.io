    // --- Audio ---
    let audioCtx: AudioContext | null = null;
    function initAudio() { if (!audioCtx) audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)(); }
    function playSfx(freq: number, dur: number, type: OscillatorType = 'sine', vol = 0.12) {
      if (!audioCtx) return;
      const t = audioCtx.currentTime, g = audioCtx.createGain(), o = audioCtx.createOscillator();
      o.type = type; o.frequency.setValueAtTime(freq, t); o.frequency.exponentialRampToValueAtTime(freq * 0.5, t + dur);
      g.gain.setValueAtTime(vol, t); g.gain.exponentialRampToValueAtTime(0.001, t + dur);
      o.connect(g); g.connect(audioCtx.destination); o.start(t); o.stop(t + dur);
    }
    function sfxJump() { playSfx(440, 0.08, 'sine', 0.08); }
    function sfxHit() { playSfx(880, 0.1, 'square', 0.1); }
    function sfxNote() { playSfx(660, 0.12, 'sine', 0.1); playSfx(990, 0.12, 'sine', 0.06); }
    function sfxHurt() { playSfx(180, 0.2, 'sawtooth', 0.12); }
    function sfxKill() { playSfx(520, 0.15, 'square', 0.1); playSfx(780, 0.1, 'sine', 0.08); }
    function sfxClear() { playSfx(523, 0.15, 'sine', 0.12); setTimeout(() => playSfx(659, 0.15, 'sine', 0.12), 120); setTimeout(() => playSfx(784, 0.25, 'sine', 0.14), 240); }

    // --- Helpers ---
    function overlaps(a: Rect, b: Rect) { return a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y; }
    function hexRgba(hex: string, a: number) { const r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16); return `rgba(${r},${g},${b},${a})`; }
    function setAccent(color: string) { const r = parseInt(color.slice(1,3),16), g = parseInt(color.slice(3,5),16), b = parseInt(color.slice(5,7),16); document.documentElement.style.setProperty('--dash-accent', color); document.documentElement.style.setProperty('--dash-accent-rgb', `${r},${g},${b}`); }
    function burst(x: number, y: number, color: string, n: number) { for (let i = 0; i < n; i++) { const a = Math.PI * 2 * i / n; particles.push({ x, y, vx: Math.cos(a) * (100 + Math.random() * 120), vy: Math.sin(a) * (100 + Math.random() * 120) - 80, life: 0.4 + Math.random() * 0.2, color, size: 3 + Math.random() * 3 }); } }
    function shake(amount: number) { shakeT = 0.2; shakeX = (Math.random() - 0.5) * amount; shakeY = (Math.random() - 0.5) * amount; }

    function showMsg(text: string, dur = 1.5) { msgTimer = dur; gameMsg.textContent = text; gameMsg.classList.add('show'); }

    function showSecretToast(text: string) {
      secretToast.textContent = text;
      secretToastTimer = 2.4;
      secretToast.classList.add('show');
      secretToast.classList.remove('hidden');
    }

    function loadSave() {
      try {
        const raw = localStorage.getItem(SAVE_KEY);
        if (!raw) return;
        const parsed = JSON.parse(raw) as Partial<GameSave>;
        saveData = {
          runs: Number(parsed.runs || 0),
          bestScore: Number(parsed.bestScore || 0),
          clearedStages: Math.max(0, Math.min(STAGES.length, Number(parsed.clearedStages || 0))),
          unlockedChars: Array.from(new Set([...(parsed.unlockedChars || []), 1].map(Number))).filter(i => i >= 0 && i < CHARS.length),
          metNpcIds: Array.from(new Set(parsed.metNpcIds || [])),
          totalKills: Number(parsed.totalKills || 0),
          totalNotes: Number(parsed.totalNotes || 0),
          bossClears: Number(parsed.bossClears || 0),
        };
      } catch {
        saveData = { ...DEFAULT_SAVE, unlockedChars: [...DEFAULT_SAVE.unlockedChars], metNpcIds: [] };
      }
    }

    function persistSave() {
      localStorage.setItem(SAVE_KEY, JSON.stringify(saveData));
    }

    function showTitleHint(text: string) {
      saveSummary.textContent = text;
      window.setTimeout(updateTitleProgress, 1600);
    }

    function isCharUnlocked(id: number) {
      return saveData.unlockedChars.includes(id);
    }

    function isStageUnlocked(id: number) {
      return id <= saveData.clearedStages;
    }

    function unlockChar(id: number, announce = false) {
      if (isCharUnlocked(id)) return false;
      saveData.unlockedChars.push(id);
      saveData.unlockedChars.sort((a, b) => a - b);
      if (announce) showSecretToast(`新角色解锁：${CHARS[id].name}`);
      return true;
    }

    function applyProgressUnlocks(announce = false) {
      if (saveData.clearedStages >= 1) unlockChar(0, announce);
      if (saveData.clearedStages >= 2) unlockChar(2, announce);
      if (saveData.clearedStages >= 3) unlockChar(3, announce);
      if (saveData.clearedStages >= 4) unlockChar(4, announce);
    }

    function updateTitleProgress() {
      const unlocked = saveData.unlockedChars.map(i => CHARS[i]?.name).filter(Boolean).join(' / ');
      saveSummary.textContent = `游玩 ${saveData.runs} 次 · 最佳 ${saveData.bestScore} · 已解锁：${unlocked}`;
    }

    function updateCharacterLocks() {
      document.querySelectorAll<HTMLButtonElement>('.char-btn').forEach(btn => {
        const id = parseInt(btn.dataset.char || '0');
        const locked = !isCharUnlocked(id);
        btn.classList.toggle('locked', locked);
        btn.setAttribute('aria-disabled', String(locked));
        btn.classList.toggle('active', id === selChar);
      });
    }

    function updateStageLocks() {
      document.querySelectorAll<HTMLButtonElement>('.stage-pill').forEach(btn => {
        const id = parseInt(btn.dataset.stage || '0');
        const locked = !isStageUnlocked(id);
        btn.classList.toggle('locked', locked);
        btn.setAttribute('aria-disabled', String(locked));
        btn.classList.toggle('active', id === selStage);
      });
    }

    function refreshProgressUi() {
      applyProgressUnlocks(false);
      if (!isCharUnlocked(selChar)) selChar = 1;
      if (!isStageUnlocked(selStage)) selStage = Math.min(saveData.clearedStages, STAGES.length - 1);
      updateTitleProgress();
      updateCharacterLocks();
      updateStageLocks();
      setAccent(STAGES[selStage].accent);
    }

    function unlockSuperMode() {
      if (superMode) { showSecretToast('超能力已经处于激活状态'); return; }
      superMode = true;
      if (player) {
        player.maxJumps = Math.max(player.maxJumps, 3);
        player.hp = Math.min(player.maxHp, player.hp + 8);
      }
      burst(player ? player.x + player.w / 2 : 80, player ? player.y + player.h / 2 : 360, '#ffd66e', 28);
      sfxClear();
      showSecretToast('解锁超能力：超远射程 / 高伤害 / 三段跳');
      showMsg('超能力已解锁', 1.4);
      if (player) updateHud();
    }

    function handleSecretInput(key: string) {
      if (!/^[wasdjk]$/.test(key)) return;
      const code = 'wwssaaddjkjk';
      secretBuffer = (secretBuffer + key).slice(-code.length);
      if (secretBuffer === code) {
        secretBuffer = '';
        unlockSuperMode();
      }
    }

    function drawTinyNote(x: number, y: number, scale = 1) {
      ctx.save();
      ctx.translate(x, y);
      ctx.scale(scale, scale);
      ctx.fillStyle = '#ffd66e';
      ctx.fillRect(-2, -12, 4, 17);
      ctx.fillRect(2, -12, 9, 4);
      ctx.fillRect(7, -8, 4, 4);
      ctx.beginPath();
      ctx.ellipse(-5, 6, 7, 5, -0.35, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    function drawHeartIcon(x: number, y: number, filled: boolean, scale = 1) {
      ctx.save();
      ctx.translate(x, y);
      ctx.scale(scale, scale);
      ctx.fillStyle = filled ? '#ff6688' : 'rgba(255,102,136,.22)';
      ctx.fillRect(-5, -6, 4, 4);
      ctx.fillRect(1, -6, 4, 4);
      ctx.fillRect(-7, -2, 14, 5);
      ctx.fillRect(-5, 3, 10, 4);
      ctx.fillRect(-2, 7, 4, 3);
      ctx.restore();
    }

    function drawXpShard(x: number, y: number, scale = 1) {
      ctx.save();
      ctx.translate(x, y);
      ctx.scale(scale, scale);
      ctx.fillStyle = '#88ddff';
      ctx.shadowColor = '#88ddff';
      ctx.shadowBlur = 8;
      ctx.beginPath();
      ctx.moveTo(0, -12);
      ctx.lineTo(11, 0);
      ctx.lineTo(0, 12);
      ctx.lineTo(-11, 0);
      ctx.closePath();
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(-2, -5, 4, 10);
      ctx.restore();
    }

    function resetCampaign() {
      heroLevel = 1; heroXp = 0; heroXpNext = 100;
      upgradeHp = 0; upgradePower = 0; upgradeHaste = 0; upgradeJump = 0;
      rogueDamage = 0; rogueRange = 0; rogueMulti = 0; roguePierce = 0; rogueCrit = 0; rogueRegen = 0; rogueShield = 0; shieldCharges = 0;
      runAbilityNames = []; choosingAbility = false; pendingAbilityChoices = [];
      score = 0; notesCollected = 0; enemiesKilled = 0; pendingNextStage = false;
      bossDefeatCutscene = 0; resultRecorded = false;
      abilityOverlay.classList.add('hidden');
    }
    function maxHpForChar() { return CHARS[selChar].hp + upgradeHp; }
    function attackDamage() { return (superMode ? 8 : 1) + upgradePower + rogueDamage; }
    function rollAttackDamage() { return attackDamage() * (Math.random() < rogueCrit ? 2 : 1); }
    function attackCooldown() { return Math.max(95, CHARS[selChar].atkCd * (1 - upgradeHaste * 0.08)); }
    function jumpPower() { return CHARS[selChar].jumpPow + upgradeJump * 35; }
    function projectileLife() { return (superMode ? 2.4 : 0.75) + rogueRange * 0.18; }
    function projectileSpeed() { return CHARS[selChar].projSpd * (superMode ? 1.35 : 1); }
    function activateStageButton() {
      updateStageLocks();
    }
    function setPaused(value: boolean) {
      if (!running || finished) value = false;
      paused = value;
      pauseOverlay.classList.toggle('hidden', !paused);
      pauseBtn.textContent = paused ? '继续' : '暂停';
      Object.keys(keys).forEach(k => { keys[k] = false; });
    }
    function returnToMenu() {
      running = false;
      finished = false;
      paused = false;
      choosingAbility = false;
      gameScreen.classList.add('hidden');
      resultsScreen.classList.add('hidden');
      touchControls.classList.add('hidden');
      pauseOverlay.classList.add('hidden');
      abilityOverlay.classList.add('hidden');
      titleScreen.classList.remove('hidden');
    }

    function addRunAbility(name: string) {
      runAbilityNames.push(name);
      updateHud();
    }

    function abilityPool(): AbilityOption[] {
      return [
        { id: 'power', name: '暗色强音', desc: '攻击伤害 +1，所有角色的主要攻击都更重。', icon: 'ATK', rarity: 'COMMON', apply: () => { upgradePower++; addRunAbility('暗色强音'); } },
        { id: 'haste', name: '高速谱面', desc: '攻击冷却缩短，弹幕衔接更快。', icon: 'SPD', rarity: 'COMMON', apply: () => { upgradeHaste++; addRunAbility('高速谱面'); } },
        { id: 'range', name: '远响轨迹', desc: '投射物存在时间更久，能打到更远的敌人。', icon: 'RNG', rarity: 'COMMON', apply: () => { rogueRange++; addRunAbility('远响轨迹'); } },
        { id: 'pierce', name: '穿透余音', desc: '玩家弹幕额外穿透 1 个目标，适合清精英怪群。', icon: 'PEN', rarity: 'RARE', apply: () => { roguePierce++; addRunAbility('穿透余音'); } },
        { id: 'multi', name: '和弦分裂', desc: '追加副弹，Mizuki 与 Kanade 的弹幕会更密。', icon: 'X2', rarity: 'RARE', apply: () => { rogueMulti++; addRunAbility('和弦分裂'); } },
        { id: 'crit', name: '空白暴击', desc: '暴击率 +15%，触发时造成双倍伤害。', icon: 'CRIT', rarity: 'RARE', apply: () => { rogueCrit = Math.min(0.6, rogueCrit + 0.15); addRunAbility('空白暴击'); } },
        { id: 'heart', name: '残响护心', desc: '最大生命 +1，并立刻回复 1 点生命。', icon: 'HP', rarity: 'COMMON', apply: () => { upgradeHp++; player.maxHp = maxHpForChar(); player.hp = Math.min(player.maxHp, player.hp + 1); addRunAbility('残响护心'); } },
        { id: 'jump', name: '轻音踏步', desc: '机动 +1，解锁或强化二段跳。', icon: 'JMP', rarity: 'COMMON', apply: () => { upgradeJump++; player.maxJumps = Math.max(player.maxJumps, superMode ? 3 : 2); addRunAbility('轻音踏步'); } },
        { id: 'shield', name: '夜色护盾', desc: '每关获得一次免伤护盾。', icon: 'DEF', rarity: 'EPIC', apply: () => { rogueShield++; shieldCharges = Math.max(shieldCharges, rogueShield); addRunAbility('夜色护盾'); } },
        { id: 'regen', name: '终幕回生', desc: '进入下一幕时额外回复生命。', icon: 'RE', rarity: 'EPIC', apply: () => { rogueRegen++; addRunAbility('终幕回生'); } },
      ];
    }

    function openAbilityChoice() {
      if (finished || choosingAbility) return;
      const pool = abilityPool();
      pendingAbilityChoices = [];
      while (pendingAbilityChoices.length < 3 && pool.length) {
        const idx = Math.floor(Math.random() * pool.length);
        pendingAbilityChoices.push(pool.splice(idx, 1)[0]);
      }
      choosingAbility = true;
      abilitySubtitle.textContent = `等级 ${heroLevel} · 选择本局构筑方向`;
      abilityChoices.innerHTML = pendingAbilityChoices.map((a, i) => `
        <button class="ability-card" type="button" data-ability="${i}" data-rarity="${a.rarity}" data-index="0${i + 1}">
          <span class="ability-icon">${a.icon}</span>
          <strong>${a.name}</strong>
          <span>${a.desc}</span>
          <em>${a.rarity}</em>
        </button>
      `).join('');
      abilityOverlay.classList.remove('hidden');
    }

    function chooseAbility(index: number) {
      const choice = pendingAbilityChoices[index];
      if (!choice) return;
      choice.apply();
      pendingAbilityChoices = [];
      choosingAbility = false;
      abilityOverlay.classList.add('hidden');
      sfxClear();
      burst(player.x + player.w / 2, player.y + player.h / 2, CHARS[selChar].color, 20);
      showMsg(`获得能力：${choice.name}`, 1.2);
      updateHud();
    }

    function gainXp(amount: number) {
      heroXp += amount;
      let levelsGained = 0;
      while (heroXp >= heroXpNext) {
        heroXp -= heroXpNext;
        heroLevel++;
        heroXpNext += 45;
        levelsGained++;
      }
      if (levelsGained > 0) {
        sfxClear();
        burst(player.x + player.w / 2, player.y + player.h / 2, CHARS[selChar].color, 16);
        openAbilityChoice();
      }
      updateHud();
    }

    function meetNpc(npc: NpcEncounter) {
      if (npc.met) return;
      npc.met = true;
      if (!saveData.metNpcIds.includes(npc.id)) {
        saveData.metNpcIds.push(npc.id);
        persistSave();
      }
      if (npc.reward === 'hp') { upgradeHp++; player.maxHp = maxHpForChar(); player.hp = Math.min(player.maxHp, player.hp + 1); }
      else if (npc.reward === 'haste') upgradeHaste++;
      else if (npc.reward === 'power') upgradePower++;
      else if (npc.reward === 'jump') { upgradeJump++; player.maxJumps = Math.max(player.maxJumps, superMode ? 3 : 2); }
      score += 180;
      gainXp(45);
      burst(npc.x + npc.w / 2, npc.y + npc.h / 2, npc.color, 18);
      showMsg(`${npc.name}: ${npc.text}`, 2.4);
      updateHud();
    }

    function recordStageResult(clear: boolean) {
      if (resultRecorded) return;
      resultRecorded = true;
      saveData.runs++;
      saveData.bestScore = Math.max(saveData.bestScore, score);
      saveData.totalKills += enemiesKilled;
      saveData.totalNotes += notesCollected;
      if (clear) {
        saveData.clearedStages = Math.max(saveData.clearedStages, selStage + 1);
        if (STAGES[selStage].boss) saveData.bossClears++;
        applyProgressUnlocks(true);
      }
      persistSave();
      updateCharacterLocks();
      updateStageLocks();
      updateTitleProgress();
    }
    // --- Stage Building ---
    function buildStage(stageIdx: number) {
      const stage = STAGES[stageIdx];
      platforms = []; enemies = []; collectNotes = []; pickups = []; npcs = []; projectiles = []; particles = []; boss = null;
      worldW = stage.worldW;
      stage.buildPlatforms(platforms);

      const groundPlats = platforms.filter(p => p.h <= 28 && p.w >= 140);
      for (let i = 0; i < stage.enemies && i < groundPlats.length; i++) {
        const p = groundPlats[i];
        const roll = Math.random();
        const type: EnemyType = stageIdx >= 2 && roll < 0.18 ? 'sniper' : stageIdx >= 1 && roll < 0.38 ? 'charger' : roll < 0.58 ? 'bat' : roll < 0.78 ? 'ghost' : 'slime';
        const elite = stageIdx > 0 && (i % 5 === 3 || (stageIdx >= 2 && Math.random() < 0.22));
        const baseHp = type === 'sniper' ? 4 : type === 'charger' ? 3 : type === 'ghost' ? 3 : type === 'bat' ? 2 : 1;
        const hp = baseHp + (elite ? 3 + stageIdx : 0);
        const xp = (type === 'sniper' ? 46 : type === 'charger' ? 38 : type === 'ghost' ? 35 : type === 'bat' ? 28 : 20) + (elite ? 45 : 0);
        const size = elite ? 40 : 32;
        const y = p.y - (type === 'bat' ? 68 : size);
        enemies.push({ x: p.x + p.w / 2 - size / 2, y, w: size, h: size, vx: (type === 'sniper' ? 0 : 60 + Math.random() * 40 + (elite ? 18 : 0)) * (Math.random() < 0.5 ? 1 : -1), hp, maxHp: hp, left: p.x, right: p.x + p.w, type, alive: true, atkTimer: 0.8 + Math.random() * 1.6, xp, elite, baseY: y, dashTimer: 1.2 + Math.random() * 1.4 });
      }

      const npcTemplates = NPCS_BY_STAGE[stageIdx] || [];
      npcTemplates.forEach((npc, index) => {
        const p = groundPlats[Math.min(groundPlats.length - 1, 1 + index * 3)] || platforms[0];
        npcs.push({ ...npc, x: p.x + Math.min(p.w - 42, 42 + index * 34), y: p.y - 48, w: 34, h: 48, met: false, seen: saveData.metNpcIds.includes(npc.id) });
      });

      for (let i = 0; i < 12; i++) {
        const p = platforms[Math.floor(Math.random() * platforms.length)];
        collectNotes.push({ x: p.x + 20 + Math.random() * Math.max(0, p.w - 40), y: p.y - 50 - Math.random() * 30, taken: false });
      }
      for (let i = 0; i < 3; i++) {
        const p = platforms[2 + Math.floor(Math.random() * Math.max(1, platforms.length - 2))];
        pickups.push({ x: p.x + p.w / 2, y: p.y - 40, type: 'health', taken: false });
      }
      for (let i = 0; i < 4; i++) {
        const p = platforms[1 + Math.floor(Math.random() * Math.max(1, platforms.length - 2))];
        pickups.push({ x: p.x + 30 + Math.random() * Math.max(0, p.w - 60), y: p.y - 72, type: 'amp', taken: false });
      }
      if (stage.boss) {
        boss = { x: worldW - 430, y: 300, w: 96, h: 144, hp: 90, maxHp: 90, active: false, alive: true, phase: 1, pattern: 'idle', timer: 0, attackTimer: 1.4, burstCount: 0, beamWarn: 0, beamY: 0, teleportTimer: 3.2, homeY: 300 };
      }
    }
    // --- Init Game ---
    function initGame(resetRun = true) {
      initAudio();
      if (resetRun) resetCampaign();
      const stage = STAGES[selStage];
      const prevHp = player ? player.hp : 0;
      setAccent(stage.accent);
      buildStage(selStage);

      const maxHp = maxHpForChar();
      const startHp = resetRun ? maxHp : Math.min(maxHp, Math.max(1, prevHp) + 1);
      player = { x: 60, y: 400, w: 36, h: 48, vx: 0, vy: 0, grounded: false, facing: 1, hp: startHp, maxHp, invuln: 0, jumps: 0, maxJumps: superMode ? 3 : (selChar === 2 || selChar === 3 || upgradeJump > 0) ? 2 : 1, atkTimer: 0 };
      if (!resetRun && rogueRegen > 0) player.hp = Math.min(player.maxHp, player.hp + rogueRegen);
      shieldCharges = rogueShield;
      cameraX = 0; running = true; finished = false; paused = false; pendingNextStage = false; resultRecorded = false;
      pauseOverlay.classList.add('hidden');
      pauseBtn.textContent = '暂停';

      titleScreen.classList.add('hidden');
      gameScreen.classList.remove('hidden');
      resultsScreen.classList.add('hidden');
      touchControls.classList.remove('hidden');
      updateHud();
      showMsg(stage.name, 1.8);
    }

    function updateHud() {
      const maxHp = player.maxHp;
      hudHp.innerHTML = `<span class="hp-label">生命</span><span class="hp-count">${Math.max(0, player.hp)}/${maxHp}</span><span class="hp-hearts">${Array.from({ length: maxHp }, (_, i) => `<span class="hp-dot${i < player.hp ? ' filled' : ''}"></span>`).join('')}</span>`;
      hudNotes.textContent = String(notesCollected);
      hudLevel.textContent = String(heroLevel);
      hudXp.textContent = `${heroXp}/${heroXpNext}`;
      hudScore.textContent = String(score);
      const abilities = [
        `${CHARS[selChar].name} · ${CHARS[selChar].desc}`,
        upgradePower ? `攻击 +${upgradePower}` : '',
        upgradeHaste ? `射速 +${upgradeHaste}` : '',
        upgradeHp ? `生命 +${upgradeHp}` : '',
        upgradeJump ? `机动 +${upgradeJump}` : '',
        rogueRange ? `射程 +${rogueRange}` : '',
        roguePierce ? `穿透 +${roguePierce}` : '',
        rogueMulti ? `副弹 +${rogueMulti}` : '',
        rogueCrit ? `暴击 ${Math.round(rogueCrit * 100)}%` : '',
        shieldCharges ? `护盾 ${shieldCharges}` : '',
        superMode ? '超能力' : '',
        ...runAbilityNames.slice(-3),
      ].filter(Boolean);
      hudAbilities.innerHTML = abilities.map(text => `<span class="ability-chip${text === '超能力' ? ' super' : ''}">${text}</span>`).join('');
    }
    // --- Input ---
    document.addEventListener('keydown', e => {
      const k = e.key.toLowerCase();
      keys[k] = true;
      handleSecretInput(k);
      if ((k === 'escape' || k === 'p') && !gameScreen.classList.contains('hidden')) { e.preventDefault(); setPaused(!paused); return; }
      if (k === 'arrowup' || k === 'w' || k === ' ') { e.preventDefault(); doJump(); }
      if (k === 'j' || k === 'k') doAttack();
      if (k === 'enter' && !running && !titleScreen.classList.contains('hidden')) initGame(true);
    });
    document.addEventListener('keyup', e => { keys[e.key.toLowerCase()] = false; });

    // Touch
    const touchBtns = touchControls.querySelectorAll<HTMLButtonElement>('.t-btn');
    touchBtns.forEach(btn => {
      const dir = btn.dataset.dir || '';
      const down = (e: PointerEvent) => { e.preventDefault(); btn.setPointerCapture(e.pointerId); btn.classList.add('active'); keys['t_' + dir] = true; if (dir === 'jump') doJump(); if (dir === 'attack') doAttack(); };
      const up = () => { btn.classList.remove('active'); keys['t_' + dir] = false; };
      btn.addEventListener('pointerdown', down);
      btn.addEventListener('pointerup', up);
      btn.addEventListener('pointercancel', up);
      btn.addEventListener('lostpointercapture', up);
    });

    function doJump() {
      if (!running || finished || paused || choosingAbility) return;
      if (player.grounded || player.jumps < player.maxJumps) {
        player.vy = -jumpPower();
        player.grounded = false;
        player.jumps++;
        sfxJump();
      }
    }

    function spawnPlayerProjectile(partial: Partial<Projectile>) {
      const c = CHARS[selChar];
      projectiles.push({
        x: player.x + (player.facing > 0 ? player.w : -22),
        y: player.y + 16,
        w: superMode ? 26 : 16,
        h: superMode ? 15 : 12,
        vx: projectileSpeed() * player.facing,
        vy: 0,
        life: projectileLife(),
        damage: rollAttackDamage(),
        kind: 'player',
        color: superMode ? '#ffd66e' : c.color,
        shape: 'note',
        pierce: roguePierce + (superMode ? 2 : 0),
        ...partial,
      });
    }

    function doAttack() {
      if (!running || finished || paused || choosingAbility || player.atkTimer > 0) return;
      const c = CHARS[selChar];
      const dir = player.facing;
      const spd = projectileSpeed();
      const dmg = rollAttackDamage();
      const pierce = roguePierce + (superMode ? 2 : 0);
      player.atkTimer = attackCooldown();

      if (selChar === 0) {
        const count = 1 + Math.min(2, rogueMulti);
        for (let i = 0; i < count; i++) {
          const spread = (i - (count - 1) / 2) * 80;
          spawnPlayerProjectile({ y: player.y + 12 + i * 8, w: 15, h: 15, vx: spd * 0.82 * dir, vy: spread, life: projectileLife() + 0.25, damage: Math.max(1, dmg), shape: 'note', homing: 0.09, pierce });
        }
      } else if (selChar === 1) {
        spawnPlayerProjectile({ x: player.x + (dir > 0 ? player.w - 4 : -56), y: player.y + 13, w: superMode ? 76 : 58, h: 18, vx: spd * 1.08 * dir, vy: 0, life: projectileLife() * 0.72, damage: dmg + 1, shape: 'slash', pierce: pierce + 1 });
        if (rogueMulti > 0) spawnPlayerProjectile({ x: player.x + (dir > 0 ? player.w - 2 : -44), y: player.y + 30, w: 44, h: 12, vx: spd * 0.98 * dir, vy: 0, life: projectileLife() * 0.58, damage: Math.max(1, dmg - 1), shape: 'slash', pierce });
      } else if (selChar === 2) {
        const count = 3 + Math.min(2, rogueMulti);
        for (let i = 0; i < count; i++) {
          const spread = (i - (count - 1) / 2) * 72;
          spawnPlayerProjectile({ y: player.y + 18, w: 13, h: 13, vx: spd * dir, vy: spread, life: projectileLife() * 0.82, damage: Math.max(1, dmg), shape: 'fan', pierce });
        }
        player.vx += dir * 90;
      } else if (selChar === 3) {
        spawnPlayerProjectile({ y: player.y + 10, w: 20, h: 20, vx: spd * 0.72 * dir, vy: -170 - rogueMulti * 24, life: projectileLife() + 0.45, damage: dmg + 1, shape: 'paint', accelY: 520, aoe: 72 + rogueRange * 10, pierce: 0 });
      } else {
        const count = 1 + Math.min(2, rogueMulti);
        for (let i = 0; i < count; i++) {
          const offset = (i - (count - 1) / 2) * 13;
          spawnPlayerProjectile({ y: player.y + 18 + offset, w: superMode ? 86 : 64, h: 10, vx: spd * 1.45 * dir, vy: 0, life: projectileLife() * 0.64, damage: dmg, shape: 'beam', pierce: pierce + 2 });
        }
      }
      sfxHit();
      burst(player.x + player.w / 2 + dir * 20, player.y + 20, c.color, 5 + rogueMulti);
    }

    function killEnemy(enemy: Enemy, bonusScore: number) {
      if (!enemy.alive) return;
      enemy.alive = false; enemiesKilled++; score += bonusScore; gainXp(enemy.xp);
      burst(enemy.x + enemy.w / 2, enemy.y + enemy.h / 2, STAGES[selStage].accent, 12);
      sfxKill(); shake(8); updateHud();
    }
    function spawnAimedProjectile(x: number, y: number, speed: number, kind: 'enemy' | 'boss', color: string, size = 14) {
      const tx = player.x + player.w / 2 - x, ty = player.y + player.h / 2 - y;
      const len = Math.max(1, Math.hypot(tx, ty));
      projectiles.push({ x, y, w: size, h: size, vx: tx / len * speed, vy: ty / len * speed, life: 3, damage: 1, kind, color });
    }

    function nearestProjectileTarget(proj: Projectile) {
      let target: Rect | null = null;
      let best = 999999;
      for (const enemy of enemies) {
        if (!enemy.alive) continue;
        const dx = enemy.x + enemy.w / 2 - (proj.x + proj.w / 2);
        const dy = enemy.y + enemy.h / 2 - (proj.y + proj.h / 2);
        const d = dx * dx + dy * dy;
        if (d < best && d < 520 * 520) { best = d; target = enemy; }
      }
      if (boss && boss.alive && boss.active) {
        const dx = boss.x + boss.w / 2 - (proj.x + proj.w / 2);
        const dy = boss.y + boss.h / 2 - (proj.y + proj.h / 2);
        const d = dx * dx + dy * dy;
        if (d < best && d < 620 * 620) target = boss;
      }
      return target;
    }

    function consumeProjectileHit(proj: Projectile) {
      if (proj.aoe) explodePlayerProjectile(proj);
      if ((proj.pierce || 0) > 0 && !proj.aoe) {
        proj.pierce = (proj.pierce || 0) - 1;
        proj.x += Math.sign(proj.vx || player.facing) * Math.max(18, proj.w);
      } else {
        proj.life = 0;
      }
    }

    function explodePlayerProjectile(proj: Projectile) {
      const radius = proj.aoe || 0;
      if (!radius) return;
      const cx = proj.x + proj.w / 2;
      const cy = proj.y + proj.h / 2;
      burst(cx, cy, proj.color, 22);
      shake(8);
      for (const enemy of enemies) {
        if (!enemy.alive) continue;
        const ex = enemy.x + enemy.w / 2, ey = enemy.y + enemy.h / 2;
        if (Math.hypot(ex - cx, ey - cy) <= radius) {
          enemy.hp -= Math.max(1, Math.floor(proj.damage * 0.75));
          if (enemy.hp <= 0) killEnemy(enemy, (enemy.type === 'ghost' ? 260 : 200) + (enemy.elite ? 240 : 0));
        }
      }
      if (boss && boss.alive && boss.active) {
        const bx = boss.x + boss.w / 2, by = boss.y + boss.h / 2;
        if (Math.hypot(bx - cx, by - cy) <= radius + 40) damageBoss(Math.max(1, Math.floor(proj.damage * 0.7)));
      }
    }

    function damageBoss(amount: number) {
      if (!boss || !boss.alive) return;
      boss.hp = Math.max(0, boss.hp - amount);
      burst(boss.x + boss.w / 2, boss.y + boss.h / 2, '#ffffff', 5); shake(6);
      if (boss.hp <= 0) {
        boss.alive = false; boss.active = false; score += 2500; finished = true; running = false; pendingNextStage = false; gainXp(220);
        burst(boss.x + boss.w / 2, boss.y + boss.h / 2, STAGES[selStage].accent, 36);
        sfxClear();
        startBossDefeatCutscene();
      } else if (boss.phase === 1 && boss.hp <= boss.maxHp * 0.66) { boss.phase = 2; boss.attackTimer = 0.5; boss.teleportTimer = 1.2; showMsg('BOSS 第二阶段', 1.1); shake(12); }
      else if (boss.phase === 2 && boss.hp <= boss.maxHp * 0.34) { boss.phase = 3; boss.attackTimer = 0.4; boss.teleportTimer = 0.8; showMsg('BOSS 第三阶段', 1.1); shake(14); }
      updateHud();
    }

    function startBossDefeatCutscene() {
      bossDefeatCutscene = 3.8;
     
      bossFinisher.classList.remove('hidden');
      bossFinisher.classList.remove('slowmo');
      void bossFinisher.offsetWidth;
      bossFinisher.classList.add('slowmo');
      bossFinisherLine.textContent = '破碎的世界....还值得拯救吗...';
      bossFinisherImg.src = BOSS_SPRITES.defeat1;
      setTimeout(() => { bossFinisherImg.src = BOSS_SPRITES.defeat2; }, 760);
      setTimeout(() => { bossFinisherImg.src = BOSS_SPRITES.fade1; }, 1780);
      setTimeout(() => { bossFinisherImg.src = BOSS_SPRITES.fade2; }, 2480);
      setTimeout(() => { bossFinisherImg.src = BOSS_SPRITES.fade3; }, 3140);
      setTimeout(() => {
        bossFinisher.classList.remove('slowmo');
        bossFinisher.classList.add('hidden');
        showResults();
      }, 3800);
    }

    function teleportBoss() {
      if (!boss || !boss.alive || boss.phase < 2) return;
      const oldX = boss.x + boss.w / 2;
      const oldY = boss.y + boss.h / 2;
      burst(oldX, oldY, '#ff66dd', 18);
      const arenaLeft = Math.max(2120, worldW - 1180);
      const arenaRight = worldW - 260;
      const slots = [
        { x: arenaLeft + 80, y: 292 },
        { x: arenaLeft + 420, y: 248 },
        { x: arenaRight - 190, y: 316 },
        { x: player.x + (player.x < arenaLeft + 420 ? 420 : -420), y: 276 },
      ];
      const next = slots[Math.floor(Math.random() * slots.length)];
      boss.x = Math.max(arenaLeft, Math.min(arenaRight, next.x));
      boss.homeY = Math.max(230, Math.min(340, next.y));
      boss.y = boss.homeY;
      boss.pattern = 'idle';
      boss.timer = 0;
      boss.attackTimer = boss.phase >= 3 ? 0.25 : 0.45;
      boss.teleportTimer = boss.phase >= 3 ? 2.4 : 3.4;
      burst(boss.x + boss.w / 2, boss.y + boss.h / 2, '#cc88ff', 22);
      showMsg('BOSS 瞬移', 0.7);
      shake(12);
    }

    function chooseBossPattern() {
      if (!boss) return;
      const order: Boss['pattern'][] = boss.phase === 1 ? ['volley', 'wave', 'rain'] : boss.phase === 2 ? ['rain', 'volley', 'beam', 'wave'] : ['beam', 'rain', 'volley', 'wave'];
      boss.pattern = order[Math.floor(Math.random() * order.length)]; boss.timer = 0; boss.burstCount = 0;
      if (boss.pattern === 'beam') { boss.beamWarn = 0.75; boss.beamY = Math.max(90, Math.min(430, player.y + player.h / 2)); boss.pattern = 'idle'; boss.attackTimer = 1.6; }
    }
    function updateBoss(dt: number) {
      if (!boss || !boss.alive) return;
      boss.y = boss.homeY + Math.sin(performance.now() * 0.002) * 10;
      if (!boss.active) { if (player.x > boss.x - 650) { boss.active = true; showMsg('BOSS: 25 初音核心', 1.4); shake(12); } return; }
      if (boss.phase >= 2) {
        boss.teleportTimer -= dt;
        if (boss.teleportTimer <= 0 && boss.beamWarn <= 0) teleportBoss();
      }
      if (boss.beamWarn > 0) { boss.beamWarn -= dt; if (boss.beamWarn <= 0) { projectiles.push({ x: Math.max(0, player.x - 320), y: boss.beamY - 9, w: 640, h: 18, vx: 0, vy: 0, life: 0.42, damage: 1, kind: 'boss', color: '#ff66dd' }); sfxHurt(); shake(16); } }
      boss.attackTimer -= dt;
      if (boss.pattern === 'idle' && boss.attackTimer <= 0 && boss.beamWarn <= 0) chooseBossPattern();
      boss.timer += dt;
      if (boss.pattern === 'volley' && boss.timer > 0.26) { boss.timer = 0; boss.burstCount++; spawnAimedProjectile(boss.x + 18, boss.y + 56, 230 + boss.phase * 45, 'boss', '#cc88ff', 16); if (boss.burstCount >= 3 + boss.phase * 2) { boss.pattern = 'idle'; boss.attackTimer = 1.1; } }
      else if (boss.pattern === 'rain' && boss.timer > 0.16) { boss.timer = 0; boss.burstCount++; const rx = player.x + player.w / 2 - 180 + Math.random() * 360; projectiles.push({ x: rx, y: -30, w: 14, h: 24, vx: (Math.random() - 0.5) * 50, vy: 300 + boss.phase * 45, life: 2.2, damage: 1, kind: 'boss', color: '#aa66ff' }); if (boss.burstCount >= 7 + boss.phase * 3) { boss.pattern = 'idle'; boss.attackTimer = 1.0; } }
      else if (boss.pattern === 'wave' && boss.timer > 0.42) { boss.timer = 0; boss.burstCount++; projectiles.push({ x: boss.x - 24, y: 452, w: 42, h: 20, vx: -(230 + boss.phase * 55), vy: 0, life: 4, damage: 1, kind: 'boss', color: '#ff99cc' }); if (boss.burstCount >= 2 + boss.phase) { boss.pattern = 'idle'; boss.attackTimer = 1.2; } }
      if (overlaps(player, boss)) takeDamage();
    }
    // --- Update ---
    function update(dt: number) {
      if (!running || finished) return;
      if (paused) return;
      if (choosingAbility) return;
      const c = CHARS[selChar];
      const stage = STAGES[selStage];

      // Player movement
      const moveL = keys['arrowleft'] || keys['a'] || keys['t_left'];
      const moveR = keys['arrowright'] || keys['d'] || keys['t_right'];
      if (moveL) { player.vx = -c.speed; player.facing = -1; }
      else if (moveR) { player.vx = c.speed; player.facing = 1; }
      else { player.vx *= Math.pow(0.01, dt); }

      player.vy += GRAVITY * dt;
      player.invuln = Math.max(0, player.invuln - dt);
      player.atkTimer = Math.max(0, player.atkTimer - dt * 1000);

      // Horizontal collision
      player.x += player.vx * dt;
      for (const p of platforms) {
        if (overlaps(player, p)) {
          if (player.vx > 0) player.x = p.x - player.w;
          else if (player.vx < 0) player.x = p.x + p.w;
          player.vx = 0;
        }
      }

      // Vertical collision
      player.y += player.vy * dt;
      player.grounded = false;
      for (const p of platforms) {
        if (overlaps(player, p)) {
          if (player.vy > 0) { player.y = p.y - player.h; player.vy = 0; player.grounded = true; player.jumps = 0; }
          else if (player.vy < 0) { player.y = p.y + p.h; player.vy = 0; }
        }
      }

      // Fall off world
      if (player.y > VH + 100) {
        player.x = Math.max(60, cameraX + 80);
        player.y = 60;
        player.vy = 0;
        takeDamage();
      }

      player.x = Math.max(0, Math.min(worldW - player.w, player.x));

      // Projectiles
      for (const proj of projectiles) {
        if (proj.kind === 'player' && proj.homing) {
          const target = nearestProjectileTarget(proj);
          if (target) {
            const tx = target.x + target.w / 2 - (proj.x + proj.w / 2);
            const ty = target.y + target.h / 2 - (proj.y + proj.h / 2);
            const len = Math.max(1, Math.hypot(tx, ty));
            const speed = Math.max(180, Math.hypot(proj.vx, proj.vy));
            proj.vx += (tx / len * speed - proj.vx) * proj.homing;
            proj.vy += (ty / len * speed - proj.vy) * proj.homing;
          }
        }
        if (proj.accelY) proj.vy += proj.accelY * dt;
        proj.x += proj.vx * dt; proj.y += proj.vy * dt; proj.life -= dt;
        if (proj.kind === 'player') {
          for (const enemy of enemies) {
            if (!enemy.alive || proj.life <= 0) continue;
            if (overlaps(proj, enemy)) {
              enemy.hp -= proj.damage;
              if (enemy.hp <= 0) killEnemy(enemy, (enemy.type === 'ghost' ? 260 : 200) + (enemy.elite ? 240 : 0));
              else burst(enemy.x + enemy.w / 2, enemy.y + enemy.h / 2, '#fff', enemy.elite ? 8 : 4);
              consumeProjectileHit(proj);
            }
          }
          if (boss && boss.alive && boss.active && proj.life > 0 && overlaps(proj, boss)) { damageBoss(proj.damage); consumeProjectileHit(proj); }
        } else if (overlaps(player, proj)) { proj.life = 0; takeDamage(); }
      }
      projectiles = projectiles.filter(p => p.life > 0 && p.x > cameraX - 180 && p.x < cameraX + VW + 260 && p.y > -120 && p.y < VH + 140);
      // Enemies
      for (const enemy of enemies) {
        if (!enemy.alive) continue;
        enemy.x += enemy.vx * dt;
        if (enemy.x <= enemy.left || enemy.x + enemy.w >= enemy.right) enemy.vx *= -1;
        if (enemy.type === 'bat') {
          enemy.y = (enemy.baseY || enemy.y) + Math.sin(performance.now() * 0.006 + enemy.x) * (enemy.elite ? 18 : 12);
          enemy.atkTimer -= dt;
          const dist = Math.abs((player.x + player.w / 2) - (enemy.x + enemy.w / 2));
          if (enemy.atkTimer <= 0 && dist < 420) {
            projectiles.push({ x: enemy.x + enemy.w / 2, y: enemy.y + enemy.h, w: 12, h: 18, vx: (player.x > enemy.x ? 80 : -80), vy: 280, life: 1.8, damage: 1, kind: 'enemy', color: '#ff66aa', shape: 'paint' });
            enemy.atkTimer = enemy.elite ? 1.3 : 2.0;
          }
        }
        if (enemy.type === 'ghost') {
          enemy.atkTimer -= dt;
          const dist = Math.abs((player.x + player.w / 2) - (enemy.x + enemy.w / 2));
          if (enemy.atkTimer <= 0 && dist < (enemy.elite ? 680 : 560)) { spawnAimedProjectile(enemy.x + enemy.w / 2, enemy.y + 14, enemy.elite ? 270 : 210, 'enemy', enemy.elite ? '#ffd66e' : '#88ddff', enemy.elite ? 16 : 12); enemy.atkTimer = (enemy.elite ? 1.05 : 1.6) + Math.random() * 0.8; }
        }
        if (enemy.type === 'charger') {
          enemy.dashTimer = (enemy.dashTimer || 1) - dt;
          const dx = player.x + player.w / 2 - (enemy.x + enemy.w / 2);
          if (enemy.dashTimer <= 0 && Math.abs(dx) < 520) {
            enemy.vx = Math.sign(dx || 1) * (enemy.elite ? 250 : 190);
            enemy.dashTimer = enemy.elite ? 1.15 : 1.65;
            burst(enemy.x + enemy.w / 2, enemy.y + enemy.h / 2, '#ff99cc', 6);
          }
        }
        if (enemy.type === 'sniper') {
          enemy.atkTimer -= dt;
          enemy.vx *= Math.pow(0.02, dt);
          const dist = Math.abs((player.x + player.w / 2) - (enemy.x + enemy.w / 2));
          if (enemy.atkTimer <= 0 && dist < 720) {
            const dir = player.x > enemy.x ? 1 : -1;
            projectiles.push({ x: enemy.x + (dir > 0 ? enemy.w : -34), y: enemy.y + 15, w: 34, h: 7, vx: dir * (enemy.elite ? 360 : 300), vy: 0, life: 2.1, damage: 1, kind: 'enemy', color: enemy.elite ? '#ffd66e' : '#cc88ff', shape: 'beam' });
            enemy.atkTimer = enemy.elite ? 1.2 : 1.85;
            shake(4);
          }
        }
        if (overlaps(player, enemy)) {
          if (player.vy > 100 && player.y + player.h - enemy.y < 20) { enemy.hp -= 1; player.vy = -450; if (enemy.hp <= 0) killEnemy(enemy, 250 + (enemy.elite ? 240 : 0)); else { burst(enemy.x + enemy.w / 2, enemy.y + enemy.h / 2, '#fff', enemy.elite ? 8 : 4); updateHud(); } }
          else takeDamage();
        }
      }
      for (const npc of npcs) {
        if (!npc.met && overlaps(player, npc)) meetNpc(npc);
      }
      // Collectibles
      for (const note of collectNotes) {
        if (note.taken) continue;
        if (overlaps(player, { x: note.x - 14, y: note.y - 14, w: 28, h: 28 })) {
          note.taken = true; notesCollected++; score += 100; gainXp(10);
          burst(note.x, note.y, '#ffd66e', 8); sfxNote(); updateHud();
        }
      }
      for (const pk of pickups) {
        if (pk.taken) continue;
        if (overlaps(player, { x: pk.x - 12, y: pk.y - 12, w: 24, h: 24 })) {
          pk.taken = true;
          if (pk.type === 'health' && player.hp < player.maxHp) { player.hp++; showMsg('+1 生命', 0.8); }
          else if (pk.type === 'amp') { score += 80; gainXp(35); showMsg('+经验', 0.7); }
          else score += 50;
          burst(pk.x, pk.y, pk.type === 'amp' ? '#88ddff' : '#ff6688', 6); updateHud();
        }
      }
      updateBoss(dt);
      // Particles
      for (const p of particles) { p.x += p.vx * dt; p.y += p.vy * dt; p.vy += 400 * dt; p.life -= dt; }
      particles = particles.filter(p => p.life > 0);

      // Shake
      if (shakeT > 0) { shakeT -= dt; shakeX *= 0.8; shakeY *= 0.8; } else { shakeX = 0; shakeY = 0; }

      // Message
      if (msgTimer > 0) { msgTimer -= dt; if (msgTimer <= 0) gameMsg.classList.remove('show'); }
      if (secretToastTimer > 0) {
        secretToastTimer -= dt;
        if (secretToastTimer <= 0) {
          secretToast.classList.remove('show');
          setTimeout(() => secretToast.classList.add('hidden'), 180);
        }
      }

      // Check win
      if (!stage.boss && player.x > worldW - 80) {
        finished = true; running = false; pendingNextStage = selStage < STAGES.length - 1;
        score += Math.max(0, player.hp * 500);
        sfxClear(); updateHud(); setTimeout(showResults, 800);
      }
      // Animation state
      animTimer += dt;
      if (player.atkTimer > 0) {
        if (animState !== 'attack') { animState = 'attack'; animFrame = 0; animTimer = 0; }
      } else if (!player.grounded) {
        animState = player.vy < 0 ? 'jump' : 'fall';
      } else if (Math.abs(player.vx) > 30) {
        if (animState !== 'run') { animState = 'run'; animFrame = 0; animTimer = 0; }
        const runFrameCount = selChar === 1 ? MFY_RUN_FRAMES.length : 6;
        const runFrameDelay = selChar === 1 ? MFY_RUN_CYCLE_SECONDS / MFY_RUN_FRAMES.length : 0.08;
        while (animTimer > runFrameDelay) { animFrame = (animFrame + 1) % runFrameCount; animTimer -= runFrameDelay; }
        runDustTimer += dt;
        if (runDustTimer > 0.12) { runDustTimer = 0; particles.push({ x: player.x + player.w / 2, y: player.y + player.h, vx: -player.facing * (20 + Math.random() * 30), vy: -(10 + Math.random() * 20), life: 0.3, color: 'rgba(200,200,200,0.5)', size: 2 + Math.random() * 2 }); }
      } else {
        if (animState !== 'idle') { animState = 'idle'; animFrame = 0; animTimer = 0; }
      }

      // Camera
      const targetCam = Math.max(0, Math.min(worldW - VW, player.x - VW * 0.4));
      cameraX += (targetCam - cameraX) * Math.min(1, dt * 6);
    }

    function takeDamage() {
      if (player.invuln > 0 || finished) return;
      if (shieldCharges > 0) {
        shieldCharges--;
        player.invuln = 0.8;
        sfxHit();
        shake(8);
        burst(player.x + player.w / 2, player.y + player.h / 2, '#ffd66e', 14);
        showMsg('护盾抵消', 0.8);
        updateHud();
        return;
      }
      player.hp--;
      player.invuln = 1.2;
      player.vx = -player.facing * 280;
      player.vy = -400;
      sfxHurt();
      shake(10);
      burst(player.x + player.w / 2, player.y + player.h / 2, '#e44', 8);
      updateHud();
      if (player.hp <= 0) {
        finished = true; running = false;
        showMsg('游戏结束', 2);
        setTimeout(showResults, 1500);
      }
    }

    function showResults() {
      const clear = player.hp > 0;
      recordStageResult(clear);
      document.getElementById('resTitle')!.textContent = clear ? (pendingNextStage ? '本幕通关！' : 'SEKAI 已拯救！') : '游戏结束';
      document.getElementById('resNotes')!.textContent = String(notesCollected);
      document.getElementById('resEnemies')!.textContent = String(enemiesKilled);
      document.getElementById('resLevel')!.textContent = String(heroLevel);
      document.getElementById('resScore')!.textContent = String(score);
      const retry = document.getElementById('retryBtn')!;
      retry.textContent = clear && pendingNextStage ? '下一幕' : '重试';
      setPaused(false);
      gameScreen.classList.add('hidden'); resultsScreen.classList.remove('hidden'); touchControls.classList.add('hidden');
    }
    // --- Render ---
    function render(time: number) {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = Math.round(rect.width * dpr);
      canvas.height = Math.round(rect.height * dpr);
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      if (!player) return;

      const sx = (rect.width * dpr) / VW;
      const sy = (rect.height * dpr) / VH;
      const s = Math.min(sx, sy);
      const ox = (canvas.width - VW * s) / 2;
      const oy = (canvas.height - VH * s) / 2;
      ctx.setTransform(s, 0, 0, s, ox + shakeX, oy + shakeY);

      const stage = STAGES[selStage];
      const t = time / 1000;

      // Background
      ctx.fillStyle = stage.bg1;
      ctx.fillRect(0, 0, VW, VH);
      ctx.fillStyle = stage.bg2;
      ctx.fillRect(0, VH * 0.4, VW, VH * 0.6);

      // Stars (parallax)
      for (let i = 0; i < 50; i++) {
        const x = ((i * 137 + 23 - cameraX * (0.05 + (i % 3) * 0.015)) % (VW + 80)) - 40;
        const y = 20 + (i * 59) % (VH * 0.5);
        const sz = 2 + (i % 3);
        ctx.fillStyle = i % 4 === 0 ? stage.starColor : 'rgba(255,255,255,0.3)';
        ctx.fillRect(Math.floor(x), Math.floor(y), sz, sz);
      }

      // Background buildings (parallax)
      for (let i = 0; i < 12; i++) {
        const x = Math.floor((i * 280 - cameraX * 0.12) % (VW + 300) - 150);
        const h = 60 + (i % 4) * 30;
        ctx.fillStyle = i % 2 === 0 ? hexRgba(stage.platColor, 0.4) : hexRgba(stage.bg2, 0.6);
        ctx.fillRect(x, VH - 50 - h, 80, h);
        for (let j = 0; j < 3; j++) {
          ctx.fillStyle = hexRgba(stage.accent, 0.12);
          ctx.fillRect(x + 14 + j * 20, VH - 40 - h, 8, h - 20);
        }
      }

      // Platforms
      for (const p of platforms) {
        const px = Math.round(p.x - cameraX);
        if (px + p.w < -40 || px > VW + 40) continue;
        ctx.fillStyle = stage.platColor;
        ctx.fillRect(px, p.y, p.w, p.h);
        ctx.fillStyle = stage.platTop;
        ctx.fillRect(px, p.y, p.w, Math.min(6, p.h));
        // Tile pattern
        for (let tx = 0; tx < p.w; tx += 24) {
          ctx.fillStyle = hexRgba(stage.platTop, 0.08);
          ctx.fillRect(px + tx + 16, p.y + 10, 4, 4);
        }
        ctx.fillStyle = hexRgba('#000000', 0.2);
        ctx.fillRect(px, p.y + p.h - 3, p.w, 3);
      }

      // Goal gate
      if (!stage.boss) {
        const gateX = worldW - 60 - cameraX;
        ctx.save();
        ctx.fillStyle = hexRgba(stage.accent, 0.15);
        ctx.fillRect(gateX - 24, 380, 48, 96);
        ctx.strokeStyle = stage.accent;
        ctx.lineWidth = 2;
        ctx.strokeRect(gateX - 24, 380, 48, 96);
        ctx.fillStyle = '#fff';
        ctx.font = '900 14px Courier New, monospace';
        ctx.textAlign = 'center';
        ctx.fillText('终点', gateX, 430 + Math.sin(t * 3) * 3);
        ctx.restore();
      }
      // NPC encounters
      for (const npc of npcs) {
        const nx = Math.round(npc.x - cameraX);
        const ny = Math.round(npc.y);
        if (nx + npc.w < -30 || nx > VW + 30) continue;
        ctx.save();
        ctx.fillStyle = 'rgba(0,0,0,0.2)';
        ctx.beginPath();
        ctx.ellipse(nx + npc.w / 2, ny + npc.h + 4, 18, 5, 0, 0, Math.PI * 2);
        ctx.fill();
        const npcImg = typeof npc.char === 'number' ? charImages[npc.char] : null;
        ctx.imageSmoothingEnabled = false;
        if (npcImg && npcImg.complete && npcImg.naturalWidth > 0) {
          ctx.globalAlpha = npc.met ? 0.58 : 1;
          const sw = npc.char === 1 ? 58 : 48;
          const sh = npc.char === 1 ? 64 : 58;
          ctx.drawImage(npcImg, nx + npc.w / 2 - sw / 2, ny + npc.h - sh + 4, sw, sh);
          ctx.globalAlpha = 1;
          ctx.strokeStyle = npc.met ? 'rgba(255,255,255,.25)' : npc.color;
          ctx.lineWidth = 2;
          ctx.strokeRect(nx + npc.w / 2 - sw / 2 - 2, ny + npc.h - sh + 2, sw + 4, sh + 4);
        } else {
          ctx.fillStyle = npc.met ? 'rgba(255,255,255,.36)' : npc.color;
          ctx.fillRect(nx + 7, ny + 10, 20, 30);
          ctx.fillStyle = npc.met ? 'rgba(255,255,255,.48)' : hexRgba(npc.color, .7);
          ctx.fillRect(nx + 5, ny + 2, 24, 14);
          ctx.fillStyle = '#fff';
          ctx.fillRect(nx + 11, ny + 9, 4, 4);
          ctx.fillRect(nx + 20, ny + 9, 4, 4);
        }
        if (!npc.met) {
          ctx.fillStyle = '#ffd66e';
          ctx.font = '900 18px Courier New, monospace';
          ctx.textAlign = 'center';
          ctx.fillText('!', nx + npc.w / 2, ny - 8);
        }
        ctx.restore();
      }
      // Collectibles
      for (const note of collectNotes) {
        if (note.taken) continue;
        const nx = Math.round(note.x - cameraX);
        const ny = Math.round(note.y + Math.sin(t * 3 + note.x * 0.01) * 4);
        if (nx < -30 || nx > VW + 30) continue;
        ctx.save();
        ctx.shadowColor = '#ffd66e'; ctx.shadowBlur = 8;
        drawTinyNote(nx, ny, 1.15);
        ctx.restore();
      }
      // Pickups
      for (const pk of pickups) {
        if (pk.taken) continue;
        const px = Math.round(pk.x - cameraX);
        const py = Math.round(pk.y + Math.sin(t * 2.5 + pk.x) * 3);
        if (px < -30 || px > VW + 30) continue;
        const isAmp = pk.type === 'amp';
        ctx.save();
        if (isAmp) {
          drawXpShard(px, py, 1.05);
        } else {
          drawHeartIcon(px, py, true, 1.35);
        }
        ctx.restore();
      }
      // Enemies
      for (const enemy of enemies) {
        if (!enemy.alive) continue;
        const ex = Math.round(enemy.x - cameraX);
        const ey = Math.round(enemy.y);
        if (ex + enemy.w < -20 || ex > VW + 20) continue;

        if (enemy.elite) {
          ctx.save();
          ctx.strokeStyle = '#ffd66e';
          ctx.lineWidth = 2;
          ctx.shadowColor = '#ffd66e';
          ctx.shadowBlur = 10;
          ctx.strokeRect(ex - 3, ey - 3, enemy.w + 6, enemy.h + 6);
          ctx.fillStyle = '#ffd66e';
          ctx.fillRect(ex + enemy.w / 2 - 8, ey - 11, 16, 4);
          ctx.fillRect(ex + enemy.w / 2 - 2, ey - 17, 4, 10);
          ctx.restore();
        }

        if (enemy.type === 'slime') {
          ctx.fillStyle = '#4a2060';
          ctx.fillRect(ex + 4, ey + 12, 24, 20);
          ctx.fillStyle = '#6a3088';
          ctx.fillRect(ex + 2, ey + 6, 28, 14);
          ctx.fillStyle = '#ff4488';
          ctx.fillRect(ex + 8, ey + 12, 5, 5);
          ctx.fillRect(ex + 19, ey + 12, 5, 5);
        } else if (enemy.type === 'bat') {
          const wingY = Math.sin(t * 12 + enemy.x) * 4;
          ctx.fillStyle = '#3a1848';
          ctx.fillRect(ex + 10, ey + 8, 12, 16);
          ctx.fillStyle = '#5a2868';
          ctx.fillRect(ex - 2, ey + 6 + wingY, 14, 8);
          ctx.fillRect(ex + 20, ey + 6 - wingY, 14, 8);
          ctx.fillStyle = '#ff3366';
          ctx.fillRect(ex + 12, ey + 12, 3, 3);
          ctx.fillRect(ex + 18, ey + 12, 3, 3);
        } else if (enemy.type === 'charger') {
          ctx.fillStyle = '#44182a';
          ctx.fillRect(ex + 3, ey + 8, 28, 24);
          ctx.fillStyle = '#ff6699';
          ctx.fillRect(ex + 8, ey + 2, 16, 10);
          ctx.fillRect(ex + 2, ey + 20, 8, 8);
          ctx.fillRect(ex + 22, ey + 20, 8, 8);
          ctx.fillStyle = '#fff';
          ctx.fillRect(ex + (enemy.vx > 0 ? 20 : 8), ey + 13, 5, 5);
        } else if (enemy.type === 'sniper') {
          ctx.fillStyle = '#1c1838';
          ctx.fillRect(ex + 5, ey + 6, 22, 26);
          ctx.fillStyle = '#7a66cc';
          ctx.fillRect(ex + 8, ey + 2, 16, 8);
          ctx.fillStyle = '#cc88ff';
          ctx.fillRect(ex + (player.x > enemy.x ? 20 : -2), ey + 15, 14, 5);
          ctx.fillStyle = '#fff';
          ctx.fillRect(ex + 12, ey + 11, 4, 4);
        } else {
          ctx.fillStyle = '#2a1838';
          ctx.fillRect(ex + 4, ey + 4, 24, 28);
          ctx.fillStyle = '#4a2858';
          ctx.fillRect(ex + 6, ey, 20, 12);
          ctx.fillStyle = '#88ddff';
          ctx.fillRect(ex + 10, ey + 8, 4, 4);
          ctx.fillRect(ex + 18, ey + 8, 4, 4);
          if (enemy.hp < enemy.maxHp) {
            ctx.fillStyle = 'rgba(255,255,255,0.3)';
            ctx.fillRect(ex, ey - 6, enemy.w * (enemy.hp / enemy.maxHp), 3);
          }
        }
        if (enemy.elite || enemy.hp < enemy.maxHp) {
          ctx.save();
          ctx.fillStyle = 'rgba(5,8,18,.72)';
          ctx.fillRect(ex, ey - 7, enemy.w, 4);
          ctx.fillStyle = enemy.elite ? '#ffd66e' : '#ffffff';
          ctx.fillRect(ex, ey - 7, enemy.w * Math.max(0, enemy.hp / enemy.maxHp), 4);
          ctx.restore();
        }
      }

      drawBoss(t);

      // Projectiles
      for (const proj of projectiles) {
        const px = Math.round(proj.x - cameraX);
        ctx.save();
        ctx.fillStyle = proj.color; ctx.shadowColor = proj.color; ctx.shadowBlur = 6;
        if (proj.shape === 'note') {
          drawTinyNote(px + proj.w / 2, proj.y + proj.h / 2, 0.82);
        } else if (proj.shape === 'slash') {
          ctx.fillRect(px, proj.y, proj.w, proj.h);
          ctx.fillStyle = 'rgba(255,255,255,.72)';
          ctx.fillRect(px + 6, proj.y + 3, Math.max(10, proj.w * 0.42), 3);
        } else if (proj.shape === 'fan') {
          ctx.beginPath();
          ctx.moveTo(px, proj.y + proj.h / 2);
          ctx.lineTo(px + proj.w, proj.y);
          ctx.lineTo(px + proj.w, proj.y + proj.h);
          ctx.closePath();
          ctx.fill();
        } else if (proj.shape === 'paint') {
          ctx.beginPath();
          ctx.ellipse(px + proj.w / 2, proj.y + proj.h / 2, proj.w / 2, proj.h / 2, 0, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = '#fff';
          ctx.fillRect(px + 6, proj.y + 6, 5, 5);
        } else if (proj.shape === 'beam') {
          ctx.fillRect(px, proj.y, proj.w, proj.h);
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(px + 5, proj.y + 3, Math.max(8, proj.w - 14), Math.max(2, proj.h - 6));
        } else {
          ctx.fillRect(px, proj.y, proj.w, proj.h);
          ctx.fillStyle = '#fff';
          if (proj.w <= 48) ctx.fillRect(px + 4, proj.y + 3, Math.max(3, proj.w * 0.35), Math.max(3, proj.h * 0.3));
        }
        ctx.restore();
      }
      // Player
      drawPlayer(t);

      // Particles
      ctx.save();
      for (const p of particles) {
        ctx.globalAlpha = Math.max(0, p.life * 3);
        ctx.fillStyle = p.color;
        const sz = p.size * Math.max(0.3, p.life * 2);
        ctx.fillRect(Math.round(p.x - cameraX), Math.round(p.y), sz, sz);
      }
      ctx.restore();
    }

    function drawBoss(t: number) {
      if (!boss) return;
      if (!boss.alive && bossDefeatCutscene > 0) return;
      const bx = Math.round(boss.x - cameraX), by = Math.round(boss.y);
      if (bx + boss.w < -120 || bx > VW + 140) return;
      if (boss.beamWarn > 0) {
        ctx.save();
        const alpha = 0.18 + Math.sin(t * 36) * 0.08;
        ctx.fillStyle = `rgba(255,102,221,${alpha})`;
        ctx.fillRect(0, boss.beamY - 11, VW, 22);
        ctx.fillStyle = 'rgba(255,255,255,0.45)'; ctx.fillRect(0, boss.beamY - 1, VW, 2);
        ctx.restore();
      }
      ctx.save();
      ctx.fillStyle = 'rgba(0,0,0,0.22)'; ctx.beginPath(); ctx.ellipse(bx + boss.w / 2, by + boss.h + 6, boss.w * 0.48, 8, 0, 0, Math.PI * 2); ctx.fill();
      let img = bossImages.idle;
      if (!boss.alive) { const defeatOrder = [bossImages.defeat1, bossImages.defeat2, bossImages.fade1, bossImages.fade2, bossImages.fade3]; img = defeatOrder[Math.min(defeatOrder.length - 1, Math.floor(t * 8) % defeatOrder.length)]; }
      else if (boss.pattern === 'volley') img = bossImages.volley;
      else if (boss.pattern === 'rain' || boss.beamWarn > 0) img = bossImages.rain;
      else if (boss.pattern === 'wave') img = bossImages.wave;
      const drawW = boss.alive ? 154 : 170, drawH = 190, bob = boss.alive ? Math.sin(t * 3) * 4 : 0;
      ctx.imageSmoothingEnabled = false;
      if (img && img.complete && img.naturalWidth > 0) ctx.drawImage(img, bx + boss.w / 2 - drawW / 2, by + boss.h - drawH + bob, drawW, drawH);
      else { ctx.fillStyle = '#b78cff'; ctx.fillRect(bx, by, boss.w, boss.h); ctx.fillStyle = '#fff'; ctx.fillRect(bx + 26, by + 34, 12, 12); ctx.fillRect(bx + 58, by + 34, 12, 12); }
      ctx.restore();
      if (boss.alive) {
        ctx.save(); const barW = 360, barX = VW / 2 - barW / 2;
        ctx.fillStyle = 'rgba(5,8,18,0.78)'; ctx.fillRect(barX, 48, barW, 18);
        ctx.fillStyle = '#ff66dd'; ctx.fillRect(barX + 3, 51, (barW - 6) * (boss.hp / boss.maxHp), 12);
        ctx.strokeStyle = 'rgba(255,255,255,0.35)'; ctx.strokeRect(barX, 48, barW, 18);
        ctx.fillStyle = '#fff'; ctx.font = '900 12px Courier New, monospace'; ctx.textAlign = 'center'; ctx.fillText(`25 初音核心  第${boss.phase}阶段`, VW / 2, 43);
        ctx.restore();
      }
    }
    function drawPlayer(t: number) {
      const c = CHARS[selChar];
      const px = Math.round(player.x - cameraX);
      const py = Math.round(player.y);

      if (player.invuln > 0 && Math.floor(t * 16) % 2 === 0) return;

      const dir = player.facing;
      const isMafuyu = selChar === 1;
      let img = charImages[selChar];
      if (isMafuyu) {
        if (animState === 'attack') img = mfyImages.attack;
        else if (animState === 'run') img = mfyRunImages[animFrame % mfyRunImages.length] || mfyImages.idle;
        else if (animState === 'jump') img = mfyImages.jump;
        else if (animState === 'fall') img = mfyImages.fall;
        else img = mfyImages.idle;
      }
      const color = c.color;
      const W = player.w, H = player.h;

      // Sprite draw dimensions. Mafuyu uses full action-frame PNGs from /public/mfy.
      const spW = isMafuyu ? (animState === 'attack' ? 92 : animState === 'run' ? 82 : 76) : 50;
      const spH = isMafuyu ? (animState === 'attack' ? 92 : animState === 'run' ? 82 : 76) : 58;
      const spLift = isMafuyu ? 8 : 2;
      const legH_px = 12; // height of the leg region at bottom of PNG to overlay

      // --- Transforms ---
      let sx = 1, sy = 1, tilt = 0, bob = 0;

      switch (animState) {
        case 'idle':
          bob = Math.sin(t * 3) * 2;
          break;
        case 'run': {
          const phase = animFrame * Math.PI / 3;
          bob = Math.abs(Math.sin(phase)) * -3;
          tilt = Math.sin(phase) * 0.06 * dir;
          sx = 1 + Math.sin(phase) * 0.04;
          sy = 1 - Math.sin(phase) * 0.04;
          break;
        }
        case 'jump':
          sy = Math.min(1.12, 1 + Math.abs(player.vy) / 3000);
          sx = 1 / sy;
          tilt = -0.08 * dir;
          break;
        case 'fall':
          sx = Math.min(1.1, 1 + player.vy / 3000);
          sy = 1 / sx;
          tilt = 0.05 * dir;
          break;
        case 'attack':
          tilt = 0.1 * dir;
          bob = -2;
          sx = 1.06;
          sy = 0.94;
          break;
      }

      // --- Shadow ---
      ctx.fillStyle = 'rgba(0,0,0,0.18)';
      ctx.beginPath();
      ctx.ellipse(px + W / 2, py + H + 2, W * 0.55, 4, 0, 0, Math.PI * 2);
      ctx.fill();

      // --- Main character draw (PNG + animated legs) ---
      ctx.save();
      ctx.translate(px + W / 2, py + H + bob);
      if (dir < 0) ctx.scale(-sx, sy);
      else ctx.scale(sx, sy);
      if (tilt) ctx.rotate(tilt);

      ctx.imageSmoothingEnabled = false;

      // Draw the original PNG sprite
      if (img && img.complete && img.naturalWidth > 0) {
        ctx.drawImage(img, -spW / 2, -spH + spLift, spW, spH);
      } else {
        ctx.fillStyle = color;
        ctx.fillRect(-spW / 2, -spH + 2, spW, spH);
      }

      // --- Animated legs overlay ---
      // Cover the bottom leg region of the PNG with moving legs
      if (!isMafuyu) {
        const legDark = hexRgba(color, 0.55);
        const legLight = hexRgba(color, 0.75);
        const shoeColor = hexRgba('#000000', 0.35);
        const legW = 9, footY = 0; // footY=0 means at the transform origin (feet)

        switch (animState) {
          case 'idle': {
            const ib = Math.sin(t * 2.5) * 1.5;
            ctx.fillStyle = legDark;
            ctx.fillRect(-10, footY - legH_px + ib, legW, legH_px);
            ctx.fillRect(1, footY - legH_px + ib, legW, legH_px);
            ctx.fillStyle = shoeColor;
            ctx.fillRect(-11, footY - 3 + ib, legW + 2, 3);
            ctx.fillRect(0, footY - 3 + ib, legW + 2, 3);
            break;
          }
          case 'run': {
            const phase = animFrame * Math.PI / 3;
            const l1 = Math.sin(phase) * 10, l2 = Math.sin(phase + Math.PI) * 10;
            const b1 = Math.abs(Math.sin(phase)) * -4, b2 = Math.abs(Math.sin(phase + Math.PI)) * -4;
            ctx.fillStyle = legDark;
            ctx.fillRect(-10, footY - legH_px + b1, legW, legH_px + l1);
            ctx.fillRect(1, footY - legH_px + b2, legW, legH_px + l2);
            ctx.fillStyle = legLight;
            ctx.fillRect(-9, footY - legH_px + 2 + b1, legW - 2, 3);
            ctx.fillRect(2, footY - legH_px + 2 + b2, legW - 2, 3);
            ctx.fillStyle = shoeColor;
            ctx.fillRect(-11, footY - 3 + b1 + l1, legW + 3, 3);
            ctx.fillRect(0, footY - 3 + b2 + l2, legW + 3, 3);
            break;
          }
          case 'jump': {
            ctx.fillStyle = legDark;
            ctx.fillRect(-11, footY - legH_px + 4, legW, legH_px - 6);
            ctx.fillRect(2, footY - legH_px + 4, legW, legH_px - 6);
            ctx.fillStyle = shoeColor;
            ctx.fillRect(-12, footY - legH_px + legH_px - 4, legW + 2, 3);
            ctx.fillRect(1, footY - legH_px + legH_px - 4, legW + 2, 3);
            break;
          }
          case 'fall': {
            ctx.fillStyle = legDark;
            ctx.fillRect(-13, footY - legH_px - 2, legW, legH_px + 4);
            ctx.fillRect(4, footY - legH_px - 2, legW, legH_px + 4);
            ctx.fillStyle = shoeColor;
            ctx.fillRect(-14, footY + 1, legW + 2, 3);
            ctx.fillRect(3, footY + 1, legW + 2, 3);
            break;
          }
          case 'attack': {
            ctx.fillStyle = legDark;
            ctx.fillRect(-11, footY - legH_px + 3, legW, legH_px - 2);
            ctx.fillRect(3, footY - legH_px - 2, legW, legH_px + 5);
            ctx.fillStyle = shoeColor;
            ctx.fillRect(-12, footY - 1, legW + 2, 3);
            ctx.fillRect(2, footY + 1, legW + 3, 3);
            break;
          }
        }
      }

      ctx.restore();

      // === EFFECTS (world-space, outside character transform) ===

      // --- Idle: subtle glow pulse ---
      if (animState === 'idle') {
        const pulse = (Math.sin(t * 2) + 1) * 0.5;
        ctx.fillStyle = hexRgba(color, 0.06 * pulse);
        ctx.beginPath();
        ctx.ellipse(px + W / 2, py + H / 2 + bob, 24, 28, 0, 0, Math.PI * 2);
        ctx.fill();
      }

      // --- Run: dust particles ---
      if (animState === 'run') {
        if (Math.random() < 0.4) {
          particles.push({
            x: player.x + W / 2 - dir * 12,
            y: player.y + H - 2,
            vx: -dir * (20 + Math.random() * 30),
            vy: -(10 + Math.random() * 20),
            life: 0.3 + Math.random() * 0.1,
            color: 'rgba(200,200,200,0.4)',
            size: 2 + Math.random() * 2,
          });
        }
        // Speed lines
        if (Math.random() < 0.25) {
          ctx.fillStyle = hexRgba(color, 0.12);
          const lx = px + W / 2 - dir * (18 + Math.random() * 14);
          ctx.fillRect(lx, py + 6 + Math.random() * 28, 2, 8 + Math.random() * 6);
        }
      }

      // --- Jump: launch particles ---
      if (animState === 'jump' && player.vy < -400) {
        for (let i = 0; i < 2; i++) {
          particles.push({
            x: player.x + W / 2 + (Math.random() - 0.5) * 20,
            y: player.y + H,
            vx: (Math.random() - 0.5) * 60,
            vy: 30 + Math.random() * 40,
            life: 0.3,
            color: '#fff',
            size: 2 + Math.random() * 2,
          });
        }
      }

      // --- Fall: wind streaks ---
      if (animState === 'fall' && player.vy > 250) {
        ctx.save();
        for (let i = 0; i < 3; i++) {
          ctx.fillStyle = hexRgba('#ffffff', 0.08 + i * 0.02);
          ctx.fillRect(px + 4 + i * 10, py - 4 - i * 8, 2, 10 + i * 4);
        }
        ctx.restore();
      }

      // --- Attack: weapon glow + slash arc + afterimage ---
      if (animState === 'attack') {
        const atkProg = player.atkTimer / c.atkCd;

        // Weapon orb
        const orbX = px + W / 2 + dir * (22 + (1 - atkProg) * 10);
        const orbY = py + H / 2 - 4;
        ctx.save();
        ctx.fillStyle = hexRgba(color, 0.45 * atkProg);
        ctx.shadowColor = color;
        ctx.shadowBlur = 10;
        ctx.fillRect(orbX - 9, orbY - 9, 18, 18);
        ctx.fillStyle = '#fff';
        ctx.fillRect(orbX - 3, orbY - 3, 6, 6);
        ctx.restore();

        // Slash arc
        if (atkProg > 0.5) {
          ctx.save();
          ctx.globalAlpha = (atkProg - 0.5) * 2;
          ctx.strokeStyle = '#fff';
          ctx.lineWidth = 2;
          ctx.beginPath();
          const arcCX = px + W / 2 + dir * 26;
          ctx.arc(arcCX, py + H / 2, 16, dir > 0 ? -0.8 : Math.PI - 0.8, dir > 0 ? 0.8 : Math.PI + 0.8);
          ctx.stroke();
          ctx.restore();
        }

        // Afterimage
        ctx.save();
        ctx.globalAlpha = 0.12;
        ctx.imageSmoothingEnabled = false;
        if (img && img.complete && img.naturalWidth > 0) {
          ctx.drawImage(img, px + W / 2 - spW / 2 - dir * 10, py + H - spH + spLift + bob, spW, spH);
        }
        ctx.restore();
      }

      // --- Landing impact ---
      if (player.grounded && animState !== 'run' && animState !== 'attack' && player.vy === 0) {
        // Small dust puffs at feet on landing
      }
    }

    // --- Game Loop ---
    function loop(time: number) {
      const dt = Math.min(0.032, (time - lastTime) / 1000 || 0);
      lastTime = time;
      update(dt);
      render(time);
      raf = requestAnimationFrame(loop);
    }

    // --- UI Events ---
    document.querySelectorAll<HTMLButtonElement>('.stage-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        const nextStage = parseInt(btn.dataset.stage || '0');
        if (!isStageUnlocked(nextStage)) {
          showTitleHint('先通关前一幕，才能进入后续关卡。');
          updateStageLocks();
          return;
        }
        selStage = nextStage;
        updateStageLocks();
        setAccent(STAGES[selStage].accent);
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.char-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const nextChar = parseInt(btn.dataset.char || '0');
        if (!isCharUnlocked(nextChar)) {
          showTitleHint('这个角色还没有解锁，先用 Mafuyu 推进关卡。');
          updateCharacterLocks();
          return;
        }
        selChar = nextChar;
        updateCharacterLocks();
      });
    });

    document.getElementById('goBtn')!.addEventListener('click', () => {
      if (!isStageUnlocked(selStage)) { showTitleHint('先通关前一幕，才能进入后续关卡。'); refreshProgressUi(); return; }
      if (!isCharUnlocked(selChar)) { selChar = 1; refreshProgressUi(); }
      initGame(true);
    });
    document.getElementById('retryBtn')!.addEventListener('click', () => { if (pendingNextStage) { selStage++; activateStageButton(); setAccent(STAGES[selStage].accent); initGame(false); } else initGame(true); });
    document.getElementById('backBtn')!.addEventListener('click', returnToMenu);
    pauseBtn.addEventListener('click', () => setPaused(!paused));
    menuBtn.addEventListener('click', returnToMenu);
    resumeBtn.addEventListener('click', () => setPaused(false));
    pauseMenuBtn.addEventListener('click', returnToMenu);
    abilityChoices.addEventListener('click', e => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.ability-card');
      if (!btn) return;
      chooseAbility(parseInt(btn.dataset.ability || '0'));
    });

    // Easter egg: play "旅に帰る" in shuffle mode on SekaiPlayer to unlock super mode
    window.addEventListener('sekai-song-change', ((e: CustomEvent) => {
      if (running && !finished && e.detail.shuffle && e.detail.playing && e.detail.title === '旅に帰る') {
        unlockSuperMode();
      }
    }) as EventListener);

    document.addEventListener('astro:before-swap', () => cancelAnimationFrame(raf), { once: true });

    // Start render loop
    loadSave();
    refreshProgressUi();
    raf = requestAnimationFrame(loop);
  </script>
</BaseLayout>
