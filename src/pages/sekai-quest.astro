---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="SEKAI DASH | 搁浅 的小窝" description="PJSK 像素风动作闯关 — 选择角色，穿越 SEKAI！">
  <section class="dash-shell" id="dashShell">

    <!-- Title Screen -->
    <div class="title-screen" id="titleScreen">
      <div class="title-logo">
        <span class="title-sub">同人像素冒险</span>
        <h1 class="title-main">SEKAI DASH</h1>
        <div class="save-summary" id="saveSummary">读取本地记录中...</div>
      </div>

      <div class="stage-select" id="stageSelect">
        <h2 class="sel-label">关卡</h2>
        <div class="stage-pills" id="stagePills">
          <button class="stage-pill active" data-stage="0"><span class="pill-dot" style="background:#45d"></span>第一幕</button>
          <button class="stage-pill" data-stage="1"><span class="pill-dot" style="background:#e16"></span>第二幕</button>
          <button class="stage-pill" data-stage="2"><span class="pill-dot" style="background:#b7d"></span>第三幕</button>
          <button class="stage-pill" data-stage="3"><span class="pill-dot" style="background:#849"></span>最终Boss</button>
        </div>
      </div>

      <div class="char-select">
        <h2 class="sel-label">角色</h2>
        <div class="char-row" id="charRow">
          <button class="char-btn" data-char="0">
            <img src="/knd.png" alt="Kanade" /><span>Kanade</span><small>均衡</small>
          </button>
          <button class="char-btn active" data-char="1">
            <img src="/mfy/mfy1.png" alt="Mafuyu" /><span>Mafuyu</span><small>力量</small>
          </button>
          <button class="char-btn" data-char="2">
            <img src="/mzk.png" alt="Mizuki" /><span>Mizuki</span><small>速度</small>
          </button>
          <button class="char-btn" data-char="3">
            <img src="/ena.png" alt="Ena" /><span>Ena</span><small>灵活</small>
          </button>
          <button class="char-btn" data-char="4">
            <img src="/25miku.png" alt="Miku" /><span>Miku</span><small>远程</small>
          </button>
        </div>
      </div>

      <button class="go-btn" id="goBtn">
        <span class="go-text">开始</span>
        <span class="go-keys">← → ↑ J</span>
      </button>
    </div>

    <!-- Game Screen -->
    <div class="game-screen hidden" id="gameScreen">
      <canvas class="game-canvas" id="gameCanvas" width="960" height="540"></canvas>
      <div class="game-hud-top">
        <div class="hud-hp" id="hudHp"></div>
        <div class="hud-lvl"><span>等级</span><strong id="hudLevel">1</strong><em id="hudXp">0/100</em></div>
        <div class="hud-notes"><span>音符</span><strong id="hudNotes">0</strong></div>
        <div class="hud-score"><strong id="hudScore">0</strong></div>
      </div>
      <div class="hud-abilities" id="hudAbilities"></div>
      <div class="game-action-bar">
        <button class="game-action-btn" id="pauseBtn" type="button">暂停</button>
        <button class="game-action-btn" id="menuBtn" type="button">菜单</button>
      </div>
      <div class="game-msg" id="gameMsg"></div>
      <div class="pause-overlay hidden" id="pauseOverlay">
        <div class="pause-panel">
          <div class="pause-title">已暂停</div>
          <div class="pause-actions">
            <button class="retry-btn" id="resumeBtn" type="button">继续</button>
            <button class="back-btn" id="pauseMenuBtn" type="button">返回菜单</button>
          </div>
        </div>
      </div>
      <div class="ability-overlay hidden" id="abilityOverlay">
        <div class="ability-panel">
          <div class="ability-title">选择一项能力</div>
          <div class="ability-subtitle" id="abilitySubtitle">SEKAI 的回声正在重组</div>
          <div class="ability-choices" id="abilityChoices"></div>
        </div>
      </div>
      <div class="secret-toast hidden" id="secretToast">超能力已解锁</div>
      <div class="boss-finisher hidden" id="bossFinisher">
        <div class="boss-finisher-flash"></div>
        <img id="bossFinisherImg" src="/25miku/25miku_%E6%88%98%E8%B4%A51.png" alt="25 Miku boss defeated" />
        <div class="boss-finisher-line" id="bossFinisherLine">破碎的世界....还值得拯救吗...</div>
        <div class="boss-finisher-title">25 初音核心 崩坏</div>
      </div>
    </div>

    <!-- Results -->
    <div class="results-screen hidden" id="resultsScreen">
      <div class="results-card">
        <div class="res-title" id="resTitle">通关！</div>
        <div class="res-stats">
          <div class="res-row"><span>音符</span><strong id="resNotes">0</strong></div>
          <div class="res-row"><span>敌人</span><strong id="resEnemies">0</strong></div>
          <div class="res-row"><span>等级</span><strong id="resLevel">1</strong></div>
          <div class="res-row"><span>得分</span><strong id="resScore">0</strong></div>
        </div>
        <div class="res-actions">
          <button class="retry-btn" id="retryBtn">重试</button>
          <button class="back-btn" id="backBtn">返回</button>
        </div>
      </div>
    </div>

    <!-- Touch Controls -->
    <div class="touch-controls hidden" id="touchControls">
      <div class="touch-left">
        <button class="t-btn" data-dir="left">◀</button>
        <button class="t-btn" data-dir="right">▶</button>
      </div>
      <div class="touch-right">
        <button class="t-btn t-jump" data-dir="jump">↑</button>
        <button class="t-btn t-atk" data-dir="attack">♪</button>
      </div>
    </div>
  </section>

  <style>
    :root { --dash-accent: #45d; --dash-accent-rgb: 68,85,221; }

    .dash-shell { min-height: calc(100vh - 190px); color: var(--text); user-select: none; -webkit-user-select: none; }

    .hidden { display: none !important; }

    /* ===== Title ===== */
    .title-screen { display: grid; gap: 24px; padding: 20px 18px; max-width: 820px; margin: 0 auto; }
    .title-logo { text-align: center; }
    .title-sub { display: block; font-size: .76rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--dash-accent); margin-bottom: 4px; }
    .title-main { margin: 0; font-family: 'Courier New', monospace; font-size: clamp(2.6rem, 8vw, 5rem); font-weight: 900; line-height: .95; background: linear-gradient(135deg, #fff 30%, var(--dash-accent)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; filter: drop-shadow(0 0 28px rgba(var(--dash-accent-rgb), .3)); }
    .save-summary { margin-top: 10px; color: var(--muted); font-size: .82rem; font-weight: 700; }

    .sel-label { margin: 0 0 8px; font-size: .72rem; font-weight: 800; letter-spacing: .1em; color: var(--muted); }

    .stage-pills { display: flex; flex-wrap: wrap; gap: 8px; }
    .stage-pill { display: flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 12px; border: 1.5px solid var(--panel-border); background: var(--panel); color: var(--text-soft); font-family: inherit; font-size: .88rem; font-weight: 700; cursor: pointer; transition: all 160ms ease; }
    .stage-pill:hover { border-color: rgba(var(--dash-accent-rgb), .4); }
    .stage-pill.active { border-color: var(--dash-accent); background: rgba(var(--dash-accent-rgb), .08); color: var(--dash-accent); box-shadow: 0 0 18px rgba(var(--dash-accent-rgb), .12); }
    .stage-pill.locked { opacity: .45; filter: grayscale(.45); }
    .pill-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }

    .char-row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
    .char-btn { position: relative; display: grid; gap: 4px; justify-items: center; padding: 12px 6px; border-radius: 14px; border: 1.5px solid var(--panel-border); background: var(--panel); color: var(--text-soft); font-family: inherit; cursor: pointer; transition: all 160ms ease; overflow: hidden; }
    .char-btn:hover { border-color: rgba(var(--dash-accent-rgb), .4); }
    .char-btn.active { border-color: var(--dash-accent); background: rgba(var(--dash-accent-rgb), .07); color: var(--dash-accent); }
    .char-btn.locked { opacity: .5; filter: grayscale(.6); }
    .char-btn.locked::after { content: 'LOCK'; position: absolute; top: 6px; right: 6px; padding: 2px 5px; border-radius: 6px; background: rgba(6,8,18,.86); color: #ffd66e; font-family: 'Courier New', monospace; font-size: .56rem; font-weight: 900; }
    .char-btn img { width: 48px; height: 48px; image-rendering: pixelated; image-rendering: crisp-edges; object-fit: contain; }
    .char-btn span { font-size: .78rem; font-weight: 800; }
    .char-btn small { font-size: .62rem; color: var(--muted); }

    .go-btn { display: flex; flex-direction: column; align-items: center; gap: 3px; padding: 16px 44px; margin: 0 auto; border: none; border-radius: 16px; background: linear-gradient(135deg, var(--dash-accent), rgba(var(--dash-accent-rgb), .7)); color: #0a0e18; font-family: 'Courier New', monospace; font-size: 1.4rem; font-weight: 900; cursor: pointer; letter-spacing: .06em; box-shadow: 0 8px 28px rgba(var(--dash-accent-rgb), .3); transition: transform 140ms ease, box-shadow 140ms ease; }
    .go-btn:hover { transform: translateY(-3px); box-shadow: 0 12px 36px rgba(var(--dash-accent-rgb), .4); }
    .go-keys { font-size: .68rem; font-weight: 700; letter-spacing: .14em; opacity: .55; }

    /* ===== Game ===== */
    .game-screen { position: relative; height: calc(100vh - 140px); min-height: 460px; }
    .game-canvas { display: block; width: 100%; height: 100%; image-rendering: pixelated; image-rendering: crisp-edges; }
    .game-hud-top { position: absolute; top: 10px; left: 14px; right: 14px; display: flex; justify-content: space-between; pointer-events: none; z-index: 2; gap: 8px; }
    .game-hud-top > div { min-height: 34px; padding: 7px 12px; border-radius: 10px; background: rgba(6,8,18,.8); border: 1px solid rgba(255,255,255,.08); backdrop-filter: blur(6px); font-family: 'Courier New', monospace; box-shadow: 0 6px 20px rgba(0,0,0,.16); }
    .hud-hp { display: flex; align-items: center; gap: 5px; font-size: .92rem; letter-spacing: 0; color: #fff; }
    .hp-label { margin-right: 3px; color: #ff8aa8; font-size: .82rem; font-weight: 900; }
    .hp-count { min-width: 30px; color: #fff; font-size: .92rem; font-weight: 900; text-align: right; }
    .hp-hearts { display: flex; align-items: center; gap: 4px; }
    .hp-dot { width: 12px; height: 12px; display: inline-block; background: rgba(255,102,136,.18); border: 1px solid rgba(255,102,136,.45); clip-path: polygon(50% 100%, 6% 48%, 6% 22%, 24% 6%, 42% 18%, 50% 30%, 58% 18%, 76% 6%, 94% 22%, 94% 48%); }
    .hp-dot.filled { background: #ff6688; border-color: rgba(255,255,255,.52); box-shadow: 0 0 8px rgba(255,102,136,.42); }
    .hud-notes, .hud-lvl { display: flex; align-items: center; gap: 7px; }
    .hud-notes span { color: #ffd66e; font-size: .82rem; font-weight: 900; }
    .hud-lvl span { color: var(--dash-accent); font-size: .82rem; font-weight: 900; }
    .hud-lvl em { color: var(--muted); font-size: .72rem; font-style: normal; }
    .hud-notes strong, .hud-lvl strong, .hud-score strong { color: #fff; font-size: 1.1rem; font-weight: 900; }
    .hud-abilities { position: absolute; left: 14px; bottom: 14px; z-index: 2; display: flex; flex-wrap: wrap; gap: 6px; max-width: min(620px, calc(100% - 28px)); pointer-events: none; }
    .ability-chip { min-height: 28px; padding: 6px 9px; border-radius: 8px; background: rgba(6,8,18,.74); border: 1px solid rgba(255,255,255,.1); color: #fff; font-family: 'Courier New', monospace; font-size: .72rem; font-weight: 900; box-shadow: 0 6px 18px rgba(0,0,0,.14); }
    .ability-chip.super { color: #ffd66e; border-color: rgba(255,214,110,.5); box-shadow: 0 0 18px rgba(255,214,110,.18); }
    .game-msg { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-family: 'Courier New', monospace; font-size: 2rem; font-weight: 900; color: #fff; text-shadow: 0 0 20px rgba(0,0,0,.6); pointer-events: none; z-index: 3; opacity: 0; transition: opacity .3s ease; }
    .game-msg.show { opacity: 1; }
    .game-action-bar { position: absolute; top: 56px; right: 14px; z-index: 4; display: flex; gap: 8px; }
    .game-action-btn { min-width: 54px; padding: 7px 11px; border-radius: 10px; border: 1px solid rgba(255,255,255,.13); background: rgba(6,8,18,.78); color: #fff; font-family: inherit; font-size: .78rem; font-weight: 800; cursor: pointer; backdrop-filter: blur(6px); }
    .game-action-btn:hover { border-color: rgba(var(--dash-accent-rgb), .55); color: var(--dash-accent); }
    .pause-overlay { position: absolute; inset: 0; z-index: 9; display: grid; place-items: center; background: rgba(5,8,18,.72); backdrop-filter: blur(8px); }
    .pause-panel { width: min(320px, calc(100vw - 42px)); padding: 24px; border-radius: 18px; border: 1.5px solid var(--panel-border); background: rgba(10,12,26,.92); box-shadow: 0 20px 60px rgba(0,0,0,.28); }
    .pause-title { margin-bottom: 16px; text-align: center; font-family: 'Courier New', monospace; font-size: 1.5rem; font-weight: 900; color: var(--dash-accent); }
    .pause-actions { display: flex; gap: 10px; }
    .ability-overlay { position: absolute; inset: 0; z-index: 10; display: grid; place-items: center; padding: 18px; background: radial-gradient(circle at 50% 35%, rgba(var(--dash-accent-rgb), .34), transparent 36%), linear-gradient(180deg, rgba(4,6,16,.92), rgba(7,9,24,.86)); backdrop-filter: blur(12px); overflow: hidden; }
    .ability-overlay::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px); background-size: 36px 36px; mask-image: radial-gradient(circle at center, black, transparent 76%); pointer-events: none; }
    .ability-panel { position: relative; width: min(760px, calc(100vw - 28px)); padding: 24px; border-radius: 18px; border: 1.5px solid rgba(var(--dash-accent-rgb), .46); background: linear-gradient(180deg, rgba(16,18,36,.94), rgba(8,10,22,.94)); box-shadow: 0 22px 70px rgba(0,0,0,.38), inset 0 1px 0 rgba(255,255,255,.08); overflow: hidden; }
    .ability-panel::before { content: 'LEVEL UP'; position: absolute; top: 14px; left: 18px; color: rgba(255,255,255,.12); font-family: 'Courier New', monospace; font-size: .72rem; font-weight: 900; letter-spacing: .22em; }
    .ability-title { font-family: 'Courier New', monospace; font-size: clamp(1.45rem, 4vw, 2.25rem); font-weight: 900; color: #fff; text-align: center; text-shadow: 0 0 20px rgba(var(--dash-accent-rgb), .55); }
    .ability-subtitle { margin: 6px 0 20px; color: var(--muted); text-align: center; font-size: .88rem; font-weight: 700; }
    .ability-choices { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
    .ability-card { --rarity: #88ddff; position: relative; min-height: 184px; padding: 14px; border-radius: 12px; border: 1.5px solid color-mix(in srgb, var(--rarity), transparent 42%); background: linear-gradient(180deg, color-mix(in srgb, var(--rarity), transparent 86%), rgba(255,255,255,.025)); color: #fff; font-family: inherit; text-align: left; cursor: pointer; overflow: hidden; transition: transform 140ms ease, border-color 140ms ease, box-shadow 140ms ease; }
    .ability-card[data-rarity="RARE"] { --rarity: #ff99cc; }
    .ability-card[data-rarity="EPIC"] { --rarity: #ffd66e; }
    .ability-card::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 22% 18%, color-mix(in srgb, var(--rarity), transparent 54%), transparent 42%); opacity: .95; pointer-events: none; }
    .ability-card::after { content: attr(data-index); position: absolute; right: 12px; bottom: 8px; color: rgba(255,255,255,.08); font-family: 'Courier New', monospace; font-size: 3rem; font-weight: 900; line-height: 1; }
    .ability-card:hover { transform: translateY(-4px); border-color: var(--rarity); box-shadow: 0 14px 38px color-mix(in srgb, var(--rarity), transparent 78%); }
    .ability-icon, .ability-card strong, .ability-card span, .ability-card em { position: relative; z-index: 1; display: block; }
    .ability-icon { width: 42px; height: 42px; margin-bottom: 12px; border-radius: 10px; display: grid; place-items: center; background: color-mix(in srgb, var(--rarity), transparent 78%); border: 1px solid color-mix(in srgb, var(--rarity), transparent 32%); color: #fff; font-family: 'Courier New', monospace; font-size: 1.1rem; font-weight: 900; box-shadow: 0 0 18px color-mix(in srgb, var(--rarity), transparent 78%); }
    .ability-card strong { margin-bottom: 7px; font-size: 1.02rem; font-weight: 900; }
    .ability-card span { color: var(--text-soft); font-size: .8rem; line-height: 1.55; }
    .ability-card em { margin-top: 13px; color: var(--rarity); font-family: 'Courier New', monospace; font-size: .68rem; font-style: normal; font-weight: 900; letter-spacing: .08em; }
    .secret-toast { position: absolute; left: 50%; top: 18%; z-index: 8; transform: translate(-50%, -14px) scale(.96); padding: 13px 22px; border-radius: 14px; background: rgba(10,12,26,.92); border: 1.5px solid rgba(255,214,110,.72); color: #ffd66e; font-family: 'Courier New', monospace; font-size: .95rem; font-weight: 900; letter-spacing: .04em; box-shadow: 0 0 28px rgba(255,214,110,.25); opacity: 0; pointer-events: none; transition: opacity 180ms ease, transform 180ms ease; }
    .secret-toast.show { opacity: 1; transform: translate(-50%, 0) scale(1); }
    .boss-finisher { position: absolute; inset: 0; z-index: 7; display: grid; place-items: center; overflow: hidden; background: radial-gradient(circle at 50% 48%, rgba(153,102,204,.32), rgba(5,5,14,.94) 64%); pointer-events: none; animation: finisherFade 3.8s ease both; }
    .boss-finisher::before, .boss-finisher::after { content: ''; position: absolute; inset: -20%; background: repeating-linear-gradient(115deg, transparent 0 26px, rgba(255,255,255,.08) 27px 29px, transparent 30px 54px); transform: translateX(-20%); animation: finisherStreak 3.8s ease-out both; }
    .boss-finisher::after { background: repeating-linear-gradient(65deg, transparent 0 34px, rgba(255,102,221,.11) 35px 37px, transparent 38px 68px); animation-direction: reverse; }
    .boss-finisher-flash { position: absolute; inset: 0; background: rgba(255,255,255,.65); animation: finisherFlash 3.8s ease both; }
    .boss-finisher img { position: relative; width: min(58vw, 460px); max-height: 78vh; object-fit: contain; image-rendering: pixelated; filter: drop-shadow(0 0 34px rgba(255,102,221,.65)); animation: finisherSprite 3.8s cubic-bezier(.2,.78,.12,1) both; }
    .boss-finisher-title { position: absolute; bottom: 16%; left: 50%; transform: translateX(-50%); font-family: 'Courier New', monospace; font-size: clamp(1.2rem, 4vw, 2.4rem); font-weight: 900; color: #fff; text-shadow: 0 0 18px rgba(255,102,221,.9); white-space: nowrap; }
    .boss-finisher-line { position: absolute; left: 50%; bottom: 9%; transform: translateX(-50%); width: min(86vw, 760px); padding: 10px 14px; border-left: 3px solid rgba(255,102,221,.72); background: rgba(4,6,16,.54); color: #fff; font-size: clamp(.92rem, 2.5vw, 1.25rem); font-weight: 800; text-align: center; text-shadow: 0 0 14px rgba(255,102,221,.8); opacity: 0; animation: finisherLine 3.8s ease both; }
    @keyframes finisherFlash { 0% { opacity: 1; } 9%, 72% { opacity: 0; } 86% { opacity: .38; } 100% { opacity: .12; } }
    @keyframes finisherFade { 0% { opacity: 0; } 8%, 86% { opacity: 1; } 100% { opacity: 0; } }
    @keyframes finisherSprite { 0% { transform: scale(.62) translateY(32px); opacity: 0; } 12% { transform: scale(1.18) translateY(-10px); opacity: 1; } 18%, 66% { transform: scale(1.05) translateY(0); opacity: 1; } 82% { transform: scale(1.28) translateY(-16px); opacity: .92; } 100% { transform: scale(1.55) translateY(-36px); opacity: 0; } }
    @keyframes finisherStreak { 0% { opacity: 0; transform: translateX(-28%); } 14%, 70% { opacity: 1; } 100% { opacity: 0; transform: translateX(24%); } }
    @keyframes finisherLine { 0%, 20% { opacity: 0; transform: translate(-50%, 10px); } 32%, 78% { opacity: 1; transform: translate(-50%, 0); } 100% { opacity: 0; transform: translate(-50%, -8px); } }

    /* ===== Results ===== */
    .results-screen { position: fixed; inset: 0; z-index: 90; display: grid; place-content: center; background: rgba(5,8,18,.9); backdrop-filter: blur(14px); padding: 20px; }
    .results-card { display: grid; gap: 18px; max-width: 380px; width: 100%; padding: 32px 28px; border-radius: 22px; background: var(--panel-gradient); border: 1.5px solid var(--panel-border); }
    .res-title { text-align: center; font-family: 'Courier New', monospace; font-size: 2rem; font-weight: 900; color: var(--dash-accent); }
    .res-stats { display: grid; gap: 8px; }
    .res-row { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid rgba(255,255,255,.05); }
    .res-row span { color: var(--muted); } .res-row strong { color: #fff; font-family: 'Courier New', monospace; }
    .res-actions { display: flex; gap: 10px; }
    .retry-btn, .back-btn { flex: 1; padding: 12px; border-radius: 12px; font-family: 'Courier New', monospace; font-size: .95rem; font-weight: 800; cursor: pointer; transition: all 140ms ease; }
    .retry-btn { border: none; background: var(--dash-accent); color: #0a0e18; }
    .retry-btn:hover { transform: translateY(-2px); }
    .back-btn { border: 1.5px solid var(--panel-border); background: var(--panel); color: var(--text-soft); }

    /* ===== Touch ===== */
    .touch-controls { position: fixed; bottom: 10px; left: 0; right: 0; z-index: 50; display: flex; justify-content: space-between; padding: 0 14px; pointer-events: none; }
    .touch-left, .touch-right { display: flex; gap: 8px; pointer-events: auto; }
    .t-btn { width: 60px; height: 60px; border-radius: 50%; border: 2px solid rgba(var(--dash-accent-rgb), .3); background: rgba(8,12,24,.8); color: rgba(var(--dash-accent-rgb), .8); font-size: 1.4rem; font-weight: 900; cursor: pointer; touch-action: manipulation; transition: all 80ms ease; }
    .t-btn:active { background: rgba(var(--dash-accent-rgb), .15); border-color: var(--dash-accent); transform: scale(.92); }
    .t-jump { width: 68px; height: 68px; }
    .t-atk { width: 68px; height: 68px; color: #ffd66e; }

    @media (max-width: 720px) {
      .char-row { grid-template-columns: repeat(5, 1fr); gap: 6px; }
      .char-btn { padding: 8px 3px; } .char-btn img { width: 36px; height: 36px; } .char-btn small { display: none; }
