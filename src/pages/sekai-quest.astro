---
import BaseLayout from '../layouts/BaseLayout.astro';
const VERSION = 'v0.0.1';
---

<BaseLayout title="SEKAI DASH | 搁浅 的小窝" description="PJSK 像素风动作闯关 — 选择角色，穿越 SEKAI！">
  <section class="dash-shell" id="dashShell">

    <!-- Title Screen -->
    <div class="title-screen" id="titleScreen">
      <div class="title-logo">
        <span class="title-sub">同人像素冒险</span>
        <h1 class="title-main">SEKAI DASH</h1>
        <div class="save-summary" id="saveSummary">读取本地记录中...</div>
        <div class="version-label">{VERSION}</div>
      </div>

      <div class="stage-select" id="stageSelect">
        <h2 class="sel-label">关卡</h2>
        <div class="stage-pills" id="stagePills">
          <button class="stage-pill active" data-stage="0"><span class="pill-dot" style="background:#45d"></span>第一幕</button>
          <button class="stage-pill" data-stage="1"><span class="pill-dot" style="background:#e16"></span>第二幕</button>
          <button class="stage-pill" data-stage="2"><span class="pill-dot" style="background:#b7d"></span>第三幕</button>
          <button class="stage-pill" data-stage="3"><span class="pill-dot" style="background:#849"></span>最终Boss</button>
          <button class="stage-pill" data-stage="4"><span class="pill-dot" style="background:#d5a"></span>第四幕</button>
          <button class="stage-pill" data-stage="5"><span class="pill-dot" style="background:#b6e"></span>第五幕</button>
        </div>
      </div>

      <div class="char-select">
        <h2 class="sel-label">角色</h2>
        <div class="char-row" id="charRow">
          <button class="char-btn" data-char="0">
            <img src="/knd.png" alt="Kanade" /><span>Kanade</span><small>均衡</small>
          </button>
          <button class="char-btn active" data-char="1">
            <img src="/mfy/mfy1.png" alt="Mafuyu" /><span>Mafuyu</span><small>力量</small>
          </button>
          <button class="char-btn" data-char="2">
            <img src="/mzk.png" alt="Mizuki" /><span>Mizuki</span><small>速度</small>
          </button>
          <button class="char-btn" data-char="3">
            <img src="/ena.png" alt="Ena" /><span>Ena</span><small>灵活</small>
          </button>
          <button class="char-btn" data-char="4">
            <img src="/25miku.png" alt="Miku" /><span>Miku</span><small>远程</small>
          </button>
        </div>
      </div>

      <div class="title-actions">
        <button class="go-btn" id="goBtn">
          <span class="go-text">开始</span>
          <span class="go-keys">← → ↑ J</span>
        </button>
      </div>
    </div>

    <!-- Game Screen -->
    <div class="game-screen hidden" id="gameScreen">
      <canvas class="game-canvas" id="gameCanvas" width="960" height="540"></canvas>
      <div class="game-hud-top">
        <div class="hud-hp" id="hudHp"></div>
        <div class="hud-lvl"><span>等级</span><strong id="hudLevel">1</strong><em id="hudXp">0/100</em><span class="xp-track"><span class="xp-fill" id="xpFill"></span></span></div>
        <div class="hud-notes"><span>音符</span><strong id="hudNotes">0</strong></div>
        <div class="hud-score"><strong id="hudScore">0</strong></div>
      </div>
      <div class="hud-abilities" id="hudAbilities"></div>
      <div class="game-action-bar">
        <button class="game-action-btn" id="pauseBtn" type="button">暂停</button>
        <button class="game-action-btn fs-btn" id="gameFullscreenBtn" title="全屏">⛶</button>
      </div>
      <div class="game-msg" id="gameMsg"></div>
      <div class="dialogue-box hidden" id="dialogueBox">
        <div class="dialogue-name" id="dialogueName"></div>
        <div class="dialogue-text" id="dialogueText"></div>
        <div class="dialogue-hint">点击继续</div>
      </div>
      <div class="pause-overlay hidden" id="pauseOverlay">
        <div class="pause-panel">
          <div class="pause-title">已暂停</div>
          <div class="pause-actions">
            <button class="resume-btn" id="resumeBtn" type="button">继续游戏</button>
            <button class="menu-btn" id="pauseMenuBtn" type="button">返回菜单</button>
          </div>
        </div>
      </div>
      <div class="ability-overlay hidden" id="abilityOverlay">
        <div class="ability-panel">
          <div class="ability-title">选择一项能力</div>
          <div class="ability-subtitle" id="abilitySubtitle">SEKAI 的回声正在重组</div>
          <div class="ability-choices" id="abilityChoices"></div>
        </div>
      </div>
      <div class="secret-toast hidden" id="secretToast">超能力已解锁</div>
      <div class="boss-finisher hidden" id="bossFinisher">
        <div class="boss-finisher-flash"></div>
        <img id="bossFinisherImg" src="/25miku/25miku_%E6%88%98%E8%B4%A51.png" alt="25 Miku boss defeated" />
        <div class="boss-finisher-line" id="bossFinisherLine">破碎的世界....还值得拯救吗...</div>
        <div class="boss-finisher-title">25 初音核心 崩坏</div>
      </div>
      <!-- Touch Controls (inside game-screen for fullscreen support) -->
      <div class="touch-controls hidden" id="touchControls">
        <div class="touch-left">
          <button class="t-btn" data-dir="left">◀</button>
          <button class="t-btn" data-dir="right">▶</button>
        </div>
        <div class="touch-right">
          <button class="t-btn t-jump" data-dir="jump">↑</button>
          <button class="t-btn t-atk" data-dir="attack">♪</button>
        </div>
      </div>
    </div>

    <!-- Results -->
    <div class="results-screen hidden" id="resultsScreen">
      <div class="results-card">
        <div class="res-title" id="resTitle">通关！</div>
        <div class="res-stats">
          <div class="res-row"><span>音符</span><strong id="resNotes">0</strong></div>
          <div class="res-row"><span>敌人</span><strong id="resEnemies">0</strong></div>
          <div class="res-row"><span>等级</span><strong id="resLevel">1</strong></div>
          <div class="res-row"><span>得分</span><strong id="resScore">0</strong></div>
        </div>
        <div class="res-actions">
          <button class="retry-btn" id="retryBtn">重试</button>
          <button class="back-btn" id="backBtn">返回</button>
        </div>
      </div>
    </div>
  </section>

  <style is:global>
    :root { --dash-accent: #45d; --dash-accent-rgb: 68,85,221; }

    .dash-shell { min-height: calc(100vh - 190px); color: var(--text); user-select: none; -webkit-user-select: none; }

    .hidden { display: none !important; }

    /* ===== Fullscreen ===== */
    .fs-btn { font-size: 1rem; }
    .game-screen:fullscreen { height: 100vh; min-height: 100vh; width: 100vw; background: #000; }
    .game-screen:fullscreen .game-canvas { height: 100vh; width: 100vw; }
    .game-screen:fullscreen .game-hud-top { top: 12px; left: 12px; right: 12px; }
    .game-screen:fullscreen .touch-controls { bottom: 12px; padding: 0 18px; }
    .game-screen:fullscreen .touch-left, .game-screen:fullscreen .touch-right { gap: 16px; }
    .game-screen:fullscreen .t-btn { width: 66px; height: 66px; font-size: 1.6rem; border-width: 2.5px; box-shadow: 0 4px 16px rgba(0,0,0,.3); }
    .game-screen:fullscreen .t-jump, .game-screen:fullscreen .t-atk { width: 78px; height: 78px; font-size: 1.9rem; }
    .game-screen:fullscreen .t-btn:active { transform: scale(.85); }
    @media (orientation: landscape) {
      .game-screen:fullscreen .touch-controls { bottom: 8px; padding: 0 14px; }
      .game-screen:fullscreen .touch-left, .game-screen:fullscreen .touch-right { gap: 12px; }
      .game-screen:fullscreen .t-btn { width: 60px; height: 60px; font-size: 1.4rem; }
      .game-screen:fullscreen .t-jump, .game-screen:fullscreen .t-atk { width: 70px; height: 70px; font-size: 1.6rem; }
    }

    /* ===== Title ===== */
    .title-screen { display: grid; gap: 22px; padding: 28px 20px; max-width: 860px; margin: 0 auto; position: relative; }
    .title-screen::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 60% 50% at 50% 20%, rgba(var(--dash-accent-rgb), .06), transparent); pointer-events: none; }
    .title-logo { text-align: center; position: relative; padding-top: 4px; }
    .title-logo::after { content: ''; display: block; width: 60px; height: 2px; margin: 10px auto 0; border-radius: 2px; background: linear-gradient(90deg, transparent, rgba(var(--dash-accent-rgb), .25), transparent); }
    .title-sub { display: block; font-size: .7rem; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; color: var(--dash-accent); margin-bottom: 3px; opacity: .75; }
    .title-main { margin: 0; font-family: 'Courier New', monospace; font-size: clamp(2.4rem, 7vw, 4.6rem); font-weight: 900; line-height: 1; background: linear-gradient(135deg, #fff 24%, var(--dash-accent) 68%, #aaf 92%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; filter: drop-shadow(0 0 32px rgba(var(--dash-accent-rgb), .3)); letter-spacing: -.02em; }
    .save-summary { margin-top: 10px; color: var(--muted); font-size: .78rem; font-weight: 700; letter-spacing: .02em; }
    .version-label { margin-top: 4px; color: rgba(255,255,255,.18); font-size: .6rem; font-weight: 700; letter-spacing: .06em; font-family: 'Courier New', monospace; }

    .sel-label { margin: 0 0 7px; font-size: .68rem; font-weight: 800; letter-spacing: .14em; color: var(--muted); text-transform: uppercase; }

    .stage-pills { display: flex; flex-wrap: wrap; gap: 6px; }
    .stage-pill { display: flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 10px; border: 1.5px solid var(--panel-border); background: var(--panel); color: var(--text-soft); font-family: inherit; font-size: .82rem; font-weight: 700; cursor: pointer; transition: all 140ms ease; box-shadow: 0 2px 8px rgba(0,0,0,.08); }
    .stage-pill:hover { border-color: rgba(var(--dash-accent-rgb), .35); }
    .stage-pill.active { border-color: var(--dash-accent); background: rgba(var(--dash-accent-rgb), .08); color: var(--dash-accent); box-shadow: 0 0 16px rgba(var(--dash-accent-rgb), .1); }
    .stage-pill.locked { opacity: .4; filter: grayscale(.4); }
    .pill-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; box-shadow: 0 0 6px currentColor; }

    .char-row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
    .char-btn { position: relative; display: grid; gap: 3px; justify-items: center; padding: 11px 4px 9px; border-radius: 12px; border: 1.5px solid var(--panel-border); background: linear-gradient(180deg, var(--panel) 0%, rgba(6,8,18,.2) 100%); color: var(--text-soft); font-family: inherit; cursor: pointer; transition: all 160ms ease; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.06); }
    .char-btn:hover { border-color: rgba(var(--dash-accent-rgb), .3); transform: translateY(-2px); box-shadow: 0 4px 14px rgba(0,0,0,.1); }
    .char-btn.active { border-color: var(--dash-accent); background: linear-gradient(180deg, rgba(var(--dash-accent-rgb), .12) 0%, rgba(var(--dash-accent-rgb), .04) 100%); color: var(--dash-accent); box-shadow: 0 0 20px rgba(var(--dash-accent-rgb), .12); }
    .char-btn.locked { opacity: .45; filter: grayscale(.55); }
    .char-btn.locked::after { content: 'LOCK'; position: absolute; top: 4px; right: 4px; padding: 1px 4px; border-radius: 4px; background: rgba(6,8,18,.86); color: #ffd66e; font-family: 'Courier New', monospace; font-size: .5rem; font-weight: 900; line-height: 1.4; }
    .char-btn img { width: 44px; height: 44px; image-rendering: pixelated; image-rendering: crisp-edges; object-fit: contain; border-radius: 6px; transition: transform 160ms ease; }
    .char-btn:hover img { transform: scale(1.08); }
    .char-btn span { font-size: .74rem; font-weight: 800; }
    .char-btn small { font-size: .58rem; color: var(--muted); }

    .title-actions { display: flex; align-items: center; justify-content: center; gap: 14px; margin-top: 2px; }
    .go-btn { display: flex; flex-direction: column; align-items: center; gap: 3px; padding: 16px 48px; border: none; border-radius: 16px; background: linear-gradient(135deg, var(--dash-accent), rgba(var(--dash-accent-rgb), .55)); color: #0a0e18; font-family: 'Courier New', monospace; font-size: 1.4rem; font-weight: 900; cursor: pointer; letter-spacing: .06em; box-shadow: 0 6px 28px rgba(var(--dash-accent-rgb), .28); transition: transform 140ms ease, box-shadow 140ms ease; }
    .go-btn:hover { transform: translateY(-3px); box-shadow: 0 12px 36px rgba(var(--dash-accent-rgb), .38); }
    .go-btn:active { transform: translateY(0); box-shadow: 0 4px 16px rgba(var(--dash-accent-rgb), .2); }
    .go-keys { font-size: .64rem; font-weight: 700; letter-spacing: .16em; opacity: .45; }

    /* ===== Game ===== */
    .game-screen { position: relative; height: calc(100vh - 140px); min-height: 420px; }
    @media (max-width: 600px) { .game-screen:not(:fullscreen) { height: calc(100vh - 100px); min-height: 340px; } }
    .game-canvas { display: block; width: 100%; height: 100%; image-rendering: pixelated; image-rendering: crisp-edges; }
    .game-hud-top { position: absolute; top: 8px; left: 8px; right: 8px; display: flex; justify-content: space-between; pointer-events: none; z-index: 2; gap: 6px; flex-wrap: wrap; }
    .game-hud-top > div { min-height: 30px; padding: 5px 10px; border-radius: 8px; background: rgba(4,6,14,.78); border: 1px solid rgba(255,255,255,.07); backdrop-filter: blur(4px); font-family: 'Courier New', monospace; box-shadow: 0 4px 14px rgba(0,0,0,.14); }
    .hud-hp { display: flex; align-items: center; gap: 4px; font-size: .85rem; color: #fff; }
    .hp-label { color: #ff8aa8; font-size: .75rem; font-weight: 900; }
    .hp-count { min-width: 26px; color: #fff; font-size: .85rem; font-weight: 900; text-align: right; }
    .hp-hearts { display: flex; align-items: center; gap: 3px; }
    .hp-dot { width: 10px; height: 10px; display: inline-block; background: rgba(255,102,136,.15); border: 1px solid rgba(255,102,136,.38); clip-path: polygon(50% 100%, 6% 48%, 6% 22%, 24% 6%, 42% 18%, 50% 30%, 58% 18%, 76% 6%, 94% 22%, 94% 48%); transition: background .2s, box-shadow .2s; }
    .hp-dot.filled { background: #ff6688; border-color: rgba(255,255,255,.45); box-shadow: 0 0 6px rgba(255,102,136,.35); }
    .hud-notes, .hud-lvl { display: flex; align-items: center; gap: 5px; }
    .hud-notes span { color: #ffd66e; font-size: .75rem; font-weight: 900; }
    .hud-lvl span { color: var(--dash-accent); font-size: .75rem; font-weight: 900; }
    .hud-lvl em { color: var(--muted); font-size: .68rem; font-style: normal; }
    .hud-notes strong, .hud-lvl strong, .hud-score strong { color: #fff; font-size: 1rem; font-weight: 900; }
    .xp-track { display: inline-flex; width: 48px; height: 5px; border-radius: 3px; background: rgba(255,255,255,.06); overflow: hidden; vertical-align: middle; margin-left: 4px; }
    .xp-fill { height: 100%; width: 0%; border-radius: 3px; background: linear-gradient(90deg, var(--dash-accent), #77aaff); transition: width .2s ease; }
    .hud-abilities { position: absolute; left: 8px; bottom: 72px; z-index: 2; display: flex; flex-wrap: wrap; gap: 4px; max-width: min(560px, calc(100% - 16px)); pointer-events: none; }
    .ability-chip { min-height: 24px; padding: 4px 8px; border-radius: 6px; background: rgba(4,6,14,.7); border: 1px solid rgba(255,255,255,.08); color: #ddd; font-family: 'Courier New', monospace; font-size: .66rem; font-weight: 800; box-shadow: 0 4px 12px rgba(0,0,0,.1); transition: border-color .3s, box-shadow .3s; }
    .ability-chip.super { color: #ffd66e; border-color: rgba(255,214,110,.45); box-shadow: 0 0 14px rgba(255,214,110,.14); }
    .ability-chip.rare { border-color: rgba(221,85,136,.42); box-shadow: 0 0 10px rgba(221,85,136,.1); }
    .ability-chip.epic { border-color: rgba(238,170,51,.45); box-shadow: 0 0 14px rgba(238,170,51,.12); }
    .game-msg { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-family: 'Courier New', monospace; font-size: 1.8rem; font-weight: 900; color: #fff; text-shadow: 0 0 30px rgba(0,0,0,.8), 0 0 50px rgba(var(--dash-accent-rgb), .25); pointer-events: none; z-index: 3; opacity: 0; transition: opacity .2s ease, transform .25s cubic-bezier(.16,.84,.44,1); }
    .game-msg.show { opacity: 1; transform: translate(-50%, -50%) scale(1.04); }
    .dialogue-box { position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%) translateY(0); width: min(800px, calc(100% - 24px)); background: rgba(4,6,16,.9); border: 1.5px solid var(--accent, #4455dd); border-radius: 10px; padding: 12px 16px 8px; z-index: 8; cursor: pointer; box-shadow: 0 0 20px rgba(0,0,0,.45), inset 0 0 30px rgba(68,85,221,.05); transition: transform .3s cubic-bezier(.16,.84,.44,1), border-color .4s; }
    .dialogue-box.hidden { display: none; }
    .dialogue-box.enter { animation: dialogueIn .3s ease both; }
    @keyframes dialogueIn { from { opacity: 0; transform: translateX(-50%) translateY(16px); } to { opacity: 1; transform: translateX(-50%) translateY(0); } }
    .dialogue-name { font-family: 'Courier New', monospace; font-size: .82rem; font-weight: 900; margin-bottom: 4px; letter-spacing: .04em; }
    .dialogue-text { font-family: 'Noto Sans SC', 'Courier New', sans-serif; font-size: .92rem; color: #dde; line-height: 1.55; min-height: 2.2em; }
    .dialogue-hint { text-align: right; font-family: 'Courier New', monospace; font-size: .6rem; color: rgba(255,255,255,.3); margin-top: 2px; }
    .game-action-bar { position: absolute; top: 50px; right: 8px; z-index: 4; display: flex; gap: 6px; }
    .game-action-btn { min-width: 48px; padding: 6px 10px; border-radius: 8px; border: 1px solid rgba(255,255,255,.1); background: rgba(4,6,14,.74); color: #ccc; font-family: inherit; font-size: .72rem; font-weight: 800; cursor: pointer; backdrop-filter: blur(4px); transition: all 120ms ease; }
    .game-action-btn:hover { border-color: rgba(var(--dash-accent-rgb), .5); color: var(--dash-accent); }
    .pause-overlay { position: absolute; inset: 0; z-index: 9; display: grid; place-items: center; background: rgba(4,6,14,.68); backdrop-filter: blur(6px); animation: fadeIn .2s ease; }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    .pause-panel { width: min(280px, calc(100vw - 36px)); padding: 28px 24px 22px; border-radius: 18px; border: 1.5px solid rgba(var(--dash-accent-rgb), .2); background: linear-gradient(180deg, rgba(10,12,28,.96), rgba(6,8,18,.96)); box-shadow: 0 16px 48px rgba(0,0,0,.3), 0 0 40px rgba(var(--dash-accent-rgb), .04); text-align: center; animation: panelIn .3s ease both; }
    .pause-title { margin-bottom: 18px; font-family: 'Courier New', monospace; font-size: 1.4rem; font-weight: 900; color: var(--dash-accent); text-shadow: 0 0 20px rgba(var(--dash-accent-rgb), .3); letter-spacing: .04em; }
    .pause-actions { display: flex; gap: 10px; }
    .resume-btn, .menu-btn { flex: 1; padding: 12px; border-radius: 12px; font-family: 'Courier New', monospace; font-size: .9rem; font-weight: 900; cursor: pointer; transition: all 140ms ease; }
    .resume-btn { border: none; background: linear-gradient(135deg, var(--dash-accent), rgba(var(--dash-accent-rgb), .55)); color: #0a0e18; box-shadow: 0 4px 20px rgba(var(--dash-accent-rgb), .25); }
    .resume-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(var(--dash-accent-rgb), .34); }
    .menu-btn { border: 1.5px solid var(--panel-border); background: rgba(6,8,18,.6); color: var(--text-soft); }
    .menu-btn:hover { border-color: rgba(var(--dash-accent-rgb), .4); color: var(--dash-accent); transform: translateY(-1px); }
    .ability-overlay { position: absolute; inset: 0; z-index: 10; display: grid; place-items: center; padding: 14px; background: radial-gradient(circle at 50% 35%, rgba(var(--dash-accent-rgb), .3), transparent 34%), linear-gradient(180deg, rgba(4,6,16,.92), rgba(6,8,20,.86)); backdrop-filter: blur(10px); overflow: hidden; }
    .ability-overlay::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px); background-size: 32px 32px; mask-image: radial-gradient(circle at center, black, transparent 74%); pointer-events: none; }
    .ability-panel { position: relative; width: min(720px, calc(100vw - 24px)); padding: 24px; border-radius: 18px; border: 1.5px solid rgba(var(--dash-accent-rgb), .45); background: linear-gradient(180deg, rgba(10,12,28,.98), rgba(5,7,16,.98)); box-shadow: 0 20px 60px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.07), 0 0 50px rgba(var(--dash-accent-rgb), .06); animation: panelIn .3s ease both; }
    @keyframes panelIn { from { opacity: 0; transform: scale(.95); } to { opacity: 1; transform: scale(1); } }
    .ability-title { font-family: 'Courier New', monospace; font-size: clamp(1.3rem, 4vw, 2rem); font-weight: 900; color: #fff; text-align: center; text-shadow: 0 0 24px rgba(var(--dash-accent-rgb), .5); letter-spacing: .02em; padding-bottom: 2px; }
    .ability-subtitle { margin: 0 0 16px; color: rgba(255,255,255,.35); text-align: center; font-size: .78rem; font-weight: 700; letter-spacing: .04em; border-bottom: 1px solid rgba(255,255,255,.05); padding-bottom: 12px; }
    .ability-choices { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
    .ability-card { position: relative; min-height: 170px; padding: 16px 14px 14px; border-radius: 14px; border: 1.5px solid rgba(68,136,204,.45); background: linear-gradient(165deg, rgba(68,136,204,.18) 0%, rgba(68,136,204,.05) 45%, rgba(0,0,0,.3) 85%); color: #fff; font-family: inherit; text-align: left; cursor: pointer; overflow: hidden; transition: transform .2s cubic-bezier(.16,.84,.44,1), border-color .2s, box-shadow .2s; animation: cardIn .4s ease both; box-shadow: 0 0 16px rgba(68,136,204,.1), inset 0 0 36px rgba(68,136,204,.03); backdrop-filter: blur(3px); }
