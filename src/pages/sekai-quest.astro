      } else {
        if (boss.phase === 1 && boss.hp <= boss.maxHp * 0.66) { boss.phase = 2; boss.attackTimer = 0.5; boss.teleportTimer = 1.2; screenFlash = 0.5; screenFlashColor = '#ff66dd'; showMsg('BOSS 第二阶段', 1.1); shake(18); burst(boss.x + boss.w / 2, boss.y + boss.h / 2, '#ff66dd', 36); }
        else if (boss.phase === 2 && boss.hp <= boss.maxHp * 0.34) { boss.phase = 3; boss.attackTimer = 0.4; boss.teleportTimer = 0.8; screenFlash = 0.6; screenFlashColor = '#ff4488'; showMsg('BOSS 第三阶段', 1.1); shake(22); burst(boss.x + boss.w / 2, boss.y + boss.h / 2, '#ff4488', 48); }
      }
      updateHud();
    }

    function startBossDefeatCutscene() {
      bossDefeatCutscene = 3.8;
      const isMfy = boss?.isMfy ?? false;
      bossFinisher.classList.remove('hidden');
      bossFinisher.classList.remove('slowmo');
      void bossFinisher.offsetWidth;
      bossFinisher.classList.add('slowmo');
      if (isMfy) {
        bossFinisherLine.textContent = '终于理解了……你也一直在寻找自己的世界吗？';
        bossFinisherImg.src = MFY_BOSS_SPRITES.idle;
      } else {
        bossFinisherLine.textContent = '破碎的世界....还值得拯救吗...';
        bossFinisherImg.src = BOSS_SPRITES.defeat1;
        setTimeout(() => { bossFinisherImg.src = BOSS_SPRITES.defeat2; }, 760);
        setTimeout(() => { bossFinisherImg.src = BOSS_SPRITES.fade1; }, 1780);
        setTimeout(() => { bossFinisherImg.src = BOSS_SPRITES.fade2; }, 2480);
        setTimeout(() => { bossFinisherImg.src = BOSS_SPRITES.fade3; }, 3140);
      }
      setTimeout(() => {
        bossFinisher.classList.remove('slowmo');
        bossFinisher.classList.add('hidden');
        showResults();
      }, 3800);
    }

    function teleportBoss() {
      if (!boss || !boss.alive || boss.phase < 2) return;
      const oldX = boss.x + boss.w / 2;
      const oldY = boss.y + boss.h / 2;
      burst(oldX, oldY, '#ff66dd', 18);
      const arenaLeft = Math.max(2120, worldW - 1180);
      const arenaRight = worldW - 260;
      const slots = [
        { x: arenaLeft + 80, y: 292 },
        { x: arenaLeft + 420, y: 248 },
        { x: arenaRight - 190, y: 316 },
        { x: player.x + (player.x < arenaLeft + 420 ? 420 : -420), y: 276 },
      ];
      const next = slots[Math.floor(Math.random() * slots.length)];
      boss.x = Math.max(arenaLeft, Math.min(arenaRight, next.x));
      boss.homeY = Math.max(230, Math.min(340, next.y));
      boss.y = boss.homeY;
      boss.pattern = 'idle';
      boss.timer = 0;
      boss.attackTimer = boss.phase >= 3 ? 0.25 : 0.45;
      boss.teleportTimer = boss.phase >= 3 ? 2.4 : 3.4;
      burst(boss.x + boss.w / 2, boss.y + boss.h / 2, '#cc88ff', 22);
      showMsg('BOSS 瞬移', 0.7);
      shake(12);
    }

    function bossDmg() { return boss!.phase >= 3 ? 2 : 1; }
    function triggerLiberation() {
      if (!boss || !boss.isMfy) return;
      boss.pattern = 'liberate';
      boss.timer = 0;
      boss.liberateT = 3.0;
      // Teleport to mid-air
      boss.homeY = 120;
      boss.y = boss.homeY;
      burst(boss.x + boss.w / 2, boss.y + boss.h / 2, '#bb66ee', 28);
      shake(14);
      screenFlash = 0.4;
      screenFlashColor = '#bb66ee';
      showMsg('血潮 — 解放攻击', 1.5);
      // Summon minions: 3 ground (slimes), 3 float (ghosts), 1 elite (charger)
      const count = 7;
      const types: EnemyType[] = ['slime','slime','slime','ghost','ghost','ghost','charger'];
      const elites = [false,false,false,false,false,false,true];
      for (let i = 0; i < count; i++) {
        const ex = boss.x + 20 + Math.random() * 60;
        const ey = boss.y + boss.h - 32;
        const e: Enemy = {
          x: ex, y: ey, w: 28, h: 28,
          vx: (i < 3 ? 50 : 0) * (Math.random() < 0.5 ? 1 : -1),
          hp: elites[i] ? 6 : 2, maxHp: elites[i] ? 6 : 2,
          left: 0, right: worldW,
          type: types[i], alive: true, atkTimer: 1.0, xp: elites[i] ? 60 : 20,
          elite: elites[i], popIn: 0.3, summonTag: 'mfy',
        };
        enemies.push(e);
      }
      sfxBoss();
    }
    function chooseBossPattern() {
      if (!boss) return;
      if (boss.isMfy) {
        // Mafuyu: no beam/teleport, uses volley/rain/summon
        const mfyOrder: Boss['pattern'][] = ['volley', 'rain', 'summon'];
        if (boss.phase >= 2) mfyOrder.push('volley');
        if (boss.phase >= 3) mfyOrder.push('rain');
        boss.pattern = mfyOrder[Math.floor(Math.random() * mfyOrder.length)];
      } else {
        let order: Boss['pattern'][] = ['volley', 'wave', 'rain'];
        if (boss.phase >= 2) order.push('beam');
        if (boss.phase >= 3) { order = ['beam', 'rain', 'volley', 'wave', 'summon']; }
        boss.pattern = order[Math.floor(Math.random() * order.length)];
      }
      boss.timer = 0; boss.burstCount = 0;
      if (!boss.isMfy && boss.pattern === 'beam') { boss.beamWarn = 0.5; boss.beamY = Math.max(90, Math.min(430, player.y + player.h / 2)); boss.beamX = player.x + player.w / 2; boss.pattern = 'idle'; boss.attackTimer = 1.6; }
    }
    function updateBoss(dt: number) {
      if (!boss || !boss.alive) return;
      if (boss.isMfy) return updateBossMfy(dt);
      // Original Miku boss update
      boss.y = boss.homeY + Math.sin(performance.now() * 0.002) * 10;
      boss.x += boss.driftX * dt;
      const arenaLeft = Math.max(2120, worldW - 1180), arenaRight = worldW - 260;
      if (boss.x < arenaLeft) { boss.x = arenaLeft; boss.driftX = Math.abs(boss.driftX); }
      if (boss.x > arenaRight) { boss.x = arenaRight; boss.driftX = -Math.abs(boss.driftX); }
      if (boss.phase >= 2) {
        boss.teleportTimer -= dt;
        if (boss.teleportTimer <= 0 && boss.beamWarn <= 0) teleportBoss();
      }
      if (boss.phase >= 2 && Math.random() < dt * 0.6) { boss.driftX += (Math.random() - 0.5) * 120; boss.driftX = Math.max(-150, Math.min(150, boss.driftX)); }
      if (!boss.active) { if (player.x > boss.x - 650) { boss.active = true; sfxBoss(); showMsg('BOSS: 25 初音核心', 1.4); shake(12); } return; }
      if (boss.beamWarn > 0) { boss.beamWarn -= dt; if (boss.beamWarn <= 0) { projectiles.push({ x: boss.beamX - 100, y: boss.beamY - 9, w: 200, h: 18, vx: 0, vy: 0, life: 0.3, damage: bossDmg(), kind: 'boss', color: '#ff66dd' }); sfxHurt(); shake(16); } }
      boss.attackTimer -= dt;
      if (boss.pattern === 'idle' && boss.attackTimer <= 0 && boss.beamWarn <= 0) chooseBossPattern();
      boss.timer += dt;
      if (boss.pattern === 'volley' && boss.timer > 0.26) { boss.timer = 0; boss.burstCount++; spawnAimedProjectile(boss.x + 18, boss.y + 56, 230 + boss.phase * 45, 'boss', '#cc88ff', 16); if (boss.burstCount >= 3 + boss.phase * 2) { boss.pattern = 'idle'; boss.attackTimer = 1.1; } }
      else if (boss.pattern === 'rain' && boss.timer > 0.16) { boss.timer = 0; boss.burstCount++; const rx = player.x + player.w / 2 - 180 + Math.random() * 360; projectiles.push({ x: rx, y: -30, w: 14, h: 24, vx: (Math.random() - 0.5) * 50, vy: 300 + boss.phase * 45, life: 2.2, damage: bossDmg(), kind: 'boss', color: '#aa66ff' }); if (boss.burstCount >= 7 + boss.phase * 3) { boss.pattern = 'idle'; boss.attackTimer = 1.0; } }
      else if (boss.pattern === 'wave' && boss.timer > 0.42) { boss.timer = 0; boss.burstCount++; projectiles.push({ x: boss.x - 24, y: 452, w: 42, h: 20, vx: -(230 + boss.phase * 55), vy: 0, life: 4, damage: bossDmg(), kind: 'boss', color: '#ff99cc' }); if (boss.burstCount >= 2 + boss.phase) { boss.pattern = 'idle'; boss.attackTimer = 1.2; } }
      else if (boss.pattern === 'summon' && boss.timer > 1.0) { boss.timer = 0; boss.burstCount++; const count = 2 + Math.floor(Math.random() * 2); for (let i = 0; i < count; i++) { enemies.push({ x: boss.x + 20 + Math.random() * 60, y: boss.y + boss.h - 32, w: 28, h: 28, vx: (i === 0 ? 70 : -70), hp: 2, maxHp: 2, left: 0, right: worldW, type: 'bat', alive: true, atkTimer: 1.2, xp: 15, popIn: 0.35, elite: false }); } burst(boss.x + boss.w / 2, boss.y + boss.h, '#ff88cc', 16); if (boss.burstCount >= 1) { boss.pattern = 'idle'; boss.attackTimer = 2.4; } }
      if (overlaps(player, boss)) takeDamage();
    }
    function updateBossMfy(dt: number) {
      if (!boss || !boss.isMfy) return;
      // Float at homeY with sine bob + horizontal drift
      boss.y = boss.homeY + Math.sin(performance.now() * 0.002) * 10;
      boss.x += boss.driftX * dt;
      const arenaLeft = Math.max(3460, worldW - 540), arenaRight = worldW - 80;
      if (boss.x < arenaLeft) { boss.x = arenaLeft; boss.driftX = Math.abs(boss.driftX); }
      if (boss.x > arenaRight) { boss.x = arenaRight; boss.driftX = -Math.abs(boss.driftX); }
      if (Math.random() < dt * 0.5) { boss.driftX += (Math.random() - 0.5) * 100; boss.driftX = Math.max(-120, Math.min(120, boss.driftX)); }
      if (!boss.active) { if (player.x > boss.x - 700) { boss.active = true; sfxBoss(); showMsg('BOSS: Mafuyu 的终响', 1.4); shake(12); triggerLiberation(); } return; }
      // Liberation channel
      if (boss.pattern === 'liberate') {
        boss.liberateT! -= dt;
        if (boss.liberateT! <= 0) {
          // Absorb alive minions & heal
          let aliveCount = 0;
          for (const e of enemies) { if (e.alive && e.summonTag === 'mfy') aliveCount++; }
          if (aliveCount > 0) {
            const heal = aliveCount * 10;
            boss.hp = Math.min(boss.maxHp, boss.hp + heal);
            showMsg(`吸收了${aliveCount}个仆从 +${heal}HP`, 1.2);
            // Absorb effect: kill all tagged minions with burst
            for (const e of enemies) { if (e.alive && e.summonTag === 'mfy') { e.alive = false; burst(e.x + e.w / 2, e.y + e.h / 2, '#bb66ee', 12); } }
            screenFlash = 0.3; screenFlashColor = '#cc88ff'; shake(12);
          } else {
            showMsg('没有仆从可吸收', 0.8);
          }
          // Return to normal altitude
          boss.homeY = 300;
          boss.pattern = 'idle';
          boss.attackTimer = 2.0 + (3 - boss.phase) * 0.4;
        }
        return; // Channelling — no other actions
      }
      boss.attackTimer -= dt;
      if (boss.pattern === 'idle' && boss.attackTimer <= 0) chooseBossPattern();
      boss.timer += dt;
      if (boss.pattern === 'volley' && boss.timer > 0.28) {
        boss.timer = 0; boss.burstCount++;
        spawnAimedProjectile(boss.x + 18, boss.y + 56, 210 + boss.phase * 30, 'boss', '#bb66ee', 14);
        if (boss.burstCount >= 2 + boss.phase) { boss.pattern = 'idle'; boss.attackTimer = 1.0 + Math.random() * 0.6; }
      } else if (boss.pattern === 'rain' && boss.timer > 0.18) {
        boss.timer = 0; boss.burstCount++;
        const rx = player.x + player.w / 2 - 160 + Math.random() * 320;
        projectiles.push({ x: rx, y: -30, w: 12, h: 22, vx: (Math.random() - 0.5) * 40, vy: 260 + boss.phase * 40, life: 2.4, damage: bossDmg(), kind: 'boss', color: '#9966ee' });
        if (boss.burstCount >= 5 + boss.phase * 2) { boss.pattern = 'idle'; boss.attackTimer = 0.8 + Math.random() * 0.5; }
      } else if (boss.pattern === 'summon' && boss.timer > 0.8) {
        boss.timer = 0; boss.burstCount++;
        const count = 1 + Math.floor(Math.random() * 2);
        for (let i = 0; i < count; i++) {
          enemies.push({
            x: boss.x + 20 + Math.random() * 60, y: boss.y + boss.h - 32, w: 28, h: 28,
            vx: (i === 0 ? 60 : -60), hp: 2, maxHp: 2, left: 0, right: worldW,
            type: 'bat', alive: true, atkTimer: 1.0, xp: 15, popIn: 0.3, elite: false,
          });
        }
        burst(boss.x + boss.w / 2, boss.y + boss.h, '#bb77dd', 14);
        if (boss.burstCount >= 1) { boss.pattern = 'idle'; boss.attackTimer = 2.2; }
      }
      if (overlaps(player, boss)) takeDamage();
    }
    // --- Update ---
    function update(dt: number) {
      if (!running || finished) return;
      tickBgm(dt);
      if (paused) return;
      if (choosingAbility) return;
      if (freezeTimer > 0) { freezeTimer -= dt; return; }
      const c = CHARS[selChar];
      const stage = STAGES[selStage];

      // Player movement (smooth acceleration)
      const moveL = keys['arrowleft'] || keys['a'] || keys['t_left'];
      const moveR = keys['arrowright'] || keys['d'] || keys['t_right'];
      let targetVx = 0;
      if (moveL) { targetVx = -c.speed; player.facing = -1; }
      else if (moveR) { targetVx = c.speed; player.facing = 1; }
      const accelRate = player.grounded ? 14 : 9;
      const friction = player.grounded ? 0.82 : 0.92;
      if (targetVx !== 0) { player.vx += (targetVx - player.vx) * Math.min(1, dt * accelRate); }
      else { player.vx *= Math.pow(friction, dt * 60); }

      player.vy += GRAVITY * dt;
      player.invuln = Math.max(0, player.invuln - dt);
      player.atkTimer = Math.max(0, player.atkTimer - dt * 1000);

      // Horizontal collision
      player.x += player.vx * dt;
      for (const p of platforms) {
        if (overlaps(player, p)) {
          if (player.vx > 0) player.x = p.x - player.w;
          else if (player.vx < 0) player.x = p.x + p.w;
          player.vx = 0;
        }
      }

      // Vertical collision
      player.y += player.vy * dt;
      player.grounded = false;
      for (const p of platforms) {
        if (overlaps(player, p)) {
          if (player.vy > 0) { player.y = p.y - player.h; player.vy = 0; player.grounded = true; player.jumps = 0; }
          else if (player.vy < 0) { player.y = p.y + p.h; player.vy = 0; }
        }
      }

      // Coyote time + landing detection + jump buffer
      if (player.grounded) {
        coyoteTimer = 0.1;
        if (wasAirborne) {
          // Landing impact
          wasAirborne = false;
          for (let i = 0; i < 6; i++) {
            particles.push({ x: player.x + player.w / 2 + (Math.random() - 0.5) * 20, y: player.y + player.h, vx: (Math.random() - 0.5) * 80, vy: -(20 + Math.random() * 40), life: 0.3 + Math.random() * 0.15, color: 'rgba(200,200,200,0.5)', size: 2 + Math.random() * 2 });
          }
        }
        // Auto-trigger buffered jump
        if (jumpBufferTimer > 0) { doJump(); jumpBufferTimer = 0; }
      } else {
        coyoteTimer -= dt;
        wasAirborne = true;
      }
      jumpBufferTimer -= dt;

      // Moving platforms — linear ping-pong
      for (const mp of movingPlatforms) {
        const prevX = mp.x, prevY = mp.y;
        const dist = Math.hypot(mp.dx, mp.dy) || 1;
        const period = 2 * dist / mp.speed;
        mp.t = ((mp.t + dt) % period + period) % period;
        const phase = mp.t / period; // 0→1
        const tri = phase < 0.5 ? phase * 2 : 2 - phase * 2; // 0→1→0
        mp.x = mp.ox + tri * mp.dx;
        mp.y = mp.oy + tri * mp.dy;
        const deltaX = mp.x - prevX, deltaY = mp.y - prevY;
        // Collision: player standing on moving platform
        if (player.vy >= 0 && player.y + player.h >= mp.y - 4 && player.y + player.h <= mp.y + 10 && player.x + player.w > mp.x && player.x < mp.x + mp.w) {
          player.y = mp.y - player.h;
          player.vy = 0;
          player.grounded = true;
          player.jumps = 0;
          player.x += deltaX;
          player.y += deltaY;
        }
      }

      // Hazard collision (spikes)
      for (const hz of hazards) {
        if (overlaps(player, hz) && player.invuln <= 0) {
          player.hp--;
          player.invuln = 1.2;
          player.vy = -500;
          player.vx = player.facing * -200;
          freezeTimer = 0.08;
          sfxHurt();
          shake(12);
          burst(player.x + player.w / 2, player.y + player.h, '#ff4444', 10);
          updateHud();
          if (player.hp <= 0) { finished = true; running = false; showMsg('游戏结束', 2); setTimeout(showResults, 1500); }
        }
      }

      // Fall off world
      if (player.y > VH + 100) {
        player.x = Math.max(60, cameraX + 80);
        player.y = 60;
        player.vy = 0;
        takeDamage();
      }

      player.x = Math.max(0, Math.min(worldW - player.w, player.x));

      // Projectiles
      for (const proj of projectiles) {
        if (proj.kind === 'player' && proj.homing) {
          const target = nearestProjectileTarget(proj);
          if (target) {
            const tx = target.x + target.w / 2 - (proj.x + proj.w / 2);
            const ty = target.y + target.h / 2 - (proj.y + proj.h / 2);
            const len = Math.max(1, Math.hypot(tx, ty));
            const speed = Math.max(180, Math.hypot(proj.vx, proj.vy));
            proj.vx += (tx / len * speed - proj.vx) * proj.homing;
            proj.vy += (ty / len * speed - proj.vy) * proj.homing;
          }
        }
        if (proj.accelY) proj.vy += proj.accelY * dt;
        proj.x += proj.vx * dt; proj.y += proj.vy * dt; proj.life -= dt;
        if (proj.kind === 'player') {
          for (const enemy of enemies) {
            if (!enemy.alive || proj.life <= 0) continue;
            if (overlaps(proj, enemy)) {
              // Shielder blocks frontal projectiles
              if (enemy.type === 'shielder') {
                const shieldFacing = enemy.vx >= 0 ? 1 : -1;
                const projDir = proj.vx > 0 ? 1 : -1;
                if (projDir !== shieldFacing) {
                  // Hit from front — deflect
                  proj.vy = -200; proj.vx *= -0.3; proj.damage = 0; proj.color = '#aaa';
                  burst(enemy.x + (shieldFacing > 0 ? 0 : enemy.w), enemy.y + enemy.h / 2, '#cccccc', 4);
                  consumeProjectileHit(proj);
                  continue;
                }
              }
              const isCrit = proj.damage >= (attackDamage() * 1.8);
              enemy.hp -= proj.damage;
              freezeTimer = 0.035;
              if (enemy.hp <= 0) { 
                killEnemy(enemy, (enemy.type === 'ghost' ? 260 : enemy.type === 'shielder' ? 320 : enemy.type === 'bomber' ? 240 : 200) + (enemy.elite ? 240 : 0));
                if (isCrit) { sfxCrit(); burst(enemy.x + enemy.w / 2, enemy.y + enemy.h / 2, '#ffd66e', 18); shake(12); floatingTexts.push({ x: enemy.x + enemy.w / 2, y: enemy.y - 30, text: 'CRIT!', color: '#ffd66e', life: 0.8, vy: -100 }); }
              } else {
                burst(enemy.x + enemy.w / 2, enemy.y + enemy.h / 2, isCrit ? '#ffd66e' : '#fff', isCrit ? 14 : (enemy.elite ? 8 : 4));
                if (isCrit) { sfxCrit(); shake(8); floatingTexts.push({ x: enemy.x + enemy.w / 2, y: enemy.y - 20, text: 'CRIT!', color: '#ffd66e', life: 0.6, vy: -80 }); }
              }
              consumeProjectileHit(proj);
            }
          }
          if (boss && boss.alive && boss.active && proj.life > 0 && overlaps(proj, boss)) { damageBoss(proj.damage); consumeProjectileHit(proj); }
        } else if (overlaps(player, proj)) { proj.life = 0; takeDamage(); }
      }
      projectiles = projectiles.filter(p => p.life > 0 && p.x > cameraX - 180 && p.x < cameraX + VW + 260 && p.y > -120 && p.y < VH + 140);
      // Enemies
      for (const enemy of enemies) {
        // Pop-in timer
        if (enemy.popIn) { enemy.popIn -= dt; if (enemy.popIn < 0) enemy.popIn = 0; }
        // Death animation: fade + float up
        if (!enemy.alive && (enemy.deathTimer || 0) > 0) {
          enemy.deathTimer! -= dt;
          enemy.y -= 80 * dt;
          continue;
        }
        if (!enemy.alive) continue;
        enemy.x += enemy.vx * dt;
        if (enemy.x <= enemy.left || enemy.x + enemy.w >= enemy.right) enemy.vx *= -1;
        if (enemy.type === 'bat') {
          enemy.atkTimer -= dt;
          const dist = Math.abs((player.x + player.w / 2) - (enemy.x + enemy.w / 2));
          if (enemy.atkTimer <= 0 && dist < 400) {
            const atkDir = player.x > enemy.x ? 1 : -1;
            enemy.vx = atkDir * (enemy.elite ? 280 : 200);
            projectiles.push({ x: enemy.x + enemy.w / 2, y: enemy.y + 4, w: 14, h: 14, vx: atkDir * (enemy.elite ? 160 : 120), vy: -50, life: 1.6, damage: 1, kind: 'enemy', color: '#ff66aa' });
            enemy.atkTimer = enemy.elite ? 1.3 : 2.0;
            burst(enemy.x + enemy.w / 2, enemy.y + 4, '#ff6699', 3);
          }
        }
        if (enemy.type === 'ghost') {
          enemy.y = (enemy.baseY || enemy.y) + Math.sin(performance.now() * 0.004 + enemy.x * 0.01) * 10;
          enemy.atkTimer -= dt;
          const gDist = Math.abs((player.x + player.w / 2) - (enemy.x + enemy.w / 2));
          if (enemy.atkTimer <= 0 && gDist < 560) {
            spawnAimedProjectile(enemy.x + enemy.w / 2, enemy.y + 14, enemy.elite ? 250 : 190, 'enemy', enemy.elite ? '#ffd66e' : '#88ddff', enemy.elite ? 16 : 12);
            enemy.atkTimer = (enemy.elite ? 1.2 : 1.8) + Math.random() * 0.6;
          }
        }
        if (enemy.type === 'charger') {
          enemy.dashTimer = (enemy.dashTimer || 1) - dt;
          const dx = player.x + player.w / 2 - (enemy.x + enemy.w / 2);
          if (enemy.dashTimer <= 0 && Math.abs(dx) < 520) {
            enemy.vx = Math.sign(dx || 1) * (enemy.elite ? 250 : 190);
            enemy.dashTimer = enemy.elite ? 1.15 : 1.65;
            burst(enemy.x + enemy.w / 2, enemy.y + enemy.h / 2, '#ff99cc', 6);
          }
        }
        if (enemy.type === 'sniper') {
          enemy.atkTimer -= dt;
          enemy.vx *= Math.pow(0.02, dt);
          const dist = Math.abs((player.x + player.w / 2) - (enemy.x + enemy.w / 2));
          if (enemy.atkTimer <= 0 && dist < 720) {
            const dir = player.x > enemy.x ? 1 : -1;
            projectiles.push({ x: enemy.x + (dir > 0 ? enemy.w : -34), y: enemy.y + 15, w: 34, h: 7, vx: dir * (enemy.elite ? 360 : 300), vy: 0, life: 2.1, damage: 1, kind: 'enemy', color: enemy.elite ? '#ffd66e' : '#cc88ff', shape: 'beam' });
            enemy.atkTimer = enemy.elite ? 1.2 : 1.85;
            shake(4);
          }
        }
        if (enemy.type === 'shielder') {
          // Slow patrol, face toward player when nearby
          const dx = player.x + player.w / 2 - (enemy.x + enemy.w / 2);
          const dist = Math.abs(dx);
          if (dist < 400) { enemy.vx = Math.sign(dx) * 30; }
          else { enemy.vx = enemy.vx || 40; }
        }
        if (enemy.type === 'bomber') {
          enemy.atkTimer -= dt;
          const bDist = Math.abs((player.x + player.w / 2) - (enemy.x + enemy.w / 2));
          enemy.y = (enemy.baseY || enemy.y) + Math.sin(performance.now() * 0.003 + enemy.x * 0.01) * 6;
          if (enemy.atkTimer <= 0 && bDist < 500) {
            const bombX = enemy.x + enemy.w / 2 - 6;
            projectiles.push({ x: bombX, y: enemy.y + enemy.h, w: 12, h: 16, vx: 0, vy: enemy.elite ? 340 : 260, life: 2.5, damage: 1, kind: 'enemy', color: enemy.elite ? '#ff6644' : '#ff8833', shape: 'bomb' });
            enemy.atkTimer = enemy.elite ? 1.6 : 2.4;
            burst(enemy.x + enemy.w / 2, enemy.y + enemy.h, '#ff8833', 4);
          }
        }
        if (enemy.type === 'orbiter') {
          enemy.atkTimer -= dt;
          const orbDist = Math.abs((player.x + player.w / 2) - (enemy.x + enemy.w / 2));
          if (orbDist < 500) {
            const dodgeDir = player.x > enemy.x ? -1 : 1;
            enemy.vx += dodgeDir * 20 * dt;
            enemy.vx = Math.max(-100, Math.min(100, enemy.vx));
          }
          if (enemy.atkTimer <= 0 && orbDist < 600) {
            spawnAimedProjectile(enemy.x + enemy.w / 2, enemy.y + enemy.h / 4, enemy.elite ? 200 : 150, 'enemy', enemy.elite ? '#ff88cc' : '#aa66dd', 10);
            enemy.atkTimer = enemy.elite ? 1.6 : 2.4;
          }
        }
        if (overlaps(player, enemy)) {
          if (player.vy > 100 && player.y + player.h - enemy.y < 20) { enemy.hp -= (enemy.type === 'shielder' ? 2 : 1); player.vy = -450;           if (enemy.hp <= 0) killEnemy(enemy, (enemy.type === 'ghost' ? 260 : enemy.type === 'shielder' ? 320 : enemy.type === 'bomber' ? 240 : 250) + (enemy.elite ? 240 : 0)); else { burst(enemy.x + enemy.w / 2, enemy.y + enemy.h / 2, '#fff', enemy.elite ? 8 : 4); updateHud(); } }
          else takeDamage();
        }
      }
      enemies = enemies.filter(e => e.alive || (e.deathTimer || 0) > 0);
      for (const npc of npcs) {
        if (!npc.met && overlaps(player, npc)) meetNpc(npc);
      }
      // Collectibles
      for (const note of collectNotes) {
        if (note.taken) continue;
        if (note.spawnT > 0) note.spawnT -= dt;
        if (overlaps(player, { x: note.x - 14, y: note.y - 14, w: 28, h: 28 })) {
          note.taken = true; notesCollected++; score += 100; gainXp(10);
          burst(note.x, note.y, '#ffd66e', 8); sfxNote(); updateHud();
        }
      }
      for (const pk of pickups) {
        if (pk.taken) continue;
        if (pk.spawnT > 0) pk.spawnT -= dt;
        if (overlaps(player, { x: pk.x - 12, y: pk.y - 12, w: 24, h: 24 })) {
          pk.taken = true;
          if (pk.type === 'health' && player.hp < player.maxHp) { player.hp++; showMsg('+1 生命', 0.8); }
          else if (pk.type === 'amp') { score += 80; gainXp(35); showMsg('+经验', 0.7); }
          else score += 50;
          burst(pk.x, pk.y, pk.type === 'amp' ? '#88ddff' : '#ff6688', 6); updateHud();
        }
      }
      updateBoss(dt);
      // Particles
      for (const p of particles) { p.x += p.vx * dt; p.y += p.vy * dt; p.vy += 400 * dt; p.life -= dt; }
      particles = particles.filter(p => p.life > 0);
      // Floating texts
      for (const ft of floatingTexts) { ft.y += ft.vy * dt; ft.life -= dt; }
      floatingTexts = floatingTexts.filter(ft => ft.life > 0);

      // Ambient weather particles
      if (ambientParticles.length < 60 && Math.random() < dt * 12) {
        const stIdx = selStage;
        let ap: AmbientParticle;
        if (stIdx === 0) { // Rain
          ap = { x: cameraX + Math.random() * VW, y: -10, vx: -40 - Math.random() * 30, vy: 280 + Math.random() * 120, life: 2 + Math.random(), maxLife: 3, size: 2 + Math.random() * 2, color: '#6688cc', angle: 0 };
        } else if (stIdx === 1) { // Cherry blossoms
          ap = { x: cameraX + Math.random() * VW, y: -10, vx: 20 + Math.random() * 40, vy: 40 + Math.random() * 30, life: 4 + Math.random() * 2, maxLife: 6, size: 3 + Math.random() * 3, color: '#ffaacc', angle: Math.random() * Math.PI * 2 };
        } else if (stIdx === 2) { // Light particles rising
          ap = { x: cameraX + Math.random() * VW, y: VH + 10, vx: (Math.random() - 0.5) * 20, vy: -(30 + Math.random() * 40), life: 3 + Math.random() * 2, maxLife: 5, size: 2 + Math.random() * 3, color: '#ccaaff', angle: 0 };
        } else { // Dark energy converging
          const cx = cameraX + VW / 2, cy = VH / 2;
          ap = { x: cameraX + Math.random() * VW, y: Math.random() * VH, vx: 0, vy: 0, life: 3 + Math.random(), maxLife: 4, size: 2 + Math.random() * 4, color: '#6633aa', angle: 0 };
          const dx = cx - ap.x, dy = cy - ap.y;
          const len = Math.max(1, Math.hypot(dx, dy));
          ap.vx = dx / len * (40 + Math.random() * 30);
          ap.vy = dy / len * (40 + Math.random() * 30);
        }
        ambientParticles.push(ap);
      }
      for (const ap of ambientParticles) {
        ap.x += ap.vx * dt;
        ap.y += ap.vy * dt;
        ap.life -= dt;
        // Cherry blossom sway
        if (selStage === 1) { ap.angle += dt * 2; ap.x += Math.sin(ap.angle) * 15 * dt; }
      }
      ambientParticles = ambientParticles.filter(ap => ap.life > 0);

      // Shake
      if (shakeT > 0) { shakeT -= dt; shakeX *= 0.8; shakeY *= 0.8; } else { shakeX = 0; shakeY = 0; }

      // Message
      if (msgTimer > 0) { msgTimer -= dt; if (msgTimer <= 0) gameMsg.classList.remove('show'); }
      if (screenFlash > 0) screenFlash -= dt;
      if (stageClearTimer > 0) stageClearTimer -= dt;
      if (secretToastTimer > 0) {
        secretToastTimer -= dt;
        if (secretToastTimer <= 0) {
          secretToast.classList.remove('show');
          setTimeout(() => secretToast.classList.add('hidden'), 180);
        }
      }

      // Check win
      if (!stage.boss && player.x > worldW - 80) {
        finished = true; running = false; pendingNextStage = selStage < STAGES.length - 1;
        score += Math.max(0, player.hp * 500);
        sfxClear(); updateHud(); stageClearTimer = 1.2; setTimeout(showResults, 1200);
        burst(player.x + player.w / 2, player.y + player.h / 2, stage.accent, 30);
      }
      // Animation state
      animTimer += dt;
      if (player.atkTimer > 0) {
        if (animState !== 'attack') { animState = 'attack'; animFrame = 0; animTimer = 0; }
      } else if (!player.grounded) {
        animState = player.vy < 0 ? 'jump' : 'fall';
      } else if (Math.abs(player.vx) > 30) {
        if (animState !== 'run') { animState = 'run'; animFrame = 0; animTimer = 0; }
        const runFrameCount = selChar === 1 ? MFY_RUN_FRAMES.length : 6;
        const runFrameDelay = selChar === 1 ? MFY_RUN_CYCLE_SECONDS / MFY_RUN_FRAMES.length : 0.08;
        while (animTimer > runFrameDelay) { animFrame = (animFrame + 1) % runFrameCount; animTimer -= runFrameDelay; }
        runDustTimer += dt;
        if (runDustTimer > 0.12) { runDustTimer = 0; particles.push({ x: player.x + player.w / 2, y: player.y + player.h, vx: -player.facing * (20 + Math.random() * 30), vy: -(10 + Math.random() * 20), life: 0.3, color: 'rgba(200,200,200,0.5)', size: 2 + Math.random() * 2 }); }
      } else {
        if (animState !== 'idle') { animState = 'idle'; animFrame = 0; animTimer = 0; }
      }

      // Camera
      const targetCam = Math.max(0, Math.min(worldW - VW, player.x - VW * 0.4));
      cameraX += (targetCam - cameraX) * Math.min(1, dt * 6);
    }

    function takeDamage() {
      if (player.invuln > 0 || finished) return;
      if (shieldCharges > 0) {
        shieldCharges--;
        player.invuln = 0.8;
        sfxShield();
        shake(8);
        burst(player.x + player.w / 2, player.y + player.h / 2, '#ffd66e', 14);
        showMsg('护盾抵消', 0.8);
        updateHud();
        return;
      }
      player.hp--;
      player.invuln = 1.2;
      player.vx = -player.facing * 280;
      player.vy = -400;
      freezeTimer = 0.06;
      sfxHurt();
      shake(10);
      burst(player.x + player.w / 2, player.y + player.h / 2, '#e44', 8);
      updateHud();
      if (player.hp <= 0) {
        finished = true; running = false;
        showMsg('游戏结束', 2);
        setTimeout(showResults, 1500);
      }
    }

    function showResults() {
      const clear = player.hp > 0;
      recordStageResult(clear);
      document.getElementById('resTitle')!.textContent = clear ? (pendingNextStage ? '本幕通关！' : 'SEKAI 已拯救！') : '游戏结束';
      document.getElementById('resNotes')!.textContent = String(notesCollected);
      document.getElementById('resEnemies')!.textContent = String(enemiesKilled);
      document.getElementById('resLevel')!.textContent = String(heroLevel);
      document.getElementById('resScore')!.textContent = String(score);
      const retry = document.getElementById('retryBtn')!;
      retry.textContent = clear && pendingNextStage ? '下一幕' : '重试';
      setPaused(false);
      gameScreen.classList.add('hidden'); resultsScreen.classList.remove('hidden'); touchControls.classList.add('hidden');
    }
    let canvasW = 0, canvasH = 0, canvasScale = 1, canvasOx = 0, canvasOy = 0;
    function resizeCanvas() {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      const w = Math.round(rect.width * dpr);
      const h = Math.round(rect.height * dpr);
      if (w === canvasW && h === canvasH) return;
      canvasW = w; canvasH = h;
      canvas.width = w; canvas.height = h;
      const sx = (rect.width * dpr) / VW;
      const sy = (rect.height * dpr) / VH;
      canvasScale = Math.min(sx, sy);
      canvasOx = (canvasW - VW * canvasScale) / 2;
      canvasOy = (canvasH - VH * canvasScale) / 2;
    }

    // --- Render ---
    function render(time: number) {
      resizeCanvas();
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      if (!player) { ctx.clearRect(0, 0, canvasW, canvasH); return; }
      ctx.clearRect(0, 0, canvasW, canvasH);

      ctx.setTransform(canvasScale, 0, 0, canvasScale, canvasOx + shakeX, canvasOy + shakeY);

      const stage = STAGES[selStage];
      const t = time / 1000;

      // Background
      ctx.fillStyle = stage.bg1;
      ctx.fillRect(0, 0, VW, VH);
      ctx.fillStyle = stage.bg2;
      ctx.fillRect(0, VH * 0.4, VW, VH * 0.6);

      // Stars (parallax)
      for (let i = 0; i < 50; i++) {
        const x = ((i * 137 + 23 - cameraX * (0.05 + (i % 3) * 0.015)) % (VW + 80)) - 40;
        const y = 20 + (i * 59) % (VH * 0.5);
        const sz = 2 + (i % 3);
        ctx.fillStyle = i % 4 === 0 ? stage.starColor : 'rgba(255,255,255,0.3)';
        ctx.fillRect(Math.floor(x), Math.floor(y), sz, sz);
      }

      // Background buildings (parallax)
      for (let i = 0; i < 12; i++) {
        const x = Math.floor((i * 280 - cameraX * 0.12) % (VW + 300) - 150);
        const h = 60 + (i % 4) * 30;
        ctx.fillStyle = i % 2 === 0 ? hexRgba(stage.platColor, 0.4) : hexRgba(stage.bg2, 0.6);
        ctx.fillRect(x, VH - 50 - h, 80, h);
        for (let j = 0; j < 3; j++) {
          ctx.fillStyle = hexRgba(stage.accent, 0.12);
          ctx.fillRect(x + 14 + j * 20, VH - 40 - h, 8, h - 20);
        }
      }

      // Back-layer decorations
      for (const d of decors) {
        if (d.layer !== 'back') continue;
        const dx = Math.round(d.x - cameraX * d.parallax);
        if (dx + d.w < -60 || dx > VW + 60) continue;
        ctx.save();
        ctx.globalAlpha = 0.35;
        drawDecorShape(d.type, dx, d.y, d.w, d.h, stage.accent);
        ctx.restore();
      }

      // Platforms
      for (const p of platforms) {
        const px = Math.round(p.x - cameraX);
        if (px + p.w < -40 || px > VW + 40) continue;
        ctx.fillStyle = stage.platColor;
        ctx.fillRect(px, p.y, p.w, p.h);
        ctx.fillStyle = stage.platTop;
        ctx.fillRect(px, p.y, p.w, Math.min(6, p.h));
        // Tile pattern
        for (let tx = 0; tx < p.w; tx += 24) {
          ctx.fillStyle = hexRgba(stage.platTop, 0.08);
          ctx.fillRect(px + tx + 16, p.y + 10, 4, 4);
        }
        ctx.fillStyle = hexRgba('#000000', 0.2);
        ctx.fillRect(px, p.y + p.h - 3, p.w, 3);
      }

      // Moving platforms
      for (const mp of movingPlatforms) {
        const mx = Math.round(mp.x - cameraX);
        if (mx + mp.w < -40 || mx > VW + 40) continue;
        ctx.fillStyle = stage.platColor;
        ctx.fillRect(mx, mp.y, mp.w, mp.h);
        ctx.fillStyle = stage.accent;
        ctx.fillRect(mx, mp.y, mp.w, Math.min(4, mp.h));
        // Glowing edge pulse
        const glowAlpha = 0.25 + Math.sin(t * 4) * 0.12;
        ctx.fillStyle = hexRgba(stage.accent, glowAlpha);
        ctx.fillRect(mx - 2, mp.y - 2, mp.w + 4, mp.h + 4);
        // Direction arrows
        ctx.fillStyle = hexRgba(stage.accent, 0.4);
        const midX = mx + mp.w / 2, midY = mp.y + mp.h / 2;
        if (mp.dx !== 0) { ctx.fillRect(midX - 8, midY - 1, 5, 2); ctx.fillRect(midX + 3, midY - 1, 5, 2); }
        if (mp.dy !== 0) { ctx.fillRect(midX - 1, midY - 6, 2, 4); ctx.fillRect(midX - 1, midY + 2, 2, 4); }
      }

      // Spike hazards
      for (const hz of hazards) {
        const hx = Math.round(hz.x - cameraX);
        if (hx + hz.w < -20 || hx > VW + 20) continue;
        const spikeCount = Math.floor(hz.w / 12);
        const spikeW = hz.w / spikeCount;
        for (let i = 0; i < spikeCount; i++) {
          const sx = hx + i * spikeW;
          ctx.fillStyle = '#cc3322';
          ctx.beginPath();
          ctx.moveTo(sx, hz.y + hz.h);
          ctx.lineTo(sx + spikeW / 2, hz.y);
          ctx.lineTo(sx + spikeW, hz.y + hz.h);
          ctx.closePath();
          ctx.fill();
          // Highlight tip
          ctx.fillStyle = '#ff6644';
          ctx.beginPath();
          ctx.moveTo(sx + spikeW / 2 - 2, hz.y + 6);
          ctx.lineTo(sx + spikeW / 2, hz.y);
          ctx.lineTo(sx + spikeW / 2 + 2, hz.y + 6);
          ctx.closePath();
          ctx.fill();
        }
        // Base
        ctx.fillStyle = '#662211';
        ctx.fillRect(hx, hz.y + hz.h - 3, hz.w, 3);
      }

      // Goal gate
      if (!stage.boss) {
        const gateX = worldW - 60 - cameraX;
        ctx.save();
        ctx.fillStyle = hexRgba(stage.accent, 0.15);
        ctx.fillRect(gateX - 24, 380, 48, 96);
        ctx.strokeStyle = stage.accent;
        ctx.lineWidth = 2;
        ctx.strokeRect(gateX - 24, 380, 48, 96);
        ctx.fillStyle = '#fff';
        ctx.font = '900 14px Courier New, monospace';
        ctx.textAlign = 'center';
        ctx.fillText('终点', gateX, 430 + Math.sin(t * 3) * 3);
        ctx.restore();
      }
      // NPC encounters
      for (const npc of npcs) {
        const nx = Math.round(npc.x - cameraX);
        const ny = Math.round(npc.y);
        if (nx + npc.w < -30 || nx > VW + 30) continue;
        ctx.save();
        ctx.fillStyle = 'rgba(0,0,0,0.2)';
        ctx.beginPath();
        ctx.ellipse(nx + npc.w / 2, ny + npc.h + 4, 18, 5, 0, 0, Math.PI * 2);
        ctx.fill();
        const npcImg = typeof npc.char === 'number' ? charImages[npc.char] : null;
        ctx.imageSmoothingEnabled = false;
        if (npcImg && npcImg.complete && npcImg.naturalWidth > 0) {
          ctx.globalAlpha = npc.met ? 0.58 : 1;
          const sw = npc.char === 1 ? 58 : 48;
          const sh = npc.char === 1 ? 64 : 58;
          ctx.drawImage(npcImg, nx + npc.w / 2 - sw / 2, ny + npc.h - sh + 4, sw, sh);
          ctx.globalAlpha = 1;
          ctx.strokeStyle = npc.met ? 'rgba(255,255,255,.25)' : npc.color;
          ctx.lineWidth = 2;
          ctx.strokeRect(nx + npc.w / 2 - sw / 2 - 2, ny + npc.h - sh + 2, sw + 4, sh + 4);
        } else {
          ctx.fillStyle = npc.met ? 'rgba(255,255,255,.36)' : npc.color;
          ctx.fillRect(nx + 7, ny + 10, 20, 30);
          ctx.fillStyle = npc.met ? 'rgba(255,255,255,.48)' : hexRgba(npc.color, .7);
          ctx.fillRect(nx + 5, ny + 2, 24, 14);
          ctx.fillStyle = '#fff';
          ctx.fillRect(nx + 11, ny + 9, 4, 4);
          ctx.fillRect(nx + 20, ny + 9, 4, 4);
        }
        if (!npc.met) {
          ctx.fillStyle = '#ffd66e';
          ctx.font = '900 18px Courier New, monospace';
          ctx.textAlign = 'center';
          ctx.fillText('!', nx + npc.w / 2, ny - 8);
        }
        ctx.restore();
      }
      // Collectibles
      // Notes
      for (const note of collectNotes) {
        if (note.taken) continue;
        const nx = Math.round(note.x - cameraX);
        const ny = Math.round(note.y + Math.sin(t * 3 + note.x * 0.01) * 4);
        if (nx < -30 || nx > VW + 30) continue;
        const notePop = note.spawnT > 0 ? Math.min(1, (0.5 - note.spawnT) / 0.3) : 1;
        ctx.save();
        if (notePop < 1) { ctx.translate(nx, ny); ctx.scale(notePop, notePop); ctx.translate(-nx, -ny); }
        ctx.shadowColor = '#ffd66e'; ctx.shadowBlur = 8;
        drawTinyNote(nx, ny, 1.15);
        ctx.restore();
      }
      // Pickups
      for (const pk of pickups) {
        if (pk.taken) continue;
        const px = Math.round(pk.x - cameraX);
        const py = Math.round(pk.y + Math.sin(t * 2.5 + pk.x) * 3);
        if (px < -30 || px > VW + 30) continue;
        const pkPop = pk.spawnT > 0 ? Math.min(1, (0.4 - pk.spawnT) / 0.25) : 1;
        const isAmp = pk.type === 'amp';
        ctx.save();
        if (pkPop < 1) { ctx.translate(px, py); ctx.scale(pkPop, pkPop); ctx.translate(-px, -py); }
        if (isAmp) {
          drawXpShard(px, py, 1.05);
        } else {
          drawHeartIcon(px, py, true, 1.35);
        }
        ctx.restore();
      }
      // Enemies
      for (const enemy of enemies) {
        // Death animation: fading ghost
        if (!enemy.alive && (enemy.deathTimer || 0) > 0) {
          const ex = Math.round(enemy.x - cameraX);
          const ey = Math.round(enemy.y);
          ctx.save();
          ctx.globalAlpha = Math.max(0, (enemy.deathTimer! / 0.3) * 0.6);
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(ex + 2, ey + 2, enemy.w - 4, enemy.h - 4);
          // Flicker
          if (Math.floor(t * 20) % 2 === 0) {
            ctx.fillStyle = 'rgba(255,255,255,0.3)';
            ctx.fillRect(ex, ey, enemy.w, enemy.h);
          }
          ctx.restore();
          continue;
        }
        if (!enemy.alive) continue;
        const ex = Math.round(enemy.x - cameraX);
        const ey = Math.round(enemy.y);
        if (ex + enemy.w < -20 || ex > VW + 20) continue;

        const popScale = enemy.popIn ? Math.min(1, 1 - (enemy.popIn / 0.35)) : 1;
        if (popScale < 1) ctx.save();
        if (popScale < 1) { ctx.translate(ex + enemy.w / 2, ey + enemy.h / 2); ctx.scale(popScale, popScale); ctx.translate(-(ex + enemy.w / 2), -(ey + enemy.h / 2)); }

        if (enemy.elite) {
          ctx.save();
          ctx.strokeStyle = '#ffd66e';
          ctx.lineWidth = 2;
          ctx.shadowColor = '#ffd66e';
          ctx.shadowBlur = 10;
          ctx.strokeRect(ex - 3, ey - 3, enemy.w + 6, enemy.h + 6);
          ctx.fillStyle = '#ffd66e';
          ctx.fillRect(ex + enemy.w / 2 - 8, ey - 11, 16, 4);
          ctx.fillRect(ex + enemy.w / 2 - 2, ey - 17, 4, 10);
          ctx.restore();
        }

        // === Redesigned enemy visuals ===
        const eSize = enemy.w;
        const hw = eSize / 2;
        if (enemy.type === 'slime') {
          ctx.save();
          const sq = Math.sin(t * 5 + enemy.x) * 1.5;
          ctx.fillStyle = '#44bb88';
          ctx.fillRect(ex + 4, ey + 8 + sq, eSize - 8, eSize - 8 - sq);
          ctx.fillStyle = '#55dd99';
          ctx.fillRect(ex + 3, ey + 6 + sq, eSize - 6, 8);
          ctx.fillStyle = '#226644';
          ctx.fillRect(ex + 8, ey + 12 + sq, 5, 4);
          ctx.fillRect(ex + eSize - 13, ey + 12 + sq, 5, 4);
          ctx.fillStyle = '#fff';
          ctx.fillRect(ex + 8, ey + 10 + sq, 4, 4);
          ctx.fillRect(ex + eSize - 12, ey + 10 + sq, 4, 4);
          ctx.restore();
        } else if (enemy.type === 'bat') {
          ctx.save();
          const bw = Math.sin(t * 10 + enemy.x) * 3;
          ctx.fillStyle = '#3a1a48';
          ctx.fillRect(ex + 10, ey + 6, eSize - 20, eSize - 8);
          ctx.fillStyle = '#5a2870';
          ctx.fillRect(ex + 3, ey + 4 + bw, 10, 7);
          ctx.fillRect(ex + eSize - 13, ey + 4 - bw, 10, 7);
          ctx.fillStyle = '#ff3366';
          ctx.fillRect(ex + 11, ey + 10, 3, 3);
          ctx.fillRect(ex + eSize - 14, ey + 10, 3, 3);
          ctx.fillStyle = '#ff6699';
          ctx.fillRect(ex + 12, ey + 16, eSize - 24, 3);
          ctx.restore();
        } else if (enemy.type === 'ghost') {
          ctx.save();
          const wb = Math.sin(t * 4 + enemy.x) * 2;
          ctx.fillStyle = 'rgba(180,200,255,0.65)';
          ctx.fillRect(ex + 5, ey + 2, eSize - 10, eSize - 8);
          ctx.fillRect(ex + 3, ey + eSize - 8, 5, 4 + wb);
          ctx.fillRect(ex + 10, ey + eSize - 6, 5, 4 - wb);
          ctx.fillRect(ex + 17, ey + eSize - 8, 5, 4 + wb);
          ctx.fillRect(ex + 24, ey + eSize - 6, 5, 4 - wb);
          ctx.fillStyle = 'rgba(100,130,255,0.2)';
          ctx.fillRect(ex + 2, ey + eSize - 8, eSize - 4, 6);
          ctx.fillStyle = '#334';
          ctx.fillRect(ex + 9, ey + 10, 4, 5);
          ctx.fillRect(ex + eSize - 13, ey + 10, 4, 5);
          ctx.fillStyle = '#fff';
          ctx.fillRect(ex + 10, ey + 10, 2, 3);
          ctx.fillRect(ex + eSize - 12, ey + 10, 2, 3);
          ctx.restore();
        } else if (enemy.type === 'charger') {
          ctx.save();
          const chargeDir = enemy.vx >= 0 ? 1 : -1;
          ctx.fillStyle = '#881a2a';
          ctx.fillRect(ex + 4, ey + 8, eSize - 8, eSize - 12);
          ctx.fillStyle = '#cc3355';
          ctx.fillRect(ex + 5, ey + 4, eSize - 10, 8);
          ctx.fillStyle = '#ff4477';
          ctx.fillRect(ex + (chargeDir > 0 ? eSize - 8 : 0), ey + 6, 8, 4);
          ctx.fillStyle = '#442';
          ctx.fillRect(ex + 7, ey + 14, 5, 4);
          ctx.fillRect(ex + eSize - 12, ey + 14, 5, 4);
          ctx.fillStyle = '#fff';
          ctx.fillRect(ex + (chargeDir > 0 ? eSize - 10 : 6), ey + 9, 3, 3);
          ctx.fillRect(ex + (chargeDir > 0 ? eSize - 10 : 6), ey + 9, 3, 3);
          ctx.restore();
        } else if (enemy.type === 'sniper') {
          ctx.save();
          ctx.fillStyle = '#2a2848';
          ctx.fillRect(ex + 6, ey + 6, eSize - 12, eSize - 6);
          ctx.fillStyle = '#6a5aaa';
          ctx.fillRect(ex + 8, ey + 2, eSize - 16, 6);
          ctx.fillStyle = '#8877cc';
          ctx.fillRect(ex + (player.x > enemy.x ? eSize - 4 : 0), ey + 10, 8, 5);
          ctx.fillStyle = '#fff';
          ctx.fillRect(ex + (player.x > enemy.x ? eSize - 3 : 1), ey + 11, 5, 3);
          ctx.fillStyle = '#ff4488';
          ctx.fillRect(ex + 11, ey + 12, 3, 3);
          ctx.fillRect(ex + eSize - 14, ey + 12, 3, 3);
          ctx.restore();
        } else if (enemy.type === 'shielder') {
          ctx.save();
          const sf = enemy.vx >= 0 ? 1 : -1;
          ctx.fillStyle = '#3a4050';
          ctx.fillRect(ex + 5, ey + 4, eSize - 14, eSize - 4);
          ctx.fillStyle = '#556678';
          ctx.fillRect(ex + 6, ey + 2, eSize - 16, 6);
          ctx.fillStyle = '#ff8844';
          ctx.fillRect(ex + 10, ey + 10, 4, 4);
          ctx.fillRect(ex + eSize - 16, ey + 10, 4, 4);
          ctx.fillStyle = '#7788aa';
          ctx.fillRect(sf > 0 ? ex + eSize - 6 : ex - 2, ey + 2, 8, eSize - 2);
          ctx.fillStyle = '#99aabb';
          ctx.fillRect(sf > 0 ? ex + eSize - 5 : ex - 1, ey + 5, 6, 3);
          ctx.fillRect(sf > 0 ? ex + eSize - 5 : ex - 1, ey + 11, 6, 3);
          ctx.fillRect(sf > 0 ? ex + eSize - 5 : ex - 1, ey + 17, 6, 3);
          ctx.restore();
        } else if (enemy.type === 'orbiter') {
          ctx.save();
          ctx.shadowColor = enemy.elite ? '#ff88cc' : '#aa66dd';
          ctx.shadowBlur = 16;
          ctx.fillStyle = enemy.elite ? '#ff66aa' : '#9955cc';
          ctx.beginPath();
          ctx.arc(ex + hw, ey + hw, hw - 2, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = enemy.elite ? '#ffccee' : '#ddaaff';
          ctx.beginPath();
          ctx.arc(ex + hw, ey + hw, hw / 2, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = '#fff';
          ctx.fillRect(ex + hw - 2, ey + hw - 6, 4, 4);
          ctx.fillRect(ex + hw - 5, ey + hw + 2, 3, 3);
          ctx.restore();
        } else if (enemy.type === 'bomber') {
          ctx.save();
          const bb = Math.sin(t * 6 + enemy.x * 0.02) * 2;
          // Body
          ctx.fillStyle = '#882233';
          ctx.fillRect(ex + 6, ey + 8, eSize - 12, eSize - 12);
          // Top fuse
          ctx.fillStyle = '#553322';
          ctx.fillRect(ex + hw - 2, ey + 2, 4, 8);
          // Fuse spark
          ctx.fillStyle = '#ffaa33';
          ctx.shadowColor = '#ffaa33';
          ctx.shadowBlur = 8;
          ctx.fillRect(ex + hw - 2, ey + 2, 4, 3);
          // Fins
          ctx.fillStyle = enemy.elite ? '#cc4455' : '#aa3344';
          ctx.fillRect(ex + 2, ey + hw - 3, 6, 6 + bb);
          ctx.fillRect(ex + eSize - 8, ey + hw - 3, 6, 6 - bb);
          // Eyes
          ctx.fillStyle = '#ffcc44';
          ctx.fillRect(ex + 9, ey + 14, 4, 4);
          ctx.fillRect(ex + eSize - 13, ey + 14, 4, 4);
          ctx.restore();
        } else {
          ctx.fillStyle = '#4a3a5a';
          ctx.fillRect(ex + 4, ey + 4, eSize - 8, eSize - 8);
          ctx.fillStyle = '#88ddff';
          ctx.fillRect(ex + 9, ey + 9, 4, 4);
          ctx.fillRect(ex + eSize - 13, ey + 9, 4, 4);
        }
        if (enemy.elite || enemy.hp < enemy.maxHp) {
          ctx.save();
          ctx.fillStyle = 'rgba(5,8,18,.72)';
          ctx.fillRect(ex, ey - 7, enemy.w, 4);
          ctx.fillStyle = enemy.elite ? '#ffd66e' : '#ffffff';
          ctx.fillRect(ex, ey - 7, enemy.w * Math.max(0, enemy.hp / enemy.maxHp), 4);
          ctx.restore();
        }
        if (popScale < 1) ctx.restore();
      }

      drawBoss(t);

      // Projectiles
      for (const proj of projectiles) {
        const px = Math.round(proj.x - cameraX);
        const dtDraw = 1/60;
        // Retrojected trail (2 ghost copies)
        for (let t = 1; t <= 2; t++) {
          ctx.save();
          ctx.globalAlpha = 0.12 / t;
          ctx.fillStyle = proj.color;
          ctx.shadowBlur = 0;
          const tx = Math.round(proj.x - proj.vx * dtDraw * t * 0.4 - cameraX);
          const ty = proj.y - proj.vy * dtDraw * t * 0.4;
          if (proj.shape === 'note') drawTinyNote(tx + proj.w / 2, ty + proj.h / 2, 0.7);
          else if (proj.shape === 'slash') ctx.fillRect(tx, ty, proj.w * 0.8, proj.h * 0.8);
          else if (proj.shape === 'fan') { ctx.beginPath(); ctx.moveTo(tx, ty + proj.h / 2); ctx.lineTo(tx + proj.w * 0.7, ty); ctx.lineTo(tx + proj.w * 0.7, ty + proj.h); ctx.closePath(); ctx.fill(); }
          else ctx.fillRect(tx, ty, proj.w * 0.6, proj.h * 0.6);
          ctx.restore();
        }
        // Main projectile
        ctx.save();
        ctx.fillStyle = proj.color; ctx.shadowColor = proj.color; ctx.shadowBlur = 8;
        if (proj.shape === 'note') {
          const rot = performance.now() * 0.006 + proj.x * 0.002;
          drawTinyNote(px + proj.w / 2, proj.y + proj.h / 2, 0.82, rot);
        } else if (proj.shape === 'slash') {
          ctx.shadowBlur = 12;
          ctx.fillRect(px, proj.y, proj.w, proj.h);
          ctx.fillStyle = 'rgba(255,255,255,.72)';
          ctx.fillRect(px + 6, proj.y + 3, Math.max(10, proj.w * 0.42), 3);
        } else if (proj.shape === 'fan') {
          const spin = performance.now() * 0.01;
          ctx.translate(px + proj.w / 2, proj.y + proj.h / 2);
          ctx.rotate(spin);
          ctx.beginPath();
          ctx.moveTo(-proj.w / 2, 0);
          ctx.lineTo(proj.w / 2, -proj.h / 2);
          ctx.lineTo(proj.w / 2, proj.h / 2);
          ctx.closePath();
          ctx.fill();
        } else if (proj.shape === 'paint') {
          ctx.shadowBlur = 14;
          ctx.beginPath();
          ctx.ellipse(px + proj.w / 2, proj.y + proj.h / 2, proj.w / 2, proj.h / 2, 0, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = 'rgba(255,255,255,.6)';
          ctx.beginPath();
          ctx.arc(px + proj.w / 2 - 3, proj.y + proj.h / 2 - 3, proj.w * 0.15, 0, Math.PI * 2);
          ctx.fill();
        } else if (proj.shape === 'beam') {
          ctx.shadowBlur = 16;
          ctx.fillRect(px, proj.y, proj.w, proj.h);
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(px + 4, proj.y + 2, Math.max(6, proj.w - 12), Math.max(2, proj.h - 4));
        } else if (proj.shape === 'bomb') {
          ctx.shadowBlur = 14;
          ctx.beginPath();
          ctx.arc(px + proj.w / 2, proj.y + proj.h / 2, proj.w / 2, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = '#ffcc44';
          ctx.shadowBlur = 6;
          ctx.beginPath();
          ctx.arc(px + proj.w / 2, proj.y + proj.h / 2 - 2, 3, 0, Math.PI * 2);
          ctx.fill();
        } else {
          ctx.fillRect(px, proj.y, proj.w, proj.h);
          ctx.fillStyle = '#fff';
          if (proj.w <= 48) ctx.fillRect(px + 4, proj.y + 3, Math.max(3, proj.w * 0.35), Math.max(3, proj.h * 0.3));
        }
        ctx.restore();
      }
      // Player
      drawPlayer(t);

      // Particles
      ctx.save();
      for (const p of particles) {
        ctx.globalAlpha = Math.max(0, p.life * 3);
        ctx.fillStyle = p.color;
        const sz = p.size * Math.max(0.3, p.life * 2);
        ctx.fillRect(Math.round(p.x - cameraX), Math.round(p.y), sz, sz);
      }
      ctx.restore();

      // Floating texts (score popups)
      ctx.save();
      for (const ft of floatingTexts) {
        ctx.globalAlpha = Math.min(1, ft.life * 3);
        ctx.fillStyle = ft.color;
        ctx.font = 'bold 14px "Courier New", monospace';
        ctx.textAlign = 'center';
        ctx.shadowColor = 'rgba(0,0,0,.6)';
        ctx.shadowBlur = 4;
        ctx.fillText(ft.text, Math.round(ft.x - cameraX), Math.round(ft.y));
      }
      ctx.restore();

      // Front-layer decorations
      for (const d of decors) {
        if (d.layer !== 'front') continue;
        const dx = Math.round(d.x - cameraX * d.parallax);
        if (dx + d.w < -60 || dx > VW + 60) continue;
        ctx.save();
        ctx.globalAlpha = 0.18;
        drawDecorShape(d.type, dx, d.y, d.w, d.h, stage.accent);
        ctx.restore();
      }

      // Ambient weather particles
      ctx.save();
      for (const ap of ambientParticles) {
        ctx.globalAlpha = Math.min(1, ap.life / ap.maxLife) * 0.6;
        ctx.fillStyle = ap.color;
        if (selStage === 0) {
          // Rain: thin line
          ctx.fillRect(Math.round(ap.x - cameraX), Math.round(ap.y), 1, ap.size * 3);
        } else if (selStage === 1) {
          // Cherry blossom: small diamond
          const sx = Math.round(ap.x - cameraX), sy = Math.round(ap.y);
          ctx.beginPath();
          ctx.moveTo(sx, sy - ap.size);
          ctx.lineTo(sx + ap.size * 0.7, sy);
          ctx.lineTo(sx, sy + ap.size);
          ctx.lineTo(sx - ap.size * 0.7, sy);
          ctx.closePath();
          ctx.fill();
        } else if (selStage === 2) {
          // Light particles: circle
          ctx.beginPath();
          ctx.arc(Math.round(ap.x - cameraX), Math.round(ap.y), ap.size, 0, Math.PI * 2);
          ctx.fill();
        } else {
          // Dark energy: glowing square
          ctx.shadowColor = ap.color;
          ctx.shadowBlur = 6;
          ctx.fillRect(Math.round(ap.x - cameraX), Math.round(ap.y), ap.size, ap.size);
        }
      }
      ctx.restore();

      // Stage clear overlay
      if (stageClearTimer > 0) {
        ctx.save();
        ctx.globalAlpha = Math.min(1, stageClearTimer * 2);
        ctx.fillStyle = '#000';
        ctx.fillRect(0, 0, VW, VH);
        ctx.globalAlpha = Math.min(1, stageClearTimer * 1.5);
        ctx.fillStyle = '#fff';
        ctx.font = '900 42px "Courier New", monospace'; ctx.textAlign = 'center';
        ctx.shadowColor = STAGES[selStage].accent; ctx.shadowBlur = 30;
        ctx.fillText('STAGE CLEAR', VW / 2, VH / 2 - 16);
        ctx.shadowBlur = 0;
        ctx.font = '700 18px "Noto Sans SC", sans-serif';
        ctx.fillStyle = STAGES[selStage].accent;
        ctx.fillText(STAGES[selStage].name, VW / 2, VH / 2 + 30);
        ctx.restore();
      }

      // Vignette overlay
      const vig = ctx.createRadialGradient(VW / 2, VH / 2, VH * 0.25, VW / 2, VH / 2, VH * 0.8);
      vig.addColorStop(0, 'rgba(0,0,0,0)');
      vig.addColorStop(1, 'rgba(0,0,0,.45)');
      ctx.fillStyle = vig;
      ctx.fillRect(-10, -10, VW + 20, VH + 20);

      // Hit flash overlay
      if (player && player.invuln > 0.8) {
        ctx.fillStyle = `rgba(255,50,50,${(player.invuln - 0.8) * 0.12})`;
        ctx.fillRect(0, 0, VW, VH);
      }
      // Screen flash (boss phase transition)
      if (screenFlash > 0) {
        ctx.save();
        ctx.globalAlpha = Math.min(0.5, screenFlash * 1.2);
        ctx.fillStyle = screenFlashColor;
        ctx.fillRect(0, 0, VW, VH);
        ctx.restore();
      }
    }

    function drawDecorShape(type: string, x: number, y: number, w: number, h: number, accent: string) {
      if (type === 'lamp') {
        ctx.fillStyle = '#445566';
        ctx.fillRect(x + w / 2 - 2, y, 4, h);
        ctx.fillStyle = accent;
        ctx.fillRect(x + w / 2 - 6, y, 12, 8);
        ctx.fillStyle = hexRgba(accent, 0.3);
        ctx.fillRect(x + w / 2 - 10, y + 8, 20, 4);
      } else if (type === 'bench') {
        ctx.fillStyle = '#554433';
        ctx.fillRect(x, y + h - 6, w, 6);
        ctx.fillRect(x + 4, y + h - 16, 4, 16);
        ctx.fillRect(x + w - 8, y + h - 16, 4, 16);
        ctx.fillStyle = '#665544';
        ctx.fillRect(x, y + h - 12, w, 4);
      } else if (type === 'vending') {
        ctx.fillStyle = '#2a3040';
        ctx.fillRect(x, y, w, h);
        ctx.fillStyle = '#446688';
        ctx.fillRect(x + 3, y + 4, w - 6, h * 0.55);
        ctx.fillStyle = accent;
        ctx.fillRect(x + 4, y + h * 0.6 + 4, 8, 4);
        ctx.fillRect(x + w - 12, y + h * 0.6 + 4, 8, 4);
      } else if (type === 'brokenNote') {
        ctx.fillStyle = accent;
        ctx.fillRect(x + 2, y, 4, h);
        ctx.fillRect(x, y + 2, 8, 6);
        ctx.fillStyle = hexRgba(accent, 0.5);
        ctx.fillRect(x + 6, y + h * 0.3, 10, 4);
      } else if (type === 'shard') {
        ctx.fillStyle = hexRgba(accent, 0.7);
        ctx.beginPath();
        ctx.moveTo(x + w / 2, y);
        ctx.lineTo(x + w, y + h * 0.7);
        ctx.lineTo(x + w * 0.3, y + h);
        ctx.lineTo(x, y + h * 0.4);
        ctx.closePath();
        ctx.fill();
      } else if (type === 'twistedTree') {
        ctx.fillStyle = '#3a2838';
        ctx.fillRect(x + w / 2 - 4, y + h * 0.4, 8, h * 0.6);
        ctx.fillStyle = '#4a3848';
        ctx.fillRect(x + w / 2 - 3, y + h * 0.3, 6, h * 0.15);
        ctx.fillStyle = hexRgba(accent, 0.4);
        ctx.beginPath();
        ctx.arc(x + w / 2, y + h * 0.25, w * 0.45, 0, Math.PI * 2);
        ctx.fill();
      } else if (type === 'pillar') {
        ctx.fillStyle = '#38304a';
        ctx.fillRect(x, y, w, h);
        ctx.fillStyle = '#4a405a';
        ctx.fillRect(x - 2, y, w + 4, 8);
        ctx.fillRect(x - 2, y + h - 8, w + 4, 8);
      } else if (type === 'lantern') {
        ctx.fillStyle = accent;
        ctx.fillRect(x + w / 2 - 1, y, 2, h * 0.3);
        ctx.fillStyle = hexRgba(accent, 0.8);
        ctx.fillRect(x, y + h * 0.3, w, h * 0.7);
        ctx.fillStyle = '#fff';
        ctx.fillRect(x + w / 2 - 2, y + h * 0.4, 4, 4);
      } else if (type === 'stageLight') {
        ctx.fillStyle = '#333344';
        ctx.fillRect(x, y, w, h * 0.3);
        ctx.fillStyle = accent;
        ctx.fillRect(x + 2, y + h * 0.3, w - 4, h * 0.7);
        ctx.fillStyle = hexRgba(accent, 0.2);
        ctx.beginPath();
        ctx.moveTo(x + w / 2, y + h);
        ctx.lineTo(x - 20, y + h + 60);
        ctx.lineTo(x + w + 20, y + h + 60);
        ctx.closePath();
        ctx.fill();
      } else if (type === 'curtain') {
        ctx.fillStyle = hexRgba('#cc2244', 0.6);
        ctx.fillRect(x, y, w, h);
        for (let cy = 0; cy < h; cy += 12) {
          ctx.fillStyle = hexRgba('#aa1133', 0.3);
          ctx.fillRect(x, y + cy, w, 3);
        }
      } else if (type === 'speaker') {
        ctx.fillStyle = '#222233';
        ctx.fillRect(x, y, w, h);
        ctx.fillStyle = '#333344';
        ctx.fillRect(x + 4, y + 4, w - 8, h - 8);
        ctx.fillStyle = accent;
        ctx.beginPath();
        ctx.arc(x + w / 2, y + h / 2, w * 0.3, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#222233';
        ctx.beginPath();
        ctx.arc(x + w / 2, y + h / 2, w * 0.12, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    function drawBoss(t: number) {
      if (!boss) return;
      if (!boss.alive && bossDefeatCutscene > 0) return;
      if (boss.isMfy) return drawBossMfy(t);
      const bx = Math.round(boss.x - cameraX), by = Math.round(boss.y);
      if (bx + boss.w < -120 || bx > VW + 140) return;
  if (boss.beamWarn > 0) {
    ctx.save();
    const bCx = boss.beamX - cameraX;
    const alpha = 0.2 + Math.sin(t * 36) * 0.12;
    ctx.fillStyle = `rgba(255,50,200,${alpha})`;
    ctx.fillRect(bCx - 100, boss.beamY - 14, 200, 28);
    ctx.strokeStyle = `rgba(255,100,220,${0.3 + Math.sin(t * 24) * 0.15})`;
    ctx.lineWidth = 2;
    ctx.strokeRect(bCx - 100, boss.beamY - 14, 200, 28);
    ctx.fillStyle = `rgba(255,255,255,${0.5 + Math.sin(t * 30) * 0.2})`;
    ctx.fillRect(bCx - 100, boss.beamY - 1, 200, 2);
    ctx.font = 'bold 16px "Courier New", monospace'; ctx.textAlign = 'center';
    ctx.fillStyle = `rgba(255,255,255,${0.3 + Math.sin(t * 24) * 0.15})`;
    ctx.fillText('⚡ 光束范围 ⚡', bCx, boss.beamY - 24);
    ctx.restore();
  }
      // Rain warning zone
      if (boss.alive && boss.pattern === 'rain' && boss.burstCount === 0) {
        ctx.save();
        ctx.fillStyle = `rgba(200,100,255,${0.06 + Math.sin(t * 8) * 0.03})`;
        ctx.fillRect(VW / 2 - 200, VH - 80, 400, 60);
        ctx.strokeStyle = `rgba(200,100,255,${0.15 + Math.sin(t * 8) * 0.08})`;
        ctx.lineWidth = 1.5;
        ctx.strokeRect(VW / 2 - 200, VH - 80, 400, 60);
        ctx.restore();
      }
      // Wave direction warning
      if (boss.alive && boss.pattern === 'wave' && boss.burstCount === 0) {
        ctx.save();
        ctx.fillStyle = `rgba(255,150,200,${0.08 + Math.sin(t * 10) * 0.04})`;
        ctx.fillRect(0, VH - 70, 80, 50);
        ctx.globalAlpha = 0.3 + Math.sin(t * 10) * 0.15;
        ctx.fillStyle = '#ff99cc'; ctx.font = '24px "Courier New", monospace'; ctx.textAlign = 'center';
        ctx.fillText('◀', 40, VH - 40);
        ctx.restore();
      }
      ctx.save();
      ctx.fillStyle = 'rgba(0,0,0,0.22)'; ctx.beginPath(); ctx.ellipse(bx + boss.w / 2, by + boss.h + 6, boss.w * 0.48, 8, 0, 0, Math.PI * 2); ctx.fill();
      let img = bossImages.idle;
      if (!boss.alive) { const defeatOrder = [bossImages.defeat1, bossImages.defeat2, bossImages.fade1, bossImages.fade2, bossImages.fade3]; img = defeatOrder[Math.min(defeatOrder.length - 1, Math.floor(t * 8) % defeatOrder.length)]; }
      else if (boss.pattern === 'volley') img = bossImages.volley;
      else if (boss.pattern === 'rain' || boss.beamWarn > 0) img = bossImages.rain;
      else if (boss.pattern === 'wave') img = bossImages.wave;
      const drawW = boss.alive ? 154 : 170, drawH = 190, bob = boss.alive ? Math.sin(t * 3) * 4 : 0;
      ctx.imageSmoothingEnabled = false;
      if (img && img.complete && img.naturalWidth > 0) ctx.drawImage(img, bx + boss.w / 2 - drawW / 2, by + boss.h - drawH + bob, drawW, drawH);
      else { ctx.fillStyle = '#b78cff'; ctx.fillRect(bx, by, boss.w, boss.h); ctx.fillStyle = '#fff'; ctx.fillRect(bx + 26, by + 34, 12, 12); ctx.fillRect(bx + 58, by + 34, 12, 12); }
      ctx.restore();
      if (boss.alive) {
        ctx.save(); const barW = 360, barX = VW / 2 - barW / 2;
        ctx.fillStyle = 'rgba(5,8,18,0.78)'; ctx.fillRect(barX, 48, barW, 18);
        ctx.fillStyle = '#ff66dd'; ctx.fillRect(barX + 3, 51, (barW - 6) * (boss.hp / boss.maxHp), 12);
        ctx.strokeStyle = 'rgba(255,255,255,0.35)'; ctx.strokeRect(barX, 48, barW, 18);
        ctx.fillStyle = '#fff'; ctx.font = '900 12px Courier New, monospace'; ctx.textAlign = 'center'; ctx.fillText(`25 初音核心  第${boss.phase}阶段`, VW / 2, 43);
        ctx.restore();
      }
    }
    function drawBossMfy(t: number) {
      if (!boss || !boss.isMfy) return;
      if (!boss.alive && bossDefeatCutscene > 0) return;
      const bx = Math.round(boss.x - cameraX), by = Math.round(boss.y);
      if (bx + boss.w < -120 || bx > VW + 140) return;
      // Liberation channel indicator
      if (boss.pattern === 'liberate') {
        ctx.save();
        const pulse = 0.15 + Math.sin(t * 10) * 0.08;
        ctx.fillStyle = `rgba(187,102,238,${pulse})`;
        ctx.fillRect(0, 0, VW, VH);
        // "血潮" text
        ctx.textAlign = 'center';
        ctx.font = '900 36px "Courier New", monospace';
        ctx.fillStyle = `rgba(187,102,238,${0.3 + Math.sin(t * 6) * 0.15})`;
        ctx.fillText('血  潮', VW / 2, VH / 2 - 40);
        ctx.font = 'bold 14px "Courier New", monospace';
        ctx.fillStyle = `rgba(255,255,255,${0.2 + Math.sin(t * 4) * 0.1})`;
        ctx.fillText(`解放中... ${Math.max(0, Math.ceil(boss.liberateT!))}s`, VW / 2, VH / 2 + 10);
        ctx.restore();
      }
      ctx.save();
      ctx.fillStyle = 'rgba(0,0,0,0.22)'; ctx.beginPath(); ctx.ellipse(bx + boss.w / 2, by + boss.h + 6, boss.w * 0.48, 8, 0, 0, Math.PI * 2); ctx.fill();
      let img = mfyBossImages.idle;
      if (boss.pattern === 'liberate') img = mfyBossImages.liberate;
      else if (boss.pattern === 'volley') img = mfyBossImages.attack;
      const drawW = 140, drawH = 176, bob = Math.sin(t * 3) * 4;
      ctx.imageSmoothingEnabled = false;
      if (img && img.complete && img.naturalWidth > 0) ctx.drawImage(img, bx + boss.w / 2 - drawW / 2, by + boss.h - drawH + bob, drawW, drawH);
      else { ctx.fillStyle = '#bb66ee'; ctx.fillRect(bx, by, boss.w, boss.h); ctx.fillStyle = '#fff'; ctx.fillRect(bx + 20, by + 40, 10, 10); ctx.fillRect(bx + 60, by + 40, 10, 10); }
      ctx.restore();
      // HP Bar
      if (boss.alive) {
        ctx.save(); const barW = 360, barX = VW / 2 - barW / 2;
        ctx.fillStyle = 'rgba(5,8,18,0.78)'; ctx.fillRect(barX, 48, barW, 18);
        const hpPct = boss.hp / boss.maxHp;
        const barColor = hpPct > 0.5 ? '#bb66ee' : hpPct > 0.25 ? '#ee8844' : '#ee3355';
        ctx.fillStyle = barColor; ctx.fillRect(barX + 3, 51, (barW - 6) * hpPct, 12);
        ctx.strokeStyle = 'rgba(255,255,255,0.35)'; ctx.strokeRect(barX, 48, barW, 18);
        ctx.fillStyle = '#fff'; ctx.font = '900 12px Courier New, monospace'; ctx.textAlign = 'center';
        ctx.fillText(`Mafuyu  第${boss.phase}阶段`, VW / 2, 43);
        ctx.restore();
      }
    }
    function drawPlayer(t: number) {
      const c = CHARS[selChar];
      const px = Math.round(player.x - cameraX);
      const py = Math.round(player.y);

      if (player.invuln > 0 && Math.floor(t * 16) % 2 === 0) return;

      const dir = player.facing;
      const isMafuyu = selChar === 1;
      let img = charImages[selChar];
      if (isMafuyu) {
        if (animState === 'attack') img = mfyImages.attack;
        else if (animState === 'run') img = mfyRunImages[animFrame % mfyRunImages.length] || mfyImages.idle;
        else if (animState === 'jump') img = mfyImages.jump;
        else if (animState === 'fall') img = mfyImages.fall;
        else img = mfyImages.idle;
      }
      const color = c.color;
      const W = player.w, H = player.h;

      // Sprite draw dimensions. Mafuyu uses full action-frame PNGs from /public/mfy.
      const spW = isMafuyu ? (animState === 'attack' ? 92 : animState === 'run' ? 82 : 76) : 50;
      const spH = isMafuyu ? (animState === 'attack' ? 92 : animState === 'run' ? 82 : 76) : 58;
      const spLift = isMafuyu ? 8 : 2;
      const legH_px = 12; // height of the leg region at bottom of PNG to overlay

      // --- Transforms ---
      let sx = 1, sy = 1, tilt = 0, bob = 0;

      switch (animState) {
        case 'idle':
          bob = Math.sin(t * 3) * 2;
          break;
        case 'run': {
          const phase = animFrame * Math.PI / 3;
          bob = Math.abs(Math.sin(phase)) * -3;
          tilt = Math.sin(phase) * 0.06 * dir;
          sx = 1 + Math.sin(phase) * 0.04;
          sy = 1 - Math.sin(phase) * 0.04;
          break;
        }
        case 'jump':
          sy = Math.min(1.12, 1 + Math.abs(player.vy) / 3000);
          sx = 1 / sy;
          tilt = -0.08 * dir;
          break;
        case 'fall':
          sx = Math.min(1.1, 1 + player.vy / 3000);
          sy = 1 / sx;
          tilt = 0.05 * dir;
          break;
        case 'attack':
          tilt = 0.1 * dir;
          bob = -2;
          sx = 1.06;
          sy = 0.94;
          break;
      }

      // --- Shadow ---
      ctx.fillStyle = 'rgba(0,0,0,0.18)';
      ctx.beginPath();
      ctx.ellipse(px + W / 2, py + H + 2, W * 0.55, 4, 0, 0, Math.PI * 2);
      ctx.fill();

      // --- Main character draw (PNG + animated legs) ---
      ctx.save();
      ctx.translate(px + W / 2, py + H + bob);
      if (dir < 0) ctx.scale(-sx, sy);
      else ctx.scale(sx, sy);
      if (tilt) ctx.rotate(tilt);

      ctx.imageSmoothingEnabled = false;

      // Draw the original PNG sprite
      if (img && img.complete && img.naturalWidth > 0) {
        ctx.drawImage(img, -spW / 2, -spH + spLift, spW, spH);
      } else {
        ctx.fillStyle = color;
        ctx.fillRect(-spW / 2, -spH + 2, spW, spH);
      }

      // --- Animated legs overlay ---
      // Cover the bottom leg region of the PNG with moving legs
      if (!isMafuyu) {
        const legDark = hexRgba(color, 0.55);
        const legLight = hexRgba(color, 0.75);
        const shoeColor = hexRgba('#000000', 0.35);
        const legW = 9, footY = 0; // footY=0 means at the transform origin (feet)

        switch (animState) {
          case 'idle': {
            const ib = Math.sin(t * 2.5) * 1.5;
            ctx.fillStyle = legDark;
            ctx.fillRect(-10, footY - legH_px + ib, legW, legH_px);
            ctx.fillRect(1, footY - legH_px + ib, legW, legH_px);
            ctx.fillStyle = shoeColor;
            ctx.fillRect(-11, footY - 3 + ib, legW + 2, 3);
            ctx.fillRect(0, footY - 3 + ib, legW + 2, 3);
            break;
          }
          case 'run': {
            const phase = animFrame * Math.PI / 3;
            const l1 = Math.sin(phase) * 10, l2 = Math.sin(phase + Math.PI) * 10;
            const b1 = Math.abs(Math.sin(phase)) * -4, b2 = Math.abs(Math.sin(phase + Math.PI)) * -4;
            ctx.fillStyle = legDark;
            ctx.fillRect(-10, footY - legH_px + b1, legW, legH_px + l1);
            ctx.fillRect(1, footY - legH_px + b2, legW, legH_px + l2);
            ctx.fillStyle = legLight;
            ctx.fillRect(-9, footY - legH_px + 2 + b1, legW - 2, 3);
            ctx.fillRect(2, footY - legH_px + 2 + b2, legW - 2, 3);
            ctx.fillStyle = shoeColor;
            ctx.fillRect(-11, footY - 3 + b1 + l1, legW + 3, 3);
            ctx.fillRect(0, footY - 3 + b2 + l2, legW + 3, 3);
            break;
          }
          case 'jump': {
            ctx.fillStyle = legDark;
            ctx.fillRect(-11, footY - legH_px + 4, legW, legH_px - 6);
            ctx.fillRect(2, footY - legH_px + 4, legW, legH_px - 6);
            ctx.fillStyle = shoeColor;
            ctx.fillRect(-12, footY - legH_px + legH_px - 4, legW + 2, 3);
            ctx.fillRect(1, footY - legH_px + legH_px - 4, legW + 2, 3);
            break;
          }
          case 'fall': {
            ctx.fillStyle = legDark;
            ctx.fillRect(-13, footY - legH_px - 2, legW, legH_px + 4);
            ctx.fillRect(4, footY - legH_px - 2, legW, legH_px + 4);
            ctx.fillStyle = shoeColor;
            ctx.fillRect(-14, footY + 1, legW + 2, 3);
            ctx.fillRect(3, footY + 1, legW + 2, 3);
            break;
          }
          case 'attack': {
            ctx.fillStyle = legDark;
            ctx.fillRect(-11, footY - legH_px + 3, legW, legH_px - 2);
            ctx.fillRect(3, footY - legH_px - 2, legW, legH_px + 5);
            ctx.fillStyle = shoeColor;
            ctx.fillRect(-12, footY - 1, legW + 2, 3);
            ctx.fillRect(2, footY + 1, legW + 3, 3);
            break;
          }
        }
      }

      ctx.restore();

      // === EFFECTS (world-space, outside character transform) ===

      // --- Idle: subtle glow pulse ---
      if (animState === 'idle') {
        const pulse = (Math.sin(t * 2) + 1) * 0.5;
        ctx.fillStyle = hexRgba(color, 0.06 * pulse);
        ctx.beginPath();
        ctx.ellipse(px + W / 2, py + H / 2 + bob, 24, 28, 0, 0, Math.PI * 2);
        ctx.fill();
      }

      // --- Run: dust particles ---
      if (animState === 'run') {
        if (Math.random() < 0.4) {
          particles.push({
            x: player.x + W / 2 - dir * 12,
            y: player.y + H - 2,
            vx: -dir * (20 + Math.random() * 30),
            vy: -(10 + Math.random() * 20),
            life: 0.3 + Math.random() * 0.1,
            color: 'rgba(200,200,200,0.4)',
            size: 2 + Math.random() * 2,
          });
        }
        // Speed lines
        if (Math.random() < 0.25) {
          ctx.fillStyle = hexRgba(color, 0.12);
          const lx = px + W / 2 - dir * (18 + Math.random() * 14);
          ctx.fillRect(lx, py + 6 + Math.random() * 28, 2, 8 + Math.random() * 6);
        }
      }

      // --- Jump: launch particles ---
      if (animState === 'jump' && player.vy < -400) {
        for (let i = 0; i < 2; i++) {
          particles.push({
            x: player.x + W / 2 + (Math.random() - 0.5) * 20,
            y: player.y + H,
            vx: (Math.random() - 0.5) * 60,
            vy: 30 + Math.random() * 40,
            life: 0.3,
            color: '#fff',
            size: 2 + Math.random() * 2,
          });
        }
      }

      // --- Fall: wind streaks ---
      if (animState === 'fall' && player.vy > 250) {
        ctx.save();
        for (let i = 0; i < 3; i++) {
          ctx.fillStyle = hexRgba('#ffffff', 0.08 + i * 0.02);
          ctx.fillRect(px + 4 + i * 10, py - 4 - i * 8, 2, 10 + i * 4);
        }
        ctx.restore();
      }

      // --- Attack: weapon glow + slash arc + afterimage ---
      if (animState === 'attack') {
        const atkProg = player.atkTimer / c.atkCd;

        // Weapon orb
        const orbX = px + W / 2 + dir * (22 + (1 - atkProg) * 10);
        const orbY = py + H / 2 - 4;
        ctx.save();
        ctx.fillStyle = hexRgba(color, 0.45 * atkProg);
        ctx.shadowColor = color;
        ctx.shadowBlur = 10;
        ctx.fillRect(orbX - 9, orbY - 9, 18, 18);
        ctx.fillStyle = '#fff';
        ctx.fillRect(orbX - 3, orbY - 3, 6, 6);
        ctx.restore();

        // Slash arc
        if (atkProg > 0.5) {
          ctx.save();
          ctx.globalAlpha = (atkProg - 0.5) * 2;
          ctx.strokeStyle = '#fff';
          ctx.lineWidth = 2;
          ctx.beginPath();
          const arcCX = px + W / 2 + dir * 26;
          ctx.arc(arcCX, py + H / 2, 16, dir > 0 ? -0.8 : Math.PI - 0.8, dir > 0 ? 0.8 : Math.PI + 0.8);
          ctx.stroke();
          ctx.restore();
        }

        // Afterimage
        ctx.save();
        ctx.globalAlpha = 0.12;
        ctx.imageSmoothingEnabled = false;
        if (img && img.complete && img.naturalWidth > 0) {
          ctx.drawImage(img, px + W / 2 - spW / 2 - dir * 10, py + H - spH + spLift + bob, spW, spH);
        }
        ctx.restore();
      }

    }

    // --- Game Loop ---
    function loop(time: number) {
      const dt = Math.min(0.032, (time - lastTime) / 1000 || 0);
      lastTime = time;
      update(dt);
      render(time);
      raf = requestAnimationFrame(loop);
    }

    // --- UI Events ---
    document.querySelectorAll<HTMLButtonElement>('.stage-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        const nextStage = parseInt(btn.dataset.stage || '0');
        if (!isStageUnlocked(nextStage)) {
          showTitleHint('先通关前一幕，才能进入后续关卡。');
          updateStageLocks();
          return;
        }
        selStage = nextStage;
        sfxSelect();
        updateStageLocks();
        setAccent(STAGES[selStage].accent);
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.char-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const nextChar = parseInt(btn.dataset.char || '0');
        if (!isCharUnlocked(nextChar)) {
          showTitleHint('这个角色还没有解锁，先用 Mafuyu 推进关卡。');
          updateCharacterLocks();
          return;
        }
        selChar = nextChar;
        sfxSelect();
        updateCharacterLocks();
      });
    });

    document.getElementById('goBtn')!.addEventListener('click', () => {
      if (!isStageUnlocked(selStage)) { showTitleHint('先通关前一幕，才能进入后续关卡。'); refreshProgressUi(); return; }
      if (!isCharUnlocked(selChar)) { selChar = 1; refreshProgressUi(); }
      sfxSelect();
      initGame(true);
    });
    document.getElementById('retryBtn')!.addEventListener('click', () => { sfxSelect(); if (pendingNextStage) { selStage++; activateStageButton(); setAccent(STAGES[selStage].accent); initGame(false); } else initGame(true); });
    document.getElementById('backBtn')!.addEventListener('click', () => { sfxBack(); returnToMenu(); });
    document.getElementById('gameFullscreenBtn')!.addEventListener('click', toggleFullscreen);
    pauseBtn.addEventListener('click', () => setPaused(!paused));
    resumeBtn.addEventListener('click', () => setPaused(false));
    document.getElementById('pauseMenuBtn')!.addEventListener('click', () => { sfxBack(); returnToMenu(); });
    abilityChoices.addEventListener('click', e => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.ability-card');
      if (!btn) return;
      chooseAbility(parseInt(btn.dataset.ability || '0'));
    });

    // Easter egg: play "旅に帰る" in shuffle mode on SekaiPlayer to unlock super mode
    window.addEventListener('sekai-song-change', ((e: CustomEvent) => {
      if (running && !finished && e.detail.shuffle && e.detail.playing && e.detail.title === '旅に帰る') {
        unlockSuperMode();
      }
    }) as EventListener);

    window.addEventListener('resize', resizeCanvas);

    document.addEventListener('astro:before-swap', () => cancelAnimationFrame(raf), { once: true });

    // Initial canvas sizing
    resizeCanvas();

    // Start render loop
    loadSave();
    refreshProgressUi();
    raf = requestAnimationFrame(loop);
  </script>
</BaseLayout>
