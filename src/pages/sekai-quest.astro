---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="SEKAI DASH | 搁浅 的小窝" description="PJSK 像素风动作闯关 — 选择角色，穿越 SEKAI！">
  <section class="dash-shell" id="dashShell">

    <!-- Title Screen -->
    <div class="title-screen" id="titleScreen">
      <div class="title-logo">
        <span class="title-sub">Fan-made pixel adventure</span>
        <h1 class="title-main">SEKAI DASH</h1>
      </div>

      <div class="stage-select" id="stageSelect">
        <h2 class="sel-label">STAGE</h2>
        <div class="stage-pills" id="stagePills">
          <button class="stage-pill active" data-stage="0"><span class="pill-dot" style="background:#45d"></span>Leo/need</button>
          <button class="stage-pill" data-stage="1"><span class="pill-dot" style="background:#8d4"></span>MMJ</button>
          <button class="stage-pill" data-stage="2"><span class="pill-dot" style="background:#e16"></span>VBS</button>
          <button class="stage-pill" data-stage="3"><span class="pill-dot" style="background:#849"></span>25ji</button>
        </div>
      </div>

      <div class="char-select">
        <h2 class="sel-label">CHARACTER</h2>
        <div class="char-row" id="charRow">
          <button class="char-btn" data-char="0">
            <img src="/knd.png" alt="Kanade" /><span>Kanade</span><small>Balance</small>
          </button>
          <button class="char-btn active" data-char="1">
            <img src="/mfy/mfy1.png" alt="Mafuyu" /><span>Mafuyu</span><small>Power</small>
          </button>
          <button class="char-btn" data-char="2">
            <img src="/mzk.png" alt="Mizuki" /><span>Mizuki</span><small>Speed</small>
          </button>
          <button class="char-btn" data-char="3">
            <img src="/ena.png" alt="Ena" /><span>Ena</span><small>Agile</small>
          </button>
          <button class="char-btn" data-char="4">
            <img src="/25miku.png" alt="Miku" /><span>Miku</span><small>Ranged</small>
          </button>
        </div>
      </div>

      <button class="go-btn" id="goBtn">
        <span class="go-text">START</span>
        <span class="go-keys">← → ↑ J</span>
      </button>
    </div>

    <!-- Game Screen -->
    <div class="game-screen hidden" id="gameScreen">
      <canvas class="game-canvas" id="gameCanvas" width="960" height="540"></canvas>
      <div class="game-hud-top">
        <div class="hud-hp" id="hudHp"></div>
        <div class="hud-notes"><span>♪</span><strong id="hudNotes">0</strong></div>
        <div class="hud-score"><strong id="hudScore">0</strong></div>
      </div>
      <div class="game-msg" id="gameMsg"></div>
    </div>

    <!-- Results -->
    <div class="results-screen hidden" id="resultsScreen">
      <div class="results-card">
        <div class="res-title" id="resTitle">STAGE CLEAR!</div>
        <div class="res-stats">
          <div class="res-row"><span>Notes</span><strong id="resNotes">0</strong></div>
          <div class="res-row"><span>Enemies</span><strong id="resEnemies">0</strong></div>
          <div class="res-row"><span>Score</span><strong id="resScore">0</strong></div>
        </div>
        <div class="res-actions">
          <button class="retry-btn" id="retryBtn">RETRY</button>
          <button class="back-btn" id="backBtn">MENU</button>
        </div>
      </div>
    </div>

    <!-- Touch Controls -->
    <div class="touch-controls hidden" id="touchControls">
      <div class="touch-left">
        <button class="t-btn" data-dir="left">◀</button>
        <button class="t-btn" data-dir="right">▶</button>
      </div>
      <div class="touch-right">
        <button class="t-btn t-jump" data-dir="jump">↑</button>
        <button class="t-btn t-atk" data-dir="attack">♪</button>
      </div>
    </div>
  </section>

  <style>
    :root { --dash-accent: #45d; --dash-accent-rgb: 68,85,221; }

    .dash-shell { min-height: calc(100vh - 190px); color: var(--text); user-select: none; -webkit-user-select: none; }

    .hidden { display: none !important; }

    /* ===== Title ===== */
    .title-screen { display: grid; gap: 24px; padding: 20px 18px; max-width: 820px; margin: 0 auto; }
    .title-logo { text-align: center; }
    .title-sub { display: block; font-size: .76rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--dash-accent); margin-bottom: 4px; }
    .title-main { margin: 0; font-family: 'Courier New', monospace; font-size: clamp(2.6rem, 8vw, 5rem); font-weight: 900; line-height: .95; background: linear-gradient(135deg, #fff 30%, var(--dash-accent)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; filter: drop-shadow(0 0 28px rgba(var(--dash-accent-rgb), .3)); }

    .sel-label { margin: 0 0 8px; font-size: .72rem; font-weight: 800; letter-spacing: .1em; color: var(--muted); }

    .stage-pills { display: flex; flex-wrap: wrap; gap: 8px; }
    .stage-pill { display: flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 12px; border: 1.5px solid var(--panel-border); background: var(--panel); color: var(--text-soft); font-family: inherit; font-size: .88rem; font-weight: 700; cursor: pointer; transition: all 160ms ease; }
    .stage-pill:hover { border-color: rgba(var(--dash-accent-rgb), .4); }
    .stage-pill.active { border-color: var(--dash-accent); background: rgba(var(--dash-accent-rgb), .08); color: var(--dash-accent); box-shadow: 0 0 18px rgba(var(--dash-accent-rgb), .12); }
    .pill-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }

    .char-row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
    .char-btn { display: grid; gap: 4px; justify-items: center; padding: 12px 6px; border-radius: 14px; border: 1.5px solid var(--panel-border); background: var(--panel); color: var(--text-soft); font-family: inherit; cursor: pointer; transition: all 160ms ease; }
    .char-btn:hover { border-color: rgba(var(--dash-accent-rgb), .4); }
    .char-btn.active { border-color: var(--dash-accent); background: rgba(var(--dash-accent-rgb), .07); color: var(--dash-accent); }
    .char-btn img { width: 48px; height: 48px; image-rendering: pixelated; image-rendering: crisp-edges; object-fit: contain; }
    .char-btn span { font-size: .78rem; font-weight: 800; }
    .char-btn small { font-size: .62rem; color: var(--muted); }

    .go-btn { display: flex; flex-direction: column; align-items: center; gap: 3px; padding: 16px 44px; margin: 0 auto; border: none; border-radius: 16px; background: linear-gradient(135deg, var(--dash-accent), rgba(var(--dash-accent-rgb), .7)); color: #0a0e18; font-family: 'Courier New', monospace; font-size: 1.4rem; font-weight: 900; cursor: pointer; letter-spacing: .06em; box-shadow: 0 8px 28px rgba(var(--dash-accent-rgb), .3); transition: transform 140ms ease, box-shadow 140ms ease; }
    .go-btn:hover { transform: translateY(-3px); box-shadow: 0 12px 36px rgba(var(--dash-accent-rgb), .4); }
    .go-keys { font-size: .68rem; font-weight: 700; letter-spacing: .14em; opacity: .55; }

    /* ===== Game ===== */
    .game-screen { position: relative; height: calc(100vh - 140px); min-height: 460px; }
    .game-canvas { display: block; width: 100%; height: 100%; image-rendering: pixelated; image-rendering: crisp-edges; }
    .game-hud-top { position: absolute; top: 10px; left: 14px; right: 14px; display: flex; justify-content: space-between; pointer-events: none; z-index: 2; }
    .game-hud-top > div { padding: 6px 14px; border-radius: 10px; background: rgba(6,8,18,.78); backdrop-filter: blur(6px); font-family: 'Courier New', monospace; }
    .hud-hp { font-size: 1rem; letter-spacing: 2px; }
    .hud-notes { display: flex; align-items: center; gap: 6px; }
    .hud-notes span { color: #ffd66e; font-size: 1.1rem; }
    .hud-notes strong, .hud-score strong { color: #fff; font-size: 1.1rem; font-weight: 900; }
    .game-msg { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-family: 'Courier New', monospace; font-size: 2rem; font-weight: 900; color: #fff; text-shadow: 0 0 20px rgba(0,0,0,.6); pointer-events: none; z-index: 3; opacity: 0; transition: opacity .3s ease; }
    .game-msg.show { opacity: 1; }

    /* ===== Results ===== */
    .results-screen { position: fixed; inset: 0; z-index: 90; display: grid; place-content: center; background: rgba(5,8,18,.9); backdrop-filter: blur(14px); padding: 20px; }
    .results-card { display: grid; gap: 18px; max-width: 380px; width: 100%; padding: 32px 28px; border-radius: 22px; background: var(--panel-gradient); border: 1.5px solid var(--panel-border); }
    .res-title { text-align: center; font-family: 'Courier New', monospace; font-size: 2rem; font-weight: 900; color: var(--dash-accent); }
    .res-stats { display: grid; gap: 8px; }
    .res-row { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid rgba(255,255,255,.05); }
    .res-row span { color: var(--muted); } .res-row strong { color: #fff; font-family: 'Courier New', monospace; }
    .res-actions { display: flex; gap: 10px; }
    .retry-btn, .back-btn { flex: 1; padding: 12px; border-radius: 12px; font-family: 'Courier New', monospace; font-size: .95rem; font-weight: 800; cursor: pointer; transition: all 140ms ease; }
    .retry-btn { border: none; background: var(--dash-accent); color: #0a0e18; }
    .retry-btn:hover { transform: translateY(-2px); }
    .back-btn { border: 1.5px solid var(--panel-border); background: var(--panel); color: var(--text-soft); }

    /* ===== Touch ===== */
    .touch-controls { position: fixed; bottom: 10px; left: 0; right: 0; z-index: 50; display: flex; justify-content: space-between; padding: 0 14px; pointer-events: none; }
    .touch-left, .touch-right { display: flex; gap: 8px; pointer-events: auto; }
    .t-btn { width: 60px; height: 60px; border-radius: 50%; border: 2px solid rgba(var(--dash-accent-rgb), .3); background: rgba(8,12,24,.8); color: rgba(var(--dash-accent-rgb), .8); font-size: 1.4rem; font-weight: 900; cursor: pointer; touch-action: manipulation; transition: all 80ms ease; }
    .t-btn:active { background: rgba(var(--dash-accent-rgb), .15); border-color: var(--dash-accent); transform: scale(.92); }
    .t-jump { width: 68px; height: 68px; }
    .t-atk { width: 68px; height: 68px; color: #ffd66e; }

    @media (max-width: 720px) {
      .char-row { grid-template-columns: repeat(5, 1fr); gap: 6px; }
      .char-btn { padding: 8px 3px; } .char-btn img { width: 36px; height: 36px; } .char-btn small { display: none; }
      .stage-pills { gap: 6px; } .stage-pill { padding: 8px 12px; font-size: .8rem; }
    }

    @media (max-width: 460px) {
      .char-row { gap: 4px; }
      .char-btn img { width: 28px; height: 28px; }
      .char-btn span { font-size: .65rem; }
    }
  </style>

  <script>
    // ===== SEKAI DASH — Action Platformer =====
    const VW = 960, VH = 540, GRAVITY = 1800;

    const CHARS = [
      { name: 'Kanade', img: '/knd.png', speed: 280, jumpPow: 620, atkCd: 350, projSpd: 520, hp: 5, color: '#33ccbb', desc: 'Balance' },
      { name: 'Mafuyu', img: '/mfy/mfy1.png', speed: 250, jumpPow: 580, atkCd: 280, projSpd: 480, hp: 4, color: '#9966cc', desc: 'Power' },
      { name: 'Mizuki', img: '/mzk.png', speed: 360, jumpPow: 660, atkCd: 320, projSpd: 560, hp: 4, color: '#ff99aa', desc: 'Speed' },
      { name: 'Ena', img: '/ena.png', speed: 300, jumpPow: 700, atkCd: 340, projSpd: 500, hp: 5, color: '#88cc44', desc: 'Agile' },
      { name: 'Miku', img: '/25miku.png', speed: 270, jumpPow: 600, atkCd: 260, projSpd: 640, hp: 4, color: '#ccddff', desc: 'Ranged' },
    ];

    const STAGES = [
      { name: 'Leo/need', bg1: '#0a1628', bg2: '#162040', platColor: '#1e3460', platTop: '#4488cc', accent: '#4455dd', starColor: '#77aaff', enemies: 8, worldW: 3200,
        buildPlatforms: (P: Rect[]) => {
          P.push({x:0,y:476,w:600,h:64});P.push({x:700,y:440,w:200,h:24});P.push({x:1000,y:390,w:180,h:24});
          P.push({x:1280,y:440,w:320,h:24});P.push({x:1700,y:400,w:240,h:24});P.push({x:2040,y:350,w:200,h:24});
          P.push({x:2340,y:420,w:280,h:24});P.push({x:2720,y:476,w:480,h:64});
          P.push({x:500,y:340,w:120,h:20});P.push({x:1500,y:300,w:100,h:20});P.push({x:2600,y:310,w:130,h:20});
        }},
      { name: 'MORE MORE JUMP!', bg1: '#14201a', bg2: '#1a3828', platColor: '#2a5038', platTop: '#66cc66', accent: '#88dd44', starColor: '#aaffaa', enemies: 10, worldW: 3400,
        buildPlatforms: (P: Rect[]) => {
          P.push({x:0,y:476,w:500,h:64});P.push({x:600,y:430,w:160,h:24});P.push({x:860,y:380,w:160,h:24});
          P.push({x:1100,y:430,w:200,h:24});P.push({x:1400,y:360,w:180,h:24});P.push({x:1680,y:410,w:240,h:24});
          P.push({x:2020,y:340,w:160,h:24});P.push({x:2280,y:400,w:200,h:24});P.push({x:2580,y:476,w:300,h:64});
          P.push({x:2980,y:430,w:200,h:24});P.push({x:3100,y:476,w:300,h:64});
          P.push({x:400,y:320,w:100,h:20});P.push({x:1250,y:280,w:120,h:20});P.push({x:2450,y:290,w:100,h:20});
        }},
      { name: 'Vivid BAD SQUAD', bg1: '#1a0a14', bg2: '#2a1020', platColor: '#4a1830', platTop: '#cc3366', accent: '#ee1166', starColor: '#ff6699', enemies: 12, worldW: 3600,
        buildPlatforms: (P: Rect[]) => {
          P.push({x:0,y:476,w:400,h:64});P.push({x:500,y:420,w:180,h:24});P.push({x:780,y:370,w:160,h:24});
          P.push({x:1040,y:420,w:200,h:24});P.push({x:1340,y:350,w:180,h:24});P.push({x:1620,y:400,w:200,h:24});
          P.push({x:1920,y:340,w:160,h:24});P.push({x:2180,y:410,w:240,h:24});P.push({x:2520,y:360,w:180,h:24});
          P.push({x:2800,y:420,w:200,h:24});P.push({x:3100,y:476,w:500,h:64});
          P.push({x:450,y:310,w:100,h:20});P.push({x:1200,y:270,w:110,h:20});P.push({x:2000,y:260,w:100,h:20});P.push({x:2700,y:280,w:120,h:20});
        }},
      { name: '25時', bg1: '#120a1a', bg2: '#1a1030', platColor: '#2a1848', platTop: '#884499', accent: '#884499', starColor: '#bb88dd', enemies: 10, worldW: 3000,
        buildPlatforms: (P: Rect[]) => {
          P.push({x:0,y:476,w:500,h:64});P.push({x:600,y:430,w:180,h:24});P.push({x:880,y:380,w:160,h:24});
          P.push({x:1140,y:430,w:200,h:24});P.push({x:1440,y:370,w:180,h:24});P.push({x:1720,y:420,w:200,h:24});
          P.push({x:2020,y:360,w:180,h:24});P.push({x:2300,y:420,w:240,h:24});P.push({x:2600,y:476,w:400,h:64});
          P.push({x:500,y:310,w:100,h:20});P.push({x:1300,y:280,w:120,h:20});P.push({x:1900,y:270,w:100,h:20});
        }},
    ];

    interface Rect { x: number; y: number; w: number; h: number; }
    interface Player extends Rect { vx: number; vy: number; grounded: boolean; facing: number; hp: number; invuln: number; jumps: number; maxJumps: number; atkTimer: number; }
    interface Enemy extends Rect { vx: number; hp: number; maxHp: number; left: number; right: number; type: 'slime' | 'bat' | 'ghost'; alive: boolean; }
    interface Note { x: number; y: number; taken: boolean; }
    interface Pickup { x: number; y: number; type: 'health'; taken: boolean; }
    interface Projectile extends Rect { vx: number; life: number; }
    interface Particle { x: number; y: number; vx: number; vy: number; life: number; color: string; size: number; }

    // --- State ---
    let selStage = 0, selChar = 1;
    let player: Player;
    let enemies: Enemy[] = [];
    let collectNotes: Note[] = [];
    let pickups: Pickup[] = [];
    let projectiles: Projectile[] = [];
    let particles: Particle[] = [];
    let platforms: Rect[] = [];
    let cameraX = 0, score = 0, notesCollected = 0, enemiesKilled = 0;
    let running = false, finished = false;
    let shakeX = 0, shakeY = 0, shakeT = 0;
    let msgTimer = 0;
    let worldW = 3200;
    let raf = 0, lastTime = 0;
    let animState: 'idle' | 'run' | 'jump' | 'fall' | 'attack' = 'idle';
    let animFrame = 0;
    let animTimer = 0;
    let runDustTimer = 0;
    const keys: Record<string, boolean> = {};
    const charImages: HTMLImageElement[] = [];
    const MFY_SPRITES = {
      idle: '/mfy/mfy1.png',
      jump: '/mfy/mfy_run_jump.png',
      fall: '/mfy/mfy_run_jump.png',
      attack: '/mfy/mfy_att1.png',
    } as const;
    const MFY_RUN_FRAMES = [
      '/mfy/mfy_run1.png',
      '/mfy/mfy_run2.png',
      '/mfy/mfy_run3.png',
      '/mfy/mfy_run4.png',
      '/mfy/mfy_run5.png',
      '/mfy/mfy_run6.png',
      '/mfy/mfy_run7.png',
      '/mfy/mfy_run8.png',
      '/mfy/mfy_run9.png',
      '/mfy/mfy_run10.png',
      '/mfy/mfy_run11.png',
    ] as const;
    const MFY_RUN_CYCLE_SECONDS = 1.1;
    const mfyImages: Record<keyof typeof MFY_SPRITES, HTMLImageElement> = {} as Record<keyof typeof MFY_SPRITES, HTMLImageElement>;
    const mfyRunImages: HTMLImageElement[] = [];

    // --- DOM ---
    const canvas = document.getElementById('gameCanvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const titleScreen = document.getElementById('titleScreen')!;
    const gameScreen = document.getElementById('gameScreen')!;
    const resultsScreen = document.getElementById('resultsScreen')!;
    const touchControls = document.getElementById('touchControls')!;
    const gameMsg = document.getElementById('gameMsg')!;
    const hudHp = document.getElementById('hudHp')!;
    const hudNotes = document.getElementById('hudNotes')!;
    const hudScore = document.getElementById('hudScore')!;

    // Preload character images
    CHARS.forEach((c, i) => {
      const img = new Image();
      img.src = c.img;
      charImages[i] = img;
    });
    Object.entries(MFY_SPRITES).forEach(([state, src]) => {
      const img = new Image();
      img.src = src;
      mfyImages[state as keyof typeof MFY_SPRITES] = img;
    });
    MFY_RUN_FRAMES.forEach((src, index) => {
      const img = new Image();
      img.src = src;
      mfyRunImages[index] = img;
    });

    // --- Audio ---
    let audioCtx: AudioContext | null = null;
    function initAudio() { if (!audioCtx) audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)(); }
    function playSfx(freq: number, dur: number, type: OscillatorType = 'sine', vol = 0.12) {
      if (!audioCtx) return;
      const t = audioCtx.currentTime, g = audioCtx.createGain(), o = audioCtx.createOscillator();
      o.type = type; o.frequency.setValueAtTime(freq, t); o.frequency.exponentialRampToValueAtTime(freq * 0.5, t + dur);
      g.gain.setValueAtTime(vol, t); g.gain.exponentialRampToValueAtTime(0.001, t + dur);
      o.connect(g); g.connect(audioCtx.destination); o.start(t); o.stop(t + dur);
    }
    function sfxJump() { playSfx(440, 0.08, 'sine', 0.08); }
    function sfxHit() { playSfx(880, 0.1, 'square', 0.1); }
    function sfxNote() { playSfx(660, 0.12, 'sine', 0.1); playSfx(990, 0.12, 'sine', 0.06); }
    function sfxHurt() { playSfx(180, 0.2, 'sawtooth', 0.12); }
    function sfxKill() { playSfx(520, 0.15, 'square', 0.1); playSfx(780, 0.1, 'sine', 0.08); }
    function sfxClear() { playSfx(523, 0.15, 'sine', 0.12); setTimeout(() => playSfx(659, 0.15, 'sine', 0.12), 120); setTimeout(() => playSfx(784, 0.25, 'sine', 0.14), 240); }

    // --- Helpers ---
    function overlaps(a: Rect, b: Rect) { return a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y; }
    function hexRgba(hex: string, a: number) { const r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16); return `rgba(${r},${g},${b},${a})`; }
    function setAccent(color: string) { const r = parseInt(color.slice(1,3),16), g = parseInt(color.slice(3,5),16), b = parseInt(color.slice(5,7),16); document.documentElement.style.setProperty('--dash-accent', color); document.documentElement.style.setProperty('--dash-accent-rgb', `${r},${g},${b}`); }
    function burst(x: number, y: number, color: string, n: number) { for (let i = 0; i < n; i++) { const a = Math.PI * 2 * i / n; particles.push({ x, y, vx: Math.cos(a) * (100 + Math.random() * 120), vy: Math.sin(a) * (100 + Math.random() * 120) - 80, life: 0.4 + Math.random() * 0.2, color, size: 3 + Math.random() * 3 }); } }
    function shake(amount: number) { shakeT = 0.2; shakeX = (Math.random() - 0.5) * amount; shakeY = (Math.random() - 0.5) * amount; }

    function showMsg(text: string, dur = 1.5) { msgTimer = dur; gameMsg.textContent = text; gameMsg.classList.add('show'); }

    // --- Stage Building ---
    function buildStage(stageIdx: number) {
      const stage = STAGES[stageIdx];
      platforms = []; enemies = []; collectNotes = []; pickups = []; projectiles = []; particles = [];
      worldW = stage.worldW;

      stage.buildPlatforms(platforms);

      // Place enemies on platforms
      const groundPlats = platforms.filter(p => p.h <= 28 && p.w >= 140);
      for (let i = 0; i < stage.enemies && i < groundPlats.length; i++) {
        const p = groundPlats[i];
        const type: Enemy['type'] = Math.random() < 0.3 ? 'bat' : Math.random() < 0.5 ? 'ghost' : 'slime';
        const hp = type === 'ghost' ? 2 : 1;
        enemies.push({ x: p.x + p.w / 2 - 16, y: p.y - (type === 'bat' ? 60 : 32), w: 32, h: 32, vx: (60 + Math.random() * 40) * (Math.random() < 0.5 ? 1 : -1), hp, maxHp: hp, left: p.x, right: p.x + p.w, type, alive: true });
      }

      // Place notes
      for (let i = 0; i < 12; i++) {
        const p = platforms[Math.floor(Math.random() * platforms.length)];
        collectNotes.push({ x: p.x + 20 + Math.random() * Math.max(0, p.w - 40), y: p.y - 50 - Math.random() * 30, taken: false });
      }

      // Place health pickups
      for (let i = 0; i < 3; i++) {
        const p = platforms[2 + Math.floor(Math.random() * (platforms.length - 2))];
        pickups.push({ x: p.x + p.w / 2, y: p.y - 40, type: 'health', taken: false });
      }
    }

    // --- Init Game ---
    function initGame() {
      initAudio();
      const c = CHARS[selChar];
      const stage = STAGES[selStage];
      setAccent(stage.accent);
      buildStage(selStage);

      player = { x: 60, y: 400, w: 36, h: 48, vx: 0, vy: 0, grounded: false, facing: 1, hp: c.hp, invuln: 0, jumps: 0, maxJumps: selChar === 2 ? 2 : selChar === 3 ? 2 : 1, atkTimer: 0 };
      cameraX = 0; score = 0; notesCollected = 0; enemiesKilled = 0;
      running = true; finished = false;

      titleScreen.classList.add('hidden');
      gameScreen.classList.remove('hidden');
      resultsScreen.classList.add('hidden');
      touchControls.classList.remove('hidden');
      updateHud();
      showMsg(stage.name, 1.8);
    }

    function updateHud() {
      const maxHp = CHARS[selChar].hp;
      hudHp.textContent = '♥'.repeat(Math.max(0, player.hp)) + '♡'.repeat(Math.max(0, maxHp - player.hp));
      hudNotes.textContent = String(notesCollected);
      hudScore.textContent = String(score);
    }

    // --- Input ---
    document.addEventListener('keydown', e => {
      const k = e.key.toLowerCase();
      keys[k] = true;
      if (k === 'arrowup' || k === 'w' || k === ' ') { e.preventDefault(); doJump(); }
      if (k === 'j' || k === 'k') doAttack();
      if (k === 'enter' && !running && !titleScreen.classList.contains('hidden')) initGame();
    });
    document.addEventListener('keyup', e => { keys[e.key.toLowerCase()] = false; });

    // Touch
    const touchBtns = touchControls.querySelectorAll<HTMLButtonElement>('.t-btn');
    touchBtns.forEach(btn => {
      const dir = btn.dataset.dir || '';
      const down = (e: PointerEvent) => { e.preventDefault(); btn.setPointerCapture(e.pointerId); btn.classList.add('active'); keys['t_' + dir] = true; if (dir === 'jump') doJump(); if (dir === 'attack') doAttack(); };
      const up = () => { btn.classList.remove('active'); keys['t_' + dir] = false; };
      btn.addEventListener('pointerdown', down);
      btn.addEventListener('pointerup', up);
      btn.addEventListener('pointercancel', up);
      btn.addEventListener('lostpointercapture', up);
    });

    function doJump() {
      if (!running || finished) return;
      const c = CHARS[selChar];
      if (player.grounded || player.jumps < player.maxJumps) {
        player.vy = -c.jumpPow;
        player.grounded = false;
        player.jumps++;
        sfxJump();
      }
    }

    function doAttack() {
      if (!running || finished || player.atkTimer > 0) return;
      const c = CHARS[selChar];
      player.atkTimer = c.atkCd;
      projectiles.push({ x: player.x + (player.facing > 0 ? player.w : -16), y: player.y + 16, w: 16, h: 12, vx: c.projSpd * player.facing, life: 0.6 });
      sfxHit();
      burst(player.x + player.w / 2 + player.facing * 20, player.y + 20, c.color, 4);
    }

    // --- Update ---
    function update(dt: number) {
      if (!running || finished) return;
      const c = CHARS[selChar];
      const stage = STAGES[selStage];

      // Player movement
      const moveL = keys['arrowleft'] || keys['a'] || keys['t_left'];
      const moveR = keys['arrowright'] || keys['d'] || keys['t_right'];
      if (moveL) { player.vx = -c.speed; player.facing = -1; }
      else if (moveR) { player.vx = c.speed; player.facing = 1; }
      else { player.vx *= Math.pow(0.01, dt); }

      player.vy += GRAVITY * dt;
      player.invuln = Math.max(0, player.invuln - dt);
      player.atkTimer = Math.max(0, player.atkTimer - dt * 1000);

      // Horizontal collision
      player.x += player.vx * dt;
      for (const p of platforms) {
        if (overlaps(player, p)) {
          if (player.vx > 0) player.x = p.x - player.w;
          else if (player.vx < 0) player.x = p.x + p.w;
          player.vx = 0;
        }
      }

      // Vertical collision
      player.y += player.vy * dt;
      player.grounded = false;
      for (const p of platforms) {
        if (overlaps(player, p)) {
          if (player.vy > 0) { player.y = p.y - player.h; player.vy = 0; player.grounded = true; player.jumps = 0; }
          else if (player.vy < 0) { player.y = p.y + p.h; player.vy = 0; }
        }
      }

      // Fall off world
      if (player.y > VH + 100) {
        player.x = Math.max(60, cameraX + 80);
        player.y = 60;
        player.vy = 0;
        takeDamage();
      }

      player.x = Math.max(0, Math.min(worldW - player.w, player.x));

      // Projectiles
      for (const proj of projectiles) {
        proj.x += proj.vx * dt;
        proj.life -= dt;
        for (const enemy of enemies) {
          if (!enemy.alive || proj.life <= 0) continue;
          if (overlaps(proj, enemy)) {
            enemy.hp--;
            proj.life = 0;
            if (enemy.hp <= 0) {
              enemy.alive = false;
              enemiesKilled++;
              score += 200;
              burst(enemy.x + enemy.w / 2, enemy.y + enemy.h / 2, stage.accent, 10);
              sfxKill();
              shake(6);
            } else {
              burst(enemy.x + enemy.w / 2, enemy.y + enemy.h / 2, '#fff', 4);
            }
            updateHud();
          }
        }
      }
      projectiles = projectiles.filter(p => p.life > 0);

      // Enemies
      for (const enemy of enemies) {
        if (!enemy.alive) continue;
        enemy.x += enemy.vx * dt;
        if (enemy.x <= enemy.left || enemy.x + enemy.w >= enemy.right) enemy.vx *= -1;
        if (enemy.type === 'bat') enemy.y += Math.sin(performance.now() * 0.005 + enemy.x) * 0.8;

        if (overlaps(player, enemy)) {
          if (player.vy > 100 && player.y + player.h - enemy.y < 20) {
            // Stomp
            enemy.hp--;
            player.vy = -450;
            if (enemy.hp <= 0) {
              enemy.alive = false;
              enemiesKilled++;
              score += 250;
              burst(enemy.x + enemy.w / 2, enemy.y + enemy.h / 2, stage.accent, 12);
              sfxKill();
              shake(8);
            }
            updateHud();
          } else {
            takeDamage();
          }
        }
      }

      // Collectibles
      for (const note of collectNotes) {
        if (note.taken) continue;
        if (overlaps(player, { x: note.x - 14, y: note.y - 14, w: 28, h: 28 })) {
          note.taken = true;
          notesCollected++;
          score += 100;
          burst(note.x, note.y, '#ffd66e', 8);
          sfxNote();
          updateHud();
        }
      }

      for (const pk of pickups) {
        if (pk.taken) continue;
        if (overlaps(player, { x: pk.x - 12, y: pk.y - 12, w: 24, h: 24 })) {
          pk.taken = true;
          if (pk.type === 'health' && player.hp < CHARS[selChar].hp) {
            player.hp++;
            showMsg('+1 HP', 0.8);
          } else {
            score += 50;
          }
          burst(pk.x, pk.y, '#ff6688', 6);
          updateHud();
        }
      }

      // Particles
      for (const p of particles) { p.x += p.vx * dt; p.y += p.vy * dt; p.vy += 400 * dt; p.life -= dt; }
      particles = particles.filter(p => p.life > 0);

      // Shake
      if (shakeT > 0) { shakeT -= dt; shakeX *= 0.8; shakeY *= 0.8; } else { shakeX = 0; shakeY = 0; }

      // Message
      if (msgTimer > 0) { msgTimer -= dt; if (msgTimer <= 0) gameMsg.classList.remove('show'); }

      // Check win
      if (player.x > worldW - 80) {
        finished = true; running = false;
        score += Math.max(0, player.hp * 500);
        sfxClear();
        updateHud();
        setTimeout(showResults, 800);
      }

      // Animation state
      animTimer += dt;
      if (player.atkTimer > 0) {
        if (animState !== 'attack') { animState = 'attack'; animFrame = 0; animTimer = 0; }
      } else if (!player.grounded) {
        animState = player.vy < 0 ? 'jump' : 'fall';
      } else if (Math.abs(player.vx) > 30) {
        if (animState !== 'run') { animState = 'run'; animFrame = 0; animTimer = 0; }
        const runFrameCount = selChar === 1 ? MFY_RUN_FRAMES.length : 6;
        const runFrameDelay = selChar === 1 ? MFY_RUN_CYCLE_SECONDS / MFY_RUN_FRAMES.length : 0.08;
        while (animTimer > runFrameDelay) { animFrame = (animFrame + 1) % runFrameCount; animTimer -= runFrameDelay; }
        runDustTimer += dt;
        if (runDustTimer > 0.12) { runDustTimer = 0; particles.push({ x: player.x + player.w / 2, y: player.y + player.h, vx: -player.facing * (20 + Math.random() * 30), vy: -(10 + Math.random() * 20), life: 0.3, color: 'rgba(200,200,200,0.5)', size: 2 + Math.random() * 2 }); }
      } else {
        if (animState !== 'idle') { animState = 'idle'; animFrame = 0; animTimer = 0; }
      }

      // Camera
      const targetCam = Math.max(0, Math.min(worldW - VW, player.x - VW * 0.4));
      cameraX += (targetCam - cameraX) * Math.min(1, dt * 6);
    }

    function takeDamage() {
      if (player.invuln > 0 || finished) return;
      player.hp--;
      player.invuln = 1.2;
      player.vx = -player.facing * 280;
      player.vy = -400;
      sfxHurt();
      shake(10);
      burst(player.x + player.w / 2, player.y + player.h / 2, '#e44', 8);
      updateHud();
      if (player.hp <= 0) {
        finished = true; running = false;
        showMsg('GAME OVER', 2);
        setTimeout(showResults, 1500);
      }
    }

    function showResults() {
      const clear = player.hp > 0;
      document.getElementById('resTitle')!.textContent = clear ? 'STAGE CLEAR!' : 'GAME OVER';
      document.getElementById('resNotes')!.textContent = String(notesCollected);
      document.getElementById('resEnemies')!.textContent = String(enemiesKilled);
      document.getElementById('resScore')!.textContent = String(score);
      gameScreen.classList.add('hidden');
      resultsScreen.classList.remove('hidden');
      touchControls.classList.add('hidden');
    }

    // --- Render ---
    function render(time: number) {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = Math.round(rect.width * dpr);
      canvas.height = Math.round(rect.height * dpr);
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      if (!player) return;

      const sx = (rect.width * dpr) / VW;
      const sy = (rect.height * dpr) / VH;
      const s = Math.min(sx, sy);
      const ox = (canvas.width - VW * s) / 2;
      const oy = (canvas.height - VH * s) / 2;
      ctx.setTransform(s, 0, 0, s, ox + shakeX, oy + shakeY);

      const stage = STAGES[selStage];
      const t = time / 1000;

      // Background
      ctx.fillStyle = stage.bg1;
      ctx.fillRect(0, 0, VW, VH);
      ctx.fillStyle = stage.bg2;
      ctx.fillRect(0, VH * 0.4, VW, VH * 0.6);

      // Stars (parallax)
      for (let i = 0; i < 50; i++) {
        const x = ((i * 137 + 23 - cameraX * (0.05 + (i % 3) * 0.015)) % (VW + 80)) - 40;
        const y = 20 + (i * 59) % (VH * 0.5);
        const sz = 2 + (i % 3);
        ctx.fillStyle = i % 4 === 0 ? stage.starColor : 'rgba(255,255,255,0.3)';
        ctx.fillRect(Math.floor(x), Math.floor(y), sz, sz);
      }

      // Background buildings (parallax)
      for (let i = 0; i < 12; i++) {
        const x = Math.floor((i * 280 - cameraX * 0.12) % (VW + 300) - 150);
        const h = 60 + (i % 4) * 30;
        ctx.fillStyle = i % 2 === 0 ? hexRgba(stage.platColor, 0.4) : hexRgba(stage.bg2, 0.6);
        ctx.fillRect(x, VH - 50 - h, 80, h);
        for (let j = 0; j < 3; j++) {
          ctx.fillStyle = hexRgba(stage.accent, 0.12);
          ctx.fillRect(x + 14 + j * 20, VH - 40 - h, 8, h - 20);
        }
      }

      // Platforms
      for (const p of platforms) {
        const px = Math.round(p.x - cameraX);
        if (px + p.w < -40 || px > VW + 40) continue;
        ctx.fillStyle = stage.platColor;
        ctx.fillRect(px, p.y, p.w, p.h);
        ctx.fillStyle = stage.platTop;
        ctx.fillRect(px, p.y, p.w, Math.min(6, p.h));
        // Tile pattern
        for (let tx = 0; tx < p.w; tx += 24) {
          ctx.fillStyle = hexRgba(stage.platTop, 0.08);
          ctx.fillRect(px + tx + 16, p.y + 10, 4, 4);
        }
        ctx.fillStyle = hexRgba('#000000', 0.2);
        ctx.fillRect(px, p.y + p.h - 3, p.w, 3);
      }

      // Goal gate
      const gateX = worldW - 60 - cameraX;
      ctx.save();
      ctx.fillStyle = hexRgba(stage.accent, 0.15);
      ctx.fillRect(gateX - 24, 380, 48, 96);
      ctx.strokeStyle = stage.accent;
      ctx.lineWidth = 2;
      ctx.strokeRect(gateX - 24, 380, 48, 96);
      ctx.fillStyle = '#fff';
      ctx.font = '900 14px Courier New, monospace';
      ctx.textAlign = 'center';
      ctx.fillText('GOAL', gateX, 430 + Math.sin(t * 3) * 3);
      ctx.restore();

      // Collectibles
      for (const note of collectNotes) {
        if (note.taken) continue;
        const nx = Math.round(note.x - cameraX);
        const ny = Math.round(note.y + Math.sin(t * 3 + note.x * 0.01) * 4);
        if (nx < -20 || nx > VW + 20) continue;
        ctx.save();
        ctx.fillStyle = '#ffd66e';
        ctx.shadowColor = '#ffd66e';
        ctx.shadowBlur = 8;
        ctx.font = '900 18px serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('♪', nx, ny);
        ctx.restore();
      }

      // Health pickups
      for (const pk of pickups) {
        if (pk.taken) continue;
        const px = Math.round(pk.x - cameraX);
        const py = Math.round(pk.y + Math.sin(t * 2.5 + pk.x) * 3);
        if (px < -20 || px > VW + 20) continue;
        ctx.save();
        ctx.fillStyle = '#ff6688';
        ctx.shadowColor = '#ff6688';
        ctx.shadowBlur = 6;
        ctx.font = '900 16px serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('♥', px, py);
        ctx.restore();
      }

      // Enemies
      for (const enemy of enemies) {
        if (!enemy.alive) continue;
        const ex = Math.round(enemy.x - cameraX);
        const ey = Math.round(enemy.y);
        if (ex + enemy.w < -20 || ex > VW + 20) continue;

        if (enemy.type === 'slime') {
          ctx.fillStyle = '#4a2060';
          ctx.fillRect(ex + 4, ey + 12, 24, 20);
          ctx.fillStyle = '#6a3088';
          ctx.fillRect(ex + 2, ey + 6, 28, 14);
          ctx.fillStyle = '#ff4488';
          ctx.fillRect(ex + 8, ey + 12, 5, 5);
          ctx.fillRect(ex + 19, ey + 12, 5, 5);
        } else if (enemy.type === 'bat') {
          const wingY = Math.sin(t * 12 + enemy.x) * 4;
          ctx.fillStyle = '#3a1848';
          ctx.fillRect(ex + 10, ey + 8, 12, 16);
          ctx.fillStyle = '#5a2868';
          ctx.fillRect(ex - 2, ey + 6 + wingY, 14, 8);
          ctx.fillRect(ex + 20, ey + 6 - wingY, 14, 8);
          ctx.fillStyle = '#ff3366';
          ctx.fillRect(ex + 12, ey + 12, 3, 3);
          ctx.fillRect(ex + 18, ey + 12, 3, 3);
        } else {
          ctx.fillStyle = '#2a1838';
          ctx.fillRect(ex + 4, ey + 4, 24, 28);
          ctx.fillStyle = '#4a2858';
          ctx.fillRect(ex + 6, ey, 20, 12);
          ctx.fillStyle = '#88ddff';
          ctx.fillRect(ex + 10, ey + 8, 4, 4);
          ctx.fillRect(ex + 18, ey + 8, 4, 4);
          if (enemy.hp < enemy.maxHp) {
            ctx.fillStyle = 'rgba(255,255,255,0.3)';
            ctx.fillRect(ex, ey - 6, enemy.w * (enemy.hp / enemy.maxHp), 3);
          }
        }
      }

      // Projectiles
      for (const proj of projectiles) {
        const px = Math.round(proj.x - cameraX);
        ctx.save();
        ctx.fillStyle = CHARS[selChar].color;
        ctx.shadowColor = CHARS[selChar].color;
        ctx.shadowBlur = 6;
        ctx.fillRect(px, proj.y, proj.w, proj.h);
        ctx.fillStyle = '#fff';
        ctx.fillRect(px + 4, proj.y + 3, 6, 4);
        ctx.restore();
      }

      // Player
      drawPlayer(t);

      // Particles
      ctx.save();
      for (const p of particles) {
        ctx.globalAlpha = Math.max(0, p.life * 3);
        ctx.fillStyle = p.color;
        const sz = p.size * Math.max(0.3, p.life * 2);
        ctx.fillRect(Math.round(p.x - cameraX), Math.round(p.y), sz, sz);
      }
      ctx.restore();
    }

    function drawPlayer(t: number) {
      const c = CHARS[selChar];
      const px = Math.round(player.x - cameraX);
      const py = Math.round(player.y);

      if (player.invuln > 0 && Math.floor(t * 16) % 2 === 0) return;

      const dir = player.facing;
      const isMafuyu = selChar === 1;
      let img = charImages[selChar];
      if (isMafuyu) {
        if (animState === 'attack') img = mfyImages.attack;
        else if (animState === 'run') img = mfyRunImages[animFrame % mfyRunImages.length] || mfyImages.idle;
        else if (animState === 'jump') img = mfyImages.jump;
        else if (animState === 'fall') img = mfyImages.fall;
        else img = mfyImages.idle;
      }
      const color = c.color;
      const W = player.w, H = player.h;

      // Sprite draw dimensions. Mafuyu uses full action-frame PNGs from /public/mfy.
      const spW = isMafuyu ? (animState === 'attack' ? 92 : animState === 'run' ? 82 : 76) : 50;
      const spH = isMafuyu ? (animState === 'attack' ? 92 : animState === 'run' ? 82 : 76) : 58;
      const spLift = isMafuyu ? 8 : 2;
      const legH_px = 12; // height of the leg region at bottom of PNG to overlay

      // --- Transforms ---
      let sx = 1, sy = 1, tilt = 0, bob = 0;

      switch (animState) {
        case 'idle':
          bob = Math.sin(t * 3) * 2;
          break;
        case 'run': {
          const phase = animFrame * Math.PI / 3;
          bob = Math.abs(Math.sin(phase)) * -3;
          tilt = Math.sin(phase) * 0.06 * dir;
          sx = 1 + Math.sin(phase) * 0.04;
          sy = 1 - Math.sin(phase) * 0.04;
          break;
        }
        case 'jump':
          sy = Math.min(1.12, 1 + Math.abs(player.vy) / 3000);
          sx = 1 / sy;
          tilt = -0.08 * dir;
          break;
        case 'fall':
          sx = Math.min(1.1, 1 + player.vy / 3000);
          sy = 1 / sx;
          tilt = 0.05 * dir;
          break;
        case 'attack':
          tilt = 0.1 * dir;
          bob = -2;
          sx = 1.06;
          sy = 0.94;
          break;
      }

      // --- Shadow ---
      ctx.fillStyle = 'rgba(0,0,0,0.18)';
      ctx.beginPath();
      ctx.ellipse(px + W / 2, py + H + 2, W * 0.55, 4, 0, 0, Math.PI * 2);
      ctx.fill();

      // --- Main character draw (PNG + animated legs) ---
      ctx.save();
      ctx.translate(px + W / 2, py + H + bob);
      if (dir < 0) ctx.scale(-sx, sy);
      else ctx.scale(sx, sy);
      if (tilt) ctx.rotate(tilt);

      ctx.imageSmoothingEnabled = false;

      // Draw the original PNG sprite
      if (img && img.complete && img.naturalWidth > 0) {
        ctx.drawImage(img, -spW / 2, -spH + spLift, spW, spH);
      } else {
        ctx.fillStyle = color;
        ctx.fillRect(-spW / 2, -spH + 2, spW, spH);
      }

      // --- Animated legs overlay ---
      // Cover the bottom leg region of the PNG with moving legs
      if (!isMafuyu) {
        const legDark = hexRgba(color, 0.55);
        const legLight = hexRgba(color, 0.75);
        const shoeColor = hexRgba('#000000', 0.35);
        const legW = 9, footY = 0; // footY=0 means at the transform origin (feet)

        switch (animState) {
          case 'idle': {
            const ib = Math.sin(t * 2.5) * 1.5;
            ctx.fillStyle = legDark;
            ctx.fillRect(-10, footY - legH_px + ib, legW, legH_px);
            ctx.fillRect(1, footY - legH_px + ib, legW, legH_px);
            ctx.fillStyle = shoeColor;
            ctx.fillRect(-11, footY - 3 + ib, legW + 2, 3);
            ctx.fillRect(0, footY - 3 + ib, legW + 2, 3);
            break;
          }
          case 'run': {
            const phase = animFrame * Math.PI / 3;
            const l1 = Math.sin(phase) * 10, l2 = Math.sin(phase + Math.PI) * 10;
            const b1 = Math.abs(Math.sin(phase)) * -4, b2 = Math.abs(Math.sin(phase + Math.PI)) * -4;
            ctx.fillStyle = legDark;
            ctx.fillRect(-10, footY - legH_px + b1, legW, legH_px + l1);
            ctx.fillRect(1, footY - legH_px + b2, legW, legH_px + l2);
            ctx.fillStyle = legLight;
            ctx.fillRect(-9, footY - legH_px + 2 + b1, legW - 2, 3);
            ctx.fillRect(2, footY - legH_px + 2 + b2, legW - 2, 3);
            ctx.fillStyle = shoeColor;
            ctx.fillRect(-11, footY - 3 + b1 + l1, legW + 3, 3);
            ctx.fillRect(0, footY - 3 + b2 + l2, legW + 3, 3);
            break;
          }
          case 'jump': {
            ctx.fillStyle = legDark;
            ctx.fillRect(-11, footY - legH_px + 4, legW, legH_px - 6);
            ctx.fillRect(2, footY - legH_px + 4, legW, legH_px - 6);
            ctx.fillStyle = shoeColor;
            ctx.fillRect(-12, footY - legH_px + legH_px - 4, legW + 2, 3);
            ctx.fillRect(1, footY - legH_px + legH_px - 4, legW + 2, 3);
            break;
          }
          case 'fall': {
            ctx.fillStyle = legDark;
            ctx.fillRect(-13, footY - legH_px - 2, legW, legH_px + 4);
            ctx.fillRect(4, footY - legH_px - 2, legW, legH_px + 4);
            ctx.fillStyle = shoeColor;
            ctx.fillRect(-14, footY + 1, legW + 2, 3);
            ctx.fillRect(3, footY + 1, legW + 2, 3);
            break;
          }
          case 'attack': {
            ctx.fillStyle = legDark;
            ctx.fillRect(-11, footY - legH_px + 3, legW, legH_px - 2);
            ctx.fillRect(3, footY - legH_px - 2, legW, legH_px + 5);
            ctx.fillStyle = shoeColor;
            ctx.fillRect(-12, footY - 1, legW + 2, 3);
            ctx.fillRect(2, footY + 1, legW + 3, 3);
            break;
          }
        }
      }

      ctx.restore();

      // === EFFECTS (world-space, outside character transform) ===

      // --- Idle: subtle glow pulse ---
      if (animState === 'idle') {
        const pulse = (Math.sin(t * 2) + 1) * 0.5;
        ctx.fillStyle = hexRgba(color, 0.06 * pulse);
        ctx.beginPath();
        ctx.ellipse(px + W / 2, py + H / 2 + bob, 24, 28, 0, 0, Math.PI * 2);
        ctx.fill();
      }

      // --- Run: dust particles ---
      if (animState === 'run') {
        if (Math.random() < 0.4) {
          particles.push({
            x: player.x + W / 2 - dir * 12,
            y: player.y + H - 2,
            vx: -dir * (20 + Math.random() * 30),
            vy: -(10 + Math.random() * 20),
            life: 0.3 + Math.random() * 0.1,
            color: 'rgba(200,200,200,0.4)',
            size: 2 + Math.random() * 2,
          });
        }
        // Speed lines
        if (Math.random() < 0.25) {
          ctx.fillStyle = hexRgba(color, 0.12);
          const lx = px + W / 2 - dir * (18 + Math.random() * 14);
          ctx.fillRect(lx, py + 6 + Math.random() * 28, 2, 8 + Math.random() * 6);
        }
      }

      // --- Jump: launch particles ---
      if (animState === 'jump' && player.vy < -400) {
        for (let i = 0; i < 2; i++) {
          particles.push({
            x: player.x + W / 2 + (Math.random() - 0.5) * 20,
            y: player.y + H,
            vx: (Math.random() - 0.5) * 60,
            vy: 30 + Math.random() * 40,
            life: 0.3,
            color: '#fff',
            size: 2 + Math.random() * 2,
          });
        }
      }

      // --- Fall: wind streaks ---
      if (animState === 'fall' && player.vy > 250) {
        ctx.save();
        for (let i = 0; i < 3; i++) {
          ctx.fillStyle = hexRgba('#ffffff', 0.08 + i * 0.02);
          ctx.fillRect(px + 4 + i * 10, py - 4 - i * 8, 2, 10 + i * 4);
        }
        ctx.restore();
      }

      // --- Attack: weapon glow + slash arc + afterimage ---
      if (animState === 'attack') {
        const atkProg = player.atkTimer / c.atkCd;

        // Weapon orb
        const orbX = px + W / 2 + dir * (22 + (1 - atkProg) * 10);
        const orbY = py + H / 2 - 4;
        ctx.save();
        ctx.fillStyle = hexRgba(color, 0.45 * atkProg);
        ctx.shadowColor = color;
        ctx.shadowBlur = 10;
        ctx.fillRect(orbX - 9, orbY - 9, 18, 18);
        ctx.fillStyle = '#fff';
        ctx.fillRect(orbX - 3, orbY - 3, 6, 6);
        ctx.restore();

        // Slash arc
        if (atkProg > 0.5) {
          ctx.save();
          ctx.globalAlpha = (atkProg - 0.5) * 2;
          ctx.strokeStyle = '#fff';
          ctx.lineWidth = 2;
          ctx.beginPath();
          const arcCX = px + W / 2 + dir * 26;
          ctx.arc(arcCX, py + H / 2, 16, dir > 0 ? -0.8 : Math.PI - 0.8, dir > 0 ? 0.8 : Math.PI + 0.8);
          ctx.stroke();
          ctx.restore();
        }

        // Afterimage
        ctx.save();
        ctx.globalAlpha = 0.12;
        ctx.imageSmoothingEnabled = false;
        if (img && img.complete && img.naturalWidth > 0) {
          ctx.drawImage(img, px + W / 2 - spW / 2 - dir * 10, py + H - spH + spLift + bob, spW, spH);
        }
        ctx.restore();
      }

      // --- Landing impact ---
      if (player.grounded && animState !== 'run' && animState !== 'attack' && player.vy === 0) {
        // Small dust puffs at feet on landing
      }
    }

    // --- Game Loop ---
    function loop(time: number) {
      const dt = Math.min(0.032, (time - lastTime) / 1000 || 0);
      lastTime = time;
      update(dt);
      render(time);
      raf = requestAnimationFrame(loop);
    }

    // --- UI Events ---
    document.querySelectorAll<HTMLButtonElement>('.stage-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.stage-pill').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        selStage = parseInt(btn.dataset.stage || '0');
        setAccent(STAGES[selStage].accent);
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.char-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.char-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        selChar = parseInt(btn.dataset.char || '0');
      });
    });

    document.getElementById('goBtn')!.addEventListener('click', initGame);
    document.getElementById('retryBtn')!.addEventListener('click', initGame);
    document.getElementById('backBtn')!.addEventListener('click', () => {
      cancelAnimationFrame(raf);
      gameScreen.classList.add('hidden');
      resultsScreen.classList.add('hidden');
      touchControls.classList.add('hidden');
      titleScreen.classList.remove('hidden');
    });

    document.addEventListener('astro:before-swap', () => cancelAnimationFrame(raf), { once: true });

    // Start render loop
    setAccent(STAGES[0].accent);
    raf = requestAnimationFrame(loop);
  </script>
</BaseLayout>
