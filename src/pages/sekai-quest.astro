      }
      persistSave();
      updateCharacterLocks();
      updateStageLocks();
      updateTitleProgress();
    }
    // --- Stage Building ---
    function buildStage(stageIdx: number) {
      const stage = STAGES[stageIdx];
      platforms = []; enemies = []; collectNotes = []; pickups = []; npcs = []; projectiles = []; particles = []; floatingTexts = []; stageClearTimer = 0; boss = null;
      movingPlatforms = []; hazards = []; decors = []; ambientParticles = [];
      worldW = stage.worldW;
      stage.buildPlatforms(platforms);
      if ((stage as any).buildMovingPlatforms) (stage as any).buildMovingPlatforms(movingPlatforms);
      if ((stage as any).buildHazards) (stage as any).buildHazards(hazards);

      // Foreground decorations per stage
      const decorTypes = [
        // Stage 0: street scene - lamp posts, benches, vending machines
        [{ type: 'lamp', w: 16, h: 80 }, { type: 'bench', w: 48, h: 24 }, { type: 'vending', w: 32, h: 56 }],
        // Stage 1: broken SEKAI - floating notes, shards, twisted trees
        [{ type: 'brokenNote', w: 20, h: 24 }, { type: 'shard', w: 14, h: 40 }, { type: 'twistedTree', w: 48, h: 64 }],
        // Stage 2: echo corridor - pillars, lanterns
        [{ type: 'pillar', w: 20, h: 100 }, { type: 'lantern', w: 16, h: 20 }],
        // Stage 3: stage core - stage lights, curtains, speakers
        [{ type: 'stageLight', w: 24, h: 32 }, { type: 'curtain', w: 40, h: 90 }, { type: 'speaker', w: 36, h: 48 }],
      ];
      const stageDecorTypes = decorTypes[stageIdx] || decorTypes[0];
      for (let dx = 120; dx < worldW - 100; dx += 200 + Math.random() * 280) {
        const dType = stageDecorTypes[Math.floor(Math.random() * stageDecorTypes.length)];
        const layer = Math.random() < 0.3 ? 'front' : 'back';
        const parallax = layer === 'front' ? 1.08 + Math.random() * 0.06 : 0.92 + Math.random() * 0.08;
        // Place on ground platform if possible
        const groundY = 476;
        decors.push({ x: dx, y: groundY - dType.h, w: dType.w, h: dType.h, type: dType.type, layer, parallax });
      }

      const groundPlats = platforms.filter(p => {
        if (p.w < 90) return false;
        // Exclude platforms that have spikes on their surface
        for (const hz of hazards) {
          if (hz.x < p.x + p.w && hz.x + hz.w > p.x && Math.abs(hz.y - p.y) < 8) return false;
        }
        return true;
      });
      for (let i = 0; i < stage.enemies && i < groundPlats.length; i++) {
        const p = groundPlats[i];
        const roll = Math.random();
        let type: EnemyType;
        if (stageIdx === 0) {
          type = roll < 0.40 ? 'slime' : roll < 0.65 ? 'charger' : roll < 0.85 ? 'bat' : 'ghost';
        } else if (stageIdx === 1) {
          type = roll < 0.20 ? 'slime' : roll < 0.40 ? 'charger' : roll < 0.55 ? 'shielder' : roll < 0.75 ? 'bat' : 'ghost';
        } else if (stageIdx === 2) {
          type = roll < 0.18 ? 'charger' : roll < 0.32 ? 'shielder' : roll < 0.48 ? 'sniper' : roll < 0.60 ? 'ghost' : roll < 0.80 ? 'bat' : 'orbiter';
        } else if (stageIdx === 3) {
          type = roll < 0.18 ? 'sniper' : roll < 0.36 ? 'charger' : roll < 0.52 ? 'shielder' : roll < 0.66 ? 'ghost' : roll < 0.84 ? 'bat' : 'orbiter';
        } else {
          type = roll < 0.15 ? 'sniper' : roll < 0.30 ? 'charger' : roll < 0.45 ? 'shielder' : roll < 0.56 ? 'bomber' : roll < 0.68 ? 'ghost' : roll < 0.82 ? 'bat' : 'orbiter';
        }
        const elite = stageIdx > 0 && (i % 5 === 3 || (stageIdx >= 2 && Math.random() < 0.28));
        const baseHp = type === 'shielder' ? 4 : type === 'sniper' ? 4 : type === 'charger' ? 3 : type === 'ghost' ? 3 : type === 'bomber' ? 3 : type === 'orbiter' ? 2 : type === 'bat' ? 2 : 1;
        const hp = baseHp + (elite ? 3 + stageIdx : 0);
        const xp = (type === 'shielder' ? 52 : type === 'orbiter' ? 48 : type === 'sniper' ? 46 : type === 'charger' ? 38 : type === 'ghost' ? 35 : type === 'bomber' ? 36 : type === 'bat' ? 28 : 20) + (elite ? 45 : 0);
        const size = type === 'shielder' ? 36 : type === 'orbiter' ? 28 : type === 'bomber' ? 30 : (elite ? 40 : 32);
        const y = p.y - size;
        const vx = (type === 'sniper' ? 0 : (type === 'shielder' ? 40 : type === 'bomber' ? 50 : 60 + Math.random() * 40 + (elite ? 18 : 0))) * (Math.random() < 0.5 ? 1 : -1);
        enemies.push({ x: p.x + p.w / 2 - size / 2, y, w: size, h: size, vx, hp, maxHp: hp, left: p.x, right: p.x + p.w, type, alive: true, atkTimer: 0.8 + Math.random() * 1.6, xp, elite, baseY: y, dashTimer: 1.2 + Math.random() * 1.4, popIn: 0.35 });
      }

      const npcTemplates = NPCS_BY_STAGE[stageIdx] || [];
      npcTemplates.forEach((npc, index) => {
        const p = groundPlats[Math.min(groundPlats.length - 1, 1 + index * 3)] || platforms[0];
        npcs.push({ ...npc, x: p.x + Math.min(p.w - 42, 42 + index * 34), y: p.y - 48, w: 34, h: 48, met: false, seen: saveData.metNpcIds.includes(npc.id) });
      });

      const safePlats = platforms.filter(p => {
        for (const hz of hazards) {
          if (hz.x < p.x + p.w && hz.x + hz.w > p.x && Math.abs(hz.y - p.y) < 8) return false;
        }
        return true;
      });
      for (let i = 0; i < 8; i++) {
        if (safePlats.length === 0) break;
        const p = safePlats[i % safePlats.length];
        collectNotes.push({ x: p.x + 10 + Math.random() * Math.max(10, p.w - 20), y: p.y - 48 - Math.random() * 20, taken: false, spawnT: 0.5 });
      }
      for (let i = 0; i < 2; i++) {
        if (safePlats.length < 3) break;
        const p = safePlats[1 + i * 2];
        pickups.push({ x: p.x + p.w / 2, y: p.y - 40, type: 'health', taken: false, spawnT: 0.4 });
      }
      for (let i = 0; i < 3; i++) {
        if (safePlats.length < 3) break;
        const p = safePlats[1 + i * 2];
        pickups.push({ x: p.x + 30 + Math.random() * Math.max(0, p.w - 60), y: p.y - 68, type: 'amp', taken: false, spawnT: 0.5 });
      }
      if (stage.boss) {
        if (stageIdx === 5) {
          // Mafuyu boss: slower float, no teleport; liberation mechanic
          boss = { x: worldW - 430, y: 300, w: 96, h: 144, hp: 150, maxHp: 150, active: false, alive: true, phase: 1, pattern: 'idle', timer: 0, attackTimer: 2.0, burstCount: 0, beamWarn: 0, beamY: 0, beamX: 0, teleportTimer: 0, homeY: 300, driftX: 0, isMfy: true, liberateT: 0, minionIds: [] };
        } else {
          boss = { x: worldW - 430, y: 300, w: 96, h: 144, hp: 120, maxHp: 120, active: false, alive: true, phase: 1, pattern: 'idle', timer: 0, attackTimer: 1.4, burstCount: 0, beamWarn: 0, beamY: 0, beamX: 0, teleportTimer: 3.2, homeY: 300, driftX: 0 };
        }
      }
    }
    // --- Init Game ---
    function initGame(resetRun = true) {
      initAudio();
      if (resetRun) resetCampaign();
      const stage = STAGES[selStage];
      const prevHp = player ? player.hp : 0;
      setAccent(stage.accent);
      buildStage(selStage);

      const maxHp = maxHpForChar();
      const startHp = resetRun ? maxHp : Math.min(maxHp, Math.max(1, prevHp) + 1);
      player = { x: 60, y: 400, w: 36, h: 48, vx: 0, vy: 0, grounded: false, facing: 1, hp: startHp, maxHp, invuln: 0, jumps: 0, maxJumps: superMode ? 3 : (selChar === 2 || selChar === 3 || upgradeJump > 0) ? 2 : 1, atkTimer: 0 };
      if (!resetRun && rogueRegen > 0) player.hp = Math.min(player.maxHp, player.hp + rogueRegen);
      shieldCharges = rogueShield;
      cameraX = 0; running = true; finished = false; paused = false; pendingNextStage = false; resultRecorded = false;
      pauseOverlay.classList.add('hidden');
      pauseBtn.textContent = '暂停';

      titleScreen.classList.add('hidden');
      gameScreen.classList.remove('hidden');
      resultsScreen.classList.add('hidden');
      touchControls.classList.remove('hidden');
      if (!document.fullscreenElement && window.matchMedia('(pointer: coarse)').matches) {
        const gs = document.getElementById('gameScreen')!;
        gs.requestFullscreen().catch(() => {});
        showMsg('建议横屏全屏游玩', 2.4);
      }
      updateHud();
      showMsg(stage.name, 1.8);
      sfxStageStart(); startBgm();
    }

    function updateHud() {
      const maxHp = player.maxHp;
      hudHp.innerHTML = `<span class="hp-label">生命</span><span class="hp-count">${Math.max(0, player.hp)}/${maxHp}</span><span class="hp-hearts">${Array.from({ length: maxHp }, (_, i) => `<span class="hp-dot${i < player.hp ? ' filled' : ''}"></span>`).join('')}</span>`;
      hudNotes.textContent = String(notesCollected);
      hudLevel.textContent = String(heroLevel);
      hudXp.textContent = `${heroXp}/${heroXpNext}`;
      xpFill.style.width = `${Math.min(100, (heroXp / heroXpNext) * 100)}%`;
      hudScore.textContent = String(score);
      const abilityRarity: Record<string, string> = { '暗色强音':'COMMON','高速谱面':'COMMON','远响轨迹':'COMMON','残响护心':'COMMON','轻音踏步':'COMMON','穿透余音':'RARE','和弦分裂':'RARE','空白暴击':'RARE','夜色护盾':'EPIC','终幕回生':'EPIC','超能力':'EPIC' };
      const abilities = [
        { text: `${CHARS[selChar].name} · ${CHARS[selChar].desc}`, cls: '' },
        ...(upgradePower ? [{ text: `攻击 +${upgradePower}`, cls: '' }] : []),
        ...(upgradeHaste ? [{ text: `射速 +${upgradeHaste}`, cls: '' }] : []),
        ...(upgradeHp ? [{ text: `生命 +${upgradeHp}`, cls: '' }] : []),
        ...(upgradeJump ? [{ text: `机动 +${upgradeJump}`, cls: '' }] : []),
        ...(rogueRange ? [{ text: `射程 +${rogueRange}`, cls: '' }] : []),
        ...(roguePierce ? [{ text: `穿透 +${roguePierce}`, cls: '' }] : []),
        ...(rogueMulti ? [{ text: `副弹 +${rogueMulti}`, cls: '' }] : []),
        ...(rogueCrit ? [{ text: `暴击 ${Math.round(rogueCrit * 100)}%`, cls: '' }] : []),
        ...(shieldCharges ? [{ text: `护盾 ${shieldCharges}`, cls: 'epic' }] : []),
        ...(superMode ? [{ text: '超能力', cls: 'super' }] : []),
        ...(runAbilityNames.slice(-3).map(n => ({ text: n, cls: (abilityRarity[n] || '').toLowerCase() }))),
      ];
      hudAbilities.innerHTML = abilities.map(({ text, cls }) => `<span class="ability-chip${cls ? ' ' + cls : ''}">${text}</span>`).join('');
    }
    // --- Input ---
    document.addEventListener('keydown', e => {
      const k = e.key.toLowerCase();
      keys[k] = true;
      handleSecretInput(k);
      if ((k === 'escape' || k === 'p') && !gameScreen.classList.contains('hidden')) { e.preventDefault(); setPaused(!paused); return; }
      if (k === 'arrowup' || k === 'w' || k === ' ') { e.preventDefault(); doJump(); }
      if (k === 'j' || k === 'k') doAttack();
      if (k === 'enter' && !running && !titleScreen.classList.contains('hidden')) initGame(true);
    });
    document.addEventListener('keyup', e => {
      const k = e.key.toLowerCase();
      keys[k] = false;
      // Variable jump height: cut upward velocity on key release
      if ((k === 'arrowup' || k === 'w' || k === ' ') && player && player.vy < 0) {
        player.vy *= 0.55;
      }
    });

    // Touch
    const touchBtns = touchControls.querySelectorAll<HTMLButtonElement>('.t-btn');
    touchBtns.forEach(btn => {
      const dir = btn.dataset.dir || '';
      const down = (e: PointerEvent) => { e.preventDefault(); btn.setPointerCapture(e.pointerId); btn.classList.add('active'); keys['t_' + dir] = true; if (dir === 'jump') doJump(); if (dir === 'attack') doAttack(); };
      const up = () => { btn.classList.remove('active'); keys['t_' + dir] = false; if (dir === 'jump' && player && player.vy < 0) player.vy *= 0.55; };
      btn.addEventListener('pointerdown', down);
      btn.addEventListener('pointerup', up);
      btn.addEventListener('pointercancel', up);
      btn.addEventListener('lostpointercapture', up);
    });

    function doJump() {
      if (!running || finished || paused || choosingAbility) return;
      const canGroundJump = player.grounded || coyoteTimer > 0;
      if (canGroundJump) {
        player.vy = -jumpPower();
        player.grounded = false;
        coyoteTimer = 0;
        player.jumps = 1;
        sfxJump();
      } else if (player.jumps < player.maxJumps) {
        player.vy = -jumpPower();
        player.jumps++;
        sfxJump();
      } else {
        // Buffer the jump for when we land
        jumpBufferTimer = 0.12;
      }
    }

    function spawnPlayerProjectile(partial: Partial<Projectile>) {
      const c = CHARS[selChar];
      projectiles.push({
        x: player.x + (player.facing > 0 ? player.w : -22),
        y: player.y + 16,
        w: superMode ? 26 : 16,
        h: superMode ? 15 : 12,
        vx: projectileSpeed() * player.facing,
        vy: 0,
        life: projectileLife(),
        damage: rollAttackDamage(),
        kind: 'player',
        color: superMode ? '#ffd66e' : c.color,
        shape: 'note',
        pierce: roguePierce + (superMode ? 2 : 0),
        ...partial,
      });
    }

    function doAttack() {
      if (!running || finished || paused || choosingAbility || player.atkTimer > 0) return;
      const c = CHARS[selChar];
      const dir = player.facing;
      const spd = projectileSpeed();
      const dmg = rollAttackDamage();
      const pierce = roguePierce + (superMode ? 2 : 0);
      player.atkTimer = attackCooldown();

      if (selChar === 0) {
        const count = 1 + Math.min(2, rogueMulti);
        for (let i = 0; i < count; i++) {
          const spread = (i - (count - 1) / 2) * 80;
          spawnPlayerProjectile({ y: player.y + 12 + i * 8, w: 15, h: 15, vx: spd * 0.82 * dir, vy: spread, life: projectileLife() + 0.25, damage: Math.max(1, dmg), shape: 'note', homing: 0.09, pierce });
        }
      } else if (selChar === 1) {
        spawnPlayerProjectile({ x: player.x + (dir > 0 ? player.w - 4 : -56), y: player.y + 13, w: superMode ? 76 : 58, h: 18, vx: spd * 1.08 * dir, vy: 0, life: projectileLife() * 0.72, damage: dmg + 1, shape: 'slash', pierce: pierce + 1 });
        if (rogueMulti > 0) spawnPlayerProjectile({ x: player.x + (dir > 0 ? player.w - 2 : -44), y: player.y + 30, w: 44, h: 12, vx: spd * 0.98 * dir, vy: 0, life: projectileLife() * 0.58, damage: Math.max(1, dmg - 1), shape: 'slash', pierce });
      } else if (selChar === 2) {
        const count = 3 + Math.min(2, rogueMulti);
        for (let i = 0; i < count; i++) {
          const spread = (i - (count - 1) / 2) * 72;
          spawnPlayerProjectile({ y: player.y + 18, w: 13, h: 13, vx: spd * dir, vy: spread, life: projectileLife() * 0.82, damage: Math.max(1, dmg), shape: 'fan', pierce });
        }
        player.vx += dir * 90;
      } else if (selChar === 3) {
        spawnPlayerProjectile({ y: player.y + 10, w: 20, h: 20, vx: spd * 0.72 * dir, vy: -170 - rogueMulti * 24, life: projectileLife() + 0.45, damage: dmg + 1, shape: 'paint', accelY: 520, aoe: 72 + rogueRange * 10, pierce: 0 });
      } else {
        const count = 1 + Math.min(2, rogueMulti);
        for (let i = 0; i < count; i++) {
          const offset = (i - (count - 1) / 2) * 13;
          spawnPlayerProjectile({ y: player.y + 18 + offset, w: superMode ? 86 : 64, h: 10, vx: spd * 1.45 * dir, vy: 0, life: projectileLife() * 0.64, damage: dmg, shape: 'beam', pierce: pierce + 2 });
        }
      }
      sfxHit();
      shake(3);
      freezeTimer = 0.015;
      // Directional muzzle flash
      const mx = player.x + player.w / 2 + dir * 24;
      const my = player.y + 20;
      burst(mx, my, c.color, 10 + rogueMulti * 2);
      for (let i = 0; i < 6 + rogueMulti * 2; i++) {
        particles.push({ x: mx + (Math.random() - 0.5) * 12, y: my + (Math.random() - 0.5) * 12, vx: dir * (80 + Math.random() * 140) + (Math.random() - 0.5) * 60, vy: (Math.random() - 0.5) * 120, life: 0.2 + Math.random() * 0.15, color: '#fff', size: 1.5 + Math.random() * 1.5 });
      }
    }

    function killEnemy(enemy: Enemy, bonusScore: number) {
      if (!enemy.alive) return;
      enemy.alive = false; enemy.deathTimer = 0.3; enemiesKilled++; score += bonusScore; gainXp(enemy.xp);
      const cx = enemy.x + enemy.w / 2, cy = enemy.y + enemy.h / 2;
      burst(cx, cy, STAGES[selStage].accent, 12);
      freezeTimer = 0.03;
      sfxKill(); shake(8); updateHud();
      floatingTexts.push({ x: cx, y: enemy.y - 4, text: '+' + bonusScore, color: STAGES[selStage].accent, life: 1.2, vy: -120 });
      if (rogueExplode > 0) {
        const radius = 120 + rogueExplode * 20;
        burst(cx, cy, '#ff8800', 24);
        sfxExplode();
        for (const other of enemies) {
          if (other === enemy || !other.alive) continue;
          if (Math.hypot(other.x + other.w / 2 - cx, other.y + other.h / 2 - cy) < radius) {
            other.hp -= rogueExplode;
            if (other.hp <= 0) killEnemy(other, 0);
          }
        }
        if (boss && boss.alive && Math.hypot(boss.x + boss.w / 2 - cx, boss.y + boss.h / 2 - cy) < radius) {
          damageBoss(rogueExplode);
        }
      }
    }
    function spawnAimedProjectile(x: number, y: number, speed: number, kind: 'enemy' | 'boss', color: string, size = 14) {
      const tx = player.x + player.w / 2 - x, ty = player.y + player.h / 2 - y;
      const len = Math.max(1, Math.hypot(tx, ty));
      projectiles.push({ x, y, w: size, h: size, vx: tx / len * speed, vy: ty / len * speed, life: 3, damage: 1, kind, color });
    }

    function nearestProjectileTarget(proj: Projectile) {
      let target: Rect | null = null;
      let best = 999999;
      for (const enemy of enemies) {
        if (!enemy.alive) continue;
        const dx = enemy.x + enemy.w / 2 - (proj.x + proj.w / 2);
        const dy = enemy.y + enemy.h / 2 - (proj.y + proj.h / 2);
        const d = dx * dx + dy * dy;
        if (d < best && d < 520 * 520) { best = d; target = enemy; }
      }
      if (boss && boss.alive && boss.active) {
        const dx = boss.x + boss.w / 2 - (proj.x + proj.w / 2);
        const dy = boss.y + boss.h / 2 - (proj.y + proj.h / 2);
        const d = dx * dx + dy * dy;
        if (d < best && d < 620 * 620) target = boss;
      }
      return target;
    }

    function consumeProjectileHit(proj: Projectile) {
      if (proj.aoe) explodePlayerProjectile(proj);
      if ((proj.pierce || 0) > 0 && !proj.aoe) {
        proj.pierce = (proj.pierce || 0) - 1;
        proj.x += Math.sign(proj.vx || player.facing) * Math.max(18, proj.w);
      } else {
        proj.life = 0;
      }
    }

    function explodePlayerProjectile(proj: Projectile) {
      const radius = proj.aoe || 0;
      if (!radius) return;
      const cx = proj.x + proj.w / 2;
      const cy = proj.y + proj.h / 2;
      burst(cx, cy, proj.color, 22);
      shake(8);
      for (const enemy of enemies) {
        if (!enemy.alive) continue;
        const ex = enemy.x + enemy.w / 2, ey = enemy.y + enemy.h / 2;
        if (Math.hypot(ex - cx, ey - cy) <= radius) {
          enemy.hp -= Math.max(1, Math.floor(proj.damage * 0.75));
          if (enemy.hp <= 0) killEnemy(enemy, 200 + (enemy.elite ? 240 : 0));
        }
      }
      if (boss && boss.alive && boss.active) {
        const bx = boss.x + boss.w / 2, by = boss.y + boss.h / 2;
        if (Math.hypot(bx - cx, by - cy) <= radius + 40) damageBoss(Math.max(1, Math.floor(proj.damage * 0.7)));
      }
    }

    function damageBoss(amount: number) {
      if (!boss || !boss.alive) return;
      boss.hp = Math.max(0, boss.hp - amount);
      freezeTimer = 0.04;
      burst(boss.x + boss.w / 2, boss.y + boss.h / 2, '#ffffff', 8); shake(8);
      if (boss.hp <= 0) {
        boss.alive = false; boss.active = false; score += 2500; finished = true; running = false; pendingNextStage = selStage < STAGES.length - 1; gainXp(220);
        burst(boss.x + boss.w / 2, boss.y + boss.h / 2, STAGES[selStage].accent, 36);
        sfxClear();
        startBossDefeatCutscene();
      } else if (boss.isMfy) {
        const phaseThreshold = boss.phase === 1 ? 0.66 : 0.34;
        if (boss.hp <= boss.maxHp * phaseThreshold) {
          boss.phase++;
          screenFlash = 0.5; screenFlashColor = '#bb66ee';
          showMsg(`BOSS 第${boss.phase}阶段`, 1.1); shake(18);
          burst(boss.x + boss.w / 2, boss.y + boss.h / 2, '#bb66ee', 36);
