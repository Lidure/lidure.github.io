---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categoryMeta, categoryOrder } from '../data/moments';
---
<BaseLayout title="碎碎念 | 搁浅 的小窝" description="游戏，音乐、生活、吐槽，随时碎碎念。" showTime={true}>
  <section class="moments-shell" data-moments-api>

    <!-- Hero -->
    <div class="moments-hero">
      <div class="hero-bubbles">
        <span class="bubble b1"></span>
        <span class="bubble b2"></span>
        <span class="bubble b3"></span>
      </div>
      <span class="kicker">✨ Moments</span>
      <h1>碎碎念</h1>
      <p>随手记下的碎片，游戏 · 音乐 · 生活 · 吐槽。随时更新，想到什么说什么。</p>
      <div class="hero-stats" id="hero-stats">
        <span class="stat-badge"><strong id="stat-total">—</strong> 条动态</span>
        <span class="stat-badge">🎮 <strong id="stat-game">—</strong></span>
        <span class="stat-badge">🎵 <strong id="stat-music">—</strong></span>
        <span class="stat-badge">☕ <strong id="stat-life">—</strong></span>
        <span class="stat-badge">💬 <strong id="stat-rant">—</strong></span>
      </div>
    </div>

    <!-- 控制栏：筛选 + 发布 -->
    <div class="controls-bar">
      <div class="cat-pills">
        <button class="pill active" data-category="all">全部</button>
        {categoryOrder.map((cat) => (
          <button class="pill" data-category={cat}>
            {categoryMeta[cat].icon}
          </button>
        ))}
      </div>
      <button class="fab" id="publish-toggle" aria-label="发布新动态" data-admin-only hidden>
        <span id="toggle-icon">✏️</span>
      </button>
    </div>

    <!-- 发布面板 -->
    <div class="publish-panel hidden" id="publish-box" data-admin-only hidden>
      <div class="panel-topbar">
        <span class="panel-title">📝 发布新动态</span>
        <button type="button" class="icon-btn" id="close-btn" aria-label="关闭">✕</button>
      </div>
      <form id="publish-form" class="publish-form">
        <div class="form-row">
          <label class="field">
            <span class="field-label">🕒 时间</span>
            <input type="datetime-local" name="date" required />
          </label>
          <label class="field">
            <span class="field-label">🏷️ 分类</span>
            <select name="category" required>
              <option value="">选择分类</option>
              {categoryOrder.map((cat) => (
                <option value={cat}>{categoryMeta[cat].icon} {cat}</option>
              ))}
            </select>
          </label>
        </div>
        <label class="field full">
          <span class="field-label">✏️ 内容</span>
          <div class="emoji-input-wrap">
            <textarea name="text" rows="3" placeholder="想说点什么..." required></textarea>
            <button type="button" class="emoji-toggle" id="moment-emoji-toggle" title="插入 emoji" aria-label="插入 emoji" aria-expanded="false">😊</button>
            <div class="emoji-panel hidden" id="moment-emoji-panel"></div>
          </div>
        </label>
        <label class="field full">
          <span class="field-label">🔗 链接（可选）</span>
          <input type="url" name="link" placeholder="https://..." />
        </label>

        <div class="image-upload-area" id="image-upload-area">
          <input type="file" id="image-input" accept="image/*,video/mp4,video/webm" multiple hidden />
          <input type="file" id="manual-poster-input" accept="image/jpeg" hidden />
          <input type="range" id="video-poster-range" min="0.1" max="1" step="0.1" value="0.1" hidden aria-label="video poster time" />
          <div class="upload-dropzone" id="upload-placeholder">
            <span>📷 点击上传 / 拖入 / Ctrl+V 粘贴图片（最多 9 张）</span>
          </div>
          <div class="image-previews" id="image-previews"></div>
        </div>

        <div class="field full session-field">
          <div class="session-status-row">
            <p id="moments-session-status" class="session-status">检查登录状态中...</p>
            <button type="button" id="moments-logout" class="session-secondary" hidden>退出登录</button>
          </div>
          <div id="moments-login" class="session-login" hidden>
            <input type="password" id="moments-login-password" autocomplete="current-password" placeholder="管理密码" />
            <button type="button" id="moments-login-submit" class="session-secondary">登录</button>
          </div>
        </div>

        <button type="submit" class="submit-btn" id="submit-btn">🚀 发布</button>
        <p class="form-note">登录状态由安全 Cookie 保存，不再在浏览器保存管理密钥。</p>
      </form>
      <div id="form-message"></div>
    </div>

    <!-- 时间线 -->
    <div class="moments-list" id="moments-list">
      <div class="loading-skeleton">
        <div class="skeleton-card" style="--delay: 0ms"><div class="skeleton-bar"></div><div class="skeleton-line"></div><div class="skeleton-line short"></div></div>
        <div class="skeleton-card" style="--delay: 80ms"><div class="skeleton-bar"></div><div class="skeleton-line"></div><div class="skeleton-line short"></div></div>
        <div class="skeleton-card" style="--delay: 160ms"><div class="skeleton-bar"></div><div class="skeleton-line"></div><div class="skeleton-line short"></div></div>
      </div>
    </div>
    <button type="button" id="moments-retry" class="moments-retry" hidden>重试加载</button>

    <div class="lightbox-overlay" id="moment-lightbox" aria-hidden="true" hidden>
      <button type="button" class="lightbox-close" id="lightbox-close" aria-label="Close image preview">&times;</button>
      <button type="button" class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Previous image">&#8249;</button>
      <figure class="lightbox-stage" id="lightbox-stage">
        <img class="lightbox-image" id="lightbox-image" src="" alt="" decoding="async" />
        <figcaption class="lightbox-counter" id="lightbox-counter"></figcaption>
      </figure>
      <button type="button" class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Next image">&#8250;</button>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== 页面框架 ===== */
  .moments-shell {
    max-width: 760px;
    margin: 0 auto;
  }

  /* ===== Hero 区域 ===== */
  .moments-hero {
    position: relative;
    padding: 40px 36px 32px;
    margin-bottom: 28px;
    background: var(--panel-gradient);
    border: 1px solid var(--panel-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow);
    overflow: hidden;
    text-align: center;
  }

  .hero-bubbles {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .bubble {
    position: absolute;
    border-radius: 50%;
    opacity: 0.15;
    filter: blur(30px);
  }

  .b1 {
    width: 200px; height: 200px;
    background: var(--accent);
    top: -60px; left: -40px;
    animation: bubble-float 8s ease-in-out infinite;
  }

  .b2 {
    width: 160px; height: 160px;
    background: var(--accent-2);
    bottom: -40px; right: 10%;
    animation: bubble-float 10s ease-in-out infinite reverse;
  }

  .b3 {
    width: 120px; height: 120px;
    background: var(--accent-3);
    top: 20px; right: -30px;
    animation: bubble-float 7s ease-in-out infinite 2s;
  }

  @keyframes bubble-float {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-15px) scale(1.05); }
  }

  .moments-hero .kicker {
    position: relative;
    z-index: 1;
  }

  .moments-hero h1 {
    position: relative;
    z-index: 1;
    margin: 10px 0 10px;
    font-family: 'Ma Shan Zheng', cursive;
    font-size: 4.2rem;
    letter-spacing: 0;
  }

  .moments-hero p {
    position: relative;
    z-index: 1;
    color: var(--muted);
    margin: 0 0 20px;
    font-size: 1.02rem;
  }

  .hero-stats {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }

  .stat-badge {
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--tag-bg);
    border: 1px solid var(--panel-border);
    font-size: 0.85rem;
    color: var(--muted);
  }

  .stat-badge strong {
    color: var(--accent);
    font-weight: 700;
  }

  /* ===== 控制栏 ===== */
  .controls-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 24px;
  }

  .cat-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pill {
    padding: 7px 16px;
    border-radius: 999px;
    border: 1px solid var(--panel-border);
    background: var(--panel);
    color: var(--text-soft);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 180ms ease;
  }

  .pill:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .pill.active {
    background: linear-gradient(135deg, var(--accent), var(--accent-3));
    color: white;
    border-color: transparent;
    box-shadow: 0 4px 16px rgba(var(--accent-rgb), 0.3);
  }

  .fab {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background: linear-gradient(135deg, var(--accent), var(--accent-3));
    color: white;
    font-size: 1.1rem;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(var(--accent-rgb), 0.35);
    transition: transform 200ms ease, box-shadow 200ms ease;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .fab:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 24px rgba(var(--accent-rgb), 0.45);
  }

  .fab:active {
    transform: scale(0.95);
  }

  /* ===== 发布面板 ===== */
  .publish-panel {
    background: var(--panel-gradient);
    border: 1px solid var(--panel-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow);
    padding: 24px 26px;
    margin-bottom: 28px;
    backdrop-filter: blur(14px);
  }

  .panel-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .panel-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
  }

  .icon-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    color: var(--muted);
    padding: 4px 10px;
    border-radius: 8px;
    transition: all 180ms ease;
  }

  .icon-btn:hover {
    color: var(--text);
    background: var(--tag-bg);
  }

  .publish-form {
    display: grid;
    gap: 14px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field.full {
    grid-column: 1 / -1;
  }

  .field-label {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--muted);
    letter-spacing: 0.03em;
  }

  .field input,
  .field select,
  .field textarea {
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid var(--panel-border);
    background: var(--bg);
    color: var(--text);
    font-size: 0.93rem;
    font-family: inherit;
    transition: border-color 180ms ease;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
  }

  .field textarea {
    resize: vertical;
    min-height: 80px;
  }

  .emoji-input-wrap {
    position: relative;
  }

  .emoji-input-wrap textarea {
    width: 100%;
    padding-right: 48px;
  }

  .emoji-toggle {
    position: absolute;
    right: 10px;
    top: 10px;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    border: 1px solid var(--panel-border);
    background: var(--tag-bg);
    color: var(--text);
    cursor: pointer;
    font-size: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .emoji-toggle:hover {
    border-color: var(--accent);
    background: rgba(var(--accent-rgb), 0.1);
  }

  .emoji-panel {
    position: absolute;
    right: 0;
    top: 48px;
    z-index: 5;
    display: grid;
    grid-template-columns: repeat(6, 34px);
    gap: 4px;
    padding: 8px;
    border: 1px solid var(--panel-border);
    border-radius: 12px;
    background: var(--panel);
    box-shadow: var(--shadow-soft);
  }

  .emoji-panel.hidden {
    display: none;
  }

  .emoji-panel button {
    width: 34px;
    height: 34px;
    border: none;
    border-radius: 8px;
    background: transparent;
    cursor: pointer;
    font-size: 1.1rem;
  }

  .emoji-panel button:hover {
    background: var(--tag-bg);
  }

  /* 图片上传 */
  .image-upload-area {
    grid-column: 1 / -1;
  }

  .upload-dropzone {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    border: 2px dashed var(--panel-border);
    border-radius: 14px;
    cursor: pointer;
    font-size: 0.88rem;
    color: var(--muted);
    transition: all 180ms ease;
  }

  .upload-dropzone:hover,
  .upload-dropzone.drag-over {
    border-color: var(--accent);
    background: var(--tag-bg);
    color: var(--accent);
  }

  .image-previews {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 10px;
  }

  .preview-item {
    position: relative;
    width: 72px;
    height: 72px;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--panel-border);
  }

  .preview-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .preview-item .remove-img {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(0,0,0,0.65);
    color: white;
    border: none;
    cursor: pointer;
    font-size: 0.65rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .preview-item .upload-progress {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 0.75rem;
    border-radius: 10px;
  }

  .preview-item .upload-progress.hidden {
    display: none;
  }

  .preview-item.uploaded .upload-progress {
    background: rgba(40, 140, 80, 0.72);
  }

  .preview-item.failed .upload-progress {
    background: rgba(160, 30, 30, 0.72);
  }

  /* Session */
  .session-field {
    grid-column: 1 / -1;
  }

  .session-status-row,
  .session-login {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .session-status-row {
    justify-content: space-between;
    flex-wrap: wrap;
  }

  .session-status {
    margin: 0;
    color: var(--muted);
    font-size: 0.86rem;
  }

  .session-status.authenticated {
    color: #3aaa5a;
  }

  .session-status.error {
    color: #d94040;
  }

  .session-login[hidden],
  .session-secondary[hidden] {
    display: none;
  }

  .session-login input {
    flex: 1;
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid var(--panel-border);
    background: var(--bg);
    color: var(--text);
    font-size: 0.93rem;
    font-family: inherit;
    transition: border-color 180ms ease;
  }

  .session-login input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .session-secondary {
    border-radius: 999px;
    border: 1px solid var(--panel-border);
    background: var(--bg-soft);
    color: var(--text-soft);
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 8px 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 180ms ease;
  }

  .session-secondary:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: rgba(var(--accent-rgb), 0.08);
  }

  .submit-btn {
    grid-column: 1 / -1;
    padding: 13px;
    border-radius: 14px;
    border: none;
    background: linear-gradient(135deg, var(--accent), var(--accent-3));
    color: white;
    font-size: 0.97rem;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(var(--accent-rgb), 0.3);
    transition: transform 180ms ease, box-shadow 180ms ease, opacity 180ms ease;
  }

  .submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(var(--accent-rgb), 0.4);
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .form-note {
    grid-column: 1 / -1;
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0;
    text-align: center;
  }

  #form-message {
    grid-column: 1 / -1;
    padding: 10px 14px;
    border-radius: 12px;
    font-size: 0.88rem;
    text-align: center;
    margin-top: -4px;
  }

  #form-message.success {
    background: rgba(80, 200, 120, 0.15);
    color: #3aaa5a;
  }

  #form-message.error {
    background: rgba(255, 80, 80, 0.12);
    color: #d94040;
  }

  /* 隐藏/展开动画 */
  .publish-panel.hidden {
    display: none;
  }

  @keyframes slide-down {
    from { opacity: 0; transform: translateY(-12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .publish-panel:not(.hidden) {
    animation: slide-down 250ms ease both;
  }

  /* ===== 加载骨架屏 ===== */
  .loading-skeleton {
    display: grid;
    gap: 16px;
  }

  .skeleton-card {
    background: var(--panel-gradient);
    border: 1px solid var(--panel-border);
    border-radius: var(--radius-lg);
    padding: 20px 26px;
    margin-left: 20px;
    animation: skeleton-pulse 1.4s ease-in-out infinite;
    animation-delay: var(--delay, 0ms);
  }

  .skeleton-bar {
    width: 80px;
    height: 20px;
    border-radius: 999px;
    background: var(--tag-bg);
    margin-bottom: 14px;
  }

  .skeleton-line {
    height: 14px;
    border-radius: 7px;
    background: var(--tag-bg);
    margin-bottom: 8px;
  }

  .skeleton-line.short {
    width: 55%;
  }

  @keyframes skeleton-pulse {
    0%, 100% { opacity: 0.45; }
    50% { opacity: 0.8; }
  }

  .empty-state {
    text-align: center;
    color: var(--muted);
    font-size: 1rem;
    padding: 48px 20px;
    margin-left: 20px;
  }

  .error-state {
    color: #d94040;
  }

  .moments-retry {
    margin: 14px auto 0;
    padding: 9px 18px;
    border-radius: 999px;
    border: 1px solid var(--panel-border);
    background: var(--panel);
    color: var(--accent);
    cursor: pointer;
    font-weight: 700;
  }

  .moments-retry[hidden] {
    display: none;
  }

  /* ===== 时间线卡片 ===== */
  .moments-list {
    display: grid;
    gap: 16px;
    padding-left: 20px;
    border-left: 2px solid var(--panel-border);
    margin-left: 4px;
  }

  .moment-card {
    position: relative;
    margin-left: 20px;
    background: var(--panel-gradient);
    border: 1px solid var(--panel-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(14px);
    transition: transform 220ms ease, box-shadow 220ms ease;
    animation: card-in 400ms ease both;
    animation-delay: var(--delay, 0ms);
  }

  @keyframes card-in {
    from { opacity: 0; transform: translateX(-12px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .moment-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .moment-card:has(.moment-reaction-panel:not([hidden])) {
    z-index: 120;
  }

  .moment-card::before {
    content: '';
    position: absolute;
    left: -25px;
    top: 22px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--bg);
    box-shadow: 0 0 0 2px var(--accent);
  }

  .card-glow {
    position: absolute;
    top: 0; left: 0;
    width: 4px;
    height: 100%;
    border-radius: var(--radius-lg) 0 0 var(--radius-lg);
  }

  .glow-游戏 { background: linear-gradient(to bottom, #FF6B9D, #7C8CF8); }
  .glow-音乐 { background: linear-gradient(to bottom, #FFB347, #FF6B9D); }
  .glow-生活 { background: linear-gradient(to bottom, #7C8CF8, #FFB347); }
  .glow-吐槽 { background: linear-gradient(to bottom, #50C878, #FFB347); }

  .card-content {
    padding: 20px 22px 20px 26px;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    flex-wrap: wrap;
    gap: 8px;
  }

  .card-meta-left,
  .card-actions {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .cat-pill {
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .pill-游戏 { background: rgba(255, 107, 157, 0.12); color: #E0456E; }
