---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categoryOrder } from '../data/moments';
import '../styles/moments.css';
---
<BaseLayout
  title="碎碎念 | 搁浅 的小窝"
  description="游戏，音乐、生活、吐槽，随时碎碎念。"
  showBanner={false}
>
  <section class="moments-shell" data-moments-api>
    <header class="moments-wall-head">
      <h1>碎碎念</h1>
      <p>随手记下路过脑海和生活里的小事。</p>
    </header>

    <div class="controls-bar moments-wall-filter" aria-label="筛选碎碎念">
      <div class="cat-pills">
        <button class="pill active" data-category="all">全部</button>
        {categoryOrder.map((cat) => <button class="pill" data-category={cat}>{cat}</button>)}
      </div>
      <button class="fab moments-compose-trigger" id="publish-toggle" aria-label="写一条碎碎念" aria-expanded="false">
        <span id="toggle-icon" aria-hidden="true">✎</span>
        <span class="moments-compose-label">今天想记点什么？</span>
      </button>
    </div>

    <div class="publish-panel hidden" id="publish-box">
      <div class="panel-topbar">
        <span class="panel-title">写点什么</span>
        <button type="button" class="icon-btn" id="close-btn" aria-label="关闭">×</button>
      </div>
      <form id="publish-form" class="publish-form">
        <div class="form-row">
          <label class="field">
            <span class="field-label">时间</span>
            <input type="datetime-local" name="date" required />
          </label>
          <label class="field">
            <span class="field-label">分类</span>
            <select name="category" required>
              <option value="">选择分类</option>
              {categoryOrder.map((cat) => <option value={cat}>{cat}</option>)}
            </select>
          </label>
        </div>

        <label class="field full">
          <span class="field-label">内容</span>
          <div class="emoji-input-wrap">
            <textarea name="text" rows="4" placeholder="现在脑子里在想什么？" required></textarea>
            <button type="button" class="emoji-toggle" id="moment-emoji-toggle" title="插入 emoji" aria-label="插入 emoji" aria-expanded="false">☺</button>
            <div class="emoji-panel hidden" id="moment-emoji-panel"></div>
          </div>
        </label>

        <label class="field full">
          <span class="field-label">链接（可选）</span>
          <input type="url" name="link" placeholder="https://..." />
        </label>

        <div class="image-upload-area" id="image-upload-area">
          <input type="file" id="image-input" accept="image/*,video/mp4,video/webm" multiple hidden />
          <input type="file" id="manual-poster-input" accept="image/jpeg" hidden />
          <input type="range" id="video-poster-range" min="0.1" max="1" step="0.1" value="0.1" hidden aria-label="video poster time" />
          <div class="upload-dropzone" id="upload-placeholder">
            <span>点击、拖入或粘贴图片 / 视频，最多 9 个</span>
          </div>
          <div class="image-previews" id="image-previews"></div>
        </div>

        <div class="field full session-field">
          <div class="session-status-row">
            <p id="moments-session-status" class="session-status">检查登录状态中...</p>
            <button type="button" id="moments-logout" class="session-secondary" hidden>退出登录</button>
          </div>
          <div id="moments-login" class="session-login" hidden>
            <input type="password" id="moments-login-password" autocomplete="current-password" placeholder="管理密码" />
            <button type="button" id="moments-login-submit" class="session-secondary">登录</button>
          </div>
        </div>

        <button type="submit" class="submit-btn" id="submit-btn">发布</button>
        <p class="form-note">登录状态由安全 Cookie 保存，不在浏览器保存管理密钥。</p>
      </form>
      <div id="form-message"></div>
    </div>

    <div class="moments-list" id="moments-list">
      <div class="loading-skeleton" aria-label="正在加载碎碎念">
        <div class="skeleton-card"><div class="skeleton-bar"></div><div class="skeleton-line"></div><div class="skeleton-line short"></div></div>
        <div class="skeleton-card"><div class="skeleton-bar"></div><div class="skeleton-line"></div><div class="skeleton-line short"></div></div>
      </div>
    </div>
    <button type="button" id="moments-retry" class="moments-retry" hidden>重新加载</button>

    <div class="lightbox-overlay" id="moment-lightbox" aria-hidden="true" hidden>
      <button type="button" class="lightbox-close" id="lightbox-close" aria-label="关闭图片预览">&times;</button>
      <button type="button" class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="上一张">&#8249;</button>
      <figure class="lightbox-stage" id="lightbox-stage">
        <img class="lightbox-image" id="lightbox-image" src="" alt="" decoding="async" />
        <figcaption class="lightbox-counter" id="lightbox-counter"></figcaption>
      </figure>
      <button type="button" class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="下一张">&#8250;</button>
    </div>
  </section>
</BaseLayout>

<script>
  import { uploadToR2 } from '../lib/r2-upload';
  import { captureVideoPoster, choosePosterTime, VideoPosterError } from '../lib/video-poster';
  import {
    createMoment as createMomentViaApi,
    deleteMoment as deleteMomentViaApi,
    fetchMoments,
    getSession,
    login,
    logout,
    MomentApiError,
  } from '../lib/moments-api';
  import { createCommentsWidget } from '../lib/public-interactions';
  import { classifyMomentLayout, getMomentDateKey, getMomentDayParts } from '../lib/moments-life-wall.mjs';

  const DEFAULT_DANMAKU_API_BASE = 'https://api.lidure22.xyz/api';
  const API_BASE = (import.meta.env.PUBLIC_MOMENTS_API || DEFAULT_DANMAKU_API_BASE).replace(/\/$/, '');
  const MOMENT_REACTIONS_API_URL = `${API_BASE}/moment-reactions`;
  const IMAGE_PUBLIC_BASE = (import.meta.env.PUBLIC_MEDIA_BASE_URL || 'https://api.lidure22.xyz/media').replace(/\/$/, '');
  const MOMENT_REACTION_STORAGE_KEY = 'moment_reactions_v1';
  const maxMediaItems = 9;
  const maxImageBytes = 8 * 1024 * 1024;
  const maxVideoBytes = 100 * 1024 * 1024;
  let adminMode = false;

  type MomentMedia = { kind: 'image' | 'video' | 'poster'; url: string };

  type RenderMoment = {
    id?: string;
    date: string;
    category: string;
    text: string;
    link?: string;
    images: string[];
    media: MomentMedia[];
    createdAt?: number;
    reactions?: Record<string, number>;
  };

  const knownCategories = new Set(['游戏', '音乐', '生活', '吐槽']);
  const MOMENT_EMOJIS = ['😀', '😂', '😭', '🥺', '😎', '🤔', '👍', '👏', '🎉', '✨', '💯', '❤️'];
  const MOMENT_REACTION_EMOJIS = ['❤️', '😂', '😭', '👍', '👎', '✨', '🔥', '🥰', '👏', '😮', '🤔', '🎉', '💯', '😍', '😎', '🥺', '😡', '😴', '🙏', '💪', '🌟', '🍀', '🫶', '😆', '🤯', '😱', '😢', '🤣', '🤩', '🙌', '👌', '😋', '😇', '🤗', '😤', '😐', '😵', '😳', '🤓', '👀', '💔', '⚡', '🏆', '🎁', '🍻', '☕', '🌈', '💤'];
  let currentMoments: RenderMoment[] = [];
  let toastTimer: number | undefined;
  let scopedStyleAttribute: string | null | undefined;

  function reducedMotionPreferred() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches
      || document.documentElement.dataset.reduceMotion === 'true';
  }

  function resolveImageCandidates(src: string) {
    if (!src) return [];
    if (src.startsWith('http://') || src.startsWith('https://')) return [src];
    const normalized = src.replace(/^\/+/, '');
    return Array.from(new Set([
      `${IMAGE_PUBLIC_BASE}/${normalized}`,
      `${API_BASE}/${normalized}`,
      `${window.location.origin}/${normalized}`,
    ]));
  }

  function attachImageFallback(img: HTMLImageElement, candidates: string[]) {
    if (candidates.length <= 1) return;
    img.dataset.imageCandidates = JSON.stringify(candidates);
    img.dataset.imageCandidateIndex = '0';
    img.addEventListener('error', () => {
      const nextIndex = Number.parseInt(img.dataset.imageCandidateIndex || '0', 10) + 1;
      const next = candidates[nextIndex];
      if (!next) {
        img.classList.add('image-load-failed');
        return;
      }
      img.dataset.imageCandidateIndex = String(nextIndex);
      img.src = next;
    });
  }

  function formatMomentTime(value: string) {
    const parsed = new Date(value);
    if (Number.isNaN(parsed.getTime())) return value.split('T')[1]?.slice(0, 5) || '';
    return parsed.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit', hour12: false });
  }

  function localDateTimeValue(date = new Date()) {
    const local = new Date(date.getTime() - date.getTimezoneOffset() * 60_000);
    return local.toISOString().slice(0, 16);
  }

  function insertTextAtCursor(input: HTMLInputElement | HTMLTextAreaElement, text: string) {
    const start = input.selectionStart ?? input.value.length;
    const end = input.selectionEnd ?? input.value.length;
    input.value = input.value.slice(0, start) + text + input.value.slice(end);
    const nextPos = start + text.length;
    input.focus();
    input.setSelectionRange(nextPos, nextPos);
  }

  function getScopedStyleAttribute() {
    if (scopedStyleAttribute !== undefined) return scopedStyleAttribute;
    const anchor = document.querySelector<HTMLElement>('.moments-shell');
    scopedStyleAttribute = anchor?.getAttributeNames().find((name) => name.startsWith('data-astro-cid-')) ?? null;
    return scopedStyleAttribute;
  }

  function applyScopedStyles(root: Element) {
    const attr = getScopedStyleAttribute();
    if (!attr) return root;
    root.setAttribute(attr, '');
    root.querySelectorAll('*').forEach((node) => node.setAttribute(attr, ''));
    return root;
  }

  function readMomentReactionState(): Record<string, string> {
    try {
      const raw = localStorage.getItem(MOMENT_REACTION_STORAGE_KEY);
      const data = raw ? JSON.parse(raw) : {};
      return data && typeof data === 'object' && !Array.isArray(data) ? data : {};
    } catch {
      return {};
    }
  }

  function getStoredMomentReaction(momentId: string) {
    return readMomentReactionState()[momentId] || '';
  }

  function setStoredMomentReaction(momentId: string, emoji: string) {
    const state = readMomentReactionState();
    if (emoji) state[momentId] = emoji;
    else delete state[momentId];
    try { localStorage.setItem(MOMENT_REACTION_STORAGE_KEY, JSON.stringify(state)); } catch {}
  }

  function updateReactionCounts(counts: Record<string, number>, previousEmoji: string, nextEmoji: string) {
    const nextCounts = { ...counts };
    if (previousEmoji) {
      nextCounts[previousEmoji] = Math.max(0, (nextCounts[previousEmoji] || 0) - 1);
      if (nextCounts[previousEmoji] <= 0) delete nextCounts[previousEmoji];
    }
    if (nextEmoji) nextCounts[nextEmoji] = (nextCounts[nextEmoji] || 0) + 1;
    return nextCounts;
  }

  function normalizeMoment(raw: any): RenderMoment | null {
    if (!raw || typeof raw !== 'object') return null;
    const category = String(raw.category ?? '').trim();
    const text = String(raw.text ?? '').trim();
    if (!text) return null;

    const createdAt = typeof raw.createdAt === 'number' ? raw.createdAt : undefined;
    const date = String(raw.date ?? '').trim() || (createdAt ? localDateTimeValue(new Date(createdAt)) : localDateTimeValue());
    const legacyImages = Array.isArray(raw.images)
      ? raw.images.map((src: unknown) => String(src ?? '').trim()).filter(Boolean)
      : [];
    const rawMedia = Array.isArray(raw.media) ? raw.media : [];
    const media: MomentMedia[] = rawMedia
      .map((item: any) => ({
        kind: item?.kind === 'video' || item?.kind === 'poster' ? item.kind : 'image',
        url: String(item?.url ?? '').trim(),
      }))
      .filter((item: MomentMedia) => Boolean(item.url));

    for (const imageUrl of legacyImages) {
      if (!media.some((item) => item.kind === 'image' && item.url === imageUrl)) {
        media.push({ kind: 'image', url: imageUrl });
      }
    }

    const images = media.filter((item) => item.kind === 'image').map((item) => item.url);
    const link = String(raw.link ?? '').trim();
    return {
      id: raw.id ? String(raw.id) : undefined,
      date,
      category: knownCategories.has(category) ? category : '生活',
      text,
      ...(link && { link }),
      images,
      media,
      ...(createdAt && { createdAt }),
      reactions: raw.reactions && typeof raw.reactions === 'object' ? raw.reactions : {},
    };
  }

  function renderListMessage(text: string, className = '') {
    const list = document.getElementById('moments-list');
    if (!list) return;
    const message = document.createElement('p');
    message.className = `empty-state ${className}`.trim();
    message.textContent = text;
    applyScopedStyles(message);
    list.replaceChildren(message);
  }

  function setMomentsRetryVisible(visible: boolean) {
    const retry = document.getElementById('moments-retry') as HTMLButtonElement | null;
    if (retry) retry.hidden = !visible;
  }

  function notifyMomentAction(text: string) {
    let toast = document.getElementById('moments-toast');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'moments-toast';
      toast.className = 'moments-toast';
      toast.setAttribute('role', 'status');
      document.body.appendChild(toast);
    }
    toast.textContent = text;
    toast.className = `moments-toast show ${text.includes('失败') ? 'error' : 'success'}`;
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast?.classList.remove('show'), 2200);
  }

  function markMomentsSessionRequired(message = '登录已失效，请重新登录。') {
    const sessionStatus = document.getElementById('moments-session-status');
    const loginBox = document.getElementById('moments-login');
    const logoutBtn = document.getElementById('moments-logout') as HTMLButtonElement | null;
    if (sessionStatus) {
      sessionStatus.textContent = message;
      sessionStatus.classList.remove('authenticated');
      sessionStatus.classList.add('error');
    }
    if (loginBox) loginBox.hidden = false;
    if (logoutBtn) logoutBtn.hidden = true;
  }

  async function fetchMomentsFromApi(signal?: AbortSignal) {
    return (await fetchMoments({ limit: 200, signal })).items;
  }

  async function reactToMoment(momentId: string, emoji: string, previousEmoji: string) {
    const res = await fetch(MOMENT_REACTIONS_API_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json; charset=utf-8' },
      body: JSON.stringify({ momentId, emoji, previousEmoji }),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(typeof data.error === 'string' ? data.error : `API 错误 (${res.status})`);
    return {
      reactions: data.reactions && typeof data.reactions === 'object' ? data.reactions as Record<string, number> : {},
      selectedEmoji: typeof data.selectedEmoji === 'string' ? data.selectedEmoji : (previousEmoji === emoji ? '' : emoji),
    };
  }

  function closeMomentReactionPanel(panel: HTMLElement) {
    panel.hidden = true;
    panel.parentElement?.querySelector<HTMLButtonElement>('.moment-reaction-add')?.setAttribute('aria-expanded', 'false');
  }

  function closeMomentReactionPanels(except?: HTMLElement) {
    document.querySelectorAll<HTMLElement>('.moment-reaction-panel').forEach((panel) => {
      if (except && panel === except) return;
      closeMomentReactionPanel(panel);
    });
  }

  function renderMomentReactions(moment: RenderMoment, burstEmoji = '') {
    const reactions = document.createElement('div');
    reactions.className = 'moment-reactions';
    if (!moment.id) return reactions;

    const selectedEmoji = getStoredMomentReaction(moment.id);
    const counts = moment.reactions || {};
    const chips = document.createElement('div');
    chips.className = 'moment-reaction-chips';

    const addButton = document.createElement('button');
    addButton.type = 'button';
    addButton.className = 'moment-reaction-add';
    addButton.title = selectedEmoji ? '更换或取消表情' : '贴表情';
    addButton.setAttribute('aria-label', selectedEmoji ? '更换或取消表情' : '贴表情');
    addButton.setAttribute('aria-expanded', 'false');
    addButton.innerHTML = '<span class="moment-reaction-add-icon" aria-hidden="true">☺</span><span class="moment-reaction-add-plus" aria-hidden="true">+</span>';

    const picker = document.createElement('div');
    picker.className = 'moment-reaction-panel';
    picker.hidden = true;

    async function chooseReaction(emoji: string) {
      if (!moment.id) return;
      const previousEmoji = getStoredMomentReaction(moment.id);
      const nextEmoji = previousEmoji === emoji ? '' : emoji;
      const previousCounts = { ...(moment.reactions || {}) };

      moment.reactions = updateReactionCounts(previousCounts, previousEmoji, nextEmoji);
      setStoredMomentReaction(moment.id, nextEmoji);
      const nextUi = renderMomentReactions(moment, nextEmoji);
      reactions.replaceWith(nextUi);
      applyScopedStyles(nextUi);

      try {
        const result = await reactToMoment(moment.id, emoji, previousEmoji);
        moment.reactions = result.reactions;
        setStoredMomentReaction(moment.id, result.selectedEmoji);
        const confirmedUi = renderMomentReactions(moment);
        nextUi.replaceWith(confirmedUi);
        applyScopedStyles(confirmedUi);
      } catch (err) {
        moment.reactions = previousCounts;
        setStoredMomentReaction(moment.id, previousEmoji);
        const rollbackUi = renderMomentReactions(moment);
        nextUi.replaceWith(rollbackUi);
        applyScopedStyles(rollbackUi);
        notifyMomentAction('贴表情失败：' + (err instanceof Error ? err.message : String(err)).slice(0, 120));
      }
    }

    MOMENT_REACTION_EMOJIS.forEach((emoji) => {
      const option = document.createElement('button');
      option.type = 'button';
      option.className = 'moment-reaction-choice';
      option.classList.toggle('active', selectedEmoji === emoji);
      option.textContent = emoji;
      option.title = selectedEmoji === emoji ? `取消 ${emoji}` : `贴 ${emoji}`;
      option.setAttribute('aria-label', selectedEmoji === emoji ? `取消 ${emoji}` : `贴 ${emoji}`);
      option.addEventListener('click', () => chooseReaction(emoji));
      picker.appendChild(option);
    });

    MOMENT_REACTION_EMOJIS.forEach((emoji) => {
      const count = counts[emoji] || 0;
      if (count <= 0 && selectedEmoji !== emoji) return;
      const reaction = document.createElement('button');
      reaction.type = 'button';
      reaction.className = 'moment-reaction-chip';
      reaction.classList.toggle('active', selectedEmoji === emoji);
      reaction.classList.toggle('just-reacted', burstEmoji === emoji);
      reaction.textContent = count > 0 ? `${emoji} ${count}` : emoji;
      reaction.title = selectedEmoji === emoji ? `取消 ${emoji}` : `贴 ${emoji}`;
      reaction.setAttribute('aria-label', selectedEmoji === emoji ? `取消 ${emoji}` : `贴 ${emoji}`);
      reaction.addEventListener('click', () => chooseReaction(emoji));
      chips.appendChild(reaction);
    });

    addButton.addEventListener('click', (event) => {
      event.stopPropagation();
      const shouldOpen = picker.hidden;
      closeMomentReactionPanels(picker);
      picker.hidden = !shouldOpen;
      addButton.setAttribute('aria-expanded', String(shouldOpen));
    });

    chips.appendChild(addButton);
    reactions.append(chips, picker);
    if (burstEmoji) {
      const burst = document.createElement('span');
      burst.className = 'moment-reaction-burst';
      burst.textContent = burstEmoji;
      reactions.appendChild(burst);
    }
    return reactions;
  }

  function buildMomentDayGroup(dayMoments: RenderMoment[], startIndex: number, activeCategory: string) {
    const first = dayMoments[0];
    const parts = getMomentDayParts(first.date);
    const day = document.createElement('section');
    day.className = 'moment-day';
    day.dataset.date = parts.key;
    day.classList.toggle('is-today', parts.key === getMomentDateKey(new Date()));

    const mark = document.createElement('header');
    mark.className = 'moment-day-mark';
    const date = document.createElement('time');
    date.className = 'moment-day-date';
    date.dateTime = parts.machineDate;
    date.textContent = parts.dateLabel;
    const weekday = document.createElement('span');
    weekday.className = 'moment-day-weekday';
    weekday.textContent = parts.weekdayLabel;
    mark.append(date, weekday);

    const stream = document.createElement('div');
    stream.className = 'moment-day-stream';
    dayMoments.forEach((moment, index) => stream.appendChild(buildMomentCard(moment, startIndex + index, activeCategory)));
    day.append(mark, stream);
    applyScopedStyles(day);
    return day;
  }

  function applyMomentFilter(category: string) {
    document.querySelectorAll<HTMLElement>('.moment-day').forEach((day) => {
      let visible = 0;
      day.querySelectorAll<HTMLElement>('.moment-card').forEach((card) => {
        const hidden = category !== 'all' && card.dataset.category !== category;
        card.classList.toggle('hidden', hidden);
        if (!hidden) visible += 1;
      });
      day.hidden = visible === 0;
    });
  }

  function syncMoments(apiMoments: any[]) {
    const list = document.getElementById('moments-list');
    if (!list) return;
    setMomentsRetryVisible(false);

    const moments = apiMoments.map(normalizeMoment).filter((moment): moment is RenderMoment => Boolean(moment));
    currentMoments = moments;
    if (moments.length === 0) {
      renderListMessage('暂时还没有记录。');
      return;
    }

    const activeTab = document.querySelector('.pill[data-category].active') as HTMLElement | null;
    const activeCategory = activeTab?.dataset?.category || 'all';
    const fragment = document.createDocumentFragment();

    let start = 0;
    while (start < moments.length) {
      const key = getMomentDateKey(moments[start].date);
      let end = start + 1;
      while (end < moments.length && getMomentDateKey(moments[end].date) === key) end += 1;
      fragment.appendChild(buildMomentDayGroup(moments.slice(start, end), start, activeCategory));
      start = end;
    }

    list.replaceChildren(fragment);
    applyMomentFilter(activeCategory);
    setupLightboxForNewCards();
  }

  function buildMomentCard(moment: RenderMoment, idx: number, activeCategory: string) {
    const videos = (moment.media || []).filter((item) => item.kind === 'video');
    const layout = classifyMomentLayout({ text: moment.text, imageCount: moment.images.length, videoCount: videos.length });
    const card = document.createElement('article');
    card.className = `moment-card moment--${layout}`;
    card.dataset.category = moment.category;
    card.dataset.layout = layout;
    card.style.setProperty('--delay', `${idx * 24}ms`);
    if (moment.id) card.dataset.id = moment.id;
    if (activeCategory !== 'all' && moment.category !== activeCategory) card.classList.add('hidden');

    const content = document.createElement('div');
    content.className = 'card-content';
    const meta = document.createElement('div');
    meta.className = 'card-meta';
    const leftMeta = document.createElement('div');
    leftMeta.className = 'card-meta-left';
    const category = document.createElement('span');
    category.className = 'cat-pill moment-category';
    category.textContent = moment.category;
    leftMeta.appendChild(category);

    const actions = document.createElement('div');
    actions.className = 'card-actions';
    const dateEl = document.createElement('time');
    dateEl.className = 'card-date';
    dateEl.dateTime = moment.date;
    dateEl.textContent = formatMomentTime(moment.date);
    actions.appendChild(dateEl);

    if (adminMode && moment.id) {
      const deleteBtn = document.createElement('button');
      deleteBtn.type = 'button';
      deleteBtn.className = 'delete-moment-btn';
      deleteBtn.dataset.momentId = moment.id;
      deleteBtn.title = '删除这条动态';
      deleteBtn.setAttribute('aria-label', '删除这条动态');
      deleteBtn.textContent = '删除';
      actions.appendChild(deleteBtn);
    }

    meta.append(leftMeta, actions);
    content.appendChild(meta);

    const text = document.createElement('p');
    text.className = 'card-text';
    text.textContent = moment.text;
    content.appendChild(text);

    if (moment.images.length > 0) {
      const imgDiv = document.createElement('div');
      imgDiv.className = 'card-images moment-media moment-media--images';
      imgDiv.dataset.count = String(moment.images.length);
      moment.images.forEach((imgSrc, imageIndex) => {
        const img = document.createElement('img');
        const resolvedCandidates = resolveImageCandidates(imgSrc);
        img.src = resolvedCandidates[0];
        img.dataset.lightboxSrc = resolvedCandidates[0];
        if (resolvedCandidates.length > 1) {
          img.dataset.lightboxCandidates = JSON.stringify(resolvedCandidates);
          attachImageFallback(img, resolvedCandidates);
        }
        img.alt = '';
        img.loading = 'lazy';
        img.decoding = 'async';
        img.setAttribute('role', 'button');
        img.tabIndex = 0;
        if ((layout === 'photo-three' && imageIndex > 0) || (layout === 'gallery' && imageIndex > 0)) {
          img.dataset.secondary = 'true';
        }
        imgDiv.appendChild(img);
      });
      content.appendChild(imgDiv);
    }

    if (videos.length > 0) {
      const videoDiv = document.createElement('div');
      videoDiv.className = 'card-images moment-media moment-media--video';
      videoDiv.dataset.count = String(videos.length);
      videos.forEach((videoItem) => {
        const poster = (moment.media || []).find((item) => item.kind === 'poster' && item.url)?.url || '';
        if (!poster) {
          const placeholder = document.createElement('div');
          placeholder.className = 'poster-needed-placeholder';
          placeholder.textContent = '这段视频暂时没有可用封面。';
          videoDiv.appendChild(placeholder);
          return;
        }
        const video = document.createElement('video');
        video.src = videoItem.url;
        video.poster = poster;
        video.muted = true;
        video.playsInline = true;
        video.preload = 'metadata';
        video.controls = true;
        video.setAttribute('playsinline', '');
        video.setAttribute('webkit-playsinline', '');
        video.crossOrigin = 'anonymous';
        videoDiv.appendChild(video);
      });
      content.appendChild(videoDiv);
    }

    if (moment.link) {
      const link = document.createElement('a');
      link.className = 'card-link';
      link.href = moment.link;
      link.target = '_blank';
      link.rel = 'noreferrer';
      link.textContent = moment.link.replace(/^https?:\/\//, '').split('/')[0];
      content.appendChild(link);
    }

    if (moment.id) {
      content.appendChild(renderMomentReactions(moment));
      content.appendChild(createCommentsWidget('moment', moment.id, undefined, 2));
    }

    card.appendChild(content);
    applyScopedStyles(card);
    return card;
  }

  async function deleteMoment(momentId: string, trigger: HTMLButtonElement) {
    const target = currentMoments.find((moment) => moment.id === momentId);
    const label = target?.text ? `「${target.text.slice(0, 24)}${target.text.length > 24 ? '...' : ''}」` : '这条动态';
    if (!window.confirm(`确定删除 ${label} 吗？删除后不可恢复。`)) return;

    trigger.disabled = true;
    const originalText = trigger.textContent || '删除';
    trigger.textContent = '删除中...';
    try {
      await deleteMomentViaApi(momentId);
      currentMoments = currentMoments.filter((moment) => moment.id !== momentId);
      syncMoments(currentMoments);
      notifyMomentAction('已删除。');
      setTimeout(async () => {
        try { syncMoments(await fetchMomentsFromApi()); } catch {}
      }, 800);
    } catch (err) {
      const detail = err instanceof Error ? err.message : String(err);
      notifyMomentAction('删除失败：' + detail.slice(0, 200));
      if (err instanceof MomentApiError && err.code === 'AUTH_REQUIRED') markMomentsSessionRequired();
      trigger.disabled = false;
      trigger.textContent = originalText;
    }
  }

  let lightbox: HTMLElement | null = null;
  let lightboxImage: HTMLImageElement | null = null;
  let lightboxCounter: HTMLElement | null = null;
  let lightboxStage: HTMLElement | null = null;
  let lightboxClose: HTMLButtonElement | null = null;
  let lightboxPrev: HTMLButtonElement | null = null;
  let lightboxNext: HTMLButtonElement | null = null;
  let lightboxImages: HTMLImageElement[] = [];
  let lightboxIndex = 0;
  let returnFocusTarget: HTMLElement | null = null;

  function setupLightboxForNewCards() {
    document.querySelectorAll<HTMLImageElement>('.card-images img').forEach((img) => {
      if (img.dataset.lightboxBound) return;
      img.dataset.lightboxBound = '1';
      img.addEventListener('click', () => openLightbox(img));
      img.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        openLightbox(img);
      });
    });
  }

  function setLightboxImage(index: number) {
    if (!lightboxImage || !lightboxCounter || !lightboxPrev || !lightboxNext || lightboxImages.length === 0) return;
    lightboxIndex = (index + lightboxImages.length) % lightboxImages.length;
    const image = lightboxImages[lightboxIndex];
    lightboxImage.src = image.dataset.lightboxSrc || image.currentSrc || image.src;
    lightboxImage.alt = image.alt || '';
    const hasMultiple = lightboxImages.length > 1;
    lightboxCounter.textContent = hasMultiple ? `${lightboxIndex + 1} / ${lightboxImages.length}` : '';
    lightboxPrev.hidden = !hasMultiple;
    lightboxNext.hidden = !hasMultiple;
  }

  function openLightbox(target: HTMLImageElement) {
    if (!lightbox || !lightboxImage) return;
    const gallery = target.closest<HTMLElement>('.card-images');
    lightboxImages = gallery ? Array.from(gallery.querySelectorAll<HTMLImageElement>('img')) : [target];
    returnFocusTarget = target;
    setLightboxImage(Math.max(0, lightboxImages.indexOf(target)));
    lightbox.hidden = false;
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.classList.add('lightbox-open');
    lightboxClose?.focus({ preventScroll: true });
  }

  function closeLightbox() {
    if (!lightbox || lightbox.hidden) return;
    lightbox.hidden = true;
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('lightbox-open');
    lightboxImage?.removeAttribute('src');
    returnFocusTarget?.focus({ preventScroll: true });
    returnFocusTarget = null;
  }

  function moveLightbox(delta: number) {
    if (lightbox?.hidden !== false || lightboxImages.length < 2) return;
    setLightboxImage(lightboxIndex + delta);
  }

  let cleanupMomentsPage: AbortController | undefined;

  function initMomentsPage() {
    const shell = document.querySelector<HTMLElement>('.moments-shell');
    if (!shell || shell.dataset.momentsInitialized === '1') return;

    cleanupMomentsPage?.abort();
    const controller = new AbortController();
    cleanupMomentsPage = controller;
    const { signal } = controller;

    shell.dataset.momentsInitialized = '1';
    scopedStyleAttribute = undefined;
    currentMoments = [];
    lightboxImages = [];
    lightboxIndex = 0;
    returnFocusTarget = null;

    type SelectedMediaItem = {
      id: string;
      file: File;
      kind: 'image' | 'video';
      previewUrl: string;
      remoteUrl?: string;
      posterBlob?: Blob;
      posterPreviewUrl?: string;
      posterRemoteUrl?: string;
      posterTime: number;
      duration?: number;
      error?: string;
      posterRequired?: boolean;
      posterGenerationId?: number;
    };
    const selectedImages: SelectedMediaItem[] = [];
    let nextPosterGenerationId = 0;
    let manualPosterTargetId = '';

    function invalidateVideoPosterGeneration(item: SelectedMediaItem) {
      item.posterGenerationId = ++nextPosterGenerationId;
    }

    function cleanupPageState() {
      selectedImages.forEach((item) => {
        invalidateVideoPosterGeneration(item);
        URL.revokeObjectURL(item.previewUrl);
        if (item.posterPreviewUrl) URL.revokeObjectURL(item.posterPreviewUrl);
      });
      selectedImages.length = 0;
      closeLightbox();
      if (cleanupMomentsPage === controller) cleanupMomentsPage = undefined;
      controller.abort();
    }
    document.addEventListener('astro:before-swap', cleanupPageState, { once: true, signal });

    const loadMoments = async () => {
      try {
        const items = await fetchMomentsFromApi(signal);
        if (signal.aborted) return;
        if (items.length === 0) renderListMessage('暂时还没有记录。');
        else syncMoments(items);
      } catch (err) {
        if (signal.aborted) return;
        console.warn('Failed to fetch moments from API:', err);
        renderListMessage('加载失败，可以稍后再试。', 'error-state');
        setMomentsRetryVisible(true);
      }
    };
    void loadMoments();

    const tabs = document.querySelectorAll<HTMLButtonElement>('.pill[data-category]');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((item) => item.classList.remove('active'));
        tab.classList.add('active');
        applyMomentFilter(tab.dataset.category ?? 'all');
      }, { signal });
    });

    document.getElementById('moments-retry')?.addEventListener('click', () => {
      setMomentsRetryVisible(false);
      void loadMoments();
    }, { signal });

    const listRoot = document.getElementById('moments-list');
    listRoot?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.delete-moment-btn');
      if (!button?.dataset.momentId) return;
      event.preventDefault();
      void deleteMoment(button.dataset.momentId, button);
    }, { signal });

    listRoot?.addEventListener('moments:pin-order-changed', (event) => {
      const orderedIds = (event as CustomEvent<{ orderedIds?: string[] }>).detail?.orderedIds || [];
      if (orderedIds.length === 0) return;
      const byId = new Map(currentMoments.filter((moment) => moment.id).map((moment) => [moment.id as string, moment]));
      const ordered = orderedIds.map((id) => byId.get(id)).filter((moment): moment is RenderMoment => Boolean(moment));
      const seen = new Set(ordered.map((moment) => moment.id));
      const rest = currentMoments.filter((moment) => !moment.id || !seen.has(moment.id));
      syncMoments([...ordered, ...rest]);
    }, { signal });

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest?.('.moment-reactions')) return;
      closeMomentReactionPanels();
    }, { signal });

    const toggleBtn = document.getElementById('publish-toggle');
    const publishBox = document.getElementById('publish-box');
    const closeBtnEl = document.getElementById('close-btn');
    const toggleIcon = document.getElementById('toggle-icon');

    function setComposerOpen(open: boolean) {
      publishBox?.classList.toggle('hidden', !open);
      toggleBtn?.setAttribute('aria-expanded', String(open));
      if (toggleIcon) toggleIcon.textContent = open ? '×' : '✎';
    }

    toggleBtn?.addEventListener('click', () => {
      const open = publishBox?.classList.contains('hidden') ?? true;
      setComposerOpen(open);
      if (open) publishBox?.scrollIntoView({ behavior: reducedMotionPreferred() ? 'auto' : 'smooth', block: 'nearest' });
    }, { signal });
    closeBtnEl?.addEventListener('click', () => setComposerOpen(false), { signal });

    const imageInput = document.getElementById('image-input') as HTMLInputElement | null;
    const uploadPlaceholder = document.getElementById('upload-placeholder');
    const imagePreviews = document.getElementById('image-previews');
    const uploadArea = document.getElementById('image-upload-area');
    const form = document.getElementById('publish-form') as HTMLFormElement | null;
    const msg = document.getElementById('form-message');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const emojiToggle = document.getElementById('moment-emoji-toggle') as HTMLButtonElement | null;
    const emojiPanel = document.getElementById('moment-emoji-panel');

    if (emojiPanel && emojiPanel.childElementCount === 0) {
      MOMENT_EMOJIS.forEach((emoji) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = emoji;
        button.addEventListener('click', () => {
          const textInput = form?.querySelector<HTMLTextAreaElement>('textarea[name="text"]');
          if (textInput) insertTextAtCursor(textInput, emoji);
          emojiPanel.classList.add('hidden');
          emojiToggle?.setAttribute('aria-expanded', 'false');
        }, { signal });
        emojiPanel.appendChild(button);
      });
    }
    emojiToggle?.addEventListener('click', () => {
      emojiPanel?.classList.toggle('hidden');
      emojiToggle.setAttribute('aria-expanded', String(!emojiPanel?.classList.contains('hidden')));
    }, { signal });
    document.addEventListener('click', (event) => {
      if (emojiPanel?.classList.contains('hidden')) return;
      const target = event.target as Node;
      if (emojiPanel?.contains(target) || emojiToggle?.contains(target)) return;
      emojiPanel?.classList.add('hidden');
      emojiToggle?.setAttribute('aria-expanded', 'false');
    }, { signal });

    function setMessage(text: string, type: 'success' | 'error' | '') {
      if (!msg) return;
      msg.textContent = text;
      msg.className = type;
    }

    function setPreviewStatus(id: string, text: string, state: 'idle' | 'uploading' | 'uploaded' | 'failed') {
      const item = document.getElementById(`preview-${id}`);
      const progress = item?.querySelector<HTMLElement>('.upload-progress');
      if (!item || !progress) return;
      item.classList.toggle('uploaded', state === 'uploaded');
      item.classList.toggle('failed', state === 'failed');
      progress.classList.toggle('hidden', state === 'idle');
      progress.textContent = text;
    }

    function clearSelectedMedia() {
      selectedImages.forEach((item) => {
        invalidateVideoPosterGeneration(item);
        URL.revokeObjectURL(item.previewUrl);
        if (item.posterPreviewUrl) URL.revokeObjectURL(item.posterPreviewUrl);
      });
      selectedImages.length = 0;
      if (imagePreviews) imagePreviews.innerHTML = '';
    }

    function revokePosterPreview(item: SelectedMediaItem) {
      if (item.posterPreviewUrl) URL.revokeObjectURL(item.posterPreviewUrl);
      item.posterPreviewUrl = undefined;
    }

    function startVideoPosterGeneration(item: SelectedMediaItem) {
      item.posterGenerationId = ++nextPosterGenerationId;
      return item.posterGenerationId;
    }

    function isCurrentVideoPosterGeneration(item: SelectedMediaItem, generationId: number) {
      return selectedImages.includes(item) && item.posterGenerationId === generationId && !signal.aborted;
    }

    async function setVideoPoster(item: SelectedMediaItem, requestedTime = item.posterTime) {
      if (item.kind !== 'video') return;
      const generationId = startVideoPosterGeneration(item);
      try {
        item.error = undefined;
        item.posterTime = choosePosterTime(item.duration || Number.POSITIVE_INFINITY, requestedTime);
        const blob = await captureVideoPoster(item.file, item.posterTime);
        const posterPreviewUrl = URL.createObjectURL(blob);
        if (!isCurrentVideoPosterGeneration(item, generationId)) {
          URL.revokeObjectURL(posterPreviewUrl);
          return;
        }
        item.posterBlob = blob;
        item.posterRequired = false;
        item.posterRemoteUrl = undefined;
        revokePosterPreview(item);
        item.posterPreviewUrl = posterPreviewUrl;
      } catch (err) {
        if (!isCurrentVideoPosterGeneration(item, generationId)) return;
        item.posterBlob = undefined;
        item.posterRequired = true;
        const code = err instanceof VideoPosterError ? err.code : '';
        item.error = code === 'VIDEO_CORS_REQUIRED'
          ? '此视频源不允许浏览器取帧，请上传 JPEG 封面。'
          : err instanceof Error ? err.message : '封面生成失败，请重试或上传 JPEG 封面。';
      }
      renderMediaPreviews();
    }

    function renderMediaPreviews() {
      if (!imagePreviews) return;
      imagePreviews.innerHTML = '';
      selectedImages.forEach((item) => {
        const div = document.createElement('div');
        div.className = `preview-item ${item.kind === 'video' ? 'video-preview' : ''}`.trim();
        div.id = `preview-${item.id}`;
        const progress = document.createElement('div');
        progress.className = 'upload-progress hidden';
        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'remove-img';
        removeBtn.textContent = '×';
        removeBtn.addEventListener('click', () => {
          const index = selectedImages.findIndex((media) => media.id === item.id);
          if (index > -1) {
            invalidateVideoPosterGeneration(selectedImages[index]);
            URL.revokeObjectURL(selectedImages[index].previewUrl);
            if (selectedImages[index].posterPreviewUrl) URL.revokeObjectURL(selectedImages[index].posterPreviewUrl);
            selectedImages.splice(index, 1);
            renderMediaPreviews();
          }
        }, { signal });

        if (item.kind === 'video') {
          const video = document.createElement('video');
          video.src = item.previewUrl;
          video.poster = item.posterPreviewUrl || '';
          video.muted = true;
          video.playsInline = true;
          video.preload = 'metadata';
          video.controls = true;
          video.setAttribute('playsinline', '');
          video.setAttribute('webkit-playsinline', '');
          video.addEventListener('loadedmetadata', () => {
            if (!Number.isFinite(video.duration)) return;
            item.duration = video.duration;
            const range = div.querySelector<HTMLInputElement>('.video-poster-range');
            if (range) {
              range.max = String(Math.max(0.1, video.duration - 0.1));
              range.value = String(choosePosterTime(video.duration, item.posterTime));
            }
          }, { once: true, signal });
          div.appendChild(video);

          const controls = document.createElement('div');
          controls.className = 'poster-controls';
          const range = document.createElement('input');
          range.type = 'range';
          range.className = 'video-poster-range';
          range.min = '0.1';
          range.max = String(Math.max(0.1, (item.duration || 1) - 0.1));
          range.step = '0.1';
          range.value = String(item.posterTime);
          const time = document.createElement('span');
          time.textContent = `封面时间 ${item.posterTime.toFixed(1)}s`;
          range.addEventListener('input', () => {
            item.posterTime = Number.parseFloat(range.value);
            time.textContent = `封面时间 ${item.posterTime.toFixed(1)}s`;
          }, { signal });
          range.addEventListener('change', () => { void setVideoPoster(item, Number.parseFloat(range.value)); }, { signal });

          const actions = document.createElement('div');
          actions.className = 'poster-actions';
          const retry = document.createElement('button');
          retry.type = 'button';
          retry.textContent = '重试取帧';
          retry.addEventListener('click', () => { void setVideoPoster(item, item.posterTime); }, { signal });
          const manual = document.createElement('button');
          manual.type = 'button';
          manual.textContent = '上传 JPEG 封面';
          manual.addEventListener('click', () => {
            manualPosterTargetId = item.id;
            (document.getElementById('manual-poster-input') as HTMLInputElement | null)?.click();
          }, { signal });
          actions.append(retry, manual);
          controls.append(range, time, actions);
          if (item.error) {
            const failure = document.createElement('span');
            failure.className = 'video-poster-needed';
            failure.textContent = item.error;
            controls.appendChild(failure);
          }
          div.appendChild(controls);
        } else {
          const img = document.createElement('img');
          img.src = item.previewUrl;
          img.alt = item.file.name;
          div.appendChild(img);
        }

        div.append(progress, removeBtn);
        applyScopedStyles(div);
        imagePreviews.appendChild(div);
        if (item.remoteUrl) setPreviewStatus(item.id, '已上传', 'uploaded');
      });
    }

    async function uploadSelectedMedia() {
      const media: MomentMedia[] = [];
      for (const item of selectedImages) {
        if (item.kind === 'video' && !item.posterBlob && !item.posterRemoteUrl) {
          item.posterRequired = true;
          item.error = item.error || '发布视频前需要先生成或上传 JPEG 封面。';
          renderMediaPreviews();
          throw new Error('发布视频前需要先生成或上传 JPEG 封面。');
        }
        if (item.kind === 'image' && item.file.size > maxImageBytes) {
          setPreviewStatus(item.id, '过大', 'failed');
          throw new Error('图片过大，请控制在 8 MB 以内');
        }
        if (item.kind === 'video' && item.file.size > maxVideoBytes) {
          setPreviewStatus(item.id, '过大', 'failed');
          throw new Error('视频过大，请控制在 100 MB 以内');
        }
        setPreviewStatus(item.id, '上传中...', 'uploading');
        try {
          if (!item.remoteUrl) item.remoteUrl = await uploadToR2(item.file, { kind: item.kind, signal });
          media.push({ kind: item.kind, url: item.remoteUrl });
          if (item.kind === 'video') {
            if (!item.posterRemoteUrl && item.posterBlob) {
              const posterFile = new File([item.posterBlob], `${item.file.name.replace(/\.[^.]+$/, '')}-poster.jpg`, { type: 'image/jpeg' });
              item.posterRemoteUrl = await uploadToR2(posterFile, { kind: 'poster', signal });
            }
            if (item.posterRemoteUrl) media.push({ kind: 'poster', url: item.posterRemoteUrl });
          }
          setPreviewStatus(item.id, '已上传', 'uploaded');
        } catch (err) {
          setPreviewStatus(item.id, '失败', 'failed');
          throw err;
        }
      }
      return media;
    }

    function handleMediaFiles(files: File[]) {
      for (const file of files) {
        const isImage = file.type.startsWith('image/');
        const isVideo = file.type === 'video/mp4' || file.type === 'video/webm';
        if (!isImage && !isVideo) continue;
        if (selectedImages.length >= maxMediaItems) {
          setMessage(`最多选择 ${maxMediaItems} 个媒体`, 'error');
          break;
        }
        const item: SelectedMediaItem = isVideo
          ? {
              id: `${Date.now()}-${Math.random().toString(36).slice(2)}`,
              file,
              kind: 'video',
              previewUrl: URL.createObjectURL(file),
              posterTime: 0.1,
              posterRequired: true,
            }
          : {
              id: `${Date.now()}-${Math.random().toString(36).slice(2)}`,
              file,
              kind: 'image',
              previewUrl: URL.createObjectURL(file),
              posterTime: 0.1,
              posterRequired: false,
            };
        selectedImages.push(item);
        if (isVideo) void setVideoPoster(item, 0.1);
      }
      renderMediaPreviews();
    }

    uploadPlaceholder?.addEventListener('click', () => imageInput?.click(), { signal });
    uploadArea?.addEventListener('dragover', (event) => {
      event.preventDefault();
      uploadPlaceholder?.classList.add('drag-over');
    }, { signal });
    uploadArea?.addEventListener('dragleave', () => uploadPlaceholder?.classList.remove('drag-over'), { signal });
    uploadArea?.addEventListener('drop', (event) => {
      event.preventDefault();
      uploadPlaceholder?.classList.remove('drag-over');
      const files = (event as DragEvent).dataTransfer?.files;
      if (files) handleMediaFiles(Array.from(files));
    }, { signal });
    imageInput?.addEventListener('change', () => {
      if (imageInput.files) handleMediaFiles(Array.from(imageInput.files));
      imageInput.value = '';
    }, { signal });

    document.getElementById('manual-poster-input')?.addEventListener('change', (event) => {
      const input = event.currentTarget as HTMLInputElement;
      const file = input.files?.[0];
      const target = selectedImages.find((item) => item.id === manualPosterTargetId && item.kind === 'video');
      input.value = '';
      if (!file || !target) return;
      if (file.type !== 'image/jpeg') {
        setMessage('请上传 JPEG 格式封面', 'error');
        return;
      }
      invalidateVideoPosterGeneration(target);
      target.posterBlob = file;
      target.posterRemoteUrl = undefined;
      target.posterRequired = false;
      target.error = undefined;
      revokePosterPreview(target);
      target.posterPreviewUrl = URL.createObjectURL(file);
      renderMediaPreviews();
    }, { signal });

    document.addEventListener('paste', (event) => {
      if (publishBox?.classList.contains('hidden')) return;
      const items = event.clipboardData?.items;
      if (!items) return;
      const files: File[] = [];
      for (let i = 0; i < items.length; i++) {
        if (items[i].type.startsWith('image/')) {
          const file = items[i].getAsFile();
          if (file) files.push(file);
        }
      }
      if (files.length > 0) {
        event.preventDefault();
        handleMediaFiles(files);
        setMessage(`已粘贴 ${files.length} 张图片`, 'success');
      }
    }, { signal });

    function updateSessionUi(authenticated: boolean, message?: string) {
      adminMode = authenticated;
      if (currentMoments.length > 0) syncMoments(currentMoments);
      const sessionStatus = document.getElementById('moments-session-status');
      const loginBox = document.getElementById('moments-login');
      const logoutBtn = document.getElementById('moments-logout') as HTMLButtonElement | null;
      if (sessionStatus) {
        sessionStatus.textContent = message || (authenticated ? '已登录，可以发布和管理动态。' : '请登录后发布或管理动态。');
        sessionStatus.classList.toggle('authenticated', authenticated);
        sessionStatus.classList.toggle('error', !authenticated && Boolean(message));
      }
      if (loginBox) loginBox.hidden = authenticated;
      if (logoutBtn) logoutBtn.hidden = !authenticated;
      if (submitBtn) submitBtn.disabled = !authenticated;
    }

    async function refreshSessionState() {
      try {
        const sessionState = await getSession({ signal });
        updateSessionUi(sessionState.authenticated);
        return sessionState.authenticated;
      } catch (err) {
        updateSessionUi(false, err instanceof Error ? err.message : '登录状态检查失败，请重试。');
        return false;
      }
    }

    const loginBox = document.getElementById('moments-login');
    const loginPassword = document.getElementById('moments-login-password') as HTMLInputElement | null;
    const loginSubmit = document.getElementById('moments-login-submit') as HTMLButtonElement | null;
    const logoutBtn = document.getElementById('moments-logout') as HTMLButtonElement | null;

    loginSubmit?.addEventListener('click', async () => {
      const password = loginPassword?.value.trim() || '';
      if (!password) {
        updateSessionUi(false, '请输入管理密码。');
        loginPassword?.focus();
        return;
      }
      loginSubmit.disabled = true;
      loginSubmit.textContent = '登录中...';
      try {
        const sessionState = await login(password, { signal });
        if (loginPassword) loginPassword.value = '';
        updateSessionUi(sessionState.authenticated);
      } catch (err) {
        updateSessionUi(false, err instanceof Error ? err.message : '登录失败，请重试。');
      } finally {
        loginSubmit.disabled = false;
        loginSubmit.textContent = '登录';
      }
    }, { signal });

    loginBox?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        loginSubmit?.click();
      }
    }, { signal });

    logoutBtn?.addEventListener('click', async () => {
      logoutBtn.disabled = true;
      try {
        await logout({ signal });
        updateSessionUi(false, '已退出登录。');
      } catch (err) {
        updateSessionUi(false, err instanceof Error ? err.message : '退出失败，请重试。');
      } finally {
        logoutBtn.disabled = false;
      }
    }, { signal });

    void refreshSessionState();

    if (form && msg && submitBtn) {
      const dateInput = form.querySelector<HTMLInputElement>('input[name="date"]');
      if (dateInput) dateInput.value = localDateTimeValue();
      updateSessionUi(false, '检查登录状态中...');

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const fd = new FormData(form);
        submitBtn.disabled = true;
        submitBtn.textContent = selectedImages.length > 0 ? '上传媒体...' : '发布中...';
        setMessage('', '');

        try {
          const link = String(fd.get('link') ?? '').trim();
          const date = String(fd.get('date') ?? '').trim();
          const category = String(fd.get('category') ?? '').trim();
          const text = String(fd.get('text') ?? '').trim();
          if (!date || !category || !text) throw new Error('请填写时间、分类和内容');

          const media = selectedImages.length > 0 ? await uploadSelectedMedia() : [];
          const imageUrls = media.filter((item) => item.kind === 'image').map((item) => item.url);
          submitBtn.textContent = '发布中...';
          const created = await createMomentViaApi({
            date,
            category,
            text,
            ...(link && { link }),
            ...(imageUrls.length > 0 && { images: imageUrls }),
            ...(media.length > 0 && { media }),
          }, { signal });

          setMessage('发布成功。', 'success');
          currentMoments = [normalizeMoment(created), ...currentMoments].filter((moment): moment is RenderMoment => Boolean(moment));
          syncMoments(currentMoments);
          setTimeout(async () => {
            if (signal.aborted) return;
            try {
              const fresh = await fetchMomentsFromApi(signal);
              if (!signal.aborted) syncMoments(fresh);
            } catch {}
          }, 2000);

          form.reset();
          clearSelectedMedia();
          if (dateInput) dateInput.value = localDateTimeValue();
        } catch (err) {
          const detail = err instanceof Error ? err.message : String(err);
          setMessage('发布失败：' + detail.slice(0, 200), 'error');
          if (err instanceof MomentApiError && err.code === 'AUTH_REQUIRED') updateSessionUi(false, '登录已失效，请重新登录。');
        } finally {
          const authenticated = (await getSession({ signal }).catch(() => ({ authenticated: false }))).authenticated;
          updateSessionUi(authenticated);
          submitBtn.textContent = '发布';
        }
      }, { signal });
    }

    lightbox = document.getElementById('moment-lightbox') as HTMLElement | null;
    lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement | null;
    lightboxCounter = document.getElementById('lightbox-counter');
    lightboxStage = document.getElementById('lightbox-stage');
    lightboxClose = document.getElementById('lightbox-close') as HTMLButtonElement | null;
    lightboxPrev = document.getElementById('lightbox-prev') as HTMLButtonElement | null;
    lightboxNext = document.getElementById('lightbox-next') as HTMLButtonElement | null;
    setupLightboxForNewCards();
    lightbox?.addEventListener('click', closeLightbox, { signal });
    lightboxStage?.addEventListener('click', (event) => event.stopPropagation(), { signal });
    lightboxClose?.addEventListener('click', (event) => { event.stopPropagation(); closeLightbox(); }, { signal });
    lightboxPrev?.addEventListener('click', (event) => { event.stopPropagation(); moveLightbox(-1); }, { signal });
    lightboxNext?.addEventListener('click', (event) => { event.stopPropagation(); moveLightbox(1); }, { signal });
    document.addEventListener('keydown', (event) => {
      if (lightbox?.hidden !== false) return;
      if (event.key === 'Escape') closeLightbox();
      if (event.key === 'ArrowLeft') moveLightbox(-1);
      if (event.key === 'ArrowRight') moveLightbox(1);
    }, { signal });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initMomentsPage, { once: true });
  else initMomentsPage();
  document.addEventListener('astro:page-load', initMomentsPage);
</script>