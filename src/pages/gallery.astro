---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryBrowser from '../components/GalleryBrowser.astro';
import GalleryLightbox from '../components/GalleryLightbox.astro';
import '../styles/gallery.css';
---

<BaseLayout
  title="画廊 | 搁浅 的小窝"
  description="Airi Gallery：收藏喜欢的画面、角色与瞬间。"
  bannerTitle="Airi Gallery"
  bannerSubtitle="收藏喜欢的画面、角色与瞬间"
>
  <div class="gallery-page-shell">
    <GalleryBrowser />
  </div>
  <GalleryLightbox />
</BaseLayout>

<script>
  import { initGalleryManageEntry } from '../lib/gallery-manage-entry.mjs';

  const galleryWindow = window as any;

  function cleanupGalleryManageEntry() {
    galleryWindow.__galleryManageEntryCleanup?.();
    galleryWindow.__galleryManageEntryCleanup = null;
  }

  function mountGalleryManageEntry() {
    cleanupGalleryManageEntry();
    galleryWindow.__galleryManageEntryCleanup = initGalleryManageEntry(document, window);
  }

  if (!galleryWindow.__galleryManageEntryLifecycleBound) {
    galleryWindow.__galleryManageEntryLifecycleBound = true;
    document.addEventListener('astro:page-load', mountGalleryManageEntry);
    document.addEventListener('astro:before-swap', cleanupGalleryManageEntry);
  }

  mountGalleryManageEntry();
</script>
